# Copy to `.env.local` for local development.
# Vite only exposes variables prefixed with VITE_ to the browser.

# Where the Vite dev/preview server forwards /v1 and /health.
# Defaults to http://localhost:8080.
VITE_API_PROXY_TARGET=http://localhost:8080

# Set only when the API is served from a different origin than the web app
# (for example in deployment). Leave unset in local development so requests
# stay same-origin and go through the proxy above.
VITE_API_BASE_URL=

# Public origin for game media served from Cloudflare R2 (no trailing slash).
# Example: https://assets.example.com. Game art, audio, and video are published
# to R2, not bundled with the web app; see `assets/README.md`.
VITE_ASSET_BASE_URL=

# --- Auth (WorkOS AuthKit) ---
# Public WorkOS client id (starts with `client_`). This value is safe to ship
# to the browser; the WorkOS API secret never belongs in the web app.
# When empty, the app stays anonymous and login shows a "not configured" note.
VITE_WORKOS_CLIENT_ID=
# Optional custom AuthKit authentication domain (defaults to api.workos.com).
# Set this only if you configured a custom AuthKit domain in WorkOS.
VITE_WORKOS_API_HOSTNAME=api.workos.com

# Opt in to the local developer identity in a non-dev build. Never enable this
# in production; production requires a real WorkOS client id.
VITE_AUTH_DEV_MODE=

# OPTIONAL dedicated origin for browser-side Python execution, for example
# https://python-sandbox.example.com. Leave empty for the default, which runs
# the sandbox on the app origin: learner Python is given no JavaScript bridge,
# so it cannot reach site storage, files, or the network. A distinct origin is
# stronger, browser-enforced isolation and must serve the same built `dist` and
# allow the app origin in its sandbox CSP `frame-ancestors`.
VITE_PYTHON_SANDBOX_ORIGIN=

# Maximum Python/WASM heap in MiB. Defaults to 384. Lower it for very
# constrained mobile devices; raise it only if authored exercises need more.
VITE_PYTHON_MAX_MEMORY_MB=
