# Copy to `.env` for local API development. Never commit real secrets.
# The web app has its own example at apps/web/.env.example.

# --- Runtime ---
APP_ENV=local
BIND_ADDR=0.0.0.0:8080
# `pretty` for humans, `json` for log collectors. Defaults to `json` when APP_ENV=production.
LOG_FORMAT=pretty
RUST_LOG=info,tower_http=debug

# --- Database ---
DATABASE_URL=postgres://app:app@localhost:5432/app
DATABASE_MAX_CONNECTIONS=5
# Convenience for local development. Use an approved migration job in production.
RUN_MIGRATIONS=true

# --- HTTP ---
# Comma-separated browser origins allowed by CORS.
CORS_ALLOWED_ORIGINS=http://localhost:5173
REQUEST_TIMEOUT_SECONDS=30
REQUEST_BODY_LIMIT_BYTES=1048576

# --- Auth (WorkOS AuthKit) ---
# Required in staging and production: the API fails to start without both
# WORKOS_CLIENT_ID and WORKOS_API_KEY. Local and test environments may omit
# them and then accept an explicit `Authorization: Bearer dev:<subject>` token.
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
# Expected token issuer. Defaults to https://api.workos.com. If your WorkOS
# environment uses an AuthKit authentication domain, set this to that domain,
# for example https://your-app-staging.authkit.app (discover it with
# `{issuer}/.well-known/openid-configuration`).
WORKOS_ISSUER=
# Optional explicit JWKS URL. Defaults to the provider layout for the issuer:
#   https://api.workos.com/sso/jwks/<client_id>
#   https://<authkit-domain>/oauth2/jwks
# Set only if your environment deviates from those.
WORKOS_JWKS_URL=

# --- Object storage (Cloudflare R2) ---
# Not used in Phase 0; documented for later phases.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Internal analytics ---
# The aggregate model-evaluation endpoint is a developer/operator tool. It is on
# by default only in local/test. Outside local/test it is off unless explicitly
# enabled, and when enabled it requires INTERNAL_API_TOKEN.
INTERNAL_EVALUATION_ENABLED=
INTERNAL_API_TOKEN=
