# Copy to `.env` for local API development. Never commit real secrets.
# The web app has its own example at apps/web/.env.example.

# --- Runtime ---
APP_ENV=local
BIND_ADDR=0.0.0.0:8080
# `pretty` for humans, `json` for log collectors. Defaults to `json` when APP_ENV=production.
LOG_FORMAT=pretty
RUST_LOG=info,tower_http=debug

# --- Database ---
DATABASE_URL=postgres://app:app@localhost:5432/app
DATABASE_MAX_CONNECTIONS=5
# Convenience for local development. Use an approved migration job in production.
RUN_MIGRATIONS=true

# --- HTTP ---
# Comma-separated browser origins allowed by CORS.
CORS_ALLOWED_ORIGINS=http://localhost:5173
REQUEST_TIMEOUT_SECONDS=30
REQUEST_BODY_LIMIT_BYTES=1048576

# --- Auth (WorkOS AuthKit) ---
# Leave all blank to run the API without authentication wired up (Phase 0).
# Set both WORKOS_CLIENT_ID and WORKOS_API_KEY, or neither.
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_ISSUER=

# --- Object storage (Cloudflare R2) ---
# Not used in Phase 0; documented for later phases.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
