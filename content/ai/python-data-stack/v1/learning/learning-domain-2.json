              "reveal": {
                "type": "code_file",
                "filename": "selection.py",
                "language": "python",
                "code": "import pandas as pd\n\ndf = pd.DataFrame({\n    \"name\": [\"Ada\", \"Linus\", \"Grace\"],\n    \"score\": [98, 72, 95],\n})\n\nhigh = df.loc[df[\"score\"] >= 90, [\"name\", \"score\"]]\nfirst_two = df.iloc[:2, :]\nhigh_query = df.query(\"score >= 90\")\n\n# high/high_query contain Ada and Grace\n# first_two contains Ada and Linus",
                "line_numbers": true,
                "annotations": [
                  {
