          "prompts": [
            {
              "id": "code",
              "kind": "look_for",
              "label": "JOIN TABLES ON A KEY",
              "placeholder": "Click on and how.",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "merge.py",
                "language": "python",
                "code": "import pandas as pd\n\nusers = pd.DataFrame({\n    \"user_id\": [1, 2],\n    \"name\": [\"Ada\", \"Grace\"],\n})\n\norders = pd.DataFrame({\n    \"user_id\": [1, 1, 3],\n    \"total\": [20, 35, 50],\n})\n\njoined = users.merge(\n    orders,\n    on=\"user_id\",\n    how=\"left\",\n)",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "on",
                    "anchor": {
                      "line": 15,
                      "text": "on=\"user_id\"",
                      "occurrence": 1
                    },
                    "title": "Join key",
                    "explanation": "Rows match when user_id values are equal.",
                    "required": true
                  },
                  {
                    "id": "how",
                    "anchor": {
                      "line": 16,
                      "text": "how=\"left\"",
                      "occurrence": 1
                    },
                    "title": "Left join",
                    "explanation": "All user rows remain even when no order matches.",
                    "required": true
                  }
                ]
              }
            }
          ],
