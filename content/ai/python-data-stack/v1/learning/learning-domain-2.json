        {
          "id": "domain-2-groupby",
          "title": "`groupby`: split rows before summarizing",
          "concept_ids": [
            "python.pandas.groupby"
          ],
          "prompts": [
            {
              "id": "code",
              "kind": "look_for",
              "label": "GROUP FIRST, THEN CHOOSE THE SUMMARY",
              "placeholder": "Click groupby and mean.",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "groupby.py",
                "language": "python",
                "code": "import pandas as pd\n\ndf = pd.DataFrame({\n    \"team\": [\"red\", \"red\", \"blue\"],\n    \"score\": [80, 100, 70],\n})\n\ngroups = df.groupby(\"team\")\nteam_mean = groups[\"score\"].mean()\n\n# blue -> 70.0\n# red  -> 90.0",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "group",
                    "anchor": {
                      "line": 8,
                      "text": "df.groupby(\"team\")",
                      "occurrence": 1
                    },
                    "title": "Split rows into groups",
                    "explanation": "Rows sharing a team value belong to the same group.",
                    "required": true
                  },
                  {
                    "id": "mean",
                    "anchor": {
                      "line": 9,
                      "text": "groups[\"score\"].mean()",
                      "occurrence": 1
                    },
                    "title": "Aggregate each group",
                    "explanation": "mean reduces each team's scores to one value.",
                    "required": true
                  }
                ]
              }
            }
          ],
