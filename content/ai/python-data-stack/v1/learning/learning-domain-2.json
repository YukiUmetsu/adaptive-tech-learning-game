        {
          "id": "domain-2-group-pipeline",
          "title": "Compose group → aggregate → sort",
          "concept_ids": [
            "python.pandas.groupby",
            "python.pandas.aggregation",
            "python.pandas.sorting"
          ],
          "prompts": [
            {
              "id": "code",
              "kind": "look_for",
              "label": "READ THE WHOLE PIPELINE",
              "placeholder": "Click groupby, agg, and sort_values in order.",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "group_pipeline.py",
                "language": "python",
                "code": "summary = (\n    df.groupby(\"team\", as_index=False)\n      .agg(\n          average_score=(\"score\", \"mean\"),\n          players=(\"score\", \"size\"),\n      )\n      .sort_values(\"average_score\", ascending=False)\n)\n\n# one row per team, highest average_score first",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "group",
                    "anchor": {
                      "line": 2,
                      "text": "groupby(\"team\", as_index=False)",
                      "occurrence": 1
                    },
                    "title": "Group rows",
                    "explanation": "as_index=False keeps team as a regular output column.",
                    "required": true
                  },
                  {
                    "id": "agg",
                    "anchor": {
                      "line": 3,
                      "text": ".agg(",
                      "occurrence": 1
                    },
                    "title": "Collapse to summaries",
                    "explanation": "Each team becomes one row with average_score and players.",
                    "required": true
                  },
                  {
                    "id": "sort",
                    "anchor": {
                      "line": 7,
                      "text": "sort_values(\"average_score\", ascending=False)",
                      "occurrence": 1
                    },
                    "title": "Rank summaries",
                    "explanation": "The aggregated rows are ordered from highest to lowest average score.",
                    "required": true
                  }
                ]
              }
            }
