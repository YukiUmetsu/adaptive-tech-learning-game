              "reveal": {
                "type": "code_file",
                "filename": "keepdims.py",
                "language": "python",
                "code": "import numpy as np\n\ndata = np.array([\n    [2, 4, 6],\n    [1, 3, 5],\n])\n\nrow_mean = data.mean(axis=1, keepdims=True)\ncentered = data - row_mean\n\n# row_mean.shape -> (2, 1)\n# centered.shape -> (2, 3)",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "keep",
                    "anchor": {
                      "line": 8,
                      "text": "keepdims=True",
                      "occurrence": 1
