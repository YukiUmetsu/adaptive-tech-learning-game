        {
          "id": "domain-4-compose",
          "title": "Data preparation comes before the plot",
          "concept_ids": [
            "python.seaborn.relational",
            "python.seaborn.semantic_mapping"
          ],
          "prompts": [
            {
              "id": "code",
              "kind": "look_for",
              "label": "PREPARE → SUMMARIZE → PLOT",
              "placeholder": "Click groupby, agg, and lineplot.",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "compose_seaborn.py",
                "language": "python",
                "code": "import seaborn as sns\n\nsummary = (\n    df.groupby([\"month\", \"region\"], as_index=False)\n      .agg(revenue=(\"revenue\", \"sum\"))\n)\n\nsns.lineplot(\n    data=summary,\n    x=\"month\",\n    y=\"revenue\",\n    hue=\"region\",\n)",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "group",
                    "anchor": {
                      "line": 4,
                      "text": "df.groupby([\"month\", \"region\"], as_index=False)",
                      "occurrence": 1
                    },
                    "title": "Prepare grouping keys",
                    "explanation": "The DataFrame is grouped into the units the chart should compare.",
                    "required": true
                  },
                  {
                    "id": "agg",
                    "anchor": {
                      "line": 5,
                      "text": ".agg(revenue=(\"revenue\", \"sum\"))",
                      "occurrence": 1
                    },
                    "title": "Build the plotted measure",
                    "explanation": "One revenue value is produced per month-region pair.",
                    "required": true
                  },
                  {
                    "id": "plot",
                    "anchor": {
                      "line": 8,
                      "text": "sns.lineplot(",
                      "occurrence": 1
                    },
                    "title": "Plot tidy summarized data",
                    "explanation": "With month, revenue, and region explicit, the plotting call stays simple.",
                    "required": true
                  }
                ]
              }
            }
          ],
          "prerequisite_node_ids": [
            "domain-4-pairplot"
          ],
