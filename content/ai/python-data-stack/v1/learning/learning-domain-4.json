          "id": "domain-4-relational",
          "title": "`scatterplot` and `lineplot`",
          "concept_ids": [
            "python.seaborn.relational"
          ],
          "prompts": [
            {
              "id": "code",
              "kind": "look_for",
              "label": "CHOOSE SCATTER VS LINE",
              "placeholder": "Click both Seaborn calls.",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "relational.py",
                "language": "python",
                "code": "import matplotlib.pyplot as plt\nimport seaborn as sns\n\nfig, axes = plt.subplots(1, 2)\n\nsns.scatterplot(\n    data=df,\n    x=\"height\",\n    y=\"weight\",\n    hue=\"group\",\n    ax=axes[0],\n)\n\nsns.lineplot(\n    data=df,\n    x=\"date\",\n    y=\"temperature\",\n    hue=\"city\",\n    ax=axes[1],\n)",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "scatter",
                    "anchor": {
                      "line": 6,
                      "text": "sns.scatterplot(",
                      "occurrence": 1
                    },
                    "title": "Observation relationship",
                    "explanation": "scatterplot shows paired observations and can encode groups with semantics.",
                    "required": true
                  },
                  {
                    "id": "line",
                    "anchor": {
                      "line": 14,
                      "text": "sns.lineplot(",
                      "occurrence": 1
                    },
                    "title": "Ordered trend",
                    "explanation": "lineplot emphasizes change across ordered x values and can encode groups.",
                    "required": true
                  }
                ]
              }
            }
          ],
