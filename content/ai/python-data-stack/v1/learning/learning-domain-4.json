        {
          "id": "domain-4-pairplot",
          "title": "`pairplot` explores many pairwise relationships",
          "concept_ids": [
            "python.seaborn.figure_axes_level",
            "python.seaborn.semantic_mapping"
          ],
          "prompts": [
            {
              "id": "code",
              "kind": "look_for",
              "label": "EXPLORE MANY VARIABLE PAIRS",
              "placeholder": "Click vars, hue, and corner.",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "pairplot.py",
                "language": "python",
                "code": "import seaborn as sns\n\nsns.pairplot(\n    data=df,\n    vars=[\"height\", \"weight\", \"age\"],\n    hue=\"group\",\n    corner=True,\n)",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "vars",
                    "anchor": {
                      "line": 5,
                      "text": "vars=[\"height\", \"weight\", \"age\"]",
                      "occurrence": 1
                    },
                    "title": "Variables in the grid",
                    "explanation": "pairplot builds pairwise views among the selected columns.",
                    "required": true
                  },
                  {
                    "id": "hue",
                    "anchor": {
                      "line": 6,
                      "text": "hue=\"group\"",
                      "occurrence": 1
                    },
                    "title": "Semantic grouping",
                    "explanation": "Observations are colored by group across the grid.",
                    "required": true
                  },
                  {
                    "id": "corner",
                    "anchor": {
                      "line": 7,
                      "text": "corner=True",
                      "occurrence": 1
                    },
                    "title": "Remove mirrored duplicates",
                    "explanation": "Only one triangular half of the symmetric pair grid is shown.",
                    "required": true
                  }
                ]
              }
            }
          ],
