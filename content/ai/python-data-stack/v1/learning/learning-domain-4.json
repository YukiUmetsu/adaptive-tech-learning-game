              "reveal": {
                "type": "code_file",
                "filename": "semantic_mapping.py",
                "language": "python",
                "code": "import seaborn as sns\n\nsns.scatterplot(\n    data=df,\n    x=\"engine_size\",\n    y=\"mpg\",\n    hue=\"origin\",\n    style=\"fuel_type\",\n    size=\"weight\",\n)",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "hue",
                    "anchor": {
                      "line": 7,
