                "language": "python",
                "code": "import matplotlib.pyplot as plt\nimport seaborn as sns\n\nfig, axes = plt.subplots(1, 2)\n\nsns.boxplot(data=df, x=\"department\", y=\"salary\", ax=axes[0])\nsns.countplot(data=df, x=\"department\", ax=axes[1])",
