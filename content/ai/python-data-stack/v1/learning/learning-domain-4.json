        {
          "id": "domain-4-heatmap",
          "title": "Correlation matrix → heatmap",
          "concept_ids": [
            "python.seaborn.heatmap"
          ],
          "prompts": [
            {
              "id": "code",
              "kind": "look_for",
              "label": "PREPARE THE MATRIX BEFORE PLOTTING",
              "placeholder": "Click corr, heatmap, and annot.",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "heatmap.py",
                "language": "python",
                "code": "import seaborn as sns\n\nnumeric = df[[\"age\", \"income\", \"score\"]]\ncorrelation = numeric.corr()\n\nsns.heatmap(\n    correlation,\n    annot=True,\n    cmap=\"coolwarm\",\n    vmin=-1,\n    vmax=1,\n)",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "corr",
                    "anchor": {
                      "line": 4,
                      "text": "numeric.corr()",
                      "occurrence": 1
                    },
                    "title": "Compute the matrix",
                    "explanation": "corr transforms selected numeric columns into a square correlation matrix.",
                    "required": true
                  },
                  {
                    "id": "heatmap",
                    "anchor": {
                      "line": 6,
                      "text": "sns.heatmap(",
                      "occurrence": 1
                    },
                    "title": "Visualize matrix values",
                    "explanation": "heatmap maps matrix cells to color.",
                    "required": true
                  },
                  {
                    "id": "annot",
                    "anchor": {
                      "line": 8,
                      "text": "annot=True",
                      "occurrence": 1
                    },
                    "title": "Show numbers",
                    "explanation": "annot writes correlation values inside the cells.",
                    "required": true
                  }
                ]
              }
            }
          ],
          "prerequisite_node_ids": [
            "domain-4-axes-figure"
          ],
