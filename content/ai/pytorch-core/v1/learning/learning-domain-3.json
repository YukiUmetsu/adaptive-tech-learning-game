                    "id": "linear",
                    "anchor": {
                      "line": 4,
                      "text": "nn.Linear(in_features=128, out_features=64)",
                      "occurrence": 1
                    },
                    "title": "Affine transform on the last dimension",
                    "explanation": "The last input dimension must match in_features; the layer replaces it with out_features.",
                    "required": true
                  },
                  {
                    "id": "call",
                    "anchor": {
                      "line": 7,
                      "text": "y = layer(x)",
                      "occurrence": 1
                    },
                    "title": "Preserve leading dimensions",
                    "explanation": "The batch dimension is preserved while the feature dimension changes from 128 to 64.",
