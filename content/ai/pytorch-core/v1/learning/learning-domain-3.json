              "reveal": {
                "type": "code_file",
                "filename": "flatten.py",
                "language": "python",
                "code": "import torch\nimport torch.nn as nn\n\nflatten = nn.Flatten(start_dim=1)\n\nx = torch.randn(32, 16, 8, 8)\ny = flatten(x)\n\n# x.shape -> [32, 16, 8, 8]\n# y.shape -> [32, 1024]",
