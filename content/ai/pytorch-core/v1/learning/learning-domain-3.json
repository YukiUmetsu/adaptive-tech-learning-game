              "reveal": {
                "type": "code_file",
                "filename": "linear.py",
                "language": "python",
                "code": "import torch\nimport torch.nn as nn\n\nlayer = nn.Linear(in_features=128, out_features=64)\n\nx = torch.randn(32, 128)\ny = layer(x)\n\n# x.shape -> [32, 128]\n# y.shape -> [32, 64]",
                "line_numbers": true,
                "annotations": [
