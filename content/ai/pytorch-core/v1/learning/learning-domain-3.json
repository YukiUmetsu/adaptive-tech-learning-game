        {
          "id": "domain-3-nn-module",
          "title": "Subclassing `nn.Module`",
          "concept_ids": [
            "ai.pytorch.nn_module"
          ],
          "prompts": [
            {
              "id": "code",
              "kind": "look_for",
              "label": "BUILD A CUSTOM MODULE",
              "placeholder": "Click the superclass initialization and registered child layers.",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "custom_module.py",
                "language": "python",
                "code": "import torch.nn as nn\n\nclass Classifier(nn.Module):\n    def __init__(self, in_features, hidden, classes):\n        super().__init__()\n        self.hidden = nn.Linear(in_features, hidden)\n        self.activation = nn.ReLU()\n        self.output = nn.Linear(hidden, classes)\n\n    def forward(self, x):\n        x = self.hidden(x)\n        x = self.activation(x)\n        return self.output(x)",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "super",
                    "anchor": {
                      "line": 5,
                      "text": "super().__init__()",
                      "occurrence": 1
                    },
                    "title": "Initialize nn.Module",
                    "explanation": "Calling the parent initializer sets up Module's registration and internal state.",
                    "required": true
                  },
                  {
                    "id": "hidden",
                    "anchor": {
                      "line": 6,
                      "text": "self.hidden = nn.Linear",
                      "occurrence": 1
                    },
                    "title": "Registered child module",
                    "explanation": "Assigning an nn.Module to an attribute registers it with the parent.",
                    "required": true
                  },
                  {
                    "id": "forward",
                    "anchor": {
                      "line": 10,
                      "text": "def forward(self, x):",
                      "occurrence": 1
                    },
                    "title": "Define the computation",
                    "explanation": "forward describes how inputs move through the registered layers.",
                    "required": true
                  }
                ]
              }
            },
            {
              "id": "registration",
              "kind": "not_this",
              "label": "REGISTER LAYERS WITH THE MODULE",
              "placeholder": "Why not keep trainable layers only in an ordinary Python list?",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Plain Python containers do not automatically register child modules. Use ModuleList or ModuleDict when you need container behavior plus module registration."
              }
            }
          ],
          "prerequisite_node_ids": [],
          "map_position": {
            "x": 0.12,
            "y": 0.14
          },
          "source_refs": []
        },
