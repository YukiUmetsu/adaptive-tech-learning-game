        {
          "id": "domain-1-manual-seed",
          "title": "Random seeds",
          "concept_ids": [
            "ai.pytorch.manual_seed"
          ],
          "prompts": [
            {
              "id": "code",
              "kind": "look_for",
              "label": "START FROM A REPEATABLE PYTORCH RNG STATE",
              "placeholder": "Click manual_seed and compare the repeated random draws.",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "manual_seed.py",
                "language": "python",
                "code": "import torch\n\ntorch.manual_seed(42)\nfirst = torch.randn(3)\n\ntorch.manual_seed(42)\nsecond = torch.randn(3)\n\n# first and second begin from the same PyTorch random sequence",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "seed",
                    "anchor": {
                      "line": 3,
                      "text": "torch.manual_seed(42)",
                      "occurrence": 1
                    },
                    "title": "Set PyTorch's random seed",
                    "explanation": "torch.manual_seed seeds PyTorch random-number generators so a run can begin from a repeatable random sequence.",
                    "required": true
                  }
                ]
              }
            },
            {
              "id": "limit",
              "kind": "not_this",
              "label": "SEEDING IS NOT FULL DETERMINISM",
              "placeholder": "What does a fixed seed not guarantee?",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "A fixed seed improves reproducibility but does not by itself guarantee that every operation is deterministic across every platform, backend, or PyTorch release."
              }
            }
          ],
