        {
          "id": "domain-1-shape-ndim-numel",
          "title": "Shape, dimensions, and element count",
          "concept_ids": [
            "ai.pytorch.shape_ndim_numel"
          ],
          "prompts": [
            {
              "id": "code",
              "kind": "look_for",
              "label": "READ TENSOR STRUCTURE",
              "placeholder": "Click shape, ndim, and numel. Each answers a different structural question.",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "tensor_structure.py",
                "language": "python",
                "code": "import torch\n\nx = torch.zeros((8, 3, 32, 32))\n\nbatch_size = x.shape[0]\ndimensions = x.ndim\nelements = x.numel()\n\n# x.shape -> torch.Size([8, 3, 32, 32])\n# x.ndim  -> 4\n# x.numel() -> 24576",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "shape",
                    "anchor": {
                      "line": 5,
                      "text": "x.shape[0]",
                      "occurrence": 1
                    },
                    "title": "Read a dimension size",
                    "explanation": "shape contains the size of every axis. The leading dimension is often the batch dimension.",
                    "required": true
                  },
                  {
                    "id": "ndim",
                    "anchor": {
                      "line": 6,
                      "text": "x.ndim",
                      "occurrence": 1
                    },
                    "title": "Count axes",
                    "explanation": "ndim reports the number of dimensions, not the number of elements.",
                    "required": true
                  },
                  {
                    "id": "numel",
                    "anchor": {
                      "line": 7,
                      "text": "x.numel()",
                      "occurrence": 1
                    },
                    "title": "Count all elements",
                    "explanation": "numel multiplies the dimension sizes and returns the total element count.",
                    "required": true
                  }
                ]
              }
            }
          ],
