        {
          "id": "domain-1-tensor-creation",
          "title": "Creating tensors",
          "concept_ids": [
            "ai.pytorch.tensor_creation"
          ],
          "prompts": [
            {
              "id": "code",
              "kind": "look_for",
              "label": "CREATE TENSORS IN CONTEXT",
              "placeholder": "Click each constructor and compare what it is used for.",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "tensor_creation.py",
                "language": "python",
                "code": "import torch\n\ndata = [[1, 2], [3, 4]]\n\nfrom_data = torch.tensor(data, dtype=torch.float32)\nzeros = torch.zeros((2, 3))\nnoise = torch.randn((2, 3))\n\ncopied = from_data.clone()",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "tensor",
                    "anchor": {
                      "line": 5,
                      "text": "torch.tensor(data",
                      "occurrence": 1
                    },
                    "title": "Create from Python data",
                    "explanation": "torch.tensor(...) constructs a tensor from existing Python data and can set dtype explicitly.",
                    "required": true
                  },
                  {
                    "id": "zeros",
                    "anchor": {
                      "line": 6,
                      "text": "torch.zeros((2, 3))",
                      "occurrence": 1
                    },
                    "title": "Factory-created values",
                    "explanation": "Factory functions such as torch.zeros create a new tensor directly from the requested shape.",
                    "required": true
                  },
                  {
                    "id": "randn",
                    "anchor": {
                      "line": 7,
                      "text": "torch.randn((2, 3))",
                      "occurrence": 1
                    },
                    "title": "Random factory",
                    "explanation": "torch.randn creates new random values drawn from a standard normal distribution.",
                    "required": true
                  },
                  {
                    "id": "clone",
                    "anchor": {
                      "line": 9,
                      "text": "from_data.clone()",
                      "occurrence": 1
                    },
                    "title": "Copy an existing tensor",
                    "explanation": "When you need another tensor with copied data, clone is clearer than reconstructing with torch.tensor(existing_tensor).",
                    "required": true
                  }
                ]
              }
            },
            {
              "id": "gotcha",
              "kind": "not_this",
              "label": "DON'T RECONSTRUCT AN EXISTING TENSOR",
              "placeholder": "Why is torch.tensor(existing_tensor) usually the wrong copy/view tool?",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Constructing a new tensor from an existing tensor can copy data and lose autograd history. Use tensor operations such as clone, detach, or view/reshape according to the behavior you actually need."
              }
            }
          ],
          "prerequisite_node_ids": [],
