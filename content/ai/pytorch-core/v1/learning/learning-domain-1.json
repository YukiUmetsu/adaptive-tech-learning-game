        {
          "id": "domain-1-dtype-device-to",
          "title": "dtype, device, and `.to(...)`",
          "concept_ids": [
            "ai.pytorch.dtype_device_to"
          ],
          "prompts": [
            {
              "id": "code",
              "kind": "look_for",
              "label": "MOVE AND CONVERT A TENSOR",
              "placeholder": "Click dtype, device, and .to(...).",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "dtype_device.py",
                "language": "python",
                "code": "import torch\n\nx = torch.tensor([1, 2, 3], dtype=torch.float32)\n\nprint(x.dtype)\nprint(x.device)\n\ndevice = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\nx = x.to(device=device, dtype=torch.float32)",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "dtype",
                    "anchor": {
                      "line": 5,
                      "text": "x.dtype",
                      "occurrence": 1
                    },
                    "title": "Tensor dtype",
                    "explanation": "dtype describes the numeric type used to store tensor elements.",
                    "required": true
                  },
                  {
                    "id": "device",
                    "anchor": {
                      "line": 6,
                      "text": "x.device",
                      "occurrence": 1
                    },
                    "title": "Tensor device",
                    "explanation": "device tells you where the tensor currently lives.",
                    "required": true
                  },
                  {
                    "id": "to",
                    "anchor": {
                      "line": 9,
                      "text": "x.to(device=device, dtype=torch.float32)",
                      "occurrence": 1
                    },
                    "title": "Move and/or convert",
                    "explanation": ".to(...) can move a tensor to another device and can also change dtype.",
                    "required": true
                  }
                ]
              }
            },
            {
              "id": "compatibility",
              "kind": "not_this",
              "label": "KEEP OPERANDS COMPATIBLE",
              "placeholder": "What is the common device rule for model operations?",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Model parameters and input tensors used by the same operation normally need to be on compatible devices."
              }
            }
          ],
