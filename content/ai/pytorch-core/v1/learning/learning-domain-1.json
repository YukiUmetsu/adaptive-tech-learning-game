        {
          "id": "domain-1-unsqueeze-squeeze",
          "title": "`unsqueeze` and `squeeze`",
          "concept_ids": [
            "ai.pytorch.unsqueeze_squeeze"
          ],
          "prompts": [
            {
              "id": "code",
              "kind": "look_for",
              "label": "ADD OR REMOVE SIZE-1 AXES",
              "placeholder": "Click unsqueeze and squeeze.",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "squeeze_unsqueeze.py",
                "language": "python",
                "code": "import torch\n\nimage = torch.zeros((3, 224, 224))\nbatched = image.unsqueeze(0)\n\nrestored = batched.squeeze(0)\n\n# image.shape   -> [3, 224, 224]\n# batched.shape -> [1, 3, 224, 224]",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "unsqueeze",
                    "anchor": {
                      "line": 4,
                      "text": "image.unsqueeze(0)",
                      "occurrence": 1
                    },
                    "title": "Insert a size-1 dimension",
                    "explanation": "unsqueeze(0) adds a leading dimension, which is useful when turning one sample into a batch of size 1.",
                    "required": true
                  },
                  {
                    "id": "squeeze",
                    "anchor": {
                      "line": 6,
                      "text": "batched.squeeze(0)",
                      "occurrence": 1
                    },
                    "title": "Remove a selected size-1 dimension",
                    "explanation": "squeeze(0) removes only dimension 0 when its size is 1.",
                    "required": true
                  }
                ]
              }
            },
            {
              "id": "gotcha",
              "kind": "not_this",
              "label": "BE CAREFUL WITH BARE squeeze()",
              "placeholder": "Why can squeeze() be dangerous when batch size may equal 1?",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Bare squeeze() removes every size-1 dimension, so it can accidentally remove a meaningful batch dimension. Prefer squeeze(dim) when you know which axis should disappear."
              }
            }
          ],
