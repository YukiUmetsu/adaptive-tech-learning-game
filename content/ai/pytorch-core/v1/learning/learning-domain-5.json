            {
              "id": "code",
              "kind": "look_for",
              "label": "STEP WITH THE MONITORED METRIC",
              "placeholder": "Click ReduceLROnPlateau and scheduler.step(validation_loss).",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "reduce_plateau.py",
                "language": "python",
                "code": "scheduler = torch.optim.lr_scheduler.ReduceLROnPlateau(\n    optimizer,\n    mode=\"min\",\n    patience=2,\n    factor=0.5,\n)\n\nfor epoch in range(epochs):\n    train_one_epoch(model, train_loader, optimizer)\n    validation_loss = validate(model, validation_loader)\n\n    scheduler.step(validation_loss)",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "scheduler",
                    "anchor": {
                      "line": 1,
                      "text": "ReduceLROnPlateau(",
                      "occurrence": 1
                    },
                    "title": "Metric-based scheduler",
                    "explanation": "The scheduler lowers the learning rate when the monitored metric stops improving for the configured patience.",
                    "required": true
                  },
                  {
                    "id": "metric",
                    "anchor": {
                      "line": 12,
                      "text": "scheduler.step(validation_loss)",
                      "occurrence": 1
                    },
                    "title": "Pass the monitored value",
                    "explanation": "Unlike simple epoch schedulers, ReduceLROnPlateau needs the metric value at step time.",
                    "required": true
                  }
                ]
              }
            }
