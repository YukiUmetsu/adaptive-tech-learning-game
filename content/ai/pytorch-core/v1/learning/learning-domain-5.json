          "id": "domain-5-cross-entropy",
          "title": "CrossEntropyLoss",
          "concept_ids": [
            "ai.pytorch.cross_entropy"
          ],
          "prompts": [
            {
              "id": "code",
              "kind": "look_for",
              "label": "MATCH LOGITS AND CLASS-INDEX TARGETS",
              "placeholder": "Click logits, integer targets, and CrossEntropyLoss.",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "cross_entropy.py",
                "language": "python",
                "code": "import torch\nimport torch.nn as nn\n\nlogits = torch.randn(32, 10)\ntargets = torch.randint(0, 10, (32,))\n\nloss_fn = nn.CrossEntropyLoss()\nloss = loss_fn(logits, targets)\n\n# logits.shape  -> [32, 10]\n# targets.shape -> [32]",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "logits",
                    "anchor": {
                      "line": 4,
                      "text": "logits = torch.randn(32, 10)",
                      "occurrence": 1
                    },
                    "title": "Unnormalized class scores",
                    "explanation": "For the common class-index case, CrossEntropyLoss expects one logit per class.",
                    "required": true
                  },
                  {
                    "id": "targets",
                    "anchor": {
                      "line": 5,
                      "text": "targets = torch.randint(0, 10, (32,))",
                      "occurrence": 1
                    },
                    "title": "Integer class indices",
                    "explanation": "Each target is a class id from 0 through C-1.",
                    "required": true
                  },
                  {
                    "id": "loss",
                    "anchor": {
                      "line": 7,
                      "text": "nn.CrossEntropyLoss()",
                      "occurrence": 1
                    },
                    "title": "Cross-entropy objective",
                    "explanation": "The loss consumes logits directly, so do not apply softmax first.",
                    "required": true
                  }
                ]
              }
            }
          ],
