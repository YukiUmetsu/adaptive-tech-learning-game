        {
          "id": "domain-5-bce-logits",
          "title": "BCEWithLogitsLoss",
          "concept_ids": [
            "ai.pytorch.bce_logits"
          ],
          "prompts": [
            {
              "id": "code",
              "kind": "look_for",
              "label": "USE RAW BINARY LOGITS",
              "placeholder": "Click BCEWithLogitsLoss and compare input/target shapes.",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "bce_logits.py",
                "language": "python",
                "code": "import torch\nimport torch.nn as nn\n\nlogits = torch.randn(32, 5)\ntargets = torch.randint(0, 2, (32, 5)).float()\n\nloss_fn = nn.BCEWithLogitsLoss()\nloss = loss_fn(logits, targets)",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "targets",
                    "anchor": {
                      "line": 5,
                      "text": "targets = torch.randint(0, 2, (32, 5)).float()",
                      "occurrence": 1
                    },
                    "title": "Floating-point targets",
                    "explanation": "Typical binary or multi-label targets are floating-point values compatible with the logits shape.",
                    "required": true
                  },
                  {
                    "id": "loss",
                    "anchor": {
                      "line": 7,
                      "text": "nn.BCEWithLogitsLoss()",
                      "occurrence": 1
                    },
                    "title": "Sigmoid + BCE in one stable loss",
                    "explanation": "The loss combines sigmoid behavior with binary cross-entropy in a numerically stable formulation.",
                    "required": true
                  }
                ]
              }
            },
            {
              "id": "sigmoid",
              "kind": "not_this",
              "label": "DON'T APPLY sigmoid FIRST",
              "placeholder": "Should the model output be passed through sigmoid before BCEWithLogitsLoss?",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "No. Feed raw logits to BCEWithLogitsLoss."
              }
            }
          ],
