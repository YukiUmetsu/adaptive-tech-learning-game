          "id": "domain-5-scheduler-step",
          "title": "Learning-rate schedulers",
          "concept_ids": [
            "ai.pytorch.scheduler_step"
          ],
          "prompts": [
            {
              "id": "code",
              "kind": "look_for",
              "label": "STEP AN EPOCH-BASED SCHEDULER",
              "placeholder": "Click StepLR and scheduler.step.",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "scheduler_step.py",
                "language": "python",
                "code": "optimizer = torch.optim.SGD(model.parameters(), lr=0.1)\n\nscheduler = torch.optim.lr_scheduler.StepLR(\n    optimizer,\n    step_size=10,\n    gamma=0.1,\n)\n\nfor epoch in range(30):\n    train_one_epoch(model, loader, optimizer)\n    scheduler.step()",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "scheduler",
                    "anchor": {
                      "line": 3,
                      "text": "torch.optim.lr_scheduler.StepLR(",
                      "occurrence": 1
                    },
                    "title": "Schedule learning-rate changes",
                    "explanation": "StepLR changes the optimizer learning rate according to its configured epoch schedule.",
                    "required": true
                  },
                  {
                    "id": "step",
                    "anchor": {
                      "line": 11,
                      "text": "scheduler.step()",
                      "occurrence": 1
                    },
                    "title": "Advance the scheduler",
                    "explanation": "Scheduler step timing depends on scheduler type; for this epoch-based example it advances after each training epoch.",
                    "required": true
                  }
                ]
              }
            }
          ],
