          "concept_ids": [
            "ai.pytorch.zero_grad"
          ],
          "prompts": [
            {
              "id": "code",
              "kind": "look_for",
              "label": "READ THE TRAINING STEP IN ORDER",
              "placeholder": "Click zero_grad and notice that it happens before forward/backward for the next update.",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "training_step.py",
                "language": "python",
                "code": "optimizer.zero_grad()\n\nlogits = model(X)\nloss = loss_fn(logits, y)\n\nloss.backward()\noptimizer.step()",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "zero",
                    "anchor": {
                      "line": 1,
                      "text": "optimizer.zero_grad()",
                      "occurrence": 1
                    },
                    "title": "Clear old parameter gradients",
                    "explanation": "A normal one-batch-per-step loop clears gradients before computing the next update.",
                    "required": true
                  },
                  {
                    "id": "backward",
                    "anchor": {
                      "line": 6,
                      "text": "loss.backward()",
                      "occurrence": 1
                    },
                    "title": "Compute current gradients",
                    "explanation": "Backward writes/accumulates gradients for the current loss.",
                    "required": true
                  },
                  {
                    "id": "step",
                    "anchor": {
                      "line": 7,
                      "text": "optimizer.step()",
                      "occurrence": 1
                    },
                    "title": "Update parameters",
                    "explanation": "The optimizer reads the current gradients and updates its managed parameters.",
                    "required": true
                  }
                ]
              }
            }
          ],
          "prerequisite_node_ids": [],
