        {
          "id": "domain-4-requires-grad",
          "title": "`requires_grad`",
          "concept_ids": [
            "ai.pytorch.requires_grad"
          ],
          "prompts": [
            {
              "id": "code",
              "kind": "look_for",
              "label": "TURN GRADIENT TRACKING ON FOR A TENSOR",
              "placeholder": "Click requires_grad and inspect .grad before and after backward.",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "requires_grad.py",
                "language": "python",
                "code": "import torch\n\nx = torch.tensor(3.0, requires_grad=True)\ny = x**2 + 2 * x\n\ny.backward()\n\nprint(x.grad)  # 8",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "requires",
                    "anchor": {
                      "line": 3,
                      "text": "requires_grad=True",
                      "occurrence": 1
                    },
                    "title": "Track operations for gradients",
                    "explanation": "In normal grad mode, PyTorch records operations needed to compute derivatives with respect to x.",
                    "required": true
                  },
                  {
                    "id": "backward",
                    "anchor": {
                      "line": 6,
                      "text": "y.backward()",
                      "occurrence": 1
                    },
                    "title": "Run reverse-mode differentiation",
                    "explanation": "Backward traverses the recorded graph and accumulates gradients into relevant leaf tensors.",
                    "required": true
                  },
                  {
                    "id": "grad",
                    "anchor": {
                      "line": 8,
                      "text": "x.grad",
                      "occurrence": 1
                    },
                    "title": "Leaf gradient storage",
                    "explanation": "After backward, x.grad contains dy/dx evaluated at x=3.",
                    "required": true
                  }
                ]
              }
            },
            {
              "id": "parameters",
              "kind": "what",
              "label": "MODEL PARAMETERS REQUIRE GRADIENTS BY DEFAULT",
              "placeholder": "Do nn.Parameter objects normally need requires_grad=True set manually?",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "No. Model Parameters require gradients by default unless you explicitly freeze them."
              }
            }
          ],
          "prerequisite_node_ids": [],
          "map_position": {
            "x": 0.12,
            "y": 0.14
          },
          "source_refs": []
        },
        {
          "id": "domain-4-backward",
          "title": "`loss.backward()`",
          "concept_ids": [
            "ai.pytorch.backward"
          ],
          "prompts": [
            {
              "id": "code",
              "kind": "look_for",
              "label": "SEE WHERE backward FITS",
              "placeholder": "Click loss.backward and inspect the parameter gradient.",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "backward.py",
                "language": "python",
                "code": "import torch\nimport torch.nn as nn\n\nmodel = nn.Linear(4, 1)\nx = torch.randn(8, 4)\ntarget = torch.randn(8, 1)\n\nprediction = model(x)\nloss = nn.MSELoss()(prediction, target)\n\nloss.backward()\n\nprint(model.weight.grad.shape)",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "loss",
                    "anchor": {
                      "line": 9,
                      "text": "loss = nn.MSELoss()",
                      "occurrence": 1
                    },
                    "title": "Build a scalar loss",
                    "explanation": "The loss connects model outputs to trainable parameters through the recorded computation graph.",
                    "required": true
                  },
                  {
                    "id": "backward",
                    "anchor": {
                      "line": 11,
                      "text": "loss.backward()",
                      "occurrence": 1
                    },
                    "title": "Populate parameter gradients",
                    "explanation": "Backward accumulates gradients in the .grad fields of trainable leaf Parameters.",
                    "required": true
                  },
                  {
                    "id": "grad",
                    "anchor": {
                      "line": 13,
                      "text": "model.weight.grad",
                      "occurrence": 1
                    },
                    "title": "Inspect the result",
                    "explanation": "The weight gradient has the same shape as the weight parameter.",
                    "required": true
                  }
                ]
              }
            }
          ],
          "prerequisite_node_ids": [
            "domain-4-requires-grad"
          ],
          "map_position": {
            "x": 0.35,
            "y": 0.14
          },
          "source_refs": []
        },
        {
          "id": "domain-4-grad-accumulation",
          "title": "Gradient accumulation",
          "concept_ids": [
            "ai.pytorch.grad_accumulation"
          ],
          "prompts": [
            {
              "id": "code",
              "kind": "look_for",
              "label": "INTENTIONALLY ACCUMULATE MICRO-BATCH GRADIENTS",
              "placeholder": "Click zero_grad and the repeated backward call.",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "gradient_accumulation.py",
                "language": "python",
                "code": "optimizer.zero_grad()\n\nfor X, y in microbatches:\n    logits = model(X)\n    loss = loss_fn(logits, y) / len(microbatches)\n    loss.backward()\n\noptimizer.step()",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "zero",
                    "anchor": {
                      "line": 1,
                      "text": "optimizer.zero_grad()",
                      "occurrence": 1
                    },
                    "title": "Clear once before accumulation",
                    "explanation": "Gradients start empty for this optimizer update.",
                    "required": true
                  },
                  {
                    "id": "backward",
                    "anchor": {
                      "line": 6,
                      "text": "loss.backward()",
                      "occurrence": 1
                    },
                    "title": "Accumulate into existing .grad",
                    "explanation": "Each backward adds another microbatch contribution to the same parameter gradients.",
                    "required": true
                  },
                  {
                    "id": "step",
                    "anchor": {
                      "line": 8,
                      "text": "optimizer.step()",
                      "occurrence": 1
                    },
                    "title": "Update once after accumulation",
                    "explanation": "The optimizer uses the accumulated gradients for one parameter update.",
                    "required": true
                  }
                ]
              }
            },
            {
              "id": "gotcha",
              "kind": "not_this",
              "label": "ACCUMULATION IS THE DEFAULT BEHAVIOR",
              "placeholder": "What happens if you forget to clear gradients in an ordinary one-batch-per-step loop?",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "PyTorch accumulates parameter gradients by default, so forgetting to clear them causes unintended accumulation across batches."
              }
            }
          ],
          "prerequisite_node_ids": [
            "domain-4-backward"
          ],
          "map_position": {
            "x": 0.58,
            "y": 0.14
          },
          "source_refs": []
        },
        {
          "id": "domain-4-detach",
          "title": "`detach()`",
          "concept_ids": [
            "ai.pytorch.detach"
          ],
          "prompts": [
            {
              "id": "code",
              "kind": "look_for",
              "label": "BREAK THE AUTOGRAD CONNECTION",
              "placeholder": "Click detach and compare requires_grad.",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "detach.py",
                "language": "python",
                "code": "import torch\n\nx = torch.tensor([1.0, 2.0], requires_grad=True)\ny = x * 3\n\nlogged = y.detach()\n\nprint(y.requires_grad)       # True\nprint(logged.requires_grad)  # False",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "detach",
                    "anchor": {
                      "line": 6,
                      "text": "y.detach()",
                      "occurrence": 1
                    },
                    "title": "Detach from the current graph",
                    "explanation": "The returned tensor shares data history/storage semantics with y but is not connected to the current autograd graph.",
                    "required": true
                  }
                ]
              }
            },
            {
              "id": "storage",
              "kind": "not_this",
              "label": "DETACH IS NOT THE SAME AS COPY",
              "placeholder": "Can a detached tensor share storage with the original?",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Yes. Detaching changes autograd history, not necessarily storage ownership. Clone when you specifically need copied tensor data."
              }
            }
          ],
          "prerequisite_node_ids": [
            "domain-4-grad-accumulation"
          ],
          "map_position": {
            "x": 0.81,
            "y": 0.14
          },
          "source_refs": []
        }
      ]
