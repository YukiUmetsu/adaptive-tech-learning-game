              "placeholder": "Click Dataset creation and DataLoader wrapping.",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "dataset_loader.py",
                "language": "python",
                "code": "from torch.utils.data import DataLoader, TensorDataset\nimport torch\n\nfeatures = torch.randn(100, 20)\ntargets = torch.randint(0, 3, (100,))\n\ndataset = TensorDataset(features, targets)\nloader = DataLoader(dataset, batch_size=16, shuffle=True)\n\nfor X, y in loader:\n    print(X.shape, y.shape)\n    break",
