          "prompts": [
            {
              "id": "code",
              "kind": "look_for",
              "label": "PAIR PINNED HOST MEMORY WITH DEVICE TRANSFER",
              "placeholder": "Click pin_memory and non_blocking.",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "pin_memory.py",
                "language": "python",
                "code": "from torch.utils.data import DataLoader\n\nloader = DataLoader(\n    dataset,\n    batch_size=64,\n    pin_memory=True,\n)\n\nfor X, y in loader:\n    X = X.to(device, non_blocking=True)\n    y = y.to(device, non_blocking=True)",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "pin",
                    "anchor": {
                      "line": 6,
                      "text": "pin_memory=True",
                      "occurrence": 1
                    },
                    "title": "Pinned host memory",
                    "explanation": "Pinned host memory can improve CPU-to-CUDA transfer performance.",
                    "required": true
                  },
                  {
                    "id": "nonblocking",
                    "anchor": {
                      "line": 10,
                      "text": "non_blocking=True",
                      "occurrence": 1
                    },
                    "title": "Request asynchronous-compatible transfer",
                    "explanation": "non_blocking=True can enable overlap when the source/destination and execution context support it.",
                    "required": true
                  }
                ]
              }
            },
            {
              "id": "scope",
              "kind": "not_this",
              "label": "KNOW WHAT PINNING OPTIMIZES",
              "placeholder": "Is pinned memory a universal CPU speedup?",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "No. Pinned memory is primarily a host-to-accelerator transfer optimization."
              }
