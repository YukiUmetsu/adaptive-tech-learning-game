        {
          "id": "domain-2-custom-dataset",
          "title": "Custom Dataset methods",
          "concept_ids": [
            "ai.pytorch.custom_dataset"
          ],
          "prompts": [
            {
              "id": "code",
              "kind": "look_for",
              "label": "IMPLEMENT A MAP-STYLE DATASET",
              "placeholder": "Click __len__ and __getitem__.",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "custom_dataset.py",
                "language": "python",
                "code": "from torch.utils.data import Dataset\n\nclass RecordDataset(Dataset):\n    def __init__(self, records, transform=None):\n        self.records = records\n        self.transform = transform\n\n    def __len__(self):\n        return len(self.records)\n\n    def __getitem__(self, idx):\n        features, target = self.records[idx]\n        if self.transform is not None:\n            features = self.transform(features)\n        return features, target",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "len",
                    "anchor": {
                      "line": 8,
                      "text": "def __len__(self):",
                      "occurrence": 1
                    },
                    "title": "Dataset size",
                    "explanation": "__len__ reports how many indexed samples the map-style dataset exposes.",
                    "required": true
                  },
                  {
                    "id": "getitem",
                    "anchor": {
                      "line": 11,
                      "text": "def __getitem__(self, idx):",
                      "occurrence": 1
                    },
                    "title": "Retrieve one sample",
                    "explanation": "__getitem__ returns the sample or sample-target structure for one index.",
                    "required": true
                  },
                  {
                    "id": "transform",
                    "anchor": {
                      "line": 14,
                      "text": "self.transform(features)",
                      "occurrence": 1
                    },
                    "title": "Optional sample transform",
                    "explanation": "Per-sample preprocessing can be applied before the sample is returned.",
                    "required": true
                  }
                ]
              }
            }
          ],
