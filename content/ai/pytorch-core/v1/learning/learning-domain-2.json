        {
          "id": "domain-2-collate-fn",
          "title": "Custom collation",
          "concept_ids": [
            "ai.pytorch.collate_fn"
          ],
          "prompts": [
            {
              "id": "code",
              "kind": "look_for",
              "label": "COLLATE VARIABLE-LENGTH SAMPLES",
              "placeholder": "Click collate_fn and pad_sequence.",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "custom_collate.py",
                "language": "python",
                "code": "import torch\nfrom torch.nn.utils.rnn import pad_sequence\nfrom torch.utils.data import DataLoader\n\ndef collate_batch(samples):\n    sequences, labels = zip(*samples)\n    padded = pad_sequence(sequences, batch_first=True)\n    labels = torch.tensor(labels)\n    return padded, labels\n\nloader = DataLoader(\n    dataset,\n    batch_size=32,\n    collate_fn=collate_batch,\n)",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "collate",
                    "anchor": {
                      "line": 5,
                      "text": "def collate_batch(samples):",
                      "occurrence": 1
                    },
                    "title": "Custom batch construction",
                    "explanation": "The collate function receives a list of individual dataset samples and decides how to merge them.",
                    "required": true
                  },
                  {
                    "id": "pad",
                    "anchor": {
                      "line": 7,
                      "text": "pad_sequence(sequences, batch_first=True)",
                      "occurrence": 1
                    },
                    "title": "Handle variable lengths",
                    "explanation": "Padding is a common reason to replace default collation.",
                    "required": true
                  },
                  {
                    "id": "loader",
                    "anchor": {
                      "line": 14,
                      "text": "collate_fn=collate_batch",
                      "occurrence": 1
                    },
                    "title": "Attach custom collation",
                    "explanation": "DataLoader calls the supplied collate_fn when forming each batch.",
                    "required": true
                  }
                ]
              }
            }
          ],
