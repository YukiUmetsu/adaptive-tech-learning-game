  "concepts": [
    {
      "id": "ai.python.py311_strenum",
      "name": "3.11 StrEnum",
      "description": "Python 3.11 adds `enum.StrEnum`; members are also strings, `auto()` uses the lower-cased member name by default, and exact-`str` APIs may still require `str(member)`."
    },
    {
      "id": "ai.python.py311_typing_self",
      "name": "3.11 typing.Self",
      "description": "Python 3.11 adds `typing.Self` for methods and attributes whose type follows the current class, preserving subclass-specific return types without a separate bound TypeVar."
    },
    {
      "id": "ai.python.py311_except_star",
      "name": "3.11 ExceptionGroup and except*",
      "description": "Python 3.11 adds `ExceptionGroup` and `except*`; star-handlers receive matching subgroups, multiple handlers can run for one grouped failure, and unmatched exceptions continue to propagate."
    },
    {
      "id": "ai.python.py311_asyncio_timeout",
      "name": "3.11 asyncio.timeout",
      "description": "Python 3.11 adds `asyncio.timeout()`, an async deadline context that uses cancellation internally and exposes expiry as `TimeoutError` outside the context."
    },
    {
      "id": "ai.python.py311_tomllib",
      "name": "3.11 tomllib",
      "description": "Python 3.11 adds `tomllib` for read-only TOML parsing: `load()` accepts a binary file object, `loads()` parses a string, and the module provides no TOML writer."
    }
  ],
