  "concepts": [
    {
      "id": "ai.python.function_basics",
      "name": "Writing and calling functions",
      "description": "A function bundles a reusable computation behind a name; parameters receive the call arguments and `return` hands a value back to the caller."
    },
    {
      "id": "ai.python.zip_parallel",
      "name": "zip for parallel iteration",
      "description": "`zip()` lazily pairs items from iterables in parallel; plain zip stops at the shortest input, while `strict=True` raises `ValueError` on unequal lengths."
    },
    {
      "id": "ai.python.star_args_call",
      "name": "Calling with *args",
      "description": "A single `*` in a call expands an iterable into positional arguments; the resulting arguments still must fit the callable's signature."
    },
    {
      "id": "ai.python.numpy_aggregate",
      "name": "Aggregating with NumPy",
      "description": "`numpy.mean`, `numpy.sum`, and friends aggregate whole arrays; wrapping input with `np.array(...)` lets the same functions work on Python lists."
    },
    {
      "id": "ai.python.pandas_series",
      "name": "Aggregating a pandas Series",
      "description": "`pandas.Series(values).sum()` aggregates a column of data; Series reductions return NumPy scalars that are usually converted with `int(...)` or `float(...)`."
    }
  ],
