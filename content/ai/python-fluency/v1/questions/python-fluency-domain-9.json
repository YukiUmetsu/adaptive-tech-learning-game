  "concepts": [
    {
      "id": "ai.python.py312_type_params",
      "name": "3.12 type parameter syntax",
      "description": "Python 3.12 adds bracketed type-parameter lists directly to generic class and function declarations; their type parameters live in declaration-specific annotation scope rather than becoming ordinary outer-scope variables."
    },
    {
      "id": "ai.python.py312_type_statement",
      "name": "3.12 type alias statement",
      "description": "Python 3.12 adds the `type` statement for explicit aliases, including parameterized aliases; it creates `TypeAliasType` objects and lazily evaluates alias values."
    },
    {
      "id": "ai.python.py312_override",
      "name": "3.12 typing.override",
      "description": "Python 3.12 adds `typing.override` so type checkers can verify intended overrides; it does not enforce override compatibility at runtime but attempts to set `__override__ = True`."
    },
    {
      "id": "ai.python.py312_batched",
      "name": "3.12 itertools.batched",
      "description": "Python 3.12 adds `itertools.batched(iterable, n)`, which lazily yields consecutive tuples of up to n items, returns a shorter final tuple when necessary, and requires n >= 1."
    },
    {
      "id": "ai.python.py312_path_walk",
      "name": "3.12 Path.walk",
      "description": "Python 3.12 adds `Path.walk()`, yielding `(dirpath, dirnames, filenames)`; default traversal is top-down, dirnames can be modified to prune, and directory symlinks are not followed by default."
    }
  ],
