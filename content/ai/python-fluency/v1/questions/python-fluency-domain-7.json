  "concepts": [
    {
      "id": "ai.python.py310_match_mapping",
      "name": "3.10 structural mapping patterns",
      "description": "Python 3.10 structural pattern matching compares a subject against ordered case patterns; mapping patterns require their listed keys/subpatterns, capture patterns bind values, and `_` is the wildcard."
    },
    {
      "id": "ai.python.py310_union_type",
      "name": "3.10 X | Y union types",
      "description": "Python 3.10 adds the `X | Y` union type expression for annotations and supported runtime checks such as `isinstance(value, X | Y)`."
    },
    {
      "id": "ai.python.py310_parenthesized_context",
      "name": "3.10 parenthesized context managers",
      "description": "Python 3.10 officially allows parenthesized multi-line with-items; multiple contexts still enter left-to-right and exit in reverse order."
    },
    {
      "id": "ai.python.py310_zip_strict",
      "name": "3.10 zip(strict=True)",
      "description": "Python 3.10 adds `zip(strict=True)`, which keeps zip lazy but raises `ValueError` when iteration discovers unequal input lengths."
    },
    {
      "id": "ai.python.py310_aiter_anext",
      "name": "3.10 aiter/anext",
      "description": "Python 3.10 adds built-in `aiter()` and `anext()` for direct asynchronous-iterator access; `anext()` returns an awaitable and can accept a default for exhaustion."
    }
  ],
