  "concepts": [
    {
      "id": "ai.python.py313_batched_strict",
      "name": "3.13 batched(strict=True)",
      "description": "Python 3.13 adds `strict=` to `itertools.batched`; with `strict=True`, lazy iteration raises `ValueError` when the final batch is shorter than n."
    },
    {
      "id": "ai.python.py313_copy_replace",
      "name": "3.13 copy.replace",
      "description": "Python 3.13 adds `copy.replace(obj, **changes)`, a field-replacement protocol for supported record-like objects and custom classes implementing `__replace__()`; it is not a general deep copy."
    },
    {
      "id": "ai.python.py313_queue_shutdown",
      "name": "3.13 Queue.shutdown",
      "description": "Python 3.13 adds `Queue.shutdown()` and `ShutDown`: graceful shutdown rejects new puts while draining queued work, whereas immediate shutdown drains work and weakens the normal `join()` invariant."
    },
    {
      "id": "ai.python.py313_typeis",
      "name": "3.13 typing.TypeIs",
      "description": "Python 3.13 adds `typing.TypeIs` for user-defined type predicates; compatible narrowed types can refine both True and False branches, unlike TypeGuard's positive-only narrowing."
    }
  ],
