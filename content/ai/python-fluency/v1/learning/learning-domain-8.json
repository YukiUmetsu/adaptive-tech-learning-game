              "kind": "look_for",
              "label": "TYPE A FLUENT METHOD",
              "placeholder": "Click -> Self.",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "typing_self.py",
                "language": "python",
                "code": "from typing import Self\n\nclass Builder:\n    def add(self, value: str) -> Self:\n        self.values.append(value)\n        return self",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "self",
                    "anchor": {
                      "line": 4,
                      "text": "-> Self",
                      "occurrence": 1
                    },
                    "title": "Self return type",
                    "explanation": "The return type follows the concrete type of the receiver, including subclasses.",
                    "required": true,
                    "result": {
                      "type": "value",
                      "output": "for a subclass receiver, a static type checker keeps the subclass as the return type"
                    }
                  }
                ]
