              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "except_star.py",
                "language": "python",
                "code": "try:\n    raise ExceptionGroup(\n        \"many failures\",\n        [ValueError(\"bad value\"), TypeError(\"bad type\")],\n    )\nexcept* ValueError as group:\n    print(\"value errors:\", group.exceptions)\nexcept* TypeError as group:\n    print(\"type errors:\", group.exceptions)",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "group",
                    "anchor": {
                      "line": 2,
                      "text": "ExceptionGroup(",
                      "occurrence": 1
