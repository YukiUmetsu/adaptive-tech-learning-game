              "required": true,
              "reveal": {
                "type": "text",
                "text": "When a subclass inherits a method returning `Self`, the inferred return type follows that subclass.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "subclass",
                      "text": "subclass",
                      "required": true
                    },
                    {
                      "id": "follows",
                      "text": "follows that subclass",
                      "required": true
                    }
