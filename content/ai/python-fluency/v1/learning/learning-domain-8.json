                  {
                    "id": "except",
                    "anchor": {
                      "line": 6,
                      "text": "except* ValueError as group:",
                      "occurrence": 1
                    },
                    "title": "Handle a matching subgroup",
                    "explanation": "except* selects matching exceptions from the group rather than treating the whole group as one ordinary exception.",
                    "required": true,
                    "result": {
                      "type": "console",
                      "output": "value errors: (ValueError('bad value'),)\ntype errors: (TypeError('bad type'),)"
                    }
                  }
                ]
              }
            },
            {
              "id": "multiple",
              "kind": "mental_model",
              "label": "MORE THAN ONE EXCEPT* CLAUSE CAN RUN",
              "placeholder": "",
              "required": true,
              "reveal": {
