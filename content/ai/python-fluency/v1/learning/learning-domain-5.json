        {
          "id": "domain-5-threadpool_executor",
          "title": "ThreadPoolExecutor",
          "concept_ids": [
            "ai.python.threadpool_executor"
          ],
          "prompts": [
            {
              "id": "code",
              "kind": "look_for",
              "label": "RUN BLOCKING I/O IN A THREAD POOL",
              "placeholder": "Click the executor and map.",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "thread_pool.py",
                "language": "python",
                "code": "from concurrent.futures import ThreadPoolExecutor\nfrom urllib.request import urlopen\n\nurls = [\"https://example.com\", \"https://python.org\"]\n\nwith ThreadPoolExecutor(max_workers=8) as pool:\n    pages = list(pool.map(urlopen, urls))",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "pool",
                    "anchor": {
                      "line": 6,
                      "text": "ThreadPoolExecutor(max_workers=8)",
                      "occurrence": 1
                    },
                    "title": "Thread worker pool",
                    "explanation": "Threads are commonly useful for overlapping blocking I/O.",
                    "required": true
                  },
                  {
                    "id": "map",
                    "anchor": {
                      "line": 7,
                      "text": "pool.map(urlopen, urls)",
                      "occurrence": 1
                    },
                    "title": "Apply one callable across inputs",
                    "explanation": "map schedules one call per URL and yields results in input order.",
                    "required": true
                  }
                ]
              }
            }
          ],
          "prerequisite_node_ids": [],
          "map_position": {
            "x": 0.12,
            "y": 0.15
          },
          "source_refs": []
        },
        {
          "id": "domain-5-processpool_executor",
          "title": "ProcessPoolExecutor",
          "concept_ids": [
            "ai.python.processpool_executor"
          ],
          "prompts": [
            {
              "id": "code",
              "kind": "look_for",
              "label": "RUN CPU-BOUND WORK IN PROCESSES",
              "placeholder": "Click the main guard and ProcessPoolExecutor.",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "process_pool.py",
                "language": "python",
                "code": "from concurrent.futures import ProcessPoolExecutor\n\ndef cpu_work(n):\n    return sum(i * i for i in range(n))\n\nif __name__ == \"__main__\":\n    with ProcessPoolExecutor() as pool:\n        results = list(pool.map(cpu_work, [1_000_000, 2_000_000]))",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "guard",
                    "anchor": {
                      "line": 6,
                      "text": "if __name__ == \"__main__\":",
                      "occurrence": 1
                    },
                    "title": "Safe process entry point",
                    "explanation": "The main guard supports portable process-spawning behavior.",
                    "required": true
                  },
                  {
                    "id": "pool",
                    "anchor": {
                      "line": 7,
                      "text": "ProcessPoolExecutor()",
                      "occurrence": 1
                    },
                    "title": "Process worker pool",
                    "explanation": "Separate processes are appropriate for suitable CPU-bound Python work that can cross process boundaries.",
                    "required": true
                  }
                ]
              }
            }
          ],
          "prerequisite_node_ids": [
            "domain-5-threadpool_executor"
          ],
          "map_position": {
            "x": 0.35,
            "y": 0.15
          },
          "source_refs": []
        },
        {
          "id": "domain-5-futures_as_completed",
          "title": "concurrent.futures.as_completed",
          "concept_ids": [
            "ai.python.futures_as_completed"
          ],
          "prompts": [
            {
              "id": "code",
              "kind": "look_for",
              "label": "HANDLE RESULTS IN COMPLETION ORDER",
              "placeholder": "Click submit and as_completed.",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "as_completed.py",
                "language": "python",
                "code": "from concurrent.futures import ThreadPoolExecutor, as_completed\n\nwith ThreadPoolExecutor() as pool:\n    futures = [pool.submit(fetch, url) for url in urls]\n\n    for future in as_completed(futures):\n        response = future.result()\n        handle(response)",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "submit",
                    "anchor": {
                      "line": 4,
                      "text": "pool.submit(fetch, url)",
                      "occurrence": 1
                    },
                    "title": "Create Futures",
                    "explanation": "submit schedules one call and returns a Future.",
                    "required": true
                  },
                  {
                    "id": "complete",
                    "anchor": {
                      "line": 6,
                      "text": "as_completed(futures)",
                      "occurrence": 1
                    },
                    "title": "Iterate by completion time",
                    "explanation": "Futures are yielded as they finish, not in original submission order.",
                    "required": true
                  }
                ]
              }
            }
          ],
          "prerequisite_node_ids": [
            "domain-5-processpool_executor"
          ],
          "map_position": {
            "x": 0.58,
            "y": 0.15
          },
