          "concept_ids": [
            "ai.python.queue_queue"
          ],
          "prompts": [
            {
              "id": "code",
              "kind": "look_for",
              "label": "USE A THREAD-SAFE WORK QUEUE",
              "placeholder": "Click Queue, put, get, and task_done.",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "thread_queue.py",
                "language": "python",
                "code": "from queue import Queue\n\nwork = Queue(maxsize=100)\n\nwork.put(\"job-1\")\nitem = work.get()\ntry:\n    process(item)\nfinally:\n    work.task_done()",
                "line_numbers": true,
                "annotations": [
