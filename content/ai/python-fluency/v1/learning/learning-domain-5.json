              "reveal": {
                "type": "code_file",
                "filename": "as_completed.py",
                "language": "python",
                "code": "from concurrent.futures import ThreadPoolExecutor, as_completed\n\nwith ThreadPoolExecutor() as pool:\n    futures = [pool.submit(fetch, url) for url in urls]\n\n    for future in as_completed(futures):\n        response = future.result()\n        handle(response)",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "submit",
                    "anchor": {
                      "line": 4,
                      "text": "pool.submit(fetch, url)",
                      "occurrence": 1
                    },
                    "title": "Create Futures",
                    "explanation": "submit schedules one call and returns a Future.",
                    "required": true
                  },
                  {
                    "id": "complete",
                    "anchor": {
                      "line": 6,
                      "text": "as_completed(futures)",
                      "occurrence": 1
                    },
                    "title": "Iterate by completion time",
                    "explanation": "Futures are yielded as they finish, not in original submission order.",
                    "required": true,
                    "result": {
                      "type": "value",
                      "output": "futures are handled as each one finishes\nfuture.result() returns that call's value or raises its exception"
                    }
                  }
                ]
              }
            },
            {
              "id": "result",
              "kind": "when",
              "label": "READ THE RESULT FROM EACH COMPLETED FUTURE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "`future.result()` returns the worker value, or re-raises the worker exception for that completed call.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "result",
                      "text": "`future.result()`",
                      "required": true
                    },
                    {
                      "id": "exception",
                      "text": "re-raises the worker exception",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "contrast",
              "kind": "mental_model",
              "label": "MAP AND AS_COMPLETED SERVE DIFFERENT ORDERING NEEDS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "`executor.map()` favors input ordering; `as_completed()` favors handling whichever submitted task finishes next.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "map",
                      "text": "input ordering",
                      "required": true
                    },
                    {
                      "id": "as-completed",
                      "text": "finishes next",
                      "required": true
                    }
                  ]
                }
              }
            }
