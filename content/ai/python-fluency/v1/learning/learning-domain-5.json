              "reveal": {
                "type": "code_file",
                "filename": "mp_context.py",
                "language": "python",
                "code": "import multiprocessing as mp\n\ndef worker(value):\n    print(value)\n\nif __name__ == \"__main__\":\n    ctx = mp.get_context(\"spawn\")\n    process = ctx.Process(target=worker, args=(42,))\n    process.start()\n    process.join()",
