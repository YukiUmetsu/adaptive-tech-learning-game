              "label": "WORKERS MUST IMPORT THE PROGRAM SAFELY",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "The `__main__` module must be importable by worker subprocesses, so REPL functions and lambdas should not be expected to work.",
