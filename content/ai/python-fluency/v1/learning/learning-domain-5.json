        {
          "id": "domain-5-processpool_executor",
          "title": "ProcessPoolExecutor",
          "concept_ids": [
            "ai.python.processpool_executor"
          ],
          "prompts": [
            {
              "id": "definition",
              "kind": "what",
              "label": "WHY USE A PROCESS POOL?",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "`ProcessPoolExecutor` runs work in a separate worker process, which sidesteps one process's GIL for suitable CPU-bound Python work.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "worker",
                      "text": "worker process",
                      "required": true
                    },
                    {
                      "id": "cpu",
                      "text": "CPU-bound Python work",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "code",
              "kind": "look_for",
              "label": "RUN CPU-BOUND WORK IN PROCESSES",
              "placeholder": "Click the main guard and ProcessPoolExecutor.",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "process_pool.py",
                "language": "python",
                "code": "from concurrent.futures import ProcessPoolExecutor\n\ndef cpu_work(n):\n    return sum(i * i for i in range(n))\n\nif __name__ == \"__main__\":\n    with ProcessPoolExecutor() as pool:\n        results = list(pool.map(cpu_work, [1_000_000, 2_000_000]))",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "guard",
                    "anchor": {
                      "line": 6,
                      "text": "if __name__ == \"__main__\":",
                      "occurrence": 1
                    },
                    "title": "Safe process entry point",
                    "explanation": "The main guard supports portable process-spawning behavior.",
                    "required": true
                  },
                  {
                    "id": "pool",
                    "anchor": {
                      "line": 7,
                      "text": "ProcessPoolExecutor()",
                      "occurrence": 1
                    },
                    "title": "Process worker pool",
                    "explanation": "Separate processes are appropriate for suitable CPU-bound Python work that can cross process boundaries.",
                    "required": true,
                    "result": {
                      "type": "value",
                      "output": "results = [333332833333500000, 2666664666667000000]"
                    }
                  }
                ]
              }
            },
            {
              "id": "pickle",
              "kind": "not_this",
              "label": "PROCESS-BOUNDARY VALUES MUST TRAVEL",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Submitted callables, arguments, and returned values generally need to be picklable.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "picklable",
                      "text": "picklable",
                      "required": true
                    }
                  ]
                }
              }
