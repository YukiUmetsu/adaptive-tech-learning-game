          "glossary": [
            {
              "term": "worker process",
              "definition": "A separate operating-system process used by a pool to execute submitted work."
            },
            {
              "term": "picklable",
              "definition": "Able to be serialized with Python's pickle protocol so data or callables can cross a process boundary."
