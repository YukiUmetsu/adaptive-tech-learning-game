          "id": "domain-5-threading_event",
          "title": "threading.Event",
          "concept_ids": [
            "ai.python.threading_event"
          ],
          "prompts": [
            {
              "id": "code",
              "kind": "look_for",
              "label": "SIGNAL BETWEEN THREADS",
              "placeholder": "Click wait and set.",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "threading_event.py",
                "language": "python",
                "code": "from threading import Event, Thread\n\nready = Event()\n\ndef worker():\n    ready.wait()\n    process()\n\nthread = Thread(target=worker)\nthread.start()\n\nprepare()\nready.set()",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "wait",
                    "anchor": {
                      "line": 6,
                      "text": "ready.wait()",
                      "occurrence": 1
                    },
                    "title": "Wait for the signal",
                    "explanation": "The worker blocks until another thread sets the Event.",
                    "required": true
                  },
                  {
                    "id": "set",
                    "anchor": {
                      "line": 13,
                      "text": "ready.set()",
                      "occurrence": 1
                    },
                    "title": "Publish the signal",
                    "explanation": "set wakes waiting threads and leaves the Event in the set state.",
                    "required": true
                  }
                ]
              }
            }
          ],
          "prerequisite_node_ids": [],
