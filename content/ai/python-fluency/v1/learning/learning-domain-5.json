              "reveal": {
                "type": "code_file",
                "filename": "threading_lock.py",
                "language": "python",
                "code": "from threading import Lock\n\nlock = Lock()\ncounter = 0\n\ndef increment():\n    global counter\n    with lock:\n        counter += 1",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "lock",
                    "anchor": {
                      "line": 8,
                      "text": "with lock",
                      "occurrence": 1
                    },
                    "title": "Critical section",
                    "explanation": "Only one thread at a time can hold this lock and update counter.",
                    "required": true
                  }
                ]
              }
            }
          ],
