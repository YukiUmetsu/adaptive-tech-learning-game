          "glossary": [
            {
              "term": "type predicate",
              "definition": "A Boolean function whose result lets a static type checker refine the type of one of its arguments."
            },
            {
              "term": "positive branch",
              "definition": "The code path taken when a type predicate returns `True`."
            },
            {
              "term": "negative branch",
              "definition": "The code path taken when a type predicate returns `False`."
            },
            {
              "term": "subtype",
              "definition": "A type whose values are valid wherever values of a broader parent type are expected."
            }
          ]
