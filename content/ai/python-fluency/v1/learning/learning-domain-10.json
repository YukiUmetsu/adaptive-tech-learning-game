          "prerequisite_node_ids": [],
          "map_position": {
            "x": 0.12,
            "y": 0.15
          },
          "source_refs": [
            {
              "title": "queue.Queue.shutdown — Python 3.13",
              "url": "https://docs.python.org/3.13/library/queue.html#queue.Queue.shutdown"
            },
            {
              "title": "What's New In Python 3.13",
              "url": "https://docs.python.org/3.13/whatsnew/3.13.html"
            }
          ],
          "glossary": [
            {
              "term": "graceful shutdown",
              "definition": "Stopping new queue work while allowing already queued work to be retrieved and completed normally."
            },
            {
              "term": "immediate shutdown",
              "definition": "Queue termination that drains remaining work instead of waiting for normal processing."
            },
            {
              "term": "join invariant",
              "definition": "The normal rule that `join()` unblocks only after every enqueued item has received a matching `task_done()`."
            }
          ]
        },
