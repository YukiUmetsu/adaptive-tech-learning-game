              "reveal": {
                "type": "code_file",
                "filename": "batched_strict.py",
                "language": "python",
                "code": "from itertools import batched\n\nrecords = range(12)\ngroups = list(batched(records, 3, strict=True))",
                "line_numbers": true,
                "annotations": [
