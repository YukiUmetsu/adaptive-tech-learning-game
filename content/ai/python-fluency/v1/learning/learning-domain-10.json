                "filename": "typeis.py",
                "language": "python",
                "code": "from typing import TypeIs\n\ndef is_string(value: object) -> TypeIs[str]:\n    return isinstance(value, str)\n\ndef normalize(value: object) -> str:\n    if is_string(value):\n        return value.strip()\n    return str(value)",
