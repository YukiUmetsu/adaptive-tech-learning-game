                    "title": "Begin shutdown",
                    "explanation": "The queue enters shutdown so new puts are rejected and blocked operations respond according to the API.",
                    "required": true,
                    "result": {
                      "type": "value",
                      "output": "existing 'job' can still be retrieved\nfuture put() calls raise ShutDown"
                    }
                  },
                  {
                    "id": "exception",
                    "anchor": {
                      "line": 9,
                      "text": "except ShutDown:",
                      "occurrence": 1
                    },
                    "title": "Observe queue shutdown",
                    "explanation": "Queue operations can raise ShutDown so callers can handle the closed state.",
                    "required": true
                  }
                ]
              }
            },
            {
              "id": "empty",
              "kind": "mental_model",
              "label": "GET() FAILS AFTER THE GRACEFUL QUEUE DRAINS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "After a graceful shutdown becomes empty, later `get()` calls raise `ShutDown`.",
                "progressive_reveal": {
                  "spans": [
