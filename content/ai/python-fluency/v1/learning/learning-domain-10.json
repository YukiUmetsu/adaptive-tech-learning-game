          ],
          "prompts": [
            {
              "id": "code",
              "kind": "look_for",
              "label": "SIGNAL A QUEUE TO STOP ACCEPTING WORK",
              "placeholder": "Click shutdown and ShutDown.",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "queue_shutdown.py",
                "language": "python",
                "code": "from queue import Queue, ShutDown\n\nqueue = Queue()\nqueue.put(\"job\")\nqueue.shutdown()\n\ntry:\n    queue.put(\"late-job\")\nexcept ShutDown:\n    print(\"queue is closed\")",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "shutdown",
                    "anchor": {
                      "line": 5,
                      "text": "queue.shutdown()",
                      "occurrence": 1
                    },
                    "title": "Begin shutdown",
                    "explanation": "The queue enters shutdown so new puts are rejected and blocked operations respond according to the API.",
                    "required": true
                  },
                  {
                    "id": "exception",
                    "anchor": {
                      "line": 9,
                      "text": "except ShutDown:",
                      "occurrence": 1
                    },
                    "title": "Observe queue shutdown",
                    "explanation": "Queue operations can raise ShutDown so callers can handle the closed state.",
                    "required": true
                  }
