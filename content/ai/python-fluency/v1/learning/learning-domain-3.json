          "prompts": [
            {
              "id": "code",
              "kind": "look_for",
              "label": "NORMALIZE OPTIONAL CONTEXT MANAGEMENT",
              "placeholder": "Click nullcontext.",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "nullcontext.py",
                "language": "python",
                "code": "from contextlib import nullcontext\n\ndef process(stream=None):\n    cm = open(\"input.txt\") if stream is None else nullcontext(stream)\n\n    with cm as source:\n        return source.read()",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "null",
                    "anchor": {
                      "line": 4,
                      "text": "nullcontext(stream)",
                      "occurrence": 1
                    },
                    "title": "Do-nothing context manager",
                    "explanation": "The caller-owned stream can share the same with structure without being opened here.",
                    "required": true
                  }
                ]
              }
            }
