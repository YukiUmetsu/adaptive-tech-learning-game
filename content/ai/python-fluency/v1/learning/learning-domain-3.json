              "reveal": {
                "type": "code_file",
                "filename": "suppress.py",
                "language": "python",
                "code": "from contextlib import suppress\nfrom pathlib import Path\n\nwith suppress(FileNotFoundError):\n    Path(\"cache.tmp\").unlink()",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "suppress",
                    "anchor": {
                      "line": 4,
                      "text": "suppress(FileNotFoundError)",
