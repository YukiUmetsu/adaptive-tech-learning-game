          "id": "domain-3-contextlib_contextmanager",
          "title": "contextlib.contextmanager",
          "concept_ids": [
            "ai.python.contextlib_contextmanager"
          ],
          "prompts": [
            {
              "id": "code",
              "kind": "look_for",
              "label": "TURN A GENERATOR INTO A CONTEXT MANAGER",
              "placeholder": "Click @contextmanager, yield, and finally.",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "contextmanager.py",
                "language": "python",
                "code": "from contextlib import contextmanager\n\n@contextmanager\ndef managed_connection(connect):\n    connection = connect()\n    try:\n        yield connection\n    finally:\n        connection.close()",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "decorator",
                    "anchor": {
                      "line": 3,
                      "text": "@contextmanager",
                      "occurrence": 1
                    },
                    "title": "Adapter decorator",
                    "explanation": "This generator-style function becomes usable in a with statement.",
                    "required": true
                  },
                  {
                    "id": "yield",
                    "anchor": {
                      "line": 7,
                      "text": "yield connection",
                      "occurrence": 1
                    },
                    "title": "Expose the resource",
                    "explanation": "The yielded value is bound by the as-clause.",
                    "required": true
                  },
                  {
                    "id": "finally",
                    "anchor": {
                      "line": 8,
                      "text": "finally:",
                      "occurrence": 1
                    },
                    "title": "Cleanup path",
                    "explanation": "Cleanup after yield belongs in finally so it also runs on exceptions.",
                    "required": true
                  }
                ]
              }
            }
          ],
          "prerequisite_node_ids": [],
          "map_position": {
            "x": 0.12,
            "y": 0.15
