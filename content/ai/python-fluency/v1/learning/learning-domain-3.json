          "glossary": [
            {
              "term": "memoization",
              "definition": "Saving a function result so the same input can reuse it instead of recomputing it."
            },
            {
              "term": "hashable",
              "definition": "Able to provide a stable hash value, which is required for dictionary keys and cached function arguments."
            },
            {
              "term": "cache hit",
              "definition": "A call whose result is already stored and can be reused without recomputing the function."
            },
            {
              "term": "eviction",
              "definition": "Removing a stored cache entry, usually to keep a bounded cache from growing indefinitely."
            }
          ]
