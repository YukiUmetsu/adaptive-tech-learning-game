        {
          "id": "domain-3-functools_wraps",
          "title": "functools.wraps in decorators",
          "concept_ids": [
            "ai.python.functools_wraps"
          ],
          "prompts": [
            {
              "id": "code",
              "kind": "look_for",
              "label": "PRESERVE WRAPPED FUNCTION METADATA",
              "placeholder": "Click @wraps.",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "decorator.py",
                "language": "python",
                "code": "from functools import wraps\n\ndef trace(func):\n    @wraps(func)\n    def wrapper(*args, **kwargs):\n        print(f\"calling {func.__name__}\")\n        return func(*args, **kwargs)\n    return wrapper",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "wraps",
                    "anchor": {
                      "line": 4,
                      "text": "@wraps(func)",
                      "occurrence": 1
                    },
                    "title": "Preserve metadata",
                    "explanation": "wraps copies important metadata and sets __wrapped__ to the original function.",
                    "required": true
                  }
                ]
              }
            }
          ],
          "prerequisite_node_ids": [],
          "map_position": {
            "x": 0.12,
            "y": 0.15
          },
          "source_refs": []
        },
        {
          "id": "domain-3-functools_cache",
          "title": "functools.cache and lru_cache",
          "concept_ids": [
            "ai.python.functools_cache"
          ],
          "prompts": [
            {
              "id": "code",
              "kind": "look_for",
              "label": "MEMOIZE PURE CALLS",
              "placeholder": "Click @cache.",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "cache.py",
                "language": "python",
                "code": "from functools import cache\n\n@cache\ndef fibonacci(n):\n    if n < 2:\n        return n\n    return fibonacci(n - 1) + fibonacci(n - 2)",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "cache",
                    "anchor": {
                      "line": 3,
                      "text": "@cache",
                      "occurrence": 1
                    },
                    "title": "Unbounded memoization",
                    "explanation": "Repeated calls with the same hashable arguments reuse the stored result.",
                    "required": true
                  }
                ]
              }
            },
            {
              "id": "bounded",
              "kind": "when",
              "label": "WHEN TO BOUND THE CACHE",
              "placeholder": "What if the input space is large?",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Use lru_cache(maxsize=...) when you need bounded memoization and eviction."
              }
            }
          ],
          "prerequisite_node_ids": [
            "domain-3-functools_wraps"
          ],
          "map_position": {
            "x": 0.35,
