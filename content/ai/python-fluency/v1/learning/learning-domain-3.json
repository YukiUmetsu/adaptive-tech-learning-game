                    "explanation": "Repeated calls with the same hashable arguments reuse the stored result.",
                    "required": true,
                    "result": {
                      "type": "value",
                      "output": "fibonacci(10) -> 55\nrepeated calls reuse cached results"
                    }
                  }
                ]
