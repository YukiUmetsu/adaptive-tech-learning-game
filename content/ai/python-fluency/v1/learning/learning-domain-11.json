              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "interpreter_pool.py",
                "language": "python",
                "code": "from concurrent.futures import InterpreterPoolExecutor\n\ndef square(value):\n    return value * value\n\nwith InterpreterPoolExecutor(max_workers=4) as pool:\n    results = list(pool.map(square, range(8)))",
