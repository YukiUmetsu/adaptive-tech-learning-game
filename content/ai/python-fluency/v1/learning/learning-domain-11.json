          "title": "3.14 functools.Placeholder",
          "concept_ids": [
            "ai.python.py314_partial_placeholder"
          ],
          "prompts": [
            {
              "id": "code",
              "kind": "look_for",
              "label": "LEAVE A HOLE IN POSITIONAL BINDING",
              "placeholder": "Click Placeholder and the placeholder slot.",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "partial_placeholder.py",
                "language": "python",
                "code": "from functools import partial, Placeholder as _\n\ndef format_message(prefix, value, suffix):\n    return f\"{prefix}{value}{suffix}\"\n\nwrap_error = partial(format_message, \"[ERROR] \", _, \"!\")\nmessage = wrap_error(\"disk full\")",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "placeholder",
                    "anchor": {
                      "line": 1,
                      "text": "Placeholder as _",
                      "occurrence": 1
                    },
                    "title": "Placeholder sentinel",
                    "explanation": "Placeholder marks a positional slot that a future call must fill.",
                    "required": true
                  },
                  {
                    "id": "partial",
                    "anchor": {
                      "line": 6,
                      "text": "partial(format_message, \"[ERROR] \", _, \"!\")",
                      "occurrence": 1
                    },
                    "title": "Bind around the hole",
                    "explanation": "The prefix and suffix are fixed while the middle value stays open.",
                    "required": true
                  }
                ]
              }
            }
          ],
