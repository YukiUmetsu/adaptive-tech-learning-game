          "title": "subprocess.run",
          "concept_ids": [
            "ai.python.subprocess_run"
          ],
          "prompts": [
            {
              "id": "code",
              "kind": "look_for",
              "label": "RUN A COMMAND WITHOUT SHELL PARSING",
              "placeholder": "Click the argument list, check, and capture_output.",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "subprocess_run.py",
                "language": "python",
                "code": "import subprocess\n\nresult = subprocess.run(\n    [\"git\", \"status\", \"--short\"],\n    check=True,\n    capture_output=True,\n    text=True,\n)\n\nprint(result.stdout)",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "args",
                    "anchor": {
                      "line": 4,
                      "text": "[\"git\", \"status\", \"--short\"]",
                      "occurrence": 1
                    },
                    "title": "Argument vector",
                    "explanation": "Program and arguments stay separate instead of being parsed from one shell string.",
                    "required": true
                  },
                  {
                    "id": "check",
                    "anchor": {
                      "line": 5,
                      "text": "check=True",
                      "occurrence": 1
                    },
                    "title": "Fail on non-zero exit",
                    "explanation": "A failing command raises CalledProcessError.",
                    "required": true
                  },
                  {
                    "id": "capture",
                    "anchor": {
                      "line": 6,
                      "text": "capture_output=True",
                      "occurrence": 1
                    },
                    "title": "Capture stdout/stderr",
                    "explanation": "The completed-process object receives captured streams.",
                    "required": true
                  },
                  {
                    "id": "text",
                    "anchor": {
                      "line": 7,
                      "text": "text=True",
                      "occurrence": 1
                    },
                    "title": "Decode as text",
                    "explanation": "stdout/stderr are strings instead of bytes.",
                    "required": true
                  }
                ]
              }
            }
