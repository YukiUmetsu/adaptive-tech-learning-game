          "id": "domain-9-py312_override",
          "title": "3.12 typing.override",
          "concept_ids": [
            "ai.python.py312_override"
          ],
          "prompts": [
            {
              "id": "definition",
              "kind": "what",
              "label": "WHAT DOES @OVERRIDE COMMUNICATE?",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "`@typing.override` marks a subclass definition as an intended override so a static type checker can verify that a base definition exists.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "override",
                      "text": "override",
                      "occurrence": 2,
                      "required": true
                    },
                    {
                      "id": "checker",
                      "text": "static type checker",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "code",
              "kind": "look_for",
              "label": "MARK INTENTIONAL OVERRIDES",
              "placeholder": "Click @override.",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "override.py",
                "language": "python",
                "code": "from typing import override\n\nclass Base:\n    def close(self) -> None:\n        pass\n\nclass Resource(Base):\n    @override\n    def close(self) -> None:\n        print(\"closed\")",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "override",
                    "anchor": {
                      "line": 8,
                      "text": "@override",
                      "occurrence": 1
                    },
                    "title": "Override intent",
                    "explanation": "Type checkers can verify that a compatible base-class method exists.",
                    "required": true,
                    "result": {
                      "type": "value",
                      "output": "Resource.close.__override__ = True\n# override compatibility is still checked by a type checker"
                    }
                  }
                ]
              }
            },
            {
              "id": "runtime",
              "kind": "not_this",
              "label": "IT DOES NOT ENFORCE OVERRIDING AT RUNTIME",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "The decorator does not perform runtime override validation; that correctness check belongs to static analysis.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "not-runtime",
                      "text": "does not perform runtime override validation",
                      "required": true
                    },
                    {
                      "id": "static",
                      "text": "static analysis",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "marker",
              "kind": "mental_model",
              "label": "THE DECORATOR ATTEMPTS TO MARK THE FUNCTION",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "`typing.override` attempts to set `__override__ = True` on the decorated object, even though the override rule itself is not runtime-enforced.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "marker",
                      "text": "`__override__ = True`",
                      "required": true
                    },
                    {
                      "id": "not-enforced",
                      "text": "not runtime-enforced",
                      "required": true
                    }
                  ]
                }
              }
            }
          ],
          "prerequisite_node_ids": [
            "domain-9-py312_type_statement"
