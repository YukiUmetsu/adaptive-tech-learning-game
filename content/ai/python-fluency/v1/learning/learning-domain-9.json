          "glossary": [
            {
              "term": "type parameter",
              "definition": "A placeholder type declared by a generic class, function, or type alias, such as `T`."
            },
            {
              "term": "generic",
              "definition": "Code parameterized by one or more types so the same definition can preserve type relationships across different concrete types."
            },
            {
              "term": "annotation scope",
              "definition": "A Python 3.12 scope used for type parameters and some type-related expressions."
            }
          ]
