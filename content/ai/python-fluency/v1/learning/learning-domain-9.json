          ],
          "glossary": [
            {
              "term": "type alias",
              "definition": "A named type expression used to make annotations clearer or reusable."
            },
            {
              "term": "TypeAliasType",
              "definition": "The runtime object created by Python 3.12's `type` statement."
            },
            {
              "term": "lazy evaluation",
              "definition": "Delaying evaluation until the value is actually requested."
