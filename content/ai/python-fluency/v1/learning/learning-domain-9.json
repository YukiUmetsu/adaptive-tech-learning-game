        {
          "id": "domain-9-py312_type_statement",
          "title": "3.12 type alias statement",
          "concept_ids": [
            "ai.python.py312_type_statement"
          ],
          "prompts": [
            {
              "id": "definition",
              "kind": "what",
              "label": "WHAT DOES THE TYPE STATEMENT CREATE?",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Python 3.12's `type Name = ...` statement explicitly creates a type alias represented at runtime by `TypeAliasType`.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "alias",
                      "text": "type alias",
                      "required": true
                    },
                    {
                      "id": "runtime",
                      "text": "`TypeAliasType`",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "code",
              "kind": "look_for",
              "label": "DECLARE EXPLICIT TYPE ALIASES",
              "placeholder": "Click both type statements.",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "type_alias.py",
                "language": "python",
                "code": "type UserId = int\ntype Pair[T] = tuple[T, T]\n\ndef duplicate[T](value: T) -> Pair[T]:\n    return value, value",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "simple",
                    "anchor": {
                      "line": 1,
                      "text": "type UserId = int",
                      "occurrence": 1
                    },
                    "title": "Type alias statement",
                    "explanation": "This explicitly declares UserId as a type alias.",
                    "required": true
                  },
                  {
                    "id": "generic",
                    "anchor": {
                      "line": 2,
                      "text": "type Pair[T] = tuple[T, T]",
                      "occurrence": 1
                    },
                    "title": "Generic type alias",
                    "explanation": "The alias can declare its own type parameters.",
                    "required": true,
                    "result": {
                      "type": "value",
                      "output": "UserId.__value__ is int -> True\nPair.__name__ = 'Pair'"
                    }
                  }
                ]
              }
            },
            {
              "id": "generic",
              "kind": "mental_model",
              "label": "ALIASES CAN DECLARE THEIR OWN PARAMETERS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "A generic alias such as `type Pair[T] = tuple[T, T]` declares its type parameter directly on the alias.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "pair",
                      "text": "`type Pair[T] = tuple[T, T]`",
                      "required": true
                    },
                    {
                      "id": "parameter",
                      "text": "type parameter",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "lazy",
              "kind": "not_this",
              "label": "THE ALIAS VALUE IS LAZILY EVALUATED",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "The alias's value uses lazy evaluation, so names in the right-hand type expression can be resolved only when the value is requested.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "lazy",
                      "text": "lazy evaluation",
                      "required": true
                    },
                    {
                      "id": "requested",
                      "text": "when the value is requested",
                      "required": true
                    }
                  ]
                }
              }
            }
          ],
          "prerequisite_node_ids": [
            "domain-9-py312_type_params"
          ],
