            },
            {
              "title": "typing — Support for type hints — Python 3.12",
              "url": "https://docs.python.org/3.12/library/typing.html"
            }
          ],
          "glossary": [
            {
              "term": "override",
              "definition": "A subclass method or attribute that intentionally replaces a definition inherited from a base class."
            },
            {
              "term": "static type checker",
              "definition": "A tool such as mypy or pyright that checks annotations without enforcing them as normal runtime rules."
            },
            {
              "term": "__override__",
              "definition": "A marker attribute that `typing.override` attempts to set to `True` on the decorated object."
            }
          ]
        }
