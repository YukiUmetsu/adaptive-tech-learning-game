          "id": "domain-9-py312_type_params",
          "title": "3.12 type parameter syntax",
          "concept_ids": [
            "ai.python.py312_type_params"
          ],
          "prompts": [
            {
              "id": "definition",
              "kind": "what",
              "label": "WHAT CHANGED FOR GENERICS IN 3.12?",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Python 3.12 lets a generic class or function declare each type parameter directly in square brackets after its name.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "generic",
                      "text": "generic",
                      "required": true
                    },
                    {
                      "id": "parameter",
                      "text": "type parameter",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "code",
              "kind": "look_for",
              "label": "READ THE NEW GENERIC SYNTAX",
              "placeholder": "Click function and class type parameters.",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "type_params.py",
                "language": "python",
                "code": "def first[T](items: list[T]) -> T:\n    return items[0]\n\nclass Box[T]:\n    def __init__(self, value: T):\n        self.value = value",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "func",
                    "anchor": {
                      "line": 1,
                      "text": "def first[T]",
                      "occurrence": 1
                    },
                    "title": "Function type parameter",
                    "explanation": "T is declared directly in the generic function header.",
                    "required": true,
                    "result": {
                      "type": "value",
                      "output": "first([10, 20, 30]) = 10\nBox('Ada').value = 'Ada'"
                    }
                  },
                  {
                    "id": "class",
                    "anchor": {
                      "line": 4,
                      "text": "class Box[T]",
                      "occurrence": 1
                    },
                    "title": "Class type parameter",
                    "explanation": "The class declares T without a separate TypeVar assignment.",
                    "required": true
                  }
                ]
              }
            },
            {
              "id": "scope",
              "kind": "mental_model",
              "label": "TYPE PARAMETERS HAVE THEIR OWN SCOPE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "A type parameter declared in this syntax is available inside the declaration's annotation scope, not as a normal module-level name afterward.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "annotation",
                      "text": "annotation scope",
                      "required": true
                    },
                    {
                      "id": "not-module",
                      "text": "not as a normal module-level name",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "boilerplate",
              "kind": "when",
              "label": "THIS REPLACES COMMON TYPEVAR BOILERPLATE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "For many generics, `class Box[T]` or `def first[T](...)` removes the need for a separate `T = TypeVar('T')` declaration.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "class",
                      "text": "`class Box[T]`",
                      "required": true
                    },
                    {
                      "id": "function",
                      "text": "`def first[T](...)`",
                      "required": true
                    }
                  ]
                }
              }
            }
          ],
          "prerequisite_node_ids": [],
          "map_position": {
            "x": 0.12,
            "y": 0.15
          },
          "source_refs": [
            {
              "title": "What's New In Python 3.12",
