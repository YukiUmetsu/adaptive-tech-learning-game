                    "id": "star",
                    "anchor": {
                      "line": 2,
                      "text": "*pairs",
                      "occurrence": 1
                    },
                    "title": "Expand rows into arguments",
                    "explanation": "* passes each pair as a separate positional argument to zip.",
                    "required": true
                  },
                  {
                    "id": "zip",
                    "anchor": {
                      "line": 2,
                      "text": "zip(*pairs)",
                      "occurrence": 1
                    },
                    "title": "Transpose the pairs",
                    "explanation": "zip groups all first elements together and all second elements together.",
                    "required": true
                  }
                ]
              }
            }
          ],
