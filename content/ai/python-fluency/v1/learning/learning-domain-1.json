        {
          "id": "domain-1-zip_parallel",
          "title": "zip for parallel iteration",
          "concept_ids": [
            "ai.python.zip_parallel"
          ],
          "prompts": [
            {
              "id": "code",
              "kind": "look_for",
              "label": "READ PARALLEL ITERATION",
              "placeholder": "Click the important parts. zip pairs items by position.",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "zip_parallel.py",
                "language": "python",
                "code": "names = [\"Ada\", \"Linus\", \"Grace\"]\nscores = [98, 91, 95]\n\nfor name, score in zip(names, scores):\n    print(f\"{name}: {score}\")",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "zip",
                    "anchor": {
                      "line": 4,
                      "text": "zip(names, scores)",
                      "occurrence": 1
                    },
                    "title": "Pair iterables by position",
                    "explanation": "zip yields one tuple from the same position of each iterable.",
                    "required": true
                  },
                  {
                    "id": "unpack",
                    "anchor": {
                      "line": 4,
                      "text": "for name, score",
                      "occurrence": 1
                    },
                    "title": "Unpack each pair",
                    "explanation": "The tuple from zip is unpacked directly into name and score.",
                    "required": true
                  }
                ]
              }
            },
            {
              "id": "limit",
              "kind": "not_this",
              "label": "KNOW THE DEFAULT STOP RULE",
              "placeholder": "What happens when lengths differ?",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "By default, zip stops at the shortest iterable. Use strict=True when unequal lengths should be an error."
              }
            }
          ],
          "prerequisite_node_ids": [],
          "map_position": {
            "x": 0.12,
            "y": 0.15
          },
          "source_refs": []
        },
