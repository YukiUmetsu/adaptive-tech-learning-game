              "reveal": {
                "type": "code_file",
                "filename": "dict_unpack.py",
                "language": "python",
                "code": "defaults = {\"timeout\": 5, \"retries\": 2}\nenvironment = {\"timeout\": 10}\noverride = {\"retries\": 4}\n\nconfig = {\n    **defaults,\n    **environment,\n    **override,\n}",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "env",
                    "anchor": {
                      "line": 7,
                      "text": "**environment",
                      "occurrence": 1
                    },
                    "title": "Later mapping overrides earlier duplicates",
                    "explanation": "timeout becomes 10 because environment appears after defaults.",
                    "required": true
                  },
                  {
                    "id": "override",
                    "anchor": {
                      "line": 8,
                      "text": "**override",
                      "occurrence": 1
                    },
                    "title": "Last duplicate wins",
                    "explanation": "retries becomes 4 because override is last.",
                    "required": true
                  }
                ]
              }
            }
          ],
