                    "required": true
                  },
                  {
                    "id": "put",
                    "anchor": {
                      "line": 6,
                      "text": "await queue.put(item)",
                      "occurrence": 1
                    },
                    "title": "Backpressure-aware enqueue",
                    "explanation": "put suspends when the queue is full.",
                    "required": true
                  },
                  {
                    "id": "get",
                    "anchor": {
                      "line": 9,
                      "text": "await queue.get()",
                      "occurrence": 1
                    },
