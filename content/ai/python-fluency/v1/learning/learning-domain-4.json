                "language": "python",
                "code": "import asyncio\n\nqueue = asyncio.Queue(maxsize=100)\n\nasync def producer(item):\n    await queue.put(item)\n\nasync def consumer():\n    item = await queue.get()\n    try:\n        await handle(item)\n    finally:\n        queue.task_done()",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "max",
                    "anchor": {
                      "line": 3,
                      "text": "maxsize=100",
                      "occurrence": 1
                    },
