          "id": "domain-7-py310_match_mapping",
          "title": "3.10 structural mapping patterns",
          "concept_ids": [
            "ai.python.py310_match_mapping"
          ],
          "prompts": [
            {
              "id": "definition",
              "kind": "what",
              "label": "WHAT DOES MATCH COMPARE?",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Python 3.10 `match` compares a subject against case patterns from top to bottom until one succeeds.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "subject",
                      "text": "subject",
                      "required": true
                    },
                    {
                      "id": "order",
                      "text": "top to bottom",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "code",
              "kind": "look_for",
              "label": "READ A MAPPING PATTERN",
              "placeholder": "Click the mapping pattern and wildcard.",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "match_mapping.py",
                "language": "python",
                "code": "def route(event):\n    match event:\n        case {\"type\": \"user.created\", \"user_id\": user_id}:\n            return f\"created {user_id}\"\n        case {\"type\": \"user.deleted\", \"user_id\": user_id}:\n            return f\"deleted {user_id}\"\n        case _:\n            return \"ignored\"",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "pattern",
                    "anchor": {
                      "line": 3,
                      "text": "case {\"type\": \"user.created\", \"user_id\": user_id}:",
                      "occurrence": 1
                    },
                    "title": "Mapping pattern",
                    "explanation": "The case requires matching keys/literal values and binds user_id.",
                    "required": true,
                    "result": {
                      "type": "value",
                      "output": "route({\"type\": \"user.created\", \"user_id\": 42}) = \"created 42\""
                    }
                  },
                  {
                    "id": "wild",
                    "anchor": {
                      "line": 7,
                      "text": "case _:",
                      "occurrence": 1
                    },
                    "title": "Wildcard case",
                    "explanation": "_ handles any value not matched by earlier cases.",
                    "required": true
                  }
                ]
              }
            },
            {
              "id": "mapping",
              "kind": "mental_model",
              "label": "MAPPING PATTERNS REQUIRE LISTED KEYS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "A mapping pattern succeeds when every listed key is present and each associated subpattern matches; extra subject keys are allowed.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "mapping",
                      "text": "mapping pattern",
                      "required": true
                    },
                    {
                      "id": "extra",
                      "text": "extra subject keys are allowed",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "capture",
              "kind": "not_this",
              "label": "A BARE NAME CAPTURES; UNDERSCORE DOES NOT",
              "placeholder": "",
              "required": false,
              "reveal": {
                "type": "text",
                "text": "A capture pattern such as `user_id` binds the matched value, while the wildcard `_` matches without binding.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "capture",
                      "text": "capture pattern",
                      "required": true
                    },
                    {
                      "id": "wild",
                      "text": "wildcard `_`",
                      "required": true
                    }
                  ]
                }
              }
            }
          ],
          "prerequisite_node_ids": [],
          "map_position": {
            "x": 0.12,
            "y": 0.15
          },
          "source_refs": [
            {
              "title": "What's New In Python 3.10",
              "url": "https://docs.python.org/3.10/whatsnew/3.10.html"
            },
            {
              "title": "The match statement — Python 3.10",
              "url": "https://docs.python.org/3.10/reference/compound_stmts.html#the-match-statement"
            }
          ],
          "glossary": [
            {
              "term": "subject",
              "definition": "The value after `match` that Python tries to compare with each case pattern."
            },
            {
              "term": "capture pattern",
              "definition": "A pattern name that binds the matched value to that name."
            },
            {
              "term": "wildcard",
              "definition": "The `_` pattern, which matches any value without binding a name."
            },
            {
              "term": "mapping",
              "definition": "A key-value container interface such as `dict`."
            }
          ]
