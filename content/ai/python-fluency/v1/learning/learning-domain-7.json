          "id": "domain-7-py310_zip_strict",
          "title": "3.10 zip(strict=True)",
          "concept_ids": [
            "ai.python.py310_zip_strict"
          ],
          "prompts": [
            {
              "id": "definition",
              "kind": "what",
              "label": "WHAT DOES STRICT=TRUE ADD TO ZIP?",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Python 3.10 `zip(..., strict=True)` raises `ValueError` when iteration discovers a length mismatch.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "error",
                      "text": "`ValueError`",
                      "required": true
                    },
                    {
                      "id": "mismatch",
                      "text": "length mismatch",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "code",
              "kind": "look_for",
              "label": "MAKE LENGTH MISMATCH AN ERROR",
              "placeholder": "Click strict=True.",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "zip_strict.py",
                "language": "python",
                "code": "names = [\"Ada\", \"Grace\"]\nscores = [98, 95]\n\npairs = list(zip(names, scores, strict=True))",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "strict",
                    "anchor": {
                      "line": 4,
                      "text": "strict=True",
                      "occurrence": 1
                    },
                    "title": "Require equal-length inputs",
                    "explanation": "zip raises ValueError if one iterable is exhausted before the others.",
                    "required": true,
                    "result": {
                      "type": "value",
                      "output": "pairs = [('Ada', 98), ('Grace', 95)]"
                    }
                  }
                ]
              }
            },
            {
              "id": "lazy",
              "kind": "mental_model",
              "label": "THE CHECK IS STILL LAZY",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "`zip()` remains lazy, so a mismatch is detected only when iteration reaches the point where one iterable ends first.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "lazy",
                      "text": "lazy",
                      "required": true
                    },
                    {
                      "id": "detected",
                      "text": "detected only when iteration reaches",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "default",
              "kind": "not_this",
              "label": "DEFAULT ZIP STILL TRUNCATES",
              "placeholder": "",
              "required": false,
              "reveal": {
                "type": "text",
                "text": "Without `strict=True`, `zip()` stops at the shortest iterable and silently ignores remaining items from longer inputs.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "shortest",
                      "text": "shortest iterable",
                      "required": true
                    },
                    {
                      "id": "ignores",
                      "text": "silently ignores remaining items",
                      "required": true
                    }
                  ]
                }
              }
            }
