          "id": "domain-7-py310_match_mapping",
          "title": "3.10 structural mapping patterns",
          "concept_ids": [
            "ai.python.py310_match_mapping"
          ],
          "prompts": [
            {
              "id": "code",
              "kind": "look_for",
              "label": "READ A MAPPING PATTERN",
              "placeholder": "Click the mapping pattern and wildcard.",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "match_mapping.py",
                "language": "python",
                "code": "def route(event):\n    match event:\n        case {\"type\": \"user.created\", \"user_id\": user_id}:\n            return f\"created {user_id}\"\n        case {\"type\": \"user.deleted\", \"user_id\": user_id}:\n            return f\"deleted {user_id}\"\n        case _:\n            return \"ignored\"",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "pattern",
                    "anchor": {
                      "line": 3,
                      "text": "case {\"type\": \"user.created\", \"user_id\": user_id}:",
                      "occurrence": 1
                    },
                    "title": "Mapping pattern",
                    "explanation": "The case requires matching keys/literal values and binds user_id.",
                    "required": true
                  },
                  {
                    "id": "wild",
                    "anchor": {
                      "line": 7,
                      "text": "case _:",
                      "occurrence": 1
                    },
                    "title": "Wildcard case",
                    "explanation": "_ handles any value not matched by earlier cases.",
                    "required": true
                  }
                ]
              }
            }
          ],
          "prerequisite_node_ids": [],
          "map_position": {
            "x": 0.12,
            "y": 0.15
          },
          "source_refs": []
        },
