          },
          "prompts": [
            {
              "id": "d1-shared-what",
              "kind": "what",
              "label": "WHAT IS SHARED RESPONSIBILITY?",
              "placeholder": "Tap to reveal",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "In cloud computing, security and operations are split between the cloud provider and the customer. The provider protects the cloud infrastructure, while the customer remains responsible for the parts of the workload that the provider does not manage."
              }
            },
            {
              "id": "d1-shared-table",
              "kind": "connects_to",
              "label": "HOW RESPONSIBILITY SHIFTS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "table",
                "columns": [
                  {
                    "id": "model",
                    "label": "Service model"
                  },
                  {
                    "id": "customer",
                    "label": "Customer manages more of"
                  },
                  {
                    "id": "provider",
                    "label": "Provider manages more of"
                  }
                ],
                "rows": [
                  {
                    "id": "iaas",
                    "cells": {
                      "model": "IaaS",
                      "customer": "Operating system, applications, data, identities and configuration",
                      "provider": "Physical datacenter, hardware and core cloud infrastructure"
                    }
                  },
                  {
                    "id": "paas",
                    "cells": {
                      "model": "PaaS",
                      "customer": "Applications, data, identities and configuration",
                      "provider": "Infrastructure plus more of the operating platform"
                    }
                  },
                  {
                    "id": "saas",
                    "cells": {
                      "model": "SaaS",
                      "customer": "Data, identities, access and service configuration",
                      "provider": "Application platform and underlying infrastructure"
                    }
                  }
                ],
                "progressive_reveal": {
                  "mode": "row",
                  "initially_visible": {
                    "column_ids": [
                      "model"
                    ],
                    "row_ids": [],
                    "cell_ids": []
                  }
                }
              }
            },
            {
              "id": "d1-shared-clue",
              "kind": "not_this",
              "label": "DO NOT CONFUSE",
              "placeholder": "Tap to reveal",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Moving to the cloud does not transfer every security responsibility to Microsoft. The customer's responsibilities become smaller as the service becomes more managed, but they never disappear completely."
              }
            }
          ],
