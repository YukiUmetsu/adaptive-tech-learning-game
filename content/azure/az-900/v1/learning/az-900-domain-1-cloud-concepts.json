        {
          "id": "d1-security-governance",
          "title": "Security and governance benefits",
          "concept_ids": [
            "azure.az900.security_benefit",
            "azure.az900.governance_benefit"
          ],
          "prerequisite_node_ids": [
            "d1-reliability-predictability"
          ],
          "map_position": {
            "x": 0.64,
            "y": 0.39
          },
          "prompts": [
            {
              "id": "d1-sec-gov-what",
              "kind": "what",
              "label": "WHAT DO THESE BENEFITS MEAN?",
              "placeholder": "Tap to reveal",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Cloud providers supply security capabilities and protect the underlying platform. Governance tools help an organization apply standards, track compliance, and keep resource configuration within approved rules."
              }
            },
            {
              "id": "d1-sec-gov-why",
              "kind": "when",
              "label": "WHY IT MATTERS",
              "placeholder": "Tap to reveal",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Central services can make security controls and governance rules easier to apply consistently across many resources than managing every server or team separately."
              }
            },
            {
              "id": "d1-sec-gov-not",
              "kind": "not_this",
              "label": "REMEMBER SHARED RESPONSIBILITY",
              "placeholder": "Tap to reveal",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Provider security features do not make every workload secure automatically. Customers still configure identities, access, data protection, and resources appropriately for the service model they use."
              }
            }
          ],
          "glossary": [],
