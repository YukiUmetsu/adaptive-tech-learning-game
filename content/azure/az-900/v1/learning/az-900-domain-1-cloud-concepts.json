                  }
                }
              }
            },
            {
              "id": "d1-models-clue",
              "kind": "exam_clue",
              "label": "HOW TO CHOOSE",
              "placeholder": "Tap to reveal",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Look for the constraint. Public cloud fits speed and elastic capacity. Private cloud fits dedicated control. Hybrid cloud fits a requirement to keep part of the environment outside the public cloud while using both."
              }
            }
