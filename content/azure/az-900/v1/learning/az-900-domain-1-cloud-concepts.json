              "id": "d1-models-what",
              "kind": "what",
              "label": "WHAT IS A CLOUD MODEL?",
              "placeholder": "Tap to reveal",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "A cloud model describes where cloud resources run and who they are dedicated to. AZ-900 focuses on public cloud, private cloud, and hybrid cloud."
              }
            },
            {
              "id": "d1-models-table",
              "kind": "connects_to",
              "label": "COMPARE THE MODELS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "table",
                "columns": [
                  {
                    "id": "model",
                    "label": "Model"
                  },
                  {
                    "id": "meaning",
                    "label": "Meaning"
                  },
                  {
                    "id": "fit",
                    "label": "Typical fit"
                  }
                ],
                "rows": [
                  {
                    "id": "public",
                    "cells": {
                      "model": "Public cloud",
                      "meaning": "Cloud services run on provider-owned infrastructure shared across customers with logical isolation.",
                      "fit": "Fast provisioning, broad service choice, elastic scale"
                    }
                  },
                  {
                    "id": "private",
                    "cells": {
                      "model": "Private cloud",
                      "meaning": "Cloud-style infrastructure is dedicated to one organization.",
                      "fit": "Special control, legacy, or regulatory requirements"
                    }
                  },
                  {
                    "id": "hybrid",
                    "cells": {
                      "model": "Hybrid cloud",
                      "meaning": "Private or on-premises environments are connected with public cloud services.",
                      "fit": "Gradual migration, local dependencies, mixed residency needs"
                    }
                  }
                ],
                "progressive_reveal": {
