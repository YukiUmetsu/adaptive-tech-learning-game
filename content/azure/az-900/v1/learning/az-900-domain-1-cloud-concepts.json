          "prompts": [
            {
              "id": "d1-service-choice-what",
              "kind": "what",
              "label": "RECAP THE THREE MODELS",
              "placeholder": "Tap to reveal",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "IaaS provides configurable infrastructure, PaaS provides a managed application platform, and SaaS provides a complete managed application. The decision is how much of the technology stack you need to control yourself."
              }
            },
            {
              "id": "d1-service-choice-table",
              "kind": "connects_to",
              "label": "ONE DECISION TABLE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "table",
                "columns": [
                  {
                    "id": "model",
                    "label": "Model"
                  },
                  {
                    "id": "you_manage",
                    "label": "You mainly manage"
                  },
                  {
                    "id": "best_clue",
                    "label": "Best clue"
                  }
                ],
                "rows": [
                  {
                    "id": "iaas",
                    "cells": {
                      "model": "IaaS",
                      "you_manage": "OS, runtime, applications, data",
                      "best_clue": "Need server/OS control"
                    }
                  },
                  {
                    "id": "paas",
                    "cells": {
                      "model": "PaaS",
                      "you_manage": "Application code, data, configuration",
                      "best_clue": "Deploy code without managing the OS"
                    }
                  },
                  {
                    "id": "saas",
                    "cells": {
                      "model": "SaaS",
                      "you_manage": "Users, data, service settings",
                      "best_clue": "Need a finished application"
                    }
                  }
                ],
                "progressive_reveal": {
                  "mode": "row",
                  "initially_visible": {
                    "column_ids": [
                      "model"
                    ],
                    "row_ids": [],
                    "cell_ids": []
                  }
                }
              }
            },
            {
              "id": "d1-service-choice-model",
              "kind": "mental_model",
              "label": "MENTAL MODEL",
              "placeholder": "Tap to reveal",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "As you move from IaaS to PaaS to SaaS, the provider manages more of the stack and the customer manages less. The best choice depends on how much control you need versus how much platform work you want the provider to handle."
              }
            },
            {
              "id": "d1-service-choice-clue",
              "kind": "exam_clue",
              "label": "FAST ELIMINATION RULE",
              "placeholder": "Tap to reveal",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Need the operating system? Think IaaS. Need to deploy your own code on a managed platform? Think PaaS. Need to use a finished application? Think SaaS."
              }
            }
          ],
