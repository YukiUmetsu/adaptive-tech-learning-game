          },
          "prompts": [
            {
              "id": "d1-ha-scale-what",
              "kind": "what",
              "label": "DEFINE BOTH TERMS",
              "placeholder": "Tap to reveal",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "High availability means designing a service to remain accessible despite failures. Scalability means changing capacity so the service can handle more or less demand."
              }
            },
            {
              "id": "d1-ha-scale-table",
              "kind": "connects_to",
              "label": "COMPARE THE GOALS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "table",
                "columns": [
                  {
                    "id": "term",
                    "label": "Term"
                  },
                  {
                    "id": "question",
                    "label": "Question it answers"
                  },
                  {
                    "id": "example",
                    "label": "Example"
                  }
                ],
                "rows": [
                  {
                    "id": "ha",
                    "cells": {
                      "term": "High availability",
                      "question": "Can the service keep working when something fails?",
                      "example": "Use redundant instances so one failure does not stop the app."
                    }
                  },
                  {
                    "id": "scale",
                    "cells": {
                      "term": "Scalability",
                      "question": "Can capacity change with demand?",
                      "example": "Add instances when traffic rises, then remove them later."
                    }
                  }
                ],
                "progressive_reveal": {
                  "mode": "row",
                  "initially_visible": {
                    "column_ids": [
                      "term"
                    ],
                    "row_ids": [],
                    "cell_ids": []
                  }
                }
