            },
            {
              "id": "d1-ha-scale-clue",
              "kind": "exam_clue",
              "label": "EXAM CLUE",
              "placeholder": "Tap to reveal",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Failure tolerance points to high availability. A workload growing or shrinking with demand points to scalability."
              }
            }
          ],
