        {
          "id": "d1-manageability",
          "title": "Manageability in the cloud",
          "concept_ids": [
            "azure.az900.manageability"
          ],
          "prerequisite_node_ids": [
            "d1-security-governance"
          ],
          "map_position": {
            "x": 0.92,
            "y": 0.39
          },
          "prompts": [
            {
              "id": "d1-manageability-what",
              "kind": "what",
              "label": "WHAT IS MANAGEABILITY?",
              "placeholder": "Tap to reveal",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Manageability is the ability to provision, configure, monitor, and control cloud resources with consistent tools and automation."
              }
            },
            {
              "id": "d1-manageability-how",
              "kind": "connects_to",
              "label": "HOW THE CLOUD HELPS",
              "placeholder": "Tap to reveal",
              "required": true,
              "reveal": {
                "type": "bullets",
                "items": [
                  "Use web portals, command-line tools, APIs, and templates to manage resources.",
                  "Automate repetitive deployment and configuration work.",
                  "Monitor resources centrally instead of visiting physical hardware."
                ]
              }
            },
            {
              "id": "d1-manageability-clue",
              "kind": "exam_clue",
              "label": "EXAM CLUE",
              "placeholder": "Tap to reveal",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "If the requirement is repeatable administration, automation, centralized monitoring, or fast provisioning, it is describing a manageability benefit."
              }
            }
          ],
