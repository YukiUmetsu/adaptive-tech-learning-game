        {
          "id": "d1-reliability-predictability",
          "title": "Reliability and predictability",
          "concept_ids": [
            "azure.az900.reliability",
            "azure.az900.predictability"
          ],
          "prerequisite_node_ids": [
            "d1-ha-scalability"
          ],
          "map_position": {
