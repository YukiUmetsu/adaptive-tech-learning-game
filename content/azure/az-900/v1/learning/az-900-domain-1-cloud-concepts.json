          },
          "prompts": [
            {
              "id": "d1-rel-pred-what",
              "kind": "what",
              "label": "DEFINE BOTH TERMS",
              "placeholder": "Tap to reveal",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Reliability is the ability of a system to recover from failures and continue functioning as intended. Predictability means you can better anticipate performance and cost instead of depending on uncertain capacity or spending."
              }
            },
            {
              "id": "d1-rel-pred-compare",
              "kind": "connects_to",
              "label": "TWO DIFFERENT BENEFITS",
              "placeholder": "Tap to compare",
              "required": true,
              "reveal": {
                "type": "comparison",
                "columns": [
                  {
                    "title": "Reliability",
                    "items": [
                      "Design for failures",
                      "Redundancy and recovery reduce interruption",
                      "Question: can the workload keep or return to working?"
                    ]
                  },
                  {
                    "title": "Predictability",
                    "items": [
                      "Estimate expected performance and cost",
                      "Cloud tools and service models improve planning",
                      "Question: can you anticipate what the workload will need or cost?"
                    ]
                  }
                ]
              }
            },
            {
              "id": "d1-rel-pred-clue",
              "kind": "exam_clue",
              "label": "EXAM CLUE",
              "placeholder": "Tap to reveal",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Recovery after a failure is a reliability concern. Forecasting capacity, performance, or spending is a predictability concern."
              }
            }
          ],
