    {
      "id": "d1-module-3",
      "title": "Choose a cloud service type",
      "order": 3,
      "task_ids": [
        "1.3"
      ],
      "skill_ids": [
        "1.3.1",
        "1.3.2",
        "1.3.3",
        "1.3.4"
      ],
      "prerequisite_module_ids": [
        "d1-module-1"
      ],
      "nodes": [
        {
          "id": "d1-iaas",
          "title": "Infrastructure as a Service (IaaS)",
          "concept_ids": [
            "azure.az900.iaas"
          ],
          "prerequisite_node_ids": [],
          "map_position": {
            "x": 0.08,
            "y": 0.64
          },
          "prompts": [
            {
              "id": "d1-iaas-what",
              "kind": "what",
              "label": "WHAT IS IAAS?",
              "placeholder": "Tap to reveal",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Infrastructure as a Service (IaaS) provides fundamental cloud infrastructure such as virtual machines, networking, and storage. You control more of the software stack, including the guest operating system and applications."
              }
            },
            {
              "id": "d1-iaas-when",
              "kind": "when",
              "label": "WHEN TO USE IT",
              "placeholder": "Tap to reveal",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Choose IaaS when you need strong operating-system control. It also fits software that expects a traditional server or a lift-and-shift server migration."
              }
            },
            {
              "id": "d1-iaas-not",
              "kind": "not_this",
              "label": "TRADE-OFF",
              "placeholder": "Tap to reveal",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "IaaS gives more control than PaaS, but it also leaves more patching, configuration, and operating-system management to you."
              }
            }
          ],
          "glossary": [],
          "source_refs": [
            {
              "title": "Study guide for Exam AZ-900: Microsoft Azure Fundamentals — skills measured as of July 20, 2026",
              "url": "https://learn.microsoft.com/en-us/credentials/certifications/resources/study-guides/az-900"
            },
            {
              "title": "Describe cloud service types — Microsoft Learn",
              "url": "https://learn.microsoft.com/en-us/training/modules/describe-cloud-service-types/"
            }
          ]
        },
        {
          "id": "d1-paas",
          "title": "Platform as a Service (PaaS)",
          "concept_ids": [
            "azure.az900.paas"
          ],
          "prerequisite_node_ids": [
            "d1-iaas"
          ],
          "map_position": {
            "x": 0.36,
            "y": 0.64
          },
          "prompts": [
            {
              "id": "d1-paas-what",
              "kind": "what",
              "label": "WHAT IS PAAS?",
              "placeholder": "Tap to reveal",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Platform as a Service (PaaS) gives developers a managed platform for building and running applications. The provider manages more of the operating system, runtime, and infrastructure so the team can focus on application code and data."
              }
            },
            {
              "id": "d1-paas-when",
              "kind": "when",
              "label": "WHEN TO USE IT",
              "placeholder": "Tap to reveal",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Choose PaaS when you want to deploy an application without managing virtual-machine operating systems. The service still needs to support the runtime or platform features your application needs."
              }
            },
            {
              "id": "d1-paas-not",
              "kind": "not_this",
              "label": "TRADE-OFF",
              "placeholder": "Tap to reveal",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "PaaS reduces infrastructure work compared with IaaS, but it also gives you less control over the underlying operating system."
              }
            }
          ],
          "glossary": [],
          "source_refs": [
            {
              "title": "Study guide for Exam AZ-900: Microsoft Azure Fundamentals — skills measured as of July 20, 2026",
              "url": "https://learn.microsoft.com/en-us/credentials/certifications/resources/study-guides/az-900"
            },
            {
              "title": "Describe cloud service types — Microsoft Learn",
              "url": "https://learn.microsoft.com/en-us/training/modules/describe-cloud-service-types/"
            }
          ]
        },
        {
          "id": "d1-saas",
          "title": "Software as a Service (SaaS)",
          "concept_ids": [
            "azure.az900.saas"
          ],
          "prerequisite_node_ids": [
            "d1-paas"
          ],
          "map_position": {
            "x": 0.64,
            "y": 0.64
          },
          "prompts": [
            {
              "id": "d1-saas-what",
              "kind": "what",
              "label": "WHAT IS SAAS?",
              "placeholder": "Tap to reveal",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Software as a Service (SaaS) is a complete application delivered as a managed service. Users consume the software while the provider runs and maintains the application platform and infrastructure."
              }
            },
            {
              "id": "d1-saas-when",
              "kind": "when",
              "label": "WHEN TO USE IT",
              "placeholder": "Tap to reveal",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Choose SaaS when the business needs the finished application rather than a platform for building its own application."
              }
            },
            {
              "id": "d1-saas-not",
              "kind": "not_this",
              "label": "TRADE-OFF",
              "placeholder": "Tap to reveal",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "SaaS removes the most infrastructure management, but customers still manage their users, access, data, and application settings within the service."
              }
            }
          ],
          "glossary": [],
          "source_refs": [
            {
              "title": "Study guide for Exam AZ-900: Microsoft Azure Fundamentals — skills measured as of July 20, 2026",
              "url": "https://learn.microsoft.com/en-us/credentials/certifications/resources/study-guides/az-900"
            },
            {
              "title": "Describe cloud service types — Microsoft Learn",
              "url": "https://learn.microsoft.com/en-us/training/modules/describe-cloud-service-types/"
            }
          ]
        },
        {
          "id": "d1-service-model-choice",
          "title": "Choose IaaS, PaaS, or SaaS",
          "concept_ids": [
            "azure.az900.iaas",
            "azure.az900.paas",
            "azure.az900.saas",
            "azure.az900.service_model_use_cases"
          ],
