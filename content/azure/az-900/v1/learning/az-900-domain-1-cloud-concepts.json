  "glossary": [
    {
      "term": "cloud computing",
      "definition": "On-demand delivery of computing services through provider-managed infrastructure instead of owning all required hardware yourself."
    },
    {
      "term": "CapEx",
      "definition": "Capital expenditure: up-front spending to buy long-lived assets such as servers or datacenter equipment."
    },
    {
      "term": "OpEx",
      "definition": "Operational expenditure: ongoing spending for services or operations over time."
    },
    {
      "term": "serverless",
      "definition": "A cloud execution model where the provider manages the servers and the customer focuses on code or workload logic."
    },
    {
      "term": "IaaS",
      "definition": "Infrastructure as a Service: cloud infrastructure with substantial customer control over the operating system and applications."
    },
    {
      "term": "PaaS",
      "definition": "Platform as a Service: a managed application platform where the provider handles more of the operating environment."
    },
    {
      "term": "SaaS",
      "definition": "Software as a Service: a complete provider-managed application consumed by users."
    },
    {
      "term": "high availability",
      "definition": "Designing a service to remain accessible even when a component fails."
    },
    {
      "term": "API",
      "definition": "Application programming interface: a defined way for software to request functions or data from another software system."
    }
  ],
