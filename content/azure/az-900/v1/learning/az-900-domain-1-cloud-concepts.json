        {
          "id": "d1-consumption",
          "title": "Consumption-based cloud economics",
          "concept_ids": [
            "azure.az900.consumption_model",
            "azure.az900.cloud_pricing"
          ],
          "prerequisite_node_ids": [
            "d1-cloud-models"
          ],
          "map_position": {
            "x": 0.71,
            "y": 0.14
          },
          "prompts": [
            {
              "id": "d1-consumption-what",
              "kind": "what",
              "label": "WHAT IS THE CONSUMPTION MODEL?",
              "placeholder": "Tap to reveal",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "A consumption-based model charges for cloud resources as you use them. You can add capacity when demand rises and release it when demand falls instead of purchasing all future capacity up front."
              }
            },
            {
              "id": "d1-capex-opex",
              "kind": "connects_to",
              "label": "CAPEX VS OPEX",
              "placeholder": "Tap to compare",
              "required": true,
              "reveal": {
                "type": "comparison",
                "columns": [
                  {
                    "title": "Capital expenditure (CapEx)",
                    "items": [
                      "Up-front purchase",
                      "Physical servers, networking, datacenter space",
                      "Capacity is bought before it is used"
                    ]
                  },
                  {
                    "title": "Operational expenditure (OpEx)",
                    "items": [
                      "Ongoing spending",
                      "Cloud services are commonly treated as operating expense",
                      "Usage can change over time"
                    ]
                  }
                ]
              }
            },
            {
              "id": "d1-pricing-clue",
              "kind": "exam_clue",
              "label": "PRICING CLUE",
              "placeholder": "Tap to reveal",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "If a scenario says 'pay only for what is used' or 'avoid buying idle capacity,' think consumption-based, pay-as-you-go cloud pricing."
              }
            }
          ],
