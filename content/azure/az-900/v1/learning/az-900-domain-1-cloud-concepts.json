        {
          "id": "d1-cloud-computing",
          "title": "Cloud computing: the basic idea",
          "concept_ids": [
            "azure.az900.cloud_computing"
          ],
          "prerequisite_node_ids": [],
          "map_position": {
            "x": 0.08,
            "y": 0.14
          },
          "prompts": [
            {
              "id": "d1-cloud-what",
              "kind": "what",
              "label": "START HERE",
              "placeholder": "Tap to reveal",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Cloud computing is the delivery of computing services over a network when you need them. Instead of owning all the hardware yourself, you can provision resources such as compute and storage from a cloud provider."
              }
            },
            {
              "id": "d1-cloud-why",
              "kind": "when",
              "label": "WHY IT MATTERS",
              "placeholder": "Tap to reveal",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Cloud resources can be created or removed much faster than buying and installing physical infrastructure. This makes it easier to respond when demand or business needs change."
              }
            },
            {
              "id": "d1-cloud-clue",
              "kind": "exam_clue",
              "label": "RECOGNITION CLUES",
              "placeholder": "Tap to reveal",
              "required": true,
              "reveal": {
                "type": "keywords",
                "items": [
                  "on demand",
                  "provision quickly",
                  "provider-operated infrastructure",
                  "scale with demand"
                ]
              }
            }
          ],
          "glossary": [],
          "source_refs": [
            {
              "title": "Study guide for Exam AZ-900: Microsoft Azure Fundamentals — skills measured as of July 20, 2026",
