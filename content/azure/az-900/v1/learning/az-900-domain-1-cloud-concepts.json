        {
          "id": "d1-shared-responsibility",
          "title": "Shared responsibility: who secures what",
          "concept_ids": [
            "azure.az900.shared_responsibility"
          ],
          "prerequisite_node_ids": [
            "d1-cloud-computing"
          ],
          "map_position": {
            "x": 0.29,
