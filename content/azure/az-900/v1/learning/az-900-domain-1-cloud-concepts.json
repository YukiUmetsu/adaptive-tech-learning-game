        {
          "id": "d1-serverless",
          "title": "Serverless: focus on code, not servers",
          "concept_ids": [
            "azure.az900.serverless"
          ],
          "prerequisite_node_ids": [
            "d1-consumption"
          ],
          "map_position": {
            "x": 0.92,
            "y": 0.14
          },
          "prompts": [
            {
              "id": "d1-serverless-what",
              "kind": "what",
              "label": "WHAT DOES SERVERLESS MEAN?",
              "placeholder": "Tap to reveal",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Serverless computing lets you run application logic without provisioning or managing the servers that execute it. Servers still exist, but the cloud provider handles the underlying infrastructure for you."
              }
            },
            {
              "id": "d1-serverless-when",
              "kind": "when",
              "label": "WHEN DOES IT FIT?",
              "placeholder": "Tap to reveal",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Serverless is a strong fit for event-driven work. Examples include processing an uploaded file or responding to a message. Azure Functions is an Azure serverless compute service."
              }
            },
            {
              "id": "d1-serverless-not",
              "kind": "not_this",
              "label": "DO NOT CONFUSE",
              "placeholder": "Tap to reveal",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Serverless does not mean 'no servers.' It means server management is abstracted away from the application owner."
              }
            }
          ],
          "glossary": [],
