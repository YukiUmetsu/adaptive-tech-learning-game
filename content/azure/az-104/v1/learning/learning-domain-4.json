        {
          "id": "az104-d4-n05",
          "title": "NSGs and application security groups",
          "concept_ids": [
            "azure.network.nsg_asg"
          ],
          "prerequisite_node_ids": [],
          "map_position": {
            "x": 0.88,
            "y": 0.1
          },
          "prompts": [
            {
              "id": "az104-d4-n05-what",
              "kind": "what",
              "label": "WHAT IT IS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "A network security group (NSG) is a stateful Layer 3/4 traffic filter containing prioritized allow/deny rules. An application security group (ASG) is a logical label for VM network interfaces that can be referenced in NSG rules."
              }
            },
            {
              "id": "az104-d4-n05-why",
              "kind": "when",
              "label": "WHY IT MATTERS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "NSGs enforce traffic policy; ASGs make those rules easier to express without hard-coding many IP addresses."
              }
            },
            {
              "id": "az104-d4-n05-model",
              "kind": "mental_model",
              "label": "HOW TO THINK ABOUT IT",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "comparison",
                "columns": [
                  {
                    "title": "NSG",
                    "items": [
                      "Contains inbound/outbound security rules",
                      "Can be associated with subnets and supported NICs",
                      "Rule priority determines evaluation order"
                    ]
                  },
                  {
                    "title": "ASG",
                    "items": [
                      "Groups VM NICs by application role",
                      "Referenced as source/destination in NSG rules",
                      "Does not itself allow or deny traffic"
                    ]
                  }
                ]
              }
            },
            {
              "id": "az104-d4-n05-clue",
              "kind": "exam_clue",
              "label": "EXAM / PRACTICAL CLUE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "“Web tier may talk to database tier” can be expressed with ASGs inside an NSG rule. The NSG is the enforcement control."
              }
            }
          ],
          "source_refs": [
            {
              "title": "Study guide for Exam AZ-104: Microsoft Azure Administrator",
              "url": "https://learn.microsoft.com/en-us/credentials/certifications/resources/study-guides/az-104"
            },
            {
              "title": "Application security groups",
              "url": "https://learn.microsoft.com/en-us/azure/virtual-network/application-security-groups"
            }
          ],
          "glossary": [
            {
              "term": "stateful",
              "definition": "Return traffic for an allowed connection is automatically permitted without a separate reverse-direction rule for that connection."
            }
          ]
        },
        {
          "id": "az104-d4-n06",
          "title": "Effective security rules",
          "concept_ids": [
            "azure.network.nsg_asg",
            "azure.network.troubleshooting"
          ],
          "prerequisite_node_ids": [
            "az104-d4-n05"
          ],
          "map_position": {
            "x": 0.12,
            "y": 0.32
          },
          "prompts": [
            {
              "id": "az104-d4-n06-what",
              "kind": "what",
              "label": "WHAT IT IS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Effective security rules show the combined NSG rules that apply to a VM network interface after considering relevant subnet and NIC associations."
              }
            },
            {
              "id": "az104-d4-n06-why",
              "kind": "when",
              "label": "WHY IT MATTERS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "They are useful when the configured rule you see is not the only rule affecting the VM."
              }
            },
            {
              "id": "az104-d4-n06-model",
              "kind": "mental_model",
              "label": "HOW TO THINK ABOUT IT",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "sequence",
                "items": [
                  "Identify the source and destination addresses/ports",
                  "Check NSGs associated with the subnet and NIC",
                  "Review effective security rules and priorities",
                  "Confirm routing and application listening state",
                  "Test connectivity again"
                ]
              }
            },
            {
              "id": "az104-d4-n06-clue",
              "kind": "exam_clue",
              "label": "EXAM / PRACTICAL CLUE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "A packet can be denied even when one NSG appears to allow it. Inspect the combined effective rules rather than only one configuration object."
              }
            }
          ],
          "source_refs": [
            {
              "title": "Study guide for Exam AZ-104: Microsoft Azure Administrator",
              "url": "https://learn.microsoft.com/en-us/credentials/certifications/resources/study-guides/az-104"
