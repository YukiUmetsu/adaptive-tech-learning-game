        {
          "id": "az104-d4-n10",
          "title": "Azure Load Balancer and health probes",
          "concept_ids": [
            "azure.network.load_balancer"
          ],
          "prerequisite_node_ids": [],
          "map_position": {
            "x": 0.88,
            "y": 0.32
          },
          "prompts": [
            {
              "id": "az104-d4-n10-what",
              "kind": "what",
              "label": "WHAT IT IS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Azure Load Balancer distributes TCP/UDP traffic at Layer 4 across backend resources. A public load balancer uses a public frontend; an internal load balancer uses a private frontend. Health probes decide which backend instances receive new load-balanced flows."
              }
            },
            {
              "id": "az104-d4-n10-why",
              "kind": "when",
              "label": "WHY IT MATTERS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Load balancing improves availability and scale only when probes accurately represent backend health."
              }
            },
            {
              "id": "az104-d4-n10-model",
              "kind": "mental_model",
              "label": "HOW TO THINK ABOUT IT",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "comparison",
                "columns": [
                  {
                    "title": "Public Load Balancer",
                    "items": [
                      "Internet-facing frontend IP",
                      "Distributes inbound public TCP/UDP flows"
                    ]
                  },
                  {
                    "title": "Internal Load Balancer",
                    "items": [
                      "Private frontend IP",
                      "Distributes traffic inside connected private networks"
                    ]
                  },
                  {
                    "title": "Health probe",
                    "items": [
                      "Tests backend readiness",
                      "Unhealthy backend stops receiving new load-balanced flows"
                    ]
                  }
                ]
              }
            },
            {
              "id": "az104-d4-n10-clue",
              "kind": "exam_clue",
              "label": "EXAM / PRACTICAL CLUE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "If one backend should be removed from traffic when an app stops responding, inspect the health probe path/port and backend response."
              }
            }
