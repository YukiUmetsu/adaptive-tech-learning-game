            }
          ]
        },
        {
          "id": "az104-d4-n11",
          "title": "Troubleshoot VNet connectivity systematically",
          "concept_ids": [
            "azure.network.troubleshooting"
          ],
          "prerequisite_node_ids": [
            "az104-d4-n06"
          ],
          "map_position": {
            "x": 0.12,
            "y": 0.54
          },
          "prompts": [
            {
              "id": "az104-d4-n11-what",
              "kind": "what",
              "label": "WHAT IT IS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Azure network troubleshooting means checking the path layer by layer: name resolution, source/destination addressing, routing, security rules, and application/service health."
              }
            },
            {
              "id": "az104-d4-n11-why",
              "kind": "when",
              "label": "WHY IT MATTERS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Changing random NSG rules is risky and often misses the actual problem. Network Watcher tools provide evidence about route and security decisions."
              }
            },
            {
              "id": "az104-d4-n11-model",
              "kind": "mental_model",
              "label": "HOW TO THINK ABOUT IT",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "sequence",
                "items": [
                  "Resolve the destination name and address",
                  "Confirm source/destination IPs and subnet placement",
                  "Inspect effective routes / next hop",
                  "Inspect effective NSG rules or IP flow evidence",
                  "Check endpoint/listener and service health",
                  "Use Connection Monitor or other Network Watcher diagnostics for path evidence"
                ]
              }
            },
            {
              "id": "az104-d4-n11-clue",
              "kind": "exam_clue",
              "label": "EXAM / PRACTICAL CLUE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "A timeout does not automatically mean “open the firewall.” Prove DNS, route, security, and listener behavior in order."
              }
            }
          ],
          "source_refs": [
            {
              "title": "Study guide for Exam AZ-104: Microsoft Azure Administrator",
