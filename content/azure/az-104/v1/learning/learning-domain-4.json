          ]
        },
        {
          "id": "az104-d4-n04",
          "title": "System routes and user-defined routes (UDRs)",
          "concept_ids": [
            "azure.network.routing"
          ],
          "prerequisite_node_ids": [],
          "map_position": {
            "x": 0.69,
            "y": 0.1
          },
          "prompts": [
            {
              "id": "az104-d4-n04-what",
              "kind": "what",
              "label": "WHAT IT IS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Azure automatically creates system routes for each subnet. A route table lets you add user-defined routes (UDRs) so matching traffic uses a chosen next hop such as a virtual appliance."
              }
            },
            {
              "id": "az104-d4-n04-why",
              "kind": "when",
              "label": "WHY IT MATTERS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Custom routing is how you force traffic through inspection, change default egress paths, or steer packets toward specific network virtual appliances."
              }
            },
            {
              "id": "az104-d4-n04-model",
              "kind": "mental_model",
              "label": "HOW TO THINK ABOUT IT",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "table",
                "columns": [
                  {
                    "id": "term",
                    "label": "Term"
                  },
                  {
                    "id": "meaning",
                    "label": "Meaning"
                  },
                  {
                    "id": "clue",
                    "label": "Clue"
                  }
                ],
                "rows": [
                  {
                    "id": "system",
                    "cells": {
                      "term": "System route",
                      "meaning": "Azure-created baseline route",
                      "clue": "Default VNet/subnet behavior"
                    }
                  },
                  {
                    "id": "udr",
                    "cells": {
                      "term": "User-defined route",
                      "meaning": "Administrator-authored route in a route table",
                      "clue": "Force a prefix toward a chosen next hop"
                    }
                  },
                  {
                    "id": "next",
                    "cells": {
                      "term": "Next hop",
                      "meaning": "Where Azure forwards matching traffic",
                      "clue": "Virtual appliance, virtual network gateway, Internet, etc."
                    }
                  }
                ]
              }
            },
            {
              "id": "az104-d4-n04-clue",
              "kind": "exam_clue",
              "label": "EXAM / PRACTICAL CLUE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "If packets take the wrong path, inspect effective routes and longest-prefix/route-source behavior before changing security rules blindly."
              }
            }
          ],
          "source_refs": [
            {
              "title": "Study guide for Exam AZ-104: Microsoft Azure Administrator",
              "url": "https://learn.microsoft.com/en-us/credentials/certifications/resources/study-guides/az-104"
            },
