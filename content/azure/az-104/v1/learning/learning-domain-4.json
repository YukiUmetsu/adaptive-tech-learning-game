        {
          "id": "az104-d4-n07",
          "title": "Azure Bastion",
          "concept_ids": [
            "azure.network.bastion"
          ],
          "prerequisite_node_ids": [],
          "map_position": {
            "x": 0.31,
            "y": 0.32
          },
          "prompts": [
            {
              "id": "az104-d4-n07-what",
              "kind": "what",
              "label": "WHAT IT IS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Azure Bastion is a managed service for RDP and SSH connectivity to virtual machines through their private IP addresses, without requiring a public IP on each target VM."
              }
            },
            {
              "id": "az104-d4-n07-why",
              "kind": "when",
              "label": "WHY IT MATTERS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "It reduces direct management-port exposure while still giving administrators interactive VM access."
              }
            },
            {
              "id": "az104-d4-n07-model",
              "kind": "mental_model",
              "label": "HOW TO THINK ABOUT IT",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "bullets",
                "items": [
                  "Deploy/configure Bastion for the virtual network design.",
                  "Keep target VMs on private addresses when direct Internet exposure is not required.",
                  "Connect using supported RDP/SSH experiences through Bastion."
                ]
              }
            },
            {
              "id": "az104-d4-n07-clue",
              "kind": "exam_clue",
              "label": "EXAM / PRACTICAL CLUE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "“Administrators need RDP/SSH but VMs must not have public IP addresses” is the classic Bastion clue."
              }
            }
          ],
          "source_refs": [
