        {
          "id": "az104-d4-n08",
          "title": "Service endpoints versus private endpoints",
          "concept_ids": [
            "azure.network.paas_access"
          ],
          "prerequisite_node_ids": [],
          "map_position": {
            "x": 0.5,
            "y": 0.32
          },
          "prompts": [
            {
              "id": "az104-d4-n08-what",
              "kind": "what",
              "label": "WHAT IT IS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "A virtual-network service endpoint extends a subnet identity to a supported Azure PaaS service while the service is still reached through its public endpoint. A private endpoint creates a network interface with a private IP in your VNet for a specific supported service resource."
              }
            },
            {
              "id": "az104-d4-n08-why",
              "kind": "when",
              "label": "WHY IT MATTERS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Both can restrict PaaS access to trusted networks, but only the private endpoint places a private IP for the service resource inside the VNet."
              }
            },
            {
              "id": "az104-d4-n08-model",
              "kind": "mental_model",
              "label": "HOW TO THINK ABOUT IT",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "comparison",
                "columns": [
                  {
                    "title": "Service endpoint",
                    "items": [
                      "Traffic stays on Azure backbone to supported service",
                      "Service still uses a public service endpoint",
                      "Authorize selected VNets/subnets on the service"
                    ]
                  },
                  {
                    "title": "Private endpoint",
                    "items": [
                      "Private IP in your VNet",
                      "Uses Azure Private Link for a specific resource/subresource",
                      "DNS must resolve the service name to the private endpoint for private connectivity"
                    ]
                  }
                ]
              }
            },
            {
              "id": "az104-d4-n08-clue",
              "kind": "exam_clue",
              "label": "EXAM / PRACTICAL CLUE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "“The PaaS service must be reachable at a private IP” points to a private endpoint. “Allow this subnet to the service public endpoint” points toward a service endpoint."
              }
            }
          ],
          "source_refs": [
