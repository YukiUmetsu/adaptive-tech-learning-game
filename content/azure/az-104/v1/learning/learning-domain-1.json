      ],
      "prerequisite_module_ids": [],
      "nodes": [
        {
          "id": "az104-d1-n01",
          "title": "Microsoft Entra users and groups",
          "concept_ids": [
            "azure.identity.users_groups"
          ],
          "prerequisite_node_ids": [],
          "map_position": {
            "x": 0.12,
            "y": 0.1
          },
          "prompts": [
            {
              "id": "az104-d1-n01-what",
              "kind": "what",
              "label": "WHAT IT IS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Microsoft Entra ID stores identities such as users and groups. Administrators create objects, update properties, manage membership, and use groups to manage many users consistently."
              }
            },
            {
              "id": "az104-d1-n01-why",
              "kind": "when",
              "label": "WHY IT MATTERS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Groups reduce repeated administration because access, applications, or licenses can be assigned to the group instead of to each user."
              }
            },
            {
              "id": "az104-d1-n01-model",
              "kind": "mental_model",
              "label": "HOW TO THINK ABOUT IT",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "comparison",
                "columns": [
                  {
                    "title": "User object",
                    "items": [
                      "Represents one identity",
                      "Has properties such as display name and usage location",
                      "Can receive licenses directly"
                    ]
                  },
                  {
                    "title": "Group",
                    "items": [
                      "Collects users or other supported principals",
                      "Simplifies repeated assignments",
                      "Membership may be assigned or dynamic when licensing permits"
                    ]
                  }
                ]
              }
            },
            {
              "id": "az104-d1-n01-clue",
              "kind": "exam_clue",
              "label": "EXAM / PRACTICAL CLUE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "If the requirement is to manage the same entitlement for many people, think group-based administration instead of repeating the same change user by user."
              }
            }
          ],
          "source_refs": [
            {
              "title": "Study guide for Exam AZ-104: Microsoft Azure Administrator",
              "url": "https://learn.microsoft.com/en-us/credentials/certifications/resources/study-guides/az-104"
            },
            {
              "title": "Users, groups, licensing, and roles in Microsoft Entra ID",
              "url": "https://learn.microsoft.com/en-us/entra/identity/users/directory-overview-user-model"
            }
          ],
          "glossary": [
            {
              "term": "tenant",
              "definition": "A dedicated Microsoft Entra directory boundary for an organization."
            },
            {
              "term": "security principal",
              "definition": "An identity that can be granted access, such as a user, group, service principal, or managed identity."
            }
          ]
        },
        {
          "id": "az104-d1-n02",
          "title": "License assignment in Microsoft Entra ID",
          "concept_ids": [
            "azure.identity.users_groups"
          ],
          "prerequisite_node_ids": [
            "az104-d1-n01"
          ],
          "map_position": {
            "x": 0.31,
            "y": 0.1
          },
          "prompts": [
            {
              "id": "az104-d1-n02-what",
              "kind": "what",
              "label": "WHAT IT IS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "A Microsoft cloud license enables product or service capabilities for a user. Licenses can be assigned directly or through supported group-based licensing."
              }
            },
            {
              "id": "az104-d1-n02-why",
              "kind": "when",
              "label": "WHY IT MATTERS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Group-based licensing automatically applies or removes assigned licenses as membership changes, which reduces manual work at scale."
              }
            },
            {
              "id": "az104-d1-n02-model",
              "kind": "mental_model",
              "label": "HOW TO THINK ABOUT IT",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "bullets",
                "items": [
                  "Set the user usage location before assigning services that depend on location.",
                  "Use direct assignment for an isolated case.",
                  "Use group-based licensing when membership should drive entitlement at scale."
                ]
              }
            },
            {
              "id": "az104-d1-n02-clue",
              "kind": "exam_clue",
              "label": "EXAM / PRACTICAL CLUE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "The exam may give you a large onboarding/offboarding requirement. Look for group-based licensing when membership should control who receives the license."
              }
            }
          ],
          "source_refs": [
            {
              "title": "Study guide for Exam AZ-104: Microsoft Azure Administrator",
              "url": "https://learn.microsoft.com/en-us/credentials/certifications/resources/study-guides/az-104"
            },
            {
              "title": "Users, groups, licensing, and roles in Microsoft Entra ID",
              "url": "https://learn.microsoft.com/en-us/entra/identity/users/directory-overview-user-model"
            }
          ]
        },
        {
          "id": "az104-d1-n03",
          "title": "External users and B2B collaboration",
          "concept_ids": [
            "azure.identity.external_users"
          ],
          "prerequisite_node_ids": [
            "az104-d1-n01"
          ],
          "map_position": {
            "x": 0.5,
            "y": 0.1
          },
          "prompts": [
            {
              "id": "az104-d1-n03-what",
              "kind": "what",
              "label": "WHAT IT IS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Microsoft Entra B2B collaboration lets an organization invite a partner or guest to access shared resources while the guest normally authenticates with an identity they already own."
              }
            },
            {
              "id": "az104-d1-n03-why",
              "kind": "when",
              "label": "WHY IT MATTERS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "You can collaborate without creating and managing a separate local password for every partner."
              }
            },
            {
              "id": "az104-d1-n03-model",
              "kind": "mental_model",
              "label": "HOW TO THINK ABOUT IT",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "sequence",
                "items": [
                  "Invite the external user",
                  "A guest user object is created in your directory",
                  "The guest redeems the invitation or signs in through the supported flow",
                  "Assign only the group, app, or Azure access the guest needs"
                ]
              }
            },
            {
              "id": "az104-d1-n03-clue",
              "kind": "exam_clue",
              "label": "EXAM / PRACTICAL CLUE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Guest or partner access using an outside organization's credentials points to B2B collaboration and an external/guest user object."
              }
            }
          ],
          "source_refs": [
            {
              "title": "Study guide for Exam AZ-104: Microsoft Azure Administrator",
              "url": "https://learn.microsoft.com/en-us/credentials/certifications/resources/study-guides/az-104"
            },
            {
              "title": "What is Microsoft Entra B2B collaboration?",
              "url": "https://learn.microsoft.com/en-us/entra/external-id/what-is-b2b"
            }
          ],
          "glossary": [
            {
              "term": "B2B",
              "definition": "Business-to-business collaboration: allowing external partner identities to access selected resources."
            }
          ]
        },
        {
          "id": "az104-d1-n04",
          "title": "Self-service password reset (SSPR)",
          "concept_ids": [
            "azure.identity.sspr"
          ],
          "prerequisite_node_ids": [
            "az104-d1-n01"
          ],
          "map_position": {
            "x": 0.69,
            "y": 0.1
          },
          "prompts": [
            {
              "id": "az104-d1-n04-what",
              "kind": "what",
              "label": "WHAT IT IS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Self-service password reset (SSPR) allows enabled users to change or reset their password through a self-service flow instead of requiring an administrator or helpdesk reset."
              }
            },
            {
              "id": "az104-d1-n04-why",
              "kind": "when",
              "label": "WHY IT MATTERS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "SSPR reduces support work while keeping the reset process tied to configured authentication and registration requirements."
              }
            },
            {
              "id": "az104-d1-n04-model",
              "kind": "mental_model",
              "label": "HOW TO THINK ABOUT IT",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "bullets",
                "items": [
                  "Choose which users or groups can use SSPR.",
                  "Users register the required authentication methods.",
                  "A forgotten-password flow verifies the user and resets the password when requirements are met."
                ]
              }
            },
            {
              "id": "az104-d1-n04-clue",
              "kind": "exam_clue",
              "label": "EXAM / PRACTICAL CLUE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "If the goal is “users reset forgotten passwords without helpdesk involvement,” the feature is SSPR. Do not confuse it with Azure RBAC, which controls Azure resource authorization."
              }
            }
          ],
          "source_refs": [
            {
              "title": "Study guide for Exam AZ-104: Microsoft Azure Administrator",
              "url": "https://learn.microsoft.com/en-us/credentials/certifications/resources/study-guides/az-104"
            },
            {
              "title": "Troubleshoot self-service password reset in Microsoft Entra ID",
              "url": "https://learn.microsoft.com/en-us/entra/identity/authentication/troubleshoot-sspr"
            }
          ]
        }
      ]
    },
    {
      "id": "domain-1-module-2",
