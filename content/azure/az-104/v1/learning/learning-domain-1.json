              "required": true,
              "reveal": {
                "type": "text",
                "text": "Cost Management budgets track actual or forecast spend against thresholds and can trigger notifications or configured actions. Azure Advisor analyzes usage and provides recommendations, including cost optimization opportunities."
              }
            },
            {
              "id": "az104-d1-n10-why",
              "kind": "when",
              "label": "WHY IT MATTERS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Budgets tell you when spend approaches a threshold; Advisor helps identify changes that may improve cost efficiency."
              }
            },
            {
              "id": "az104-d1-n10-model",
              "kind": "mental_model",
              "label": "HOW TO THINK ABOUT IT",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "comparison",
                "columns": [
                  {
                    "title": "Budget / cost alert",
                    "items": [
                      "Monitor spending against thresholds",
                      "Notify stakeholders or invoke configured actions"
                    ]
                  },
                  {
                    "title": "Azure Advisor",
                    "items": [
                      "Analyze resource usage",
                      "Recommend cost, reliability, security, performance, and operational improvements"
                    ]
                  }
                ]
              }
            },
