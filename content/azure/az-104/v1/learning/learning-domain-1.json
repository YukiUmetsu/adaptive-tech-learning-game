          },
          "prompts": [
            {
              "id": "az104-d1-n09-what",
              "kind": "what",
              "label": "WHAT IT IS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "An Azure subscription is a resource and billing boundary associated with Azure usage. Management groups sit above subscriptions so governance such as policy and RBAC can be applied across multiple subscriptions."
              }
            },
            {
              "id": "az104-d1-n09-why",
              "kind": "when",
              "label": "WHY IT MATTERS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Large organizations use the hierarchy to avoid configuring the same governance independently on every subscription."
              }
            },
            {
              "id": "az104-d1-n09-model",
              "kind": "mental_model",
              "label": "HOW TO THINK ABOUT IT",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "sequence",
                "items": [
                  "Tenant / directory",
                  "Management group hierarchy",
                  "Subscription",
                  "Resource group",
                  "Resource"
                ]
              }
            },
            {
              "id": "az104-d1-n09-clue",
              "kind": "exam_clue",
              "label": "EXAM / PRACTICAL CLUE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "If one rule or role must apply across several subscriptions, management-group scope is the clue. Resource groups do not contain subscriptions."
              }
            }
          ],
