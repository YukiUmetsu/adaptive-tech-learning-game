      "nodes": [
        {
          "id": "az104-d1-n05",
          "title": "Azure RBAC: principal + role + scope",
          "concept_ids": [
            "azure.governance.rbac"
          ],
          "prerequisite_node_ids": [],
          "map_position": {
            "x": 0.88,
            "y": 0.1
          },
          "prompts": [
            {
              "id": "az104-d1-n05-what",
              "kind": "what",
              "label": "WHAT IT IS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Azure role-based access control (Azure RBAC) is the authorization system for Azure resources. A role assignment grants a role definition to a security principal at a particular scope."
              }
            },
            {
              "id": "az104-d1-n05-why",
              "kind": "when",
              "label": "WHY IT MATTERS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "The three-part model lets you answer who gets access, what they can do, and where they can do it."
              }
            },
            {
              "id": "az104-d1-n05-model",
              "kind": "mental_model",
              "label": "HOW TO THINK ABOUT IT",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "table",
                "columns": [
                  {
                    "id": "part",
                    "label": "Part"
                  },
                  {
                    "id": "question",
                    "label": "Question it answers"
                  },
                  {
                    "id": "example",
                    "label": "Example"
                  }
                ],
                "rows": [
                  {
                    "id": "principal",
                    "cells": {
                      "part": "Security principal",
                      "question": "Who?",
                      "example": "Operations group"
                    }
                  },
                  {
                    "id": "role",
                    "cells": {
                      "part": "Role definition",
                      "question": "What permissions?",
                      "example": "Reader"
                    }
                  },
                  {
                    "id": "scope",
                    "cells": {
                      "part": "Scope",
                      "question": "Where?",
                      "example": "One resource group"
                    }
                  }
                ]
              }
            },
            {
              "id": "az104-d1-n05-clue",
              "kind": "exam_clue",
              "label": "EXAM / PRACTICAL CLUE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Role-assignment questions are usually solved by identifying the principal, least-privilege role, and narrowest required scope separately."
              }
            }
          ],
          "source_refs": [
            {
              "title": "Study guide for Exam AZ-104: Microsoft Azure Administrator",
              "url": "https://learn.microsoft.com/en-us/credentials/certifications/resources/study-guides/az-104"
            },
            {
              "title": "What is Azure role-based access control (Azure RBAC)?",
              "url": "https://learn.microsoft.com/en-us/azure/role-based-access-control/overview"
            },
            {
              "title": "Understand scope for Azure RBAC",
              "url": "https://learn.microsoft.com/en-us/azure/role-based-access-control/scope-overview"
            }
          ],
          "glossary": [
            {
              "term": "Azure RBAC",
              "definition": "Azure role-based access control, the authorization system for Azure resources."
            },
            {
              "term": "scope",
              "definition": "The set of Azure resources to which an assignment applies."
            }
          ]
        },
        {
          "id": "az104-d1-n06",
          "title": "Built-in roles and inherited scope",
          "concept_ids": [
            "azure.governance.rbac"
          ],
          "prerequisite_node_ids": [
            "az104-d1-n05"
          ],
          "map_position": {
            "x": 0.12,
            "y": 0.32
          },
          "prompts": [
            {
              "id": "az104-d1-n06-what",
              "kind": "what",
              "label": "WHAT IT IS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Azure provides built-in roles such as Reader, Contributor, and Owner. Role assignments can be made at management group, subscription, resource group, or resource scope, and permissions flow to child scopes."
              }
            },
            {
              "id": "az104-d1-n06-why",
              "kind": "when",
              "label": "WHY IT MATTERS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Choosing the narrowest sufficient role and scope reduces unnecessary privilege."
              }
            },
            {
              "id": "az104-d1-n06-model",
              "kind": "mental_model",
              "label": "HOW TO THINK ABOUT IT",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "comparison",
                "columns": [
                  {
                    "title": "Reader",
                    "items": [
                      "View resources",
                      "Cannot make management changes"
                    ]
                  },
                  {
                    "title": "Contributor",
                    "items": [
                      "Manage resources",
                      "Does not grant the general ability to assign Azure RBAC roles"
                    ]
                  },
                  {
                    "title": "Owner",
                    "items": [
                      "Manage resources",
                      "Can assign Azure RBAC roles"
                    ]
                  }
                ]
              }
            },
            {
              "id": "az104-d1-n06-clue",
              "kind": "exam_clue",
              "label": "EXAM / PRACTICAL CLUE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "A role assigned at a subscription normally applies to resource groups and resources below it. If only one resource needs access, prefer resource scope when practical."
              }
            }
          ],
          "source_refs": [
            {
              "title": "Study guide for Exam AZ-104: Microsoft Azure Administrator",
              "url": "https://learn.microsoft.com/en-us/credentials/certifications/resources/study-guides/az-104"
            },
            {
              "title": "Azure built-in roles",
              "url": "https://learn.microsoft.com/en-us/azure/role-based-access-control/built-in-roles"
            },
            {
              "title": "Understand scope for Azure RBAC",
              "url": "https://learn.microsoft.com/en-us/azure/role-based-access-control/scope-overview"
            }
          ]
        }
      ]
    },
