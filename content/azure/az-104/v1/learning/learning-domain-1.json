        {
          "id": "az104-d1-n07",
          "title": "Azure Policy: standards and compliance",
          "concept_ids": [
            "azure.governance.policy"
          ],
          "prerequisite_node_ids": [],
          "map_position": {
            "x": 0.31,
            "y": 0.32
          },
          "prompts": [
            {
              "id": "az104-d1-n07-what",
              "kind": "what",
              "label": "WHAT IT IS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Azure Policy compares resource properties and actions against policy rules so you can assess or enforce organizational standards at scale."
              }
            },
            {
              "id": "az104-d1-n07-why",
              "kind": "when",
              "label": "WHY IT MATTERS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Policy can audit noncompliance, deny unwanted deployments, modify supported properties, or help remediate existing resources depending on the policy effect and configuration."
              }
            },
            {
              "id": "az104-d1-n07-model",
              "kind": "mental_model",
              "label": "HOW TO THINK ABOUT IT",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "sequence",
                "items": [
                  "Create or choose a policy definition",
                  "Optionally group definitions in an initiative",
                  "Assign the policy or initiative to a scope",
                  "Review compliance results",
                  "Run remediation when the selected effect supports it"
                ]
              }
            },
            {
              "id": "az104-d1-n07-clue",
              "kind": "exam_clue",
              "label": "EXAM / PRACTICAL CLUE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Azure Policy answers “is this resource configuration allowed/compliant?” Azure RBAC answers “is this identity allowed to perform this action?”"
              }
            }
          ],
          "source_refs": [
            {
