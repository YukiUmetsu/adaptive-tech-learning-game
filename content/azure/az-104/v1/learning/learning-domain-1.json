          ]
        },
        {
          "id": "az104-d1-n08",
          "title": "Resource locks, tags, and resource groups",
          "concept_ids": [
            "azure.governance.locks_tags_rg"
          ],
          "prerequisite_node_ids": [],
          "map_position": {
            "x": 0.5,
            "y": 0.32
          },
          "prompts": [
            {
              "id": "az104-d1-n08-what",
              "kind": "what",
              "label": "WHAT IT IS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Resource groups are lifecycle containers for Azure resources. Tags are key-value metadata used for organization and reporting. Resource locks protect a subscription, resource group, or resource from accidental deletion or modification."
              }
            },
            {
              "id": "az104-d1-n08-why",
              "kind": "when",
              "label": "WHY IT MATTERS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "These controls solve different governance problems: lifecycle grouping, metadata, and protection from management operations."
              }
            },
            {
              "id": "az104-d1-n08-model",
              "kind": "mental_model",
              "label": "HOW TO THINK ABOUT IT",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "table",
                "columns": [
                  {
                    "id": "control",
                    "label": "Control"
                  },
                  {
