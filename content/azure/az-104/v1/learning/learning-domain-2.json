      "nodes": [
        {
          "id": "az104-d2-n09",
          "title": "Azure Files: create, configure, and protect a file share",
          "concept_ids": [
            "azure.storage.files"
          ],
          "prerequisite_node_ids": [],
          "map_position": {
            "x": 0.69,
            "y": 0.32
          },
          "prompts": [
            {
              "id": "az104-d2-n09-what",
              "kind": "what",
              "label": "WHAT IT IS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Azure Files provides managed SMB and NFS file shares. When creating a share, choose a supported protocol and capacity/performance settings for the workload; afterward, share snapshots and soft delete provide different recovery options."
              }
            },
            {
              "id": "az104-d2-n09-why",
              "kind": "when",
              "label": "WHY IT MATTERS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Share configuration controls how clients use the file service, while snapshots and soft delete reduce the impact of accidental changes or deletion."
              }
            },
            {
              "id": "az104-d2-n09-model",
              "kind": "mental_model",
              "label": "HOW TO THINK ABOUT IT",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "table",
                "columns": [
                  {
                    "id": "feature",
                    "label": "Share setting or feature"
                  },
                  {
                    "id": "job",
                    "label": "Primary job"
                  }
                ],
                "rows": [
                  {
                    "id": "protocol",
                    "cells": {
                      "feature": "SMB or NFS protocol",
                      "job": "Choose the client/file-sharing protocol supported by the workload"
                    }
                  },
                  {
                    "id": "quota",
                    "cells": {
                      "feature": "Share quota / capacity setting",
                      "job": "Limit or provision share capacity as supported by the billing model"
                    }
                  },
                  {
                    "id": "snap",
                    "cells": {
                      "feature": "Share snapshot",
                      "job": "Keep a point-in-time, read-only view for file/share recovery"
                    }
                  },
                  {
                    "id": "soft",
                    "cells": {
                      "feature": "File-share soft delete",
                      "job": "Retain a deleted share for a configured recovery period"
                    }
                  },
                  {
                    "id": "backup",
                    "cells": {
                      "feature": "Azure Backup",
                      "job": "Centralize policy-driven backup, retention, monitoring, and restore"
                    }
                  }
                ]
              }
            },
            {
              "id": "az104-d2-n09-clue",
              "kind": "exam_clue",
              "label": "EXAM / PRACTICAL CLUE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Creating/configuring the share is different from protecting it. Snapshot = point-in-time state; soft delete = retention after share deletion; Azure Backup = managed policy and recovery workflow."
              }
            }
