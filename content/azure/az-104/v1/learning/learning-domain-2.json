            }
          ]
        },
        {
          "id": "az104-d2-n07",
          "title": "Azure Storage encryption",
          "concept_ids": [
            "azure.storage.encryption"
          ],
          "prerequisite_node_ids": [],
          "map_position": {
            "x": 0.31,
            "y": 0.32
          },
          "prompts": [
            {
              "id": "az104-d2-n07-what",
              "kind": "what",
              "label": "WHAT IT IS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Azure Storage encrypts data at rest by default using service-side encryption. Depending on the service and configuration, you can use platform-managed keys or configure supported customer-managed-key scenarios."
              }
            },
            {
              "id": "az104-d2-n07-why",
              "kind": "when",
              "label": "WHY IT MATTERS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Encryption protects stored data; it does not decide which identity is allowed to read that data."
              }
            },
            {
              "id": "az104-d2-n07-model",
              "kind": "mental_model",
              "label": "HOW TO THINK ABOUT IT",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "comparison",
                "columns": [
                  {
                    "title": "Encryption",
                    "items": [
                      "Protects data at rest",
                      "Default service-side encryption is always on"
                    ]
                  },
                  {
                    "title": "Authorization",
                    "items": [
                      "Controls who can access data",
                      "Use Microsoft Entra roles, SAS, or other supported authorization"
                    ]
                  }
                ]
              }
            },
            {
              "id": "az104-d2-n07-clue",
              "kind": "exam_clue",
              "label": "EXAM / PRACTICAL CLUE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "If a question asks “who can read the blob,” encryption is not the answer. If it asks who controls encryption keys, look at platform-managed versus customer-managed keys."
              }
            }
          ],
          "source_refs": [
