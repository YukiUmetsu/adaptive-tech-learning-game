              "title": "Create a stored access policy",
              "url": "https://learn.microsoft.com/en-us/azure/storage/common/storage-stored-access-policy-define-dotnet"
            },
            {
              "title": "Secure your Azure Storage account",
              "url": "https://learn.microsoft.com/en-us/azure/storage/common/secure-storage"
            },
            {
              "title": "Manage storage account access keys",
              "url": "https://learn.microsoft.com/en-us/azure/storage/common/storage-account-keys-manage"
            }
          ]
        },
        {
          "id": "az104-d2-n03",
          "title": "Identity-based access for Azure Files",
          "concept_ids": [
            "azure.storage.files_identity"
          ],
          "prerequisite_node_ids": [
            "az104-d2-n02"
          ],
          "map_position": {
            "x": 0.5,
            "y": 0.1
          },
          "prompts": [
            {
              "id": "az104-d2-n03-what",
              "kind": "what",
              "label": "WHAT IT IS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Azure Files SMB shares can use identity-based authentication. Azure RBAC grants share-level permissions, while Windows-style ACLs can control directory and file permissions."
              }
            },
            {
              "id": "az104-d2-n03-why",
              "kind": "when",
              "label": "WHY IT MATTERS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Identity-based access avoids giving end users the storage account key and supports per-user/group authorization."
              }
            },
            {
              "id": "az104-d2-n03-model",
              "kind": "mental_model",
              "label": "HOW TO THINK ABOUT IT",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "bullets",
                "items": [
                  "Enable a supported identity source for SMB authentication.",
                  "Assign an Azure Files data role at the share or suitable scope.",
                  "Use directory/file ACLs for finer-grained file-system permissions."
                ]
              }
            },
            {
              "id": "az104-d2-n03-clue",
              "kind": "exam_clue",
              "label": "EXAM / PRACTICAL CLUE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Do not confuse management-plane Contributor with a data-plane file role. A user may manage a storage account without automatically receiving SMB file data access."
              }
            }
          ],
          "source_refs": [
            {
              "title": "Study guide for Exam AZ-104: Microsoft Azure Administrator",
              "url": "https://learn.microsoft.com/en-us/credentials/certifications/resources/study-guides/az-104"
            },
            {
              "title": "Overview of Azure Files authorization and access control",
              "url": "https://learn.microsoft.com/en-us/azure/storage/files/storage-files-authorization-overview"
            }
          ]
        }
      ]
