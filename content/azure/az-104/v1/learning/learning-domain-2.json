      ],
      "prerequisite_module_ids": [],
      "nodes": [
        {
          "id": "az104-d2-n01",
          "title": "Storage firewalls and virtual-network access",
          "concept_ids": [
            "azure.storage.network_access"
          ],
          "prerequisite_node_ids": [],
          "map_position": {
            "x": 0.12,
            "y": 0.1
          },
          "prompts": [
            {
              "id": "az104-d2-n01-what",
              "kind": "what",
              "label": "WHAT IT IS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Azure Storage network controls decide which networks can reach a storage account endpoint. Firewall rules and virtual-network rules restrict access instead of relying on an open public endpoint."
              }
            },
            {
              "id": "az104-d2-n01-why",
              "kind": "when",
              "label": "WHY IT MATTERS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Network restrictions reduce exposure, but they do not replace data-plane authorization such as Microsoft Entra roles or SAS."
              }
            },
            {
              "id": "az104-d2-n01-model",
              "kind": "mental_model",
              "label": "HOW TO THINK ABOUT IT",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "bullets",
                "items": [
                  "Choose public network access behavior.",
                  "Add allowed IP or virtual-network rules when public endpoints remain in use.",
                  "Use private endpoints when the requirement is a private IP for the storage service."
                ]
              }
            },
            {
              "id": "az104-d2-n01-clue",
              "kind": "exam_clue",
              "label": "EXAM / PRACTICAL CLUE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "If a request reaches the endpoint but receives authorization failure, investigate identity/credentials. If the request cannot reach the endpoint, investigate network rules first."
              }
            }
          ],
          "source_refs": [
            {
              "title": "Study guide for Exam AZ-104: Microsoft Azure Administrator",
              "url": "https://learn.microsoft.com/en-us/credentials/certifications/resources/study-guides/az-104"
            },
            {
              "title": "Secure your Azure Storage account",
              "url": "https://learn.microsoft.com/en-us/azure/storage/common/secure-storage"
            }
          ]
        },
        {
          "id": "az104-d2-n02",
          "title": "SAS tokens, stored access policies, and account keys",
          "concept_ids": [
            "azure.storage.delegated_access"
          ],
          "prerequisite_node_ids": [],
          "map_position": {
            "x": 0.31,
            "y": 0.1
          },
          "prompts": [
            {
              "id": "az104-d2-n02-what",
              "kind": "what",
              "label": "WHAT IT IS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "A shared access signature (SAS) delegates limited access to storage resources. A stored access policy can centrally change or revoke supported service SAS constraints. Storage account keys are broad shared secrets with full account-level power."
              }
            },
            {
              "id": "az104-d2-n02-why",
              "kind": "when",
              "label": "WHY IT MATTERS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "The safest design gives the smallest permissions for the shortest useful time and avoids distributing long-lived account keys."
              }
            },
            {
              "id": "az104-d2-n02-model",
              "kind": "mental_model",
              "label": "HOW TO THINK ABOUT IT",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "table",
                "columns": [
                  {
                    "id": "method",
                    "label": "Method"
                  },
                  {
                    "id": "scope",
                    "label": "What to remember"
                  },
                  {
                    "id": "control",
                    "label": "Operational clue"
                  }
                ],
                "rows": [
                  {
                    "id": "udsas",
                    "cells": {
                      "method": "User delegation SAS",
                      "scope": "Signed from Microsoft Entra authorization",
                      "control": "Preferred for Blob SAS when possible"
                    }
                  },
                  {
                    "id": "servicesas",
                    "cells": {
                      "method": "Service SAS",
                      "scope": "Targets one storage service/resource scope",
                      "control": "Can reference a stored access policy"
                    }
                  },
                  {
                    "id": "key",
                    "cells": {
                      "method": "Account key",
                      "scope": "Broad Shared Key credential",
                      "control": "Two account keys support rotation without planned downtime when applications are switched between them"
                    }
                  }
                ]
              }
            },
            {
              "id": "az104-d2-n02-clue",
              "kind": "exam_clue",
              "label": "EXAM / PRACTICAL CLUE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Stored access policies apply to service SAS, not account SAS or user-delegation SAS. Account keys grant broad Shared Key access: protect them, avoid hard-coding them, and rotate them by moving clients to the other valid key before regenerating the unused key."
              }
            }
          ],
          "source_refs": [
            {
              "title": "Study guide for Exam AZ-104: Microsoft Azure Administrator",
              "url": "https://learn.microsoft.com/en-us/credentials/certifications/resources/study-guides/az-104"
            },
