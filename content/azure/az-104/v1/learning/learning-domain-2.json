            }
          ]
        },
        {
          "id": "az104-d2-n05",
          "title": "Storage redundancy: local, zone, and geo protection",
          "concept_ids": [
            "azure.storage.redundancy"
          ],
          "prerequisite_node_ids": [],
          "map_position": {
            "x": 0.88,
            "y": 0.1
          },
          "prompts": [
            {
              "id": "az104-d2-n05-what",
              "kind": "what",
              "label": "WHAT IT IS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Azure Storage redundancy keeps multiple copies of data. LRS protects within one datacenter, ZRS spreads copies across availability zones in one region, and geo-redundant options also replicate to a secondary region."
              }
            },
            {
              "id": "az104-d2-n05-why",
              "kind": "when",
              "label": "WHY IT MATTERS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Choose redundancy according to the failure you must survive, not simply by picking the option with the most letters."
              }
            },
            {
              "id": "az104-d2-n05-model",
              "kind": "mental_model",
              "label": "HOW TO THINK ABOUT IT",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "table",
                "columns": [
                  {
                    "id": "option",
                    "label": "Option family"
                  },
                  {
                    "id": "protects",
                    "label": "Primary failure scope"
                  },
                  {
                    "id": "read",
                    "label": "Secondary-region reads"
                  }
                ],
                "rows": [
                  {
                    "id": "lrs",
                    "cells": {
                      "option": "LRS",
                      "protects": "Local hardware/datacenter faults",
                      "read": "No secondary region"
                    }
                  },
                  {
                    "id": "zrs",
                    "cells": {
                      "option": "ZRS",
                      "protects": "Availability-zone failure in primary region",
                      "read": "No secondary region"
                    }
                  },
                  {
                    "id": "grs",
                    "cells": {
                      "option": "GRS / GZRS",
                      "protects": "Adds asynchronous geo-replication",
                      "read": "Secondary read not exposed unless RA variant"
                    }
                  },
                  {
                    "id": "ra",
                    "cells": {
                      "option": "RA-GRS / RA-GZRS",
                      "protects": "Geo-replication",
                      "read": "Read access to secondary endpoint"
                    }
                  }
                ]
              }
            },
            {
              "id": "az104-d2-n05-clue",
              "kind": "exam_clue",
              "label": "EXAM / PRACTICAL CLUE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "The “RA” prefix is the clue for read access to the secondary replica. GZRS combines zone redundancy in the primary region with geo-replication."
              }
            }
          ],
          "source_refs": [
            {
              "title": "Study guide for Exam AZ-104: Microsoft Azure Administrator",
              "url": "https://learn.microsoft.com/en-us/credentials/certifications/resources/study-guides/az-104"
            },
            {
              "title": "Azure Storage redundancy",
              "url": "https://learn.microsoft.com/en-us/azure/storage/common/storage-redundancy"
            }
          ]
        },
        {
          "id": "az104-d2-n06",
          "title": "Object replication for block blobs",
          "concept_ids": [
            "azure.storage.object_replication"
          ],
          "prerequisite_node_ids": [],
          "map_position": {
            "x": 0.12,
            "y": 0.32
          },
          "prompts": [
            {
              "id": "az104-d2-n06-what",
              "kind": "what",
              "label": "WHAT IT IS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Object replication asynchronously copies block blobs from a source storage account to a destination account according to replication policies and rules."
              }
            },
            {
              "id": "az104-d2-n06-why",
              "kind": "when",
              "label": "WHY IT MATTERS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "It is useful when separate accounts or regions need replicated blob copies for distribution, processing, or lower read latency."
              }
            },
            {
              "id": "az104-d2-n06-model",
              "kind": "mental_model",
              "label": "HOW TO THINK ABOUT IT",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "bullets",
                "items": [
                  "Configure source and destination accounts.",
                  "Blob versioning is required on both source and destination accounts.",
                  "The blob change feed is required on the source account.",
                  "Replication is asynchronous, so the destination can lag behind the source."
                ]
              }
            },
            {
              "id": "az104-d2-n06-clue",
              "kind": "exam_clue",
              "label": "EXAM / PRACTICAL CLUE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Do not confuse object replication with storage-account GRS/GZRS. Object replication is policy-driven replication between storage accounts and gives you a destination account you manage."
              }
            }
          ],
          "source_refs": [
            {
              "title": "Study guide for Exam AZ-104: Microsoft Azure Administrator",
              "url": "https://learn.microsoft.com/en-us/credentials/certifications/resources/study-guides/az-104"
            },
            {
