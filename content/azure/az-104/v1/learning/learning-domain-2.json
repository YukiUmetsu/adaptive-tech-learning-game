              "required": true,
              "reveal": {
                "type": "text",
                "text": "Azure Storage Explorer is a graphical desktop tool for working with Azure Storage data. AzCopy is a command-line utility optimized for copying data to, from, or between storage accounts."
              }
            },
            {
              "id": "az104-d2-n08-why",
              "kind": "when",
              "label": "WHY IT MATTERS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "The tools can manage or move storage data without requiring you to write a custom application."
              }
            },
            {
              "id": "az104-d2-n08-model",
              "kind": "mental_model",
              "label": "HOW TO THINK ABOUT IT",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "comparison",
                "columns": [
                  {
                    "title": "Storage Explorer",
                    "items": [
                      "Graphical interface",
                      "Browse and manage storage data interactively"
                    ]
                  },
                  {
                    "title": "AzCopy",
                    "items": [
                      "Command-line utility",
                      "Scriptable, high-performance data transfers"
                    ]
                  }
                ]
              }
            },
            {
              "id": "az104-d2-n08-clue",
              "kind": "exam_clue",
              "label": "EXAM / PRACTICAL CLUE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "GUI administration points to Storage Explorer. Repeatable command-line bulk transfer points to AzCopy."
              }
            }
          ],
