      "nodes": [
        {
          "id": "az104-d2-n04",
          "title": "Storage account configuration",
          "concept_ids": [
            "azure.storage.accounts"
          ],
          "prerequisite_node_ids": [],
          "map_position": {
            "x": 0.69,
            "y": 0.1
          },
          "prompts": [
            {
              "id": "az104-d2-n04-what",
              "kind": "what",
              "label": "WHAT IT IS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "A storage account is the Azure resource that provides a namespace and configuration boundary for storage services such as blobs and files."
              }
            },
            {
              "id": "az104-d2-n04-why",
              "kind": "when",
              "label": "WHY IT MATTERS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Account-level choices such as region, redundancy, networking, performance, and security affect every service hosted by that account."
              }
            },
            {
              "id": "az104-d2-n04-model",
              "kind": "mental_model",
              "label": "HOW TO THINK ABOUT IT",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "bullets",
                "items": [
                  "Choose subscription/resource group and region.",
                  "Choose supported performance and redundancy settings for the workload.",
                  "Configure networking and data-protection/security settings before production use."
                ]
              }
            },
            {
              "id": "az104-d2-n04-clue",
              "kind": "exam_clue",
              "label": "EXAM / PRACTICAL CLUE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "When a scenario changes account-wide behavior, look at the storage account configuration rather than one individual blob or file share."
              }
            }
          ],
          "source_refs": [
            {
              "title": "Study guide for Exam AZ-104: Microsoft Azure Administrator",
              "url": "https://learn.microsoft.com/en-us/credentials/certifications/resources/study-guides/az-104"
