        {
          "id": "az104-d2-n08",
          "title": "Storage Explorer and AzCopy",
          "concept_ids": [
            "azure.storage.tools"
          ],
          "prerequisite_node_ids": [],
          "map_position": {
            "x": 0.5,
            "y": 0.32
          },
          "prompts": [
            {
              "id": "az104-d2-n08-what",
              "kind": "what",
