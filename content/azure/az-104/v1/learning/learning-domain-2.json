            }
          ]
        },
        {
          "id": "az104-d2-n11",
          "title": "Blob/container soft delete, versioning, and lifecycle management",
          "concept_ids": [
            "azure.storage.blob_protection"
          ],
          "prerequisite_node_ids": [],
          "map_position": {
            "x": 0.12,
            "y": 0.54
          },
          "prompts": [
            {
              "id": "az104-d2-n11-what",
              "kind": "what",
              "label": "WHAT IT IS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Blob soft delete retains deleted blob data for a retention period. Container soft delete can restore a deleted container and its contents during its retention period. Blob versioning preserves previous blob versions when supported. Lifecycle management applies rules that can tier or delete matching blobs and versions over time."
              }
            },
            {
              "id": "az104-d2-n11-why",
              "kind": "when",
              "label": "WHY IT MATTERS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "These controls protect against different loss/change scenarios and automate data aging, so they are often combined rather than treated as substitutes."
              }
            },
            {
              "id": "az104-d2-n11-model",
              "kind": "mental_model",
              "label": "HOW TO THINK ABOUT IT",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "table",
                "columns": [
                  {
                    "id": "feature",
                    "label": "Feature"
                  },
                  {
                    "id": "job",
                    "label": "Primary job"
                  }
                ],
                "rows": [
                  {
                    "id": "blobsoft",
                    "cells": {
                      "feature": "Blob soft delete",
                      "job": "Recover recently deleted blob data during retention"
                    }
                  },
                  {
                    "id": "containersoft",
                    "cells": {
                      "feature": "Container soft delete",
                      "job": "Recover an accidentally deleted container during retention"
                    }
                  },
                  {
                    "id": "ver",
                    "cells": {
                      "feature": "Blob versioning",
                      "job": "Keep prior blob versions after writes/changes"
                    }
                  },
                  {
                    "id": "life",
                    "cells": {
                      "feature": "Lifecycle management",
                      "job": "Automate tier transitions or deletion based on rules"
                    }
                  }
                ]
              }
            },
            {
              "id": "az104-d2-n11-clue",
              "kind": "exam_clue",
              "label": "EXAM / PRACTICAL CLUE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Soft delete protects deletion scenarios, versioning preserves history after blob changes, and lifecycle management is automation. None of these is the same as a manual restore operation."
              }
            }
          ],
