        {
          "id": "az104-d2-n10",
          "title": "Blob containers and access tiers",
          "concept_ids": [
            "azure.storage.blobs_tiers"
          ],
          "prerequisite_node_ids": [],
          "map_position": {
            "x": 0.88,
            "y": 0.32
          },
          "prompts": [
            {
              "id": "az104-d2-n10-what",
              "kind": "what",
              "label": "WHAT IT IS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "A blob container organizes blobs within a storage account. When creating a container, give it a valid name and choose an appropriate access level; private access is the normal choice unless anonymous access is explicitly required and allowed. Blob access tiers separately control the storage/access trade-off for blob data."
              }
            },
            {
              "id": "az104-d2-n10-why",
              "kind": "when",
              "label": "WHY IT MATTERS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Container configuration controls the data namespace and access posture. Blob tiers control cost and retrieval behavior according to how frequently data is used."
              }
            },
            {
              "id": "az104-d2-n10-model",
              "kind": "mental_model",
              "label": "HOW TO THINK ABOUT IT",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "table",
                "columns": [
                  {
                    "id": "item",
                    "label": "Setting"
                  },
                  {
                    "id": "purpose",
                    "label": "What it controls"
                  }
                ],
                "rows": [
                  {
                    "id": "container",
                    "cells": {
                      "item": "Container",
                      "purpose": "Logical collection/namespace for blobs"
                    }
                  },
                  {
                    "id": "access",
                    "cells": {
                      "item": "Container access level",
                      "purpose": "Whether anonymous read access is permitted when account settings allow it; keep private unless public access is required"
                    }
                  },
                  {
                    "id": "hot",
                    "cells": {
                      "item": "Hot tier",
                      "purpose": "Frequently accessed online data"
                    }
                  },
                  {
                    "id": "cool",
                    "cells": {
                      "item": "Cool / cold tiers",
                      "purpose": "Less frequently accessed online data"
                    }
                  },
                  {
                    "id": "archive",
                    "cells": {
                      "item": "Archive tier",
                      "purpose": "Offline archival data that must be rehydrated before normal reads"
                    }
                  }
                ]
              }
            },
            {
              "id": "az104-d2-n10-clue",
              "kind": "exam_clue",
              "label": "EXAM / PRACTICAL CLUE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Do not confuse container access with blob tier. Access level answers who can read anonymously; tier answers how the blob is stored and retrieved for cost/latency."
              }
            }
          ],
          "source_refs": [
            {
              "title": "Study guide for Exam AZ-104: Microsoft Azure Administrator",
