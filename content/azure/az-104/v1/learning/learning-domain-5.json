      "nodes": [
        {
          "id": "az104-d5-n01",
          "title": "Metrics, logs, and Azure Monitor",
          "concept_ids": [
            "azure.monitor.signals"
          ],
          "prerequisite_node_ids": [],
          "map_position": {
            "x": 0.12,
            "y": 0.1
          },
          "prompts": [
            {
              "id": "az104-d5-n01-what",
              "kind": "what",
              "label": "WHAT IT IS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Azure Monitor collects monitoring data about Azure resources and applications. Metrics are lightweight numeric time-series values; logs are records that can carry richer structured detail and are queried for investigation and analysis."
              }
            },
            {
              "id": "az104-d5-n01-why",
              "kind": "when",
              "label": "WHY IT MATTERS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Choosing the right signal lets you answer the right question quickly: “how much/how many?” often fits metrics, while “what exactly happened?” often needs logs."
              }
            },
            {
              "id": "az104-d5-n01-model",
              "kind": "mental_model",
              "label": "HOW TO THINK ABOUT IT",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "comparison",
                "columns": [
                  {
                    "title": "Metrics",
                    "items": [
                      "Numeric time-series measurements",
                      "Efficient for thresholds, charts, and near-real-time alert conditions",
                      "Examples: CPU percentage, request count"
                    ]
                  },
                  {
                    "title": "Logs",
                    "items": [
                      "Structured/semi-structured records",
                      "Queried for detailed investigation/correlation",
                      "Examples: resource logs, activity or application records routed to a workspace"
                    ]
                  }
                ]
              }
            },
            {
              "id": "az104-d5-n01-clue",
              "kind": "exam_clue",
              "label": "EXAM / PRACTICAL CLUE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "A graph of CPU over time points to metrics. Searching many detailed records by fields/time points to logs."
              }
            }
          ],
          "source_refs": [
            {
              "title": "Study guide for Exam AZ-104: Microsoft Azure Administrator",
              "url": "https://learn.microsoft.com/en-us/credentials/certifications/resources/study-guides/az-104"
            },
            {
              "title": "Diagnostic settings in Azure Monitor",
              "url": "https://learn.microsoft.com/en-us/azure/azure-monitor/platform/diagnostic-settings"
            },
            {
              "title": "Log queries in Azure Monitor",
              "url": "https://learn.microsoft.com/en-us/azure/azure-monitor/logs/log-query-overview"
            }
          ]
        },
        {
          "id": "az104-d5-n02",
          "title": "Diagnostic settings and Log Analytics",
          "concept_ids": [
            "azure.monitor.diagnostic"
          ],
          "prerequisite_node_ids": [
            "az104-d5-n01"
          ],
          "map_position": {
            "x": 0.31,
            "y": 0.1
          },
          "prompts": [
            {
              "id": "az104-d5-n02-what",
              "kind": "what",
              "label": "WHAT IT IS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "A diagnostic setting routes supported platform logs and metrics from an Azure resource to configured destinations such as a Log Analytics workspace, storage account, or event streaming destination. Log Analytics stores/query data using Kusto Query Language (KQL)."
              }
            },
            {
              "id": "az104-d5-n02-why",
              "kind": "when",
              "label": "WHY IT MATTERS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Resources do not automatically send every resource log to the workspace you want. Diagnostic settings establish that route."
              }
            },
            {
              "id": "az104-d5-n02-model",
              "kind": "mental_model",
              "label": "HOW TO THINK ABOUT IT",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "sequence",
                "items": [
                  "Choose the resource and supported log/metric categories",
                  "Create a diagnostic setting",
                  "Select the destination such as Log Analytics",
                  "Generate/collect data",
                  "Query the workspace with KQL and validate retention/access"
                ]
              }
            },
            {
              "id": "az104-d5-n02-clue",
              "kind": "exam_clue",
              "label": "EXAM / PRACTICAL CLUE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "If a Log Analytics query returns no resource logs, first confirm the resource category is enabled in a diagnostic setting and routed to that workspace."
              }
            }
          ],
          "source_refs": [
            {
              "title": "Study guide for Exam AZ-104: Microsoft Azure Administrator",
              "url": "https://learn.microsoft.com/en-us/credentials/certifications/resources/study-guides/az-104"
            },
            {
              "title": "Diagnostic settings in Azure Monitor",
              "url": "https://learn.microsoft.com/en-us/azure/azure-monitor/platform/diagnostic-settings"
            },
            {
              "title": "Log queries in Azure Monitor",
              "url": "https://learn.microsoft.com/en-us/azure/azure-monitor/logs/log-query-overview"
            }
          ],
          "glossary": [
            {
              "term": "KQL",
              "definition": "Kusto Query Language, the query language used to analyze log data in Azure Monitor Logs."
            }
          ]
        },
        {
          "id": "az104-d5-n03",
          "title": "Alerts, action groups, and processing rules",
          "concept_ids": [
            "azure.monitor.alerting"
          ],
          "prerequisite_node_ids": [],
          "map_position": {
            "x": 0.5,
            "y": 0.1
          },
          "prompts": [
            {
              "id": "az104-d5-n03-what",
              "kind": "what",
              "label": "WHAT IT IS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "An Azure Monitor alert rule evaluates a condition against a signal. An action group contains notification or automation actions. Alert processing rules can add/suppress action groups or control notification behavior for matching alerts, including scheduled suppression scenarios."
              }
            },
            {
              "id": "az104-d5-n03-why",
              "kind": "when",
              "label": "WHY IT MATTERS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Keeping the condition and the response separate makes one action group reusable across many alert rules and lets maintenance windows suppress noise without deleting monitoring."
              }
            },
            {
              "id": "az104-d5-n03-model",
              "kind": "mental_model",
              "label": "HOW TO THINK ABOUT IT",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "table",
                "columns": [
                  {
                    "id": "part",
                    "label": "Part"
                  },
                  {
                    "id": "job",
                    "label": "Primary job"
                  },
                  {
                    "id": "clue",
                    "label": "Clue"
                  }
                ],
                "rows": [
                  {
                    "id": "rule",
                    "cells": {
                      "part": "Alert rule",
                      "job": "Decide when a condition is met",
                      "clue": "CPU > threshold, log query matches"
                    }
                  },
                  {
                    "id": "group",
                    "cells": {
                      "part": "Action group",
                      "job": "Notify or invoke an action",
                      "clue": "Email, SMS, webhook, automation target"
                    }
                  },
                  {
                    "id": "processing",
                    "cells": {
                      "part": "Alert processing rule",
                      "job": "Modify/suppress actions for matching fired alerts",
                      "clue": "Maintenance-window notification suppression"
                    }
                  }
                ]
              }
            },
            {
              "id": "az104-d5-n03-clue",
              "kind": "exam_clue",
              "label": "EXAM / PRACTICAL CLUE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "If the metric threshold is correct but notifications must be muted during maintenance, use alert-processing behavior rather than deleting the alert rule."
              }
            }
          ],
          "source_refs": [
            {
              "title": "Study guide for Exam AZ-104: Microsoft Azure Administrator",
              "url": "https://learn.microsoft.com/en-us/credentials/certifications/resources/study-guides/az-104"
            },
            {
              "title": "Overview of Azure Monitor alerts",
