        {
          "id": "az104-d5-n09",
          "title": "Backup monitoring, reports, and alerts",
          "concept_ids": [
            "azure.backup.monitoring"
          ],
          "prerequisite_node_ids": [
            "az104-d5-n07"
          ],
          "map_position": {
            "x": 0.69,
            "y": 0.32
          },
          "prompts": [
            {
              "id": "az104-d5-n09-what",
              "kind": "what",
              "label": "WHAT IT IS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Azure Backup monitoring surfaces protection status, job results, and alerts; reporting helps administrators review trends and protection posture across backup estates."
              }
            },
            {
              "id": "az104-d5-n09-why",
              "kind": "when",
              "label": "WHY IT MATTERS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "A silent backup failure is discovered at the worst possible time. Monitoring makes failed or stale protection visible before recovery is needed."
              }
            },
            {
              "id": "az104-d5-n09-model",
              "kind": "mental_model",
              "label": "HOW TO THINK ABOUT IT",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "bullets",
                "items": [
                  "Review failed/warning backup jobs and alerts.",
                  "Track protected instances and recovery-point health.",
                  "Use reporting/workbooks as appropriate for estate-level trends and compliance views.",
                  "Route operational notifications to the team responsible for remediation."
                ]
              }
            },
            {
              "id": "az104-d5-n09-clue",
              "kind": "exam_clue",
              "label": "EXAM / PRACTICAL CLUE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "If the requirement is “know when backup protection fails,” configure/monitor backup alerts and jobs rather than waiting for a restore request."
              }
            }
