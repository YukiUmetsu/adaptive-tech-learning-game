            },
            {
              "title": "Action groups in Azure Monitor",
              "url": "https://learn.microsoft.com/en-us/azure/azure-monitor/alerts/action-groups"
            }
          ]
        },
        {
          "id": "az104-d5-n04",
          "title": "Insights for VMs, storage, and networks",
          "concept_ids": [
            "azure.monitor.insights"
          ],
          "prerequisite_node_ids": [],
          "map_position": {
            "x": 0.69,
            "y": 0.1
          },
          "prompts": [
            {
              "id": "az104-d5-n04-what",
              "kind": "what",
              "label": "WHAT IT IS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Azure Monitor Insights are curated monitoring experiences that combine relevant metrics, logs, visualizations, and dependency/health views for particular resource types or solutions."
              }
            },
            {
              "id": "az104-d5-n04-why",
              "kind": "when",
              "label": "WHY IT MATTERS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Insights reduce the work of building every monitoring view from scratch while still using Azure Monitor data underneath."
              }
            },
            {
              "id": "az104-d5-n04-model",
              "kind": "mental_model",
              "label": "HOW TO THINK ABOUT IT",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "bullets",
                "items": [
                  "VM insights focuses on virtual-machine performance and dependencies when configured.",
                  "Storage insights summarizes storage-account health/performance/usage signals.",
                  "Network insights provides topology and health views for supported network resources."
                ]
              }
            },
            {
              "id": "az104-d5-n04-clue",
              "kind": "exam_clue",
              "label": "EXAM / PRACTICAL CLUE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "A request for a built-in, resource-specific monitoring workbook/experience often points to an Insight rather than a custom dashboard built from zero."
              }
            }
          ],
          "source_refs": [
            {
              "title": "Study guide for Exam AZ-104: Microsoft Azure Administrator",
              "url": "https://learn.microsoft.com/en-us/credentials/certifications/resources/study-guides/az-104"
            },
            {
              "title": "Network insights",
