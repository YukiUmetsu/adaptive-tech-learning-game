      "nodes": [
        {
          "id": "az104-d5-n06",
          "title": "Recovery Services vaults and Backup vaults",
          "concept_ids": [
            "azure.backup.vaults"
          ],
          "prerequisite_node_ids": [],
          "map_position": {
            "x": 0.12,
            "y": 0.32
          },
          "prompts": [
            {
              "id": "az104-d5-n06-what",
              "kind": "what",
              "label": "WHAT IT IS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Azure Backup stores protection configuration and recovery points in Azure-managed vault resources. Recovery Services vaults and Backup vaults support different workload sets, so the administrator chooses the vault type supported by the workload being protected."
              }
            },
            {
              "id": "az104-d5-n06-why",
              "kind": "when",
              "label": "WHY IT MATTERS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "The vault is the management boundary for backup policies, protected items, recovery points, security settings, and monitoring for its supported scenarios."
              }
            },
            {
              "id": "az104-d5-n06-model",
              "kind": "mental_model",
              "label": "HOW TO THINK ABOUT IT",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "comparison",
                "columns": [
                  {
                    "title": "Recovery Services vault",
                    "items": [
                      "Established Azure Backup vault for workloads such as Azure VM and supported in-VM/file scenarios",
                      "Also used by Azure Site Recovery for supported replication scenarios"
                    ]
                  },
                  {
                    "title": "Backup vault",
                    "items": [
                      "Newer Azure Backup vault resource used by supported modern workloads",
                      "Use the workload support matrix rather than assuming every workload can use either vault"
                    ]
                  }
                ]
              }
            },
            {
              "id": "az104-d5-n06-clue",
              "kind": "exam_clue",
              "label": "EXAM / PRACTICAL CLUE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Do not select a vault only by name. First identify the workload and then choose the vault type Azure Backup supports for that workload."
              }
            }
          ],
          "source_refs": [
            {
              "title": "Study guide for Exam AZ-104: Microsoft Azure Administrator",
              "url": "https://learn.microsoft.com/en-us/credentials/certifications/resources/study-guides/az-104"
            },
            {
              "title": "What is Azure Backup?",
              "url": "https://learn.microsoft.com/en-us/azure/backup/backup-overview"
            },
            {
              "title": "Recovery Services vaults overview",
              "url": "https://learn.microsoft.com/en-us/azure/backup/backup-azure-recovery-services-vault-overview"
            }
          ]
        },
        {
          "id": "az104-d5-n07",
          "title": "Backup policies, backup jobs, and restore",
          "concept_ids": [
            "azure.backup.policy"
          ],
          "prerequisite_node_ids": [
            "az104-d5-n06"
          ],
          "map_position": {
            "x": 0.31,
            "y": 0.32
          },
          "prompts": [
            {
              "id": "az104-d5-n07-what",
              "kind": "what",
              "label": "WHAT IT IS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "An Azure Backup policy defines when backups run and how long recovery points are retained for a supported workload. Backup jobs create recovery points; restore operations use those recovery points to recover data or resources."
              }
            },
            {
              "id": "az104-d5-n07-why",
              "kind": "when",
              "label": "WHY IT MATTERS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "A backup is valuable only if the schedule/retention meet the recovery requirement and restores are tested."
              }
            },
            {
              "id": "az104-d5-n07-model",
              "kind": "mental_model",
              "label": "HOW TO THINK ABOUT IT",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "sequence",
                "items": [
                  "Choose the supported vault/workload",
                  "Create or select a backup policy",
                  "Enable protection for the resource",
                  "Monitor backup jobs and recovery points",
                  "Perform and validate restores when needed"
                ]
              }
            },
            {
              "id": "az104-d5-n07-clue",
              "kind": "exam_clue",
              "label": "EXAM / PRACTICAL CLUE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "RPO-like requirements drive backup frequency; retention requirements drive how long recovery points are kept. A policy does not replace restore testing."
              }
            }
          ],
          "source_refs": [
            {
              "title": "Study guide for Exam AZ-104: Microsoft Azure Administrator",
              "url": "https://learn.microsoft.com/en-us/credentials/certifications/resources/study-guides/az-104"
            },
            {
              "title": "What is Azure Backup?",
              "url": "https://learn.microsoft.com/en-us/azure/backup/backup-overview"
            },
            {
              "title": "Recovery Services vaults overview",
              "url": "https://learn.microsoft.com/en-us/azure/backup/backup-azure-recovery-services-vault-overview"
            }
          ]
        },
        {
          "id": "az104-d5-n08",
          "title": "Azure Site Recovery and regional failover",
          "concept_ids": [
            "azure.recovery.site_recovery"
          ],
          "prerequisite_node_ids": [],
          "map_position": {
            "x": 0.5,
            "y": 0.32
          },
          "prompts": [
            {
              "id": "az104-d5-n08-what",
              "kind": "what",
              "label": "WHAT IT IS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Azure Site Recovery (ASR) is a disaster-recovery service that replicates supported workloads and orchestrates failover to a secondary location, with planned/unplanned failover and failback workflows where supported."
              }
            },
            {
              "id": "az104-d5-n08-why",
              "kind": "when",
              "label": "WHY IT MATTERS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "ASR solves continuity of a running workload after a site/region failure; Azure Backup solves recovery from retained backup points. They complement each other but are not interchangeable."
              }
            },
            {
              "id": "az104-d5-n08-model",
              "kind": "mental_model",
              "label": "HOW TO THINK ABOUT IT",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "comparison",
                "columns": [
                  {
                    "title": "Azure Backup",
                    "items": [
                      "Point-in-time recovery copies",
                      "Recover deleted/corrupted data or a resource from a recovery point",
                      "Retention-focused protection"
                    ]
                  },
                  {
                    "title": "Azure Site Recovery",
                    "items": [
                      "Replicated standby workload/location",
                      "Orchestrated failover and failback",
                      "Continuity-focused disaster recovery"
                    ]
                  }
                ]
              }
            },
            {
              "id": "az104-d5-n08-clue",
              "kind": "exam_clue",
              "label": "EXAM / PRACTICAL CLUE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "“Fail over the application to a secondary Azure region” is a Site Recovery clue. “Restore last night’s VM backup” is an Azure Backup clue."
              }
            }
          ],
