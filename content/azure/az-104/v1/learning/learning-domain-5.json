              "title": "Diagnostic settings in Azure Monitor",
              "url": "https://learn.microsoft.com/en-us/azure/azure-monitor/platform/diagnostic-settings"
            }
          ]
        },
        {
          "id": "az104-d5-n05",
          "title": "Network Watcher and Connection Monitor",
          "concept_ids": [
            "azure.monitor.network"
          ],
          "prerequisite_node_ids": [],
          "map_position": {
            "x": 0.88,
            "y": 0.1
          },
          "prompts": [
            {
              "id": "az104-d5-n05-what",
              "kind": "what",
              "label": "WHAT IT IS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Network Watcher provides Azure networking monitoring and diagnostic tools. Connection Monitor continuously tests and records connectivity between chosen sources and destinations so you can observe reachability and latency over time."
              }
            },
            {
              "id": "az104-d5-n05-why",
              "kind": "when",
              "label": "WHY IT MATTERS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "These tools provide network-path evidence beyond a single resource configuration page."
              }
            },
            {
              "id": "az104-d5-n05-model",
              "kind": "mental_model",
              "label": "HOW TO THINK ABOUT IT",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "comparison",
                "columns": [
                  {
                    "title": "Network Watcher diagnostics",
                    "items": [
                      "Inspect IP flow/security, next hop, topology, packet capture and other supported diagnostics",
                      "Useful for point-in-time path investigation"
                    ]
                  },
                  {
                    "title": "Connection Monitor",
                    "items": [
                      "Continuously test selected endpoint paths",
                      "Track reachability/latency and detect changes over time"
                    ]
                  }
                ]
              }
            },
            {
              "id": "az104-d5-n05-clue",
              "kind": "exam_clue",
              "label": "EXAM / PRACTICAL CLUE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "If the requirement is ongoing endpoint-to-endpoint reachability monitoring, Connection Monitor is the clue. For a specific next-hop/security decision, use the corresponding Network Watcher diagnostic."
              }
            }
          ],
          "source_refs": [
