  "concepts": [
    {
      "id": "azure.network.vnet_subnet",
      "name": "Virtual networks and subnets",
      "description": "Create address spaces and subnet boundaries that provide private IP networking for Azure resources."
    },
    {
      "id": "azure.network.peering",
      "name": "Virtual network peering",
      "description": "Privately connect Azure VNets over the Microsoft backbone while keeping each VNet as its own routing domain."
    },
    {
      "id": "azure.network.public_ip",
      "name": "Public IP addresses",
      "description": "Assign stable public addressing to supported Azure front ends/resources when Internet-reachable endpoints are required."
    },
    {
      "id": "azure.network.routing",
      "name": "Azure routing and user-defined routes",
      "description": "Understand system routes and customize subnet forwarding with route tables and user-defined routes."
    },
    {
      "id": "azure.network.nsg_asg",
      "name": "Network security groups and application security groups",
      "description": "Filter stateful network traffic with NSG rules and group VM NICs logically with ASGs."
    },
    {
      "id": "azure.network.bastion",
      "name": "Azure Bastion",
      "description": "Provide managed browser/client RDP and SSH access to VMs without requiring each target VM to have a public IP."
    },
    {
      "id": "azure.network.paas_access",
      "name": "Service endpoints and private endpoints",
      "description": "Choose between extending VNet identity to a public PaaS endpoint and giving a PaaS resource a private IP via Private Link."
    },
    {
      "id": "azure.network.dns",
      "name": "Azure DNS",
      "description": "Host DNS zones/records and provide name resolution without confusing DNS hosting with domain-name registration."
    },
    {
      "id": "azure.network.load_balancer",
      "name": "Azure Load Balancer",
      "description": "Distribute Layer 4 TCP/UDP traffic across healthy backend instances using public or internal front ends and health probes."
    },
    {
      "id": "azure.network.troubleshooting",
      "name": "Virtual network connectivity troubleshooting",
      "description": "Use route, security, DNS, and Network Watcher evidence to isolate why two endpoints cannot communicate."
    }
  ],
