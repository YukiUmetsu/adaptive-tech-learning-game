  "concepts": [
    {
      "id": "azure.monitor.signals",
      "name": "Azure Monitor metrics and logs",
      "description": "Distinguish numeric time-series metrics from log records and understand how Azure Monitor collects and uses both."
    },
    {
      "id": "azure.monitor.diagnostic",
      "name": "Diagnostic settings and Log Analytics",
      "description": "Route supported resource logs/metrics to destinations such as Log Analytics and query log data with Kusto Query Language."
    },
    {
      "id": "azure.monitor.alerting",
      "name": "Azure Monitor alerts, action groups, and alert processing rules",
      "description": "Evaluate conditions, trigger notifications/actions, and control how alert actions are processed or suppressed."
    },
    {
      "id": "azure.monitor.insights",
      "name": "Azure Monitor Insights",
      "description": "Use curated monitoring experiences for VMs, storage, networks, and other Azure resources."
    },
    {
      "id": "azure.monitor.network",
      "name": "Network Watcher and Connection Monitor",
      "description": "Use Azure network monitoring and diagnostic tools to inspect topology, connectivity, routes, security decisions, and ongoing connection health."
    },
    {
      "id": "azure.backup.vaults",
      "name": "Recovery Services vaults and Backup vaults",
      "description": "Create the appropriate Azure Backup vault type for supported workloads and keep backup metadata/policies in a managed recovery boundary."
    },
    {
      "id": "azure.backup.policy",
      "name": "Azure Backup policies and restore operations",
      "description": "Define backup schedules/retention, run backups, monitor jobs, and restore protected data."
    },
    {
      "id": "azure.recovery.site_recovery",
      "name": "Azure Site Recovery",
      "description": "Replicate supported workloads to another location and orchestrate failover/failback for disaster recovery."
    },
    {
      "id": "azure.backup.monitoring",
      "name": "Backup reports and alerts",
      "description": "Monitor backup health, jobs, alerts, and reporting so protection failures are detected before a recovery is needed."
    }
  ],
