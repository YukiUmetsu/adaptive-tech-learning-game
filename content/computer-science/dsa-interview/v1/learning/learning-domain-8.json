  "glossary": [
    {
      "term": "backtracking",
      "definition": "Systematically explore choices while undoing a choice before trying a sibling alternative."
    },
    {
      "term": "pruning",
      "definition": "Stop exploring a branch after proving no completion below it can produce a valid or better answer."
    },
    {
      "term": "greedy",
      "definition": "Commit to a local choice without later revisiting it."
    },
    {
      "term": "memoization",
      "definition": "Cache answers to states computed by top-down recursion."
    },
    {
      "term": "tabulation",
      "definition": "Compute DP states bottom-up in an order that satisfies their dependencies."
    }
  ],
