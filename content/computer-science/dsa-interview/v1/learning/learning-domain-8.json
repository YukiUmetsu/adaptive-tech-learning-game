          "prompts": [
            {
              "id": "what",
              "kind": "what",
              "label": "WHAT IS A DP STATE?",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "A DP state is a precise subproblem identified by the information future decisions need. A recurrence explains the state using smaller states, and a base case anchors the dependency graph.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "state",
                      "text": "information future decisions need",
                      "required": true
                    },
                    {
                      "id": "recurrence",
                      "text": "explains the state using smaller states",
