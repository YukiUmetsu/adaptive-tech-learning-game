      "nodes": [
        {
          "id": "domain-8-greedy-safe",
          "title": "Make a greedy choice only with a safety argument",
          "concept_ids": [
            "dsa.greedy.safe_choice"
          ],
          "prerequisite_node_ids": [],
          "map_position": {
            "x": 0.12,
            "y": 0.5
          },
          "prompts": [
            {
              "id": "what",
              "kind": "what",
              "label": "WHAT MAKES A GREEDY CHOICE CORRECT?",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "A greedy algorithm commits to a local choice without revisiting it. Correctness therefore needs a reason that some optimal solution can begin with that choice, often expressed with an exchange argument or structural proof.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "commit",
                      "text": "commits to a local choice without revisiting it",
                      "required": true
                    },
                    {
                      "id": "proof",
                      "text": "some optimal solution can begin with that choice",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "real-use",
              "kind": "connects_to",
              "label": "REAL USE: SCHEDULE AS MANY NON-OVERLAPPING MAINTENANCE JOBS AS POSSIBLE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "If every job occupies one time interval and the objective is to maximize the NUMBER of non-overlapping jobs, choosing the compatible job that finishes earliest is safe: it leaves at least as much remaining time as any other first choice.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "earliest",
                      "text": "finishes earliest",
                      "required": true
                    },
                    {
                      "id": "remaining",
                      "text": "leaves at least as much remaining time",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "action",
              "kind": "action",
              "label": "DON'T SAY 'GREEDY' UNTIL YOU CAN ANSWER THIS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Why can I permanently commit to this local choice without losing all optimal solutions?",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "why",
                      "text": "without losing all optimal solutions",
                      "required": true
                    }
                  ]
                }
              }
            }
          ],
          "source_refs": [
            {
              "title": "MIT OpenCourseWare 6.046J — Greedy Algorithms",
              "url": "https://ocw.mit.edu/courses/6-046j-design-and-analysis-of-algorithms-spring-2015/pages/lecture-notes/"
            },
            {
              "title": "MIT Press — Introduction to Algorithms",
              "url": "https://mitpress.mit.edu/9780262046305/introduction-to-algorithms/"
            }
          ],
          "glossary": [
            {
              "term": "greedy choice",
              "definition": "A locally preferred decision committed to without later backtracking."
            },
            {
              "term": "exchange argument",
              "definition": "A proof technique showing an optimal solution can be transformed to use the greedy choice without becoming worse."
            }
          ]
        },
        {
          "id": "domain-8-greedy-interval",
          "title": "For maximum interval count, choose earliest finish",
          "concept_ids": [
            "dsa.greedy.interval_scheduling",
            "dsa.greedy.safe_choice"
          ],
          "prerequisite_node_ids": [
            "domain-8-greedy-safe"
