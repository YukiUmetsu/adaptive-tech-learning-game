      "nodes": [
        {
          "id": "domain-8-backtracking-tree",
          "title": "Treat constrained search as a decision tree",
          "concept_ids": [
            "dsa.backtracking.choose_explore_undo"
          ],
          "prerequisite_node_ids": [],
          "map_position": {
            "x": 0.12,
            "y": 0.14
          },
          "prompts": [
            {
              "id": "what",
              "kind": "what",
              "label": "WHEN DOES BACKTRACKING FIT?",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Backtracking fits when a solution is built from a sequence of choices, multiple alternatives may be possible at each step, and a partial choice can later prove incompatible with the constraints.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "choices",
                      "text": "solution is built from a sequence of choices",
                      "required": true
                    },
                    {
                      "id": "incompatible",
                      "text": "partial choice can later prove incompatible",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "real-use",
              "kind": "connects_to",
              "label": "REAL USE: GENERATE A VALID TEST CONFIGURATION",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Suppose a test environment needs one database, one cache mode, and one region, but some combinations are forbidden. Choose one option, explore the remaining choices, and undo when a constraint blocks the partial configuration.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "config",
                      "text": "some combinations are forbidden",
                      "required": true
                    },
                    {
                      "id": "undo",
                      "text": "undo when a constraint blocks",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "sequence",
              "kind": "mental_model",
              "label": "THE BACKTRACKING LOOP",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "sequence",
                "items": [
                  "Choose one candidate option.",
                  "Apply it to the partial state.",
                  "Explore the remaining decision problem.",
                  "Record a complete valid solution if one is reached.",
                  "Undo the choice.",
                  "Try the next candidate option."
                ]
              }
            }
          ],
          "source_refs": [
            {
              "title": "MIT OpenCourseWare 6.006 — Depth-First Search",
              "url": "https://ocw.mit.edu/courses/6-006-introduction-to-algorithms-spring-2020/pages/lecture-notes/"
            },
            {
              "title": "MIT Press — Introduction to Algorithms",
              "url": "https://mitpress.mit.edu/9780262046305/introduction-to-algorithms/"
            }
          ],
          "glossary": [
            {
              "term": "decision tree",
              "definition": "A conceptual tree whose branches represent alternative choices made while constructing a solution."
            },
            {
              "term": "partial candidate",
              "definition": "The choices selected so far before a full solution is complete."
            }
          ]
        },
        {
          "id": "domain-8-backtracking-state",
          "title": "Keep reversible state small and explicit",
          "concept_ids": [
            "dsa.backtracking.state",
            "dsa.backtracking.choose_explore_undo"
          ],
          "prerequisite_node_ids": [
            "domain-8-backtracking-tree"
          ],
          "map_position": {
            "x": 0.42,
            "y": 0.14
          },
          "prompts": [
            {
              "id": "what",
              "kind": "what",
              "label": "WHAT STATE SHOULD A BACKTRACKER CARRY?",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Carry only what the next choice needs: the current partial candidate and compact constraint state such as used values, remaining capacity, occupied columns, or selected options.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "partial",
                      "text": "current partial candidate",
                      "required": true
                    },
                    {
                      "id": "constraint",
                      "text": "compact constraint state",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "real-use",
              "kind": "connects_to",
              "label": "REAL USE: ASSIGN FEATURES WITHOUT CONFLICTS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "A configuration generator may select feature flags while tracking which incompatible feature groups are already active. Adding one flag updates the conflict state; undoing it restores the previous state before testing another flag.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "restore",
                      "text": "restores the previous state",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "code",
              "kind": "mental_model",
              "label": "MUTATE, EXPLORE, RESTORE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "backtrack.py",
                "language": "python",
                "code": "def search(options, chosen):\n    if complete(chosen):\n        emit(chosen.copy())\n        return\n    for option in candidates(options, chosen):\n        chosen.append(option)\n        search(options, chosen)\n        chosen.pop()\n",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "copy",
                    "anchor": {
                      "line": 3,
                      "text": "emit(chosen.copy())",
                      "occurrence": 1
                    },
                    "title": "Save a snapshot",
                    "explanation": "The mutable chosen list will continue changing after this solution is emitted.",
                    "required": true
                  },
                  {
                    "id": "undo",
                    "anchor": {
                      "line": 8,
                      "text": "chosen.pop()",
                      "occurrence": 1
                    },
                    "title": "Restore before sibling branch",
                    "explanation": "Without undo, state from one branch leaks into the next branch.",
                    "required": true
                  }
                ]
              }
            }
          ],
          "source_refs": [
            {
              "title": "MIT OpenCourseWare 6.006 — Depth-First Search",
              "url": "https://ocw.mit.edu/courses/6-006-introduction-to-algorithms-spring-2020/pages/lecture-notes/"
            },
            {
              "title": "MIT Press — Introduction to Algorithms",
              "url": "https://mitpress.mit.edu/9780262046305/introduction-to-algorithms/"
            }
          ]
        },
        {
          "id": "domain-8-backtracking-prune",
          "title": "Prune only when the partial state proves failure",
          "concept_ids": [
            "dsa.backtracking.pruning",
            "dsa.backtracking.state"
          ],
          "prerequisite_node_ids": [
            "domain-8-backtracking-state"
          ],
          "map_position": {
            "x": 0.72,
            "y": 0.14
          },
          "prompts": [
            {
              "id": "what",
              "kind": "what",
              "label": "WHAT MAKES A PRUNE SAFE?",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "A prune is safe when the current partial state already violates a required constraint, or when a bound proves that no completion below this branch can beat or satisfy the target.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "violate",
                      "text": "already violates a required constraint",
                      "required": true
                    },
                    {
                      "id": "bound",
                      "text": "no completion below this branch can",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "real-use",
              "kind": "connects_to",
              "label": "REAL USE: STOP AN IMPOSSIBLE DEPLOYMENT CONFIG EARLY",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "If the deployment requires total requested memory ≤ 16 GiB and the partial selection already requests 18 GiB, no later choice can repair that branch if all remaining additions are non-negative. Stop immediately.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "impossible",
                      "text": "no later choice can repair that branch",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "not-this",
              "kind": "not_this",
              "label": "A HEURISTIC IS NOT AUTOMATICALLY A SAFE PRUNE",
              "placeholder": "",
              "required": false,
              "reveal": {
                "type": "text",
                "text": "It is fine to try promising choices first, but deleting a branch requires a proof that the branch cannot contain a valid or better solution. 'Looks unlikely' is ordering, not correctness-preserving pruning.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "proof",
                      "text": "requires a proof",
                      "required": true
                    }
                  ]
                }
              }
            }
          ],
          "source_refs": [
            {
              "title": "MIT Press — Introduction to Algorithms",
              "url": "https://mitpress.mit.edu/9780262046305/introduction-to-algorithms/"
            }
          ]
        }
      ]
    },
