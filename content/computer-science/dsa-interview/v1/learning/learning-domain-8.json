              "id": "code",
              "kind": "mental_model",
              "label": "TOP-DOWN CACHED STATE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "memo_dp.py",
                "language": "python",
                "code": "from functools import lru_cache\n@lru_cache(None)\ndef best(i, remaining):\n    if i == len(items):\n        return 0\n    answer = best(i + 1, remaining)\n    size, value = items[i]\n    if size <= remaining:\n        answer = max(answer, value + best(i + 1, remaining - size))\n    return answer\n",
                "line_numbers": true,
                "annotations": [
