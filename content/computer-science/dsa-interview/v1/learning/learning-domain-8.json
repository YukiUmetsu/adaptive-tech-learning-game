          "prompts": [
            {
              "id": "what",
              "kind": "what",
              "label": "WHY EARLIEST FINISH?",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "For the classic objective 'select the maximum number of mutually non-overlapping intervals,' picking the compatible interval with smallest finish time leaves the widest remaining suffix for future selections.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "objective",
                      "text": "maximum number of mutually non-overlapping intervals",
                      "required": true
                    },
                    {
                      "id": "suffix",
                      "text": "widest remaining suffix",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "real-use",
              "kind": "connects_to",
              "label": "REAL USE: MAXIMIZE THE NUMBER OF NON-OVERLAPPING TEST-LAB BOOKINGS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "If every booking counts equally and one lab can run only one booking at a time, sort by finish time and accept the next booking whose start is at or after the last accepted finish.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "equally",
                      "text": "every booking counts equally",
                      "required": true
                    },
                    {
                      "id": "accept",
                      "text": "start is at or after",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "warning",
              "kind": "not_this",
              "label": "CHANGE THE OBJECTIVE, CHANGE THE ALGORITHM",
              "placeholder": "",
              "required": false,
              "reveal": {
                "type": "text",
                "text": "Earliest finish is optimal for maximum interval count, not for every scheduling objective. If jobs have different values/profits, weighted interval scheduling is a different problem and typically requires dynamic programming.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "notall",
