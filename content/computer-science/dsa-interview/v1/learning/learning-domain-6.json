        {
          "id": "domain-6-tree-return-state",
          "title": "Return only the subtree state the parent needs",
          "concept_ids": [
            "dsa.tree.return_state",
            "dsa.recursion.decompose_combine"
          ],
          "prerequisite_node_ids": [
            "domain-6-recursion-combine"
          ],
          "map_position": {
            "x": 0.72,
            "y": 0.14
          },
          "prompts": [
            {
              "id": "what",
              "kind": "what",
              "label": "THE RETURN VALUE IS THE INTERFACE BETWEEN LEVELS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "A recursive tree solution becomes simpler when each subtree returns a small, precise summary. Height, subtree sum, validity, or a pair of values may be enough; returning an entire subtree's history usually is not.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "summary",
                      "text": "small, precise summary",
                      "required": true
                    },
                    {
                      "id": "enough",
                      "text": "Height, subtree sum, validity, or a pair of values",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "real-use",
              "kind": "connects_to",
              "label": "REAL USE: COMPUTE HIERARCHY HEIGHT",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "height.py",
                "language": "python",
                "code": "def height(node):\n    if node is None:\n        return 0\n    left_h = height(node.left)\n    right_h = height(node.right)\n    return 1 + max(left_h, right_h)\n",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "child-state",
                    "anchor": {
                      "line": 4,
                      "text": "left_h = height(node.left)",
                      "occurrence": 1
                    },
                    "title": "Child returns one number",
                    "explanation": "The parent does not need the child's entire traversal, only its height.",
                    "required": true
                  },
                  {
                    "id": "parent-combine",
                    "anchor": {
                      "line": 6,
                      "text": "1 + max(left_h, right_h)",
                      "occurrence": 1
                    },
                    "title": "Parent combines summaries",
                    "explanation": "The current subtree height is one plus the larger child height.",
                    "required": true
                  }
                ]
              }
            },
            {
              "id": "not-this",
              "kind": "not_this",
              "label": "DON'T MIX SUBTREE STATE WITH GLOBAL SIDE EFFECTS UNLESS NEEDED",
              "placeholder": "",
              "required": false,
              "reveal": {
                "type": "text",
                "text": "A pure return-state design is often easier to reason about and test. Use external mutable state only when it clearly simplifies a problem whose final answer is not itself a subtree summary.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "pure",
                      "text": "pure return-state design",
                      "required": true
                    }
                  ]
                }
              }
            }
          ],
          "source_refs": [
            {
              "title": "MIT OpenCourseWare 6.006 — Lecture 6: Binary Trees, Part 1",
