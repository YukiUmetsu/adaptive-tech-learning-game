        {
          "id": "domain-6-recursion-combine",
          "title": "Solve children, then combine their answers",
          "concept_ids": [
            "dsa.recursion.decompose_combine"
          ],
          "prerequisite_node_ids": [
            "domain-6-recursion-contract"
          ],
          "map_position": {
            "x": 0.42,
            "y": 0.14
          },
          "prompts": [
            {
              "id": "what",
              "kind": "what",
              "label": "THE TREE RECURSION SHAPE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "For a hierarchical tree, the same computation often applies to every child subtree. Recursively obtain each child result, then combine those results with the current node's contribution.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "children",
                      "text": "same computation often applies to every child subtree",
                      "required": true
                    },
                    {
                      "id": "combine",
                      "text": "combine those results with the current node's contribution",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "real-use",
              "kind": "connects_to",
              "label": "REAL USE: AGGREGATE CONFIGURATION COST",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "subtree_cost.py",
                "language": "python",
                "code": "def total_cost(node):\n    if node is None:\n        return 0\n    child_total = 0\n    for child in node.children:\n        child_total += total_cost(child)\n    return node.cost + child_total\n",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "base",
                    "anchor": {
                      "line": 2,
                      "text": "if node is None:",
                      "occurrence": 1
                    },
                    "title": "Base case",
                    "explanation": "An absent subtree contributes zero cost and makes no further calls.",
                    "required": true
                  },
                  {
                    "id": "recursive",
                    "anchor": {
                      "line": 6,
                      "text": "child_total += total_cost(child)",
                      "occurrence": 1
                    },
                    "title": "Same contract on a smaller subtree",
                    "explanation": "Each child call returns the total cost of that child's subtree.",
                    "required": true
                  },
                  {
                    "id": "combine",
                    "anchor": {
                      "line": 7,
                      "text": "return node.cost + child_total",
                      "occurrence": 1
                    },
                    "title": "Combine at the parent",
                    "explanation": "The parent can compute its answer solely from its own contribution and child results.",
                    "required": true
                  }
                ]
              }
            },
            {
              "id": "action",
              "kind": "action",
              "label": "ASK THIS BEFORE CODING",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "If the child subtree solved itself correctly, what exact value would I need back from it to solve the parent?",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "question",
                      "text": "what exact value would I need back",
                      "required": true
                    }
                  ]
                }
              }
            }
          ],
          "source_refs": [
            {
              "title": "MIT OpenCourseWare 6.006 — Lecture 6: Binary Trees, Part 1",
