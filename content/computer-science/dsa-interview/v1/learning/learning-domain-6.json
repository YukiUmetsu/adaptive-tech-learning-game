        {
          "id": "domain-6-recursion-contract",
          "title": "Give every recursive call a smaller contract",
          "concept_ids": [
            "dsa.recursion.base_case"
          ],
          "prerequisite_node_ids": [],
          "map_position": {
            "x": 0.12,
            "y": 0.14
          },
          "prompts": [
            {
              "id": "what",
              "kind": "what",
              "label": "WHAT MAKES RECURSION SAFE?",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "A recursive function needs a contract, a base case, and progress. Each recursive call must receive a strictly smaller or simpler subproblem so repeated calls eventually reach a base case.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "base",
                      "text": "base case",
                      "required": true
                    },
                    {
                      "id": "progress",
                      "text": "strictly smaller or simpler subproblem",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "real-use",
              "kind": "connects_to",
              "label": "REAL USE: WALK A DIRECTORY TREE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "A directory's total size can be defined as its own file sizes plus the total sizes of child directories. Each child directory is a smaller subtree, and an empty directory is a natural base case.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "subtree",
                      "text": "Each child directory is a smaller subtree",
                      "required": true
                    },
                    {
                      "id": "empty",
                      "text": "empty directory is a natural base case",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "not-this",
              "kind": "not_this",
              "label": "RECURSION IS NOT 'CALL YOURSELF UNTIL IT WORKS'",
              "placeholder": "",
              "required": false,
              "reveal": {
                "type": "text",
                "text": "Before writing the call, state what one invocation promises to return and what input measure gets smaller. If neither is clear, the recursive design is incomplete.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "promise",
                      "text": "what one invocation promises to return",
                      "required": true
                    }
                  ]
                }
              }
            }
          ],
          "source_refs": [
            {
              "title": "MIT OpenCourseWare 6.006 — Lecture 6: Binary Trees, Part 1",
              "url": "https://ocw.mit.edu/courses/6-006-introduction-to-algorithms-spring-2020/resources/lecture-6-binary-trees-part-1/"
