          "prompts": [
            {
              "id": "what",
              "kind": "what",
              "label": "PREORDER, INORDER, OR POSTORDER?",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Traversal names describe when the current node is processed relative to its children. Preorder handles parent before children, inorder places the parent between left and right, and postorder handles children before the parent.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "pre",
                      "text": "parent before children",
                      "required": true
                    },
                    {
                      "id": "post",
                      "text": "children before the parent",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "real-use",
              "kind": "connects_to",
              "label": "REAL USE: DELETE OR AGGREGATE A HIERARCHY",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "If a parent resource can be deleted only after all children are deleted, postorder matches the dependency. If inherited configuration must be applied to a parent before visiting descendants, preorder matches the flow.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "delete",
                      "text": "deleted only after all children are deleted",
                      "required": true
                    },
                    {
                      "id": "inherit",
                      "text": "parent before visiting descendants",
                      "required": true
                    }
                  ]
                }
              }
            },
