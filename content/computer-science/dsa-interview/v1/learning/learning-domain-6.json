  "glossary": [
    {
      "term": "subtree",
      "definition": "A node together with all descendants reachable below it."
    },
    {
      "term": "preorder",
      "definition": "Process the current node before its child subtrees."
    },
    {
      "term": "inorder",
      "definition": "For a binary tree, process the current node between the left and right subtrees."
    },
    {
      "term": "postorder",
      "definition": "Process child subtrees before the current node."
    },
    {
      "term": "terminal marker",
      "definition": "Trie state indicating that the current node ends a complete stored key."
    }
