            }
          ],
          "glossary": [
            {
              "term": "base case",
              "definition": "An input simple enough that the function can return without making another recursive call."
            },
            {
              "term": "subproblem",
              "definition": "A smaller instance of the same problem solved as part of the larger result."
            }
