        {
          "id": "domain-6-tree-bfs",
          "title": "Use a FIFO frontier when depth order matters",
          "concept_ids": [
            "dsa.tree.bfs_levels"
          ],
          "prerequisite_node_ids": [
            "domain-6-tree-order"
          ],
          "map_position": {
            "x": 0.42,
            "y": 0.5
          },
          "prompts": [
            {
              "id": "what",
              "kind": "what",
              "label": "WHAT DOES LEVEL-ORDER PRESERVE?",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Breadth-first traversal visits all nodes at depth d before nodes at depth d+1. A FIFO queue preserves that frontier order because children are appended behind nodes already waiting at the current or next level.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "depth",
                      "text": "all nodes at depth d before nodes at depth d+1",
                      "required": true
                    },
                    {
                      "id": "fifo",
                      "text": "FIFO queue",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "real-use",
              "kind": "connects_to",
              "label": "REAL USE: GROUP AN ORGANIZATION TREE BY MANAGEMENT DEPTH",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "If the output needs everyone one reporting edge from the root, then everyone two edges away, and so on, level-order traversal directly produces that depth grouping.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "group",
                      "text": "depth grouping",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "code",
              "kind": "mental_model",
              "label": "LEVEL FRONTIER",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "levels.py",
                "language": "python",
                "code": "from collections import deque\nq = deque([(root, 0)])\nwhile q:\n    node, depth = q.popleft()\n    visit(node, depth)\n    for child in node.children:\n        q.append((child, depth + 1))\n",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "fifo",
                    "anchor": {
                      "line": 4,
                      "text": "q.popleft()",
                      "occurrence": 1
                    },
                    "title": "Oldest frontier node first",
                    "explanation": "FIFO ordering processes earlier-depth frontier nodes before descendants added later.",
                    "required": true
                  },
                  {
                    "id": "depth",
                    "anchor": {
                      "line": 7,
                      "text": "depth + 1",
                      "occurrence": 1
                    },
                    "title": "Children are one level deeper",
                    "explanation": "Tree edges give a direct depth increment from parent to child.",
                    "required": true
                  }
                ]
              }
            }
          ],
          "source_refs": [
            {
              "title": "MIT OpenCourseWare 6.006 — Lecture 9: Breadth-First Search",
