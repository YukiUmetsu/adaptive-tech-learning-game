              "kind": "what",
              "label": "WHAT IS THE FALLBACK LOOP?",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Use the same reasoning sequence whenever a prompt feels unfamiliar. The sequence reduces the need to invent a process while you are also solving the problem.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "same-sequence",
                      "text": "same reasoning sequence",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "sequence",
              "kind": "mental_model",
              "label": "RUN THIS LOOP",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "sequence",
                "items": [
                  "Clarify: output, constraints, mutation, duplicates, no-solution behavior.",
                  "Example: walk through one tiny case.",
                  "Baseline: state a simple correct solution.",
                  "Bottleneck: name the expensive repeated operation.",
                  "Commit: state the maintained state/invariant and complexity.",
                  "Code: implement the simplest version that preserves that reasoning.",
                  "Test: normal, boundary, and no-solution cases."
                ]
              }
            },
            {
              "id": "stuck",
              "kind": "action",
              "label": "IF YOU GET STUCK",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Do not search your memory for a random pattern name. Return to the baseline and ask which operation is repeated most often.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "return-baseline",
                      "text": "Return to the baseline",
                      "required": true
                    }
                  ]
                }
              }
            }
          ],
          "source_refs": [
