        },
        {
          "id": "domain-1-bottleneck",
          "title": "Remove repeated work, not random lines",
          "concept_ids": [
            "dsa.optimization.from_bruteforce"
          ],
          "prerequisite_node_ids": [
            "domain-1-aggregate-work"
          ],
          "map_position": {
            "x": 0.7,
            "y": 0.48
          },
          "prompts": [
            {
              "id": "what",
              "kind": "what",
              "label": "WHAT IS THE BOTTLENECK?",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "The bottleneck is the operation that dominates the baseline's cost. Optimization becomes much easier when you can name that operation precisely.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "dominates",
                      "text": "dominates the baseline's cost",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "comparison",
              "kind": "mental_model",
              "label": "BASELINE → REPEATED WORK → MAINTAINED INFORMATION",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "comparison",
                "columns": [
                  {
                    "title": "Baseline",
                    "items": [
                      "For each value, scan earlier values again.",
                      "Repeated question: have I seen this value?"
                    ]
                  },
                  {
                    "title": "Improved reasoning",
                    "items": [
                      "Maintain the values already seen.",
                      "Ask membership directly instead of rescanning."
                    ]
                  }
                ]
              }
            },
            {
              "id": "questions",
              "kind": "action",
              "label": "THREE QUESTIONS TO ASK",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "sequence",
                "items": [
                  "Which operation is repeated most?",
                  "What answer/data from earlier work would make that operation cheaper?",
                  "What state or data structure can maintain that information correctly?"
                ]
              }
            },
            {
              "id": "warning",
              "kind": "not_this",
              "label": "DO NOT OPTIMIZE BY PATTERN NAME ALONE",
              "placeholder": "",
              "required": false,
              "reveal": {
                "type": "text",
                "text": "A familiar keyword is not enough. The optimization should remove a cost you can point to in the baseline.",
