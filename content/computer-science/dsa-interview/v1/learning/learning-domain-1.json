        {
          "id": "domain-1-correct-baseline",
          "title": "Start with a correct baseline",
          "concept_ids": [
            "dsa.reasoning.correct_baseline"
          ],
          "prerequisite_node_ids": [
            "domain-1-interview-signal"
          ],
          "map_position": {
            "x": 0.42,
            "y": 0.16
          },
          "prompts": [
            {
              "id": "what",
              "kind": "what",
              "label": "WHAT IS A BASELINE?",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "A baseline is the simplest approach you can explain as correct, even if it is too slow for the final constraints. It gives you something concrete to analyze instead of guessing an optimization.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "baseline-simple-correct",
                      "text": "simplest approach you can explain as correct",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "example",
              "kind": "mental_model",
              "label": "EXAMPLE: DUPLICATE CHECK",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "baseline.py",
                "language": "python",
                "code": "def has_duplicate(values):\n    for i in range(len(values)):\n        for j in range(i + 1, len(values)):\n            if values[i] == values[j]:\n                return True\n    return False\n",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "baseline-correct",
                    "anchor": {
                      "line": 2,
                      "text": "for i in range(len(values)):",
                      "occurrence": 1
                    },
                    "title": "Systematic baseline",
                    "explanation": "The loops consider every unordered pair, so a duplicate pair cannot be skipped.",
                    "required": true
                  },
                  {
                    "id": "baseline-cost",
                    "anchor": {
                      "line": 3,
                      "text": "for j in range(i + 1, len(values)):",
                      "occurrence": 1
                    },
                    "title": "Cost becomes visible",
                    "explanation": "The nested comparisons make the repeated work easy to identify before optimizing.",
                    "required": true
                  }
                ]
              }
            },
            {
              "id": "when",
              "kind": "when",
              "label": "WHEN SHOULD YOU USE THE BASELINE?",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Use it when the optimal pattern is not obvious. State the correct baseline, then ask what operation repeats and whether that result can be remembered or avoided.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "what-repeats",
                      "text": "what operation repeats",
                      "required": true
                    }
                  ]
                }
              }
            }
          ],
          "source_refs": [
            {
              "title": "MIT OpenCourseWare 6.006 — Lecture 1: Algorithms and Computation",
              "url": "https://ocw.mit.edu/courses/6-006-introduction-to-algorithms-spring-2020/resources/lecture-1-algorithms-and-computation/"
