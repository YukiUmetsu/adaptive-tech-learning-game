        {
          "id": "domain-1-invariant",
          "title": "Use an invariant and a progress rule",
          "concept_ids": [
            "dsa.correctness.invariant"
          ],
          "prerequisite_node_ids": [],
          "map_position": {
            "x": 0.24,
            "y": 0.8
          },
          "prompts": [
            {
              "id": "what",
              "kind": "what",
              "label": "WHAT IS AN INVARIANT?",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "A loop invariant is a condition that remains true at the relevant point of every iteration. It gives you a compact way to explain why each update is safe.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "remains-true",
                      "text": "remains true",
                      "required": true
                    },
                    {
                      "id": "safe-update",
                      "text": "why each update is safe",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "four-checks",
              "kind": "mental_model",
              "label": "FOUR CHECKS FOR A LOOP",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "sequence",
                "items": [
                  "Initialization: the invariant is true before the first iteration.",
                  "Maintenance: one iteration preserves the invariant.",
                  "Progress: some measure moves toward termination.",
                  "Exit: invariant + loop exit condition imply the desired result."
                ]
              }
            },
            {
              "id": "binary-example",
              "kind": "connects_to",
              "label": "EXAMPLE: BINARY-SEARCH CANDIDATE INTERVAL",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "binary_search.py",
                "language": "python",
                "code": "left, right = 0, len(values) - 1\nwhile left <= right:\n    mid = (left + right) // 2\n    if values[mid] == target:\n        return mid\n    if values[mid] < target:\n        left = mid + 1\n    else:\n        right = mid - 1\nreturn -1\n",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "candidate-region",
                    "anchor": {
                      "line": 1,
                      "text": "left, right = 0, len(values) - 1",
                      "occurrence": 1
                    },
                    "title": "Candidate interval",
                    "explanation": "The invariant can be stated as: if the target is still possible, it lies inside the current interval.",
                    "required": true
                  },
                  {
                    "id": "left-progress",
                    "anchor": {
                      "line": 7,
                      "text": "left = mid + 1",
                      "occurrence": 1
                    },
                    "title": "Preserve + progress",
                    "explanation": "When the midpoint is too small, mid and everything left of it can be discarded; +1 also shrinks the interval.",
                    "required": true
                  },
                  {
                    "id": "right-progress",
                    "anchor": {
                      "line": 9,
                      "text": "right = mid - 1",
                      "occurrence": 1
                    },
                    "title": "Symmetric update",
                    "explanation": "When the midpoint is too large, mid and everything right of it can be discarded.",
                    "required": true
                  }
                ]
              }
            },
