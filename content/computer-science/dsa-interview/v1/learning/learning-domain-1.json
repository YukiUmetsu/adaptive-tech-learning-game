      "nodes": [
        {
          "id": "domain-1-big-o",
          "title": "Use Big O as a scale filter",
          "concept_ids": [
            "dsa.complexity.big_o"
          ],
          "prerequisite_node_ids": [],
          "map_position": {
            "x": 0.14,
            "y": 0.48
          },
          "prompts": [
            {
              "id": "what",
              "kind": "what",
              "label": "WHAT DOES BIG O TELL YOU?",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Big O describes how resource use grows as input size grows. In interviews, first use it to reject approaches that cannot plausibly fit the stated scale.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "growth",
                      "text": "grows as input size grows",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "table",
              "kind": "mental_model",
              "label": "RECOGNIZE COMMON GROWTH SHAPES",
              "placeholder": "Reveal one row at a time.",
              "required": true,
              "reveal": {
                "type": "table",
                "columns": [
                  {
                    "id": "growth",
                    "label": "Growth"
                  },
                  {
                    "id": "shape",
                    "label": "Typical structural clue"
                  },
                  {
                    "id": "example",
                    "label": "Example"
                  }
                ],
                "rows": [
                  {
                    "id": "o1",
                    "cells": {
                      "growth": "O(1)",
                      "shape": "Amount of work does not grow with n",
                      "example": "Read one known index"
                    }
                  },
                  {
                    "id": "ologn",
                    "cells": {
                      "growth": "O(log n)",
                      "shape": "Discard a constant fraction each step",
                      "example": "Binary search"
                    }
                  },
                  {
                    "id": "on",
                    "cells": {
                      "growth": "O(n)",
                      "shape": "Process each input item a bounded number of times",
                      "example": "Single scan"
                    }
                  },
                  {
                    "id": "onlogn",
                    "cells": {
                      "growth": "O(n log n)",
                      "shape": "Linear work across logarithmic levels or comparison sorting",
                      "example": "Merge sort"
                    }
                  },
                  {
                    "id": "on2",
                    "cells": {
                      "growth": "O(n²)",
                      "shape": "For many items, scan/compare with many other items",
                      "example": "All-pairs comparison"
                    }
                  }
                ],
                "progressive_reveal": {
                  "mode": "row",
                  "initially_visible": {
                    "column_ids": [
                      "growth"
                    ],
                    "row_ids": [],
                    "cell_ids": []
                  }
                }
              }
            },
            {
              "id": "not-stopwatch",
              "kind": "not_this",
              "label": "BIG O IS NOT A STOPWATCH",
              "placeholder": "",
              "required": false,
              "reveal": {
                "type": "text",
                "text": "Big O abstracts away constant factors and focuses on growth. Use it with the actual constraints and operations, not as a substitute for all performance reasoning.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "growth-not-clock",
                      "text": "focuses on growth",
                      "required": true
                    }
                  ]
                }
              }
            }
          ],
          "source_refs": [
            {
              "title": "MIT OpenCourseWare 6.006 — Introduction to Algorithms syllabus",
