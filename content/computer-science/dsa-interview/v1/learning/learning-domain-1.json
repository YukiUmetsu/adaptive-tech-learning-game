  "glossary": [
    {
      "term": "baseline",
      "definition": "A simple correct starting solution used to expose the real cost before optimizing."
    },
    {
      "term": "Big O",
      "definition": "Notation for how time or extra memory grows as the input size grows."
    },
    {
      "term": "bottleneck",
      "definition": "The operation that dominates the cost of the current approach."
    },
    {
      "term": "invariant",
      "definition": "A condition that stays true at a chosen point while an algorithm runs."
    },
    {
      "term": "edge case",
      "definition": "An input near a boundary or unusual condition that can expose hidden assumptions."
    }
