      "nodes": [
        {
          "id": "domain-1-interview-signal",
          "title": "Make your reasoning visible",
          "concept_ids": [
            "dsa.interview.signal"
          ],
          "prerequisite_node_ids": [],
          "map_position": {
            "x": 0.14,
            "y": 0.16
          },
          "prompts": [
            {
              "id": "what",
              "kind": "what",
              "label": "WHAT ARE INTERVIEWERS TRYING TO OBSERVE?",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "A coding interview is not only a final-answer check. Make your problem decomposition, plan, correctness reasoning, complexity trade-offs, implementation, and testing visible.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "visible-reasoning",
                      "text": "Make your problem decomposition",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "signals",
              "kind": "mental_model",
              "label": "THE FIVE SIGNALS TO SHOW",
              "placeholder": "Reveal the checklist.",
              "required": true,
              "reveal": {
                "type": "bullets",
                "items": [
                  "Clarify the input, output, and constraints that can change the solution.",
                  "State a simple plan before writing code.",
                  "Explain why the chosen operations and data structures fit.",
                  "Write code that preserves the stated reasoning.",
                  "Test boundaries, errors, and a normal case before saying you are done."
                ]
              }
            },
            {
              "id": "not-memory-contest",
              "kind": "not_this",
              "label": "NOT A MEMORY CONTEST",
              "placeholder": "",
              "required": false,
              "reveal": {
                "type": "text",
                "text": "Memorized solutions are fragile when the story changes. The useful skill is applying fundamentals to a new prompt and explaining why the approach fits.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "apply-fundamentals",
                      "text": "applying fundamentals to a new prompt",
                      "required": true
                    }
                  ]
                }
              }
            }
          ],
          "source_refs": [
