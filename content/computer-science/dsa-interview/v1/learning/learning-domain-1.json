        {
          "id": "domain-1-aggregate-work",
          "title": "Count operations, not loop shapes",
          "concept_ids": [
            "dsa.complexity.aggregate_work"
          ],
          "prerequisite_node_ids": [
            "domain-1-big-o"
          ],
          "map_position": {
            "x": 0.42,
            "y": 0.48
          },
          "prompts": [
            {
              "id": "what",
              "kind": "what",
              "label": "NESTED CODE DOES NOT AUTOMATICALLY MEAN O(n²)",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Complexity depends on how many times the expensive operation can happen overall. Two pointers that only move forward may perform O(n) total moves even when the code contains a loop inside a loop.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "overall",
                      "text": "overall",
                      "required": true
                    },
                    {
                      "id": "total-moves",
                      "text": "O(n) total moves",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "code",
              "kind": "mental_model",
              "label": "TRACE TOTAL POINTER MOVES",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "two_progress_counters.py",
                "language": "python",
                "code": "left = 0\nright = 0\nwhile left < n and right < n:\n    if should_move_left(left, right):\n        left += 1\n    else:\n        right += 1\n",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "left-progress",
                    "anchor": {
                      "line": 5,
                      "text": "left += 1",
                      "occurrence": 1
                    },
                    "title": "Left only moves forward",
                    "explanation": "Across the entire loop, left can increase at most n times.",
                    "required": true
                  },
                  {
                    "id": "right-progress",
                    "anchor": {
                      "line": 7,
                      "text": "right += 1",
                      "occurrence": 1
                    },
                    "title": "Right only moves forward",
                    "explanation": "Across the entire loop, right can also increase at most n times.",
                    "required": true
                  }
                ]
              }
            },
            {
              "id": "rule",
              "kind": "look_for",
              "label": "ASK THIS BEFORE MULTIPLYING LOOP BOUNDS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Can the inner work restart from scratch for every outer step, or does some state only move forward across the entire run?",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "restart",
                      "text": "restart from scratch",
                      "required": true
                    },
                    {
                      "id": "move-forward",
                      "text": "only move forward",
                      "required": true
                    }
                  ]
                }
              }
            }
          ],
          "source_refs": [
            {
              "title": "MIT OpenCourseWare 6.006 — Lecture 1: Algorithms and Computation",
              "url": "https://ocw.mit.edu/courses/6-006-introduction-to-algorithms-spring-2020/resources/lecture-1-algorithms-and-computation/"
