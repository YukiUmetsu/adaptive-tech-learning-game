        {
          "id": "domain-4-linked-sentinel",
          "title": "Use a sentinel to remove head special cases",
          "concept_ids": [
            "dsa.linked.sentinel"
          ],
          "prerequisite_node_ids": [
            "domain-4-linked-rewire"
          ],
          "map_position": {
            "x": 0.42,
            "y": 0.14
          },
          "prompts": [
            {
              "id": "what",
              "kind": "what",
              "label": "WHY USE A DUMMY HEAD?",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "A sentinel node is not part of the logical data. It gives the real first node a predecessor, so deleting or inserting at the logical head can use the same pointer-update shape as an interior operation.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "not-data",
                      "text": "not part of the logical data",
                      "required": true
                    },
                    {
                      "id": "same-shape",
                      "text": "same pointer-update shape",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "real-use",
              "kind": "connects_to",
              "label": "REAL USE: FILTER A LINKED WORK QUEUE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "When removing selected jobs from a singly linked work queue, a dummy head lets the loop always update `prev.next`, including when the first real job must be removed. That reduces branches around head replacement.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "always",
                      "text": "always update `prev.next`",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "code",
              "kind": "mental_model",
              "label": "ONE REMOVAL SHAPE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "remove_value.py",
                "language": "python",
                "code": "dummy = Node(None, head)\nprev = dummy\ncur = head\nwhile cur:\n    if should_remove(cur):\n        prev.next = cur.next\n    else:\n        prev = cur\n    cur = cur.next\nhead = dummy.next\n",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "dummy",
                    "anchor": {
                      "line": 1,
                      "text": "dummy = Node(None, head)",
                      "occurrence": 1
                    },
                    "title": "Artificial predecessor",
                    "explanation": "Even the original head now has a predecessor.",
                    "required": true
                  },
                  {
                    "id": "return-head",
                    "anchor": {
                      "line": 10,
                      "text": "head = dummy.next",
                      "occurrence": 1
                    },
                    "title": "Recover the logical head",
                    "explanation": "The first real node may have changed during filtering.",
                    "required": true
                  }
                ]
              }
            }
          ],
          "source_refs": [
            {
              "title": "MIT OpenCourseWare 6.006 — Recitation 2: Linked List Sequence",
              "url": "https://ocw.mit.edu/courses/6-006-introduction-to-algorithms-spring-2020/c08a3b63dfe5f6f6b32257d35f86ae63_MIT6_006S20_r02.pdf"
            },
