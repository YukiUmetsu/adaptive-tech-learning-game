            }
          ]
        },
        {
          "id": "domain-4-linked-reverse",
          "title": "Reverse a chain without losing the unprocessed suffix",
          "concept_ids": [
            "dsa.linked.reverse"
          ],
          "prerequisite_node_ids": [
            "domain-4-linked-rewire"
          ],
          "map_position": {
            "x": 0.72,
            "y": 0.14
          },
          "prompts": [
            {
              "id": "what",
              "kind": "what",
              "label": "THE THREE REFERENCES YOU NEED",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "At each step, `prev` is the already-reversed prefix, `cur` is the node being moved, and `next_node` preserves the unprocessed suffix before `cur.next` is overwritten.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "prev",
                      "text": "`prev` is the already-reversed prefix",
                      "required": true
                    },
                    {
                      "id": "next",
                      "text": "`next_node` preserves the unprocessed suffix",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "real-use",
              "kind": "connects_to",
              "label": "REAL USE: RESTORE ARRIVAL ORDER AFTER PREPENDING A BATCH",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "A batch may be accumulated by repeatedly prepending nodes because front insertion is cheap. If the batch later needs original arrival order, reversing the singly linked chain once restores that order without copying every payload into another container.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "prepend",
                      "text": "repeatedly prepending nodes",
                      "required": true
                    },
                    {
                      "id": "restore",
                      "text": "reversing the singly linked chain once restores that order",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "code",
              "kind": "mental_model",
              "label": "SAVE → REWIRE → ADVANCE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "reverse.py",
                "language": "python",
                "code": "prev = None\ncur = head\nwhile cur:\n    next_node = cur.next\n    cur.next = prev\n    prev = cur\n    cur = next_node\nhead = prev\n",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "save",
                    "anchor": {
                      "line": 4,
                      "text": "next_node = cur.next",
                      "occurrence": 1
                    },
                    "title": "Preserve the suffix first",
                    "explanation": "After the next line, the original forward link is gone.",
                    "required": true
                  },
                  {
                    "id": "rewire",
                    "anchor": {
                      "line": 5,
                      "text": "cur.next = prev",
                      "occurrence": 1
                    },
                    "title": "Move current into reversed prefix",
                    "explanation": "Current now points backward toward the prefix already processed.",
                    "required": true
                  },
                  {
                    "id": "advance",
                    "anchor": {
                      "line": 7,
                      "text": "cur = next_node",
                      "occurrence": 1
                    },
                    "title": "Continue with preserved suffix",
                    "explanation": "The saved reference is what keeps the unprocessed nodes reachable.",
                    "required": true
                  }
                ]
              }
            }
          ],
          "source_refs": [
            {
              "title": "MIT OpenCourseWare 6.006 — Lecture 2 notes: Linked List Sequence",
              "url": "https://ocw.mit.edu/courses/6-006-introduction-to-algorithms-spring-2020/79a07dc1cb47d76dae2ffedc701e3d2b_MIT6_006S20_lec2.pdf"
