            },
            {
              "id": "code",
              "kind": "mental_model",
              "label": "NEXT GREATER FRONTIER",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "next_greater.py",
                "language": "python",
                "code": "stack = []\nanswer = [-1] * len(values)\nfor i, value in enumerate(values):\n    while stack and values[stack[-1]] < value:\n        j = stack.pop()\n        answer[j] = i\n    stack.append(i)\n",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "resolve",
                    "anchor": {
                      "line": 4,
                      "text": "values[stack[-1]] < value",
                      "occurrence": 1
                    },
                    "title": "Current value resolves dominated candidates",
                    "explanation": "Because those candidates have not seen a greater value earlier, the current index is their first valid answer.",
                    "required": true
                  },
                  {
                    "id": "once",
                    "anchor": {
                      "line": 5,
                      "text": "j = stack.pop()",
                      "occurrence": 1
                    },
                    "title": "Each index leaves once",
                    "explanation": "Each index is pushed once and popped at most once, giving linear total stack operations.",
                    "required": true
                  }
                ]
              }
            },
            {
              "id": "not-this",
              "kind": "not_this",
              "label": "THE STACK IS NOT 'SORTING THE INPUT'",
              "placeholder": "",
              "required": false,
              "reveal": {
                "type": "text",
                "text": "The original sequence order stays intact. The stack stores only the unresolved frontier needed to answer a directional nearest/next relationship.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "frontier",
                      "text": "unresolved frontier",
                      "required": true
                    }
                  ]
                }
              }
            }
