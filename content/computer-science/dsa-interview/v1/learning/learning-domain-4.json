              "kind": "connects_to",
              "label": "REAL USE: TOP 100 HOTTEST ERROR KEYS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "After counts are computed, an observability pipeline may need only the 100 highest-count keys from millions of keys. A bounded heap keeps the current top 100 without fully sorting every key.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "top100",
                      "text": "only the 100 highest-count keys",
                      "required": true
