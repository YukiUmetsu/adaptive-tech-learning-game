              "label": "WHAT DOES A HEAP GUARANTEE?",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "A heap is partially ordered, not fully sorted. In a min-heap, every parent is no greater than its children, so the smallest item is always at the root. Insert/pop operations repair that invariant along a logarithmic-height path.",
                "progressive_reveal": {
                  "spans": [
