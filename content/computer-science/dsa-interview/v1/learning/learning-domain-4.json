          "id": "domain-4-linked-rewire",
          "title": "Rewire references without losing the rest of the chain",
          "concept_ids": [
            "dsa.linked.rewire"
          ],
          "prerequisite_node_ids": [],
          "map_position": {
            "x": 0.12,
            "y": 0.14
          },
          "prompts": [
            {
              "id": "what",
              "kind": "what",
              "label": "WHAT MAKES A LINKED LIST DIFFERENT?",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Each node stores an item and a reference to the next node rather than relying on contiguous array positions. Insertions and removals can be local pointer changes once the relevant node or predecessor is known.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "node-next",
                      "text": "reference to the next node",
                      "required": true
                    },
                    {
                      "id": "local",
                      "text": "local pointer changes",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "real-use",
              "kind": "connects_to",
              "label": "REAL USE: REMOVE AN ITEM FROM A LINKED FREE LIST",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Systems code sometimes keeps reusable objects in linked free lists. If `prev.next` points to the node being removed, reconnecting `prev.next` to `node.next` removes that node without shifting every later item.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "reconnect",
                      "text": "reconnecting `prev.next` to `node.next`",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "code",
              "kind": "mental_model",
              "label": "REMOVE AFTER A KNOWN PREDECESSOR",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "unlink.py",
                "language": "python",
                "code": "def remove_after(prev):\n    victim = prev.next\n    if victim is None:\n        return None\n    prev.next = victim.next\n    victim.next = None\n    return victim\n",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "save-victim",
                    "anchor": {
                      "line": 2,
                      "text": "victim = prev.next",
                      "occurrence": 1
                    },
                    "title": "Keep the node reference",
                    "explanation": "Save the node being removed before changing the predecessor link.",
                    "required": true
                  },
                  {
                    "id": "bridge",
                    "anchor": {
                      "line": 5,
                      "text": "prev.next = victim.next",
                      "occurrence": 1
                    },
                    "title": "Bridge around the node",
                    "explanation": "The predecessor now points directly to the removed node's successor.",
                    "required": true
                  }
                ]
              }
            },
            {
              "id": "tradeoff",
              "kind": "not_this",
              "label": "LINKED DOES NOT MEAN FAST RANDOM ACCESS",
              "placeholder": "",
              "required": false,
              "reveal": {
                "type": "text",
                "text": "Linked lists make some local updates cheap, but reaching the i-th node still requires walking through earlier nodes. Choose the structure from the operations the workload needs.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "walk",
                      "text": "requires walking through earlier nodes",
                      "required": true
                    }
                  ]
                }
              }
            }
          ],
          "source_refs": [
