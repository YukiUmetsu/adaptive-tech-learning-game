              "label": "REAL USE: NEXT SCHEDULED EVENT",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "A discrete-event simulator or scheduler repeatedly inserts future events and removes the event with the earliest scheduled time. A min-priority queue directly supports that repeated 'what is next?' workload.",
