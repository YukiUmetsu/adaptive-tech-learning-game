              "id": "code",
              "kind": "mental_model",
              "label": "CURRENT CUTOFF AT THE ROOT",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "top_k.py",
                "language": "python",
                "code": "heap = []\nfor score, item in items:\n    if len(heap) < k:\n        heappush(heap, (score, item))\n    elif score > heap[0][0]:\n        heapreplace(heap, (score, item))\n",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "fill",
                    "anchor": {
