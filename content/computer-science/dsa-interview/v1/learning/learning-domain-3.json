            {
              "id": "table",
              "kind": "mental_model",
              "label": "PATTERN DUEL",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "table",
                "columns": [
                  {
                    "id": "pattern",
                    "label": "Pattern"
                  },
                  {
                    "id": "shape",
                    "label": "Strong clue"
                  },
                  {
                    "id": "real_use",
