      "nodes": [
        {
          "id": "domain-3-fixed-window",
          "title": "Reuse state between same-size neighboring windows",
          "concept_ids": [
            "dsa.window.fixed"
          ],
          "prerequisite_node_ids": [],
          "map_position": {
            "x": 0.12,
            "y": 0.48
          },
          "prompts": [
            {
              "id": "what",
              "kind": "what",
              "label": "WHY IS A FIXED WINDOW CHEAPER THAN RESUMMING EACH RANGE?",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Neighboring windows of the same size overlap almost completely. When the window moves one step, remove the outgoing item and add the incoming item instead of recomputing the whole range.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "overlap",
                      "text": "overlap almost completely",
                      "required": true
                    },
                    {
                      "id": "delta",
                      "text": "remove the outgoing item and add the incoming item",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "real-use",
              "kind": "connects_to",
              "label": "REAL USE: ROLLING TELEMETRY TOTAL",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "rolling_total.py",
                "language": "python",
                "code": "window = sum(readings[:k])\nbest = window\nfor right in range(k, len(readings)):\n    window += readings[right]\n    window -= readings[right - k]\n    best = max(best, window)\n",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "enter",
                    "anchor": {
                      "line": 4,
                      "text": "window += readings[right]",
                      "occurrence": 1
                    },
                    "title": "One item enters",
                    "explanation": "The new rightmost reading was not in the previous window.",
                    "required": true
                  },
                  {
                    "id": "leave",
                    "anchor": {
                      "line": 5,
                      "text": "window -= readings[right - k]",
                      "occurrence": 1
                    },
                    "title": "One item leaves",
                    "explanation": "The oldest reading is removed so the maintained state still describes exactly k readings.",
                    "required": true
                  }
                ]
              }
            },
            {
              "id": "invariant",
              "kind": "mental_model",
              "label": "WINDOW INVARIANT",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "After each update, the maintained state must describe exactly the current k contiguous items. Forgetting either the entering or leaving update breaks the invariant.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "exactly-k",
                      "text": "exactly the current k contiguous items",
                      "required": true
                    }
                  ]
                }
              }
            }
          ],
          "source_refs": [
            {
              "title": "MIT OpenCourseWare 6.006 — Lecture 2: Data Structures and Dynamic Arrays",
              "url": "https://ocw.mit.edu/courses/6-006-introduction-to-algorithms-spring-2020/resources/lecture-2-data-structures-and-dynamic-arrays/"
            },
            {
              "title": "MIT OpenCourseWare 6.006 — Lecture 1: Algorithms and Computation",
              "url": "https://ocw.mit.edu/courses/6-006-introduction-to-algorithms-spring-2020/resources/lecture-1-algorithms-and-computation/"
            }
          ]
        },
        {
          "id": "domain-3-variable-window",
          "title": "Expand, then repair a variable window",
          "concept_ids": [
            "dsa.window.variable"
          ],
          "prerequisite_node_ids": [
            "domain-3-fixed-window"
          ],
          "map_position": {
            "x": 0.42,
            "y": 0.48
          },
          "prompts": [
            {
              "id": "what",
              "kind": "what",
              "label": "WHAT MAKES A VARIABLE WINDOW VALID?",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "A variable window works when one boundary can expand the candidate and moving the other boundary can monotonically repair a violated condition. The key is not merely 'contiguous'; the repair rule must be justified.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "expand",
                      "text": "one boundary can expand the candidate",
                      "required": true
                    },
                    {
                      "id": "repair",
                      "text": "moving the other boundary can monotonically repair a violated condition",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "real-use",
              "kind": "connects_to",
              "label": "REAL USE: EXPIRE REQUESTS OUTSIDE A TRAILING TIME LIMIT",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "recent_requests.py",
                "language": "python",
                "code": "left = 0\nfor right, ts in enumerate(timestamps):\n    while ts - timestamps[left] >= 60:\n        left += 1\n    recent_count = right - left + 1\n",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "repair",
                    "anchor": {
                      "line": 3,
                      "text": "while ts - timestamps[left] >= 60:",
                      "occurrence": 1
                    },
                    "title": "Repair by expiring the oldest requests",
                    "explanation": "Because timestamps are ordered, moving left forward can only remove older requests from the active range.",
                    "required": true
                  },
                  {
                    "id": "active-range",
                    "anchor": {
                      "line": 5,
                      "text": "right - left + 1",
                      "occurrence": 1
                    },
                    "title": "Contiguous active range",
                    "explanation": "The window contains exactly the requests still inside the trailing time condition.",
                    "required": true
                  }
                ]
              }
            },
            {
              "id": "budget",
              "kind": "connects_to",
              "label": "ANOTHER REAL USE: POSITIVE-SIZE BUDGET",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "If all item sizes are non-negative and a contiguous batch must stay under a byte budget, adding items cannot reduce the sum and removing items from the left cannot increase it. That monotonic relationship justifies expand/shrink repair.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "nonnegative",
                      "text": "all item sizes are non-negative",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "warning",
              "kind": "not_this",
              "label": "SIGNED VALUES CAN BREAK THE REPAIR RULE",
              "placeholder": "",
              "required": false,
              "reveal": {
                "type": "text",
                "text": "With arbitrary positive and negative values, shrinking from the left does not reliably move a sum toward a target. Prefix-state methods may fit those problems better.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "signed",
                      "text": "arbitrary positive and negative values",
                      "required": true
                    }
                  ]
                }
              }
            }
          ],
          "source_refs": [
