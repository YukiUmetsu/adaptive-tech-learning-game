      "nodes": [
        {
          "id": "domain-3-opposing-pointers",
          "title": "Use order to discard pair candidates from both ends",
          "concept_ids": [
            "dsa.two_pointers.opposing"
          ],
          "prerequisite_node_ids": [],
          "map_position": {
            "x": 0.12,
            "y": 0.14
          },
          "prompts": [
            {
              "id": "what",
              "kind": "what",
              "label": "WHAT MAKES OPPOSING POINTERS WORK?",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "When values are ordered, a comparison at the two ends can prove that many candidate pairs are impossible. Move the boundary whose change can move the pair toward the target instead of checking every pair.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "ordered",
                      "text": "When values are ordered",
                      "required": true
                    },
                    {
                      "id": "discard",
                      "text": "prove that many candidate pairs are impossible",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "real-use",
              "kind": "connects_to",
              "label": "REAL USE: PAIR TWO SORTED RESOURCE SIZES",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Suppose sorted job sizes must be paired to exactly fill a capacity. If the smallest + largest is too small, keeping the same smallest value with any smaller right value cannot help, so the left boundary must move. If the sum is too large, the right boundary must move.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "too-small",
                      "text": "too small",
                      "required": true
                    },
                    {
                      "id": "too-large",
                      "text": "too large",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "code",
              "kind": "mental_model",
              "label": "THE ELIMINATION LOOP",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "sorted_pair.py",
                "language": "python",
                "code": "left, right = 0, len(values) - 1\nwhile left < right:\n    total = values[left] + values[right]\n    if total == target:\n        return left, right\n    if total < target:\n        left += 1\n    else:\n        right -= 1\nreturn None\n",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "left-move",
                    "anchor": {
                      "line": 7,
                      "text": "left += 1",
                      "occurrence": 1
                    },
                    "title": "Too small",
                    "explanation": "With the same left value, any smaller right value would make the sum no larger, so left can be discarded.",
                    "required": true
                  },
                  {
                    "id": "right-move",
                    "anchor": {
                      "line": 9,
                      "text": "right -= 1",
                      "occurrence": 1
                    },
                    "title": "Too large",
                    "explanation": "With the same right value, any larger left value would make the sum no smaller, so right can be discarded.",
                    "required": true
                  }
                ]
              }
            },
            {
              "id": "not-this",
              "kind": "not_this",
              "label": "ORDER IS THE REASON, NOT THE POINTERS THEMSELVES",
              "placeholder": "",
              "required": false,
              "reveal": {
                "type": "text",
                "text": "On unsorted values, the same boundary moves are not justified. Either establish usable order first or choose a different strategy such as maintained lookup state.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "reason",
                      "text": "the same boundary moves are not justified",
                      "required": true
                    }
                  ]
                }
              }
            }
          ],
          "source_refs": [
            {
              "title": "MIT OpenCourseWare 6.006 — Lecture 3: Sets and Sorting",
              "url": "https://ocw.mit.edu/courses/6-006-introduction-to-algorithms-spring-2020/resources/lecture-3-sets-and-sorting/"
            },
            {
              "title": "MIT OpenCourseWare 6.006 — Lecture 1: Algorithms and Computation",
              "url": "https://ocw.mit.edu/courses/6-006-introduction-to-algorithms-spring-2020/resources/lecture-1-algorithms-and-computation/"
            }
          ],
          "glossary": [
            {
              "term": "candidate",
              "definition": "A value, pair, range, or state that could still satisfy the problem until evidence rules it out."
            }
          ]
        },
        {
          "id": "domain-3-read-write",
          "title": "Compact a sequence with read/write pointers",
          "concept_ids": [
            "dsa.two_pointers.read_write"
          ],
          "prerequisite_node_ids": [
            "domain-3-opposing-pointers"
          ],
          "map_position": {
            "x": 0.42,
            "y": 0.14
          },
          "prompts": [
            {
              "id": "what",
              "kind": "what",
              "label": "WHAT DO READ AND WRITE MEAN?",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "The read pointer examines each input item. The write pointer marks the next output position for an item you keep. The processed output prefix remains valid and compact.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "read",
                      "text": "read pointer examines each input item",
                      "required": true
                    },
                    {
                      "id": "write",
                      "text": "write pointer marks the next output position",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "real-use",
              "kind": "connects_to",
              "label": "REAL USE: COMPACT TOMBSTONED RECORDS IN PLACE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "compact.py",
                "language": "python",
                "code": "write = 0\nfor read in range(len(records)):\n    if not records[read].deleted:\n        records[write] = records[read]\n        write += 1\nreturn write\n",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "write-prefix",
                    "anchor": {
                      "line": 4,
                      "text": "records[write] = records[read]",
                      "occurrence": 1
                    },
                    "title": "Stable compacted prefix",
                    "explanation": "Accepted records are copied in read order, so the prefix records[:write] contains exactly the kept records in their original relative order.",
                    "required": true
                  },
                  {
                    "id": "advance-only-kept",
                    "anchor": {
                      "line": 5,
                      "text": "write += 1",
                      "occurrence": 1
                    },
                    "title": "Write advances only when keeping an item",
                    "explanation": "Discarded records do not consume output positions.",
                    "required": true
                  }
                ]
              }
            },
            {
              "id": "when",
              "kind": "when",
              "label": "WHEN IS THIS BETTER THAN BUILDING A NEW LIST?",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Use read/write compaction when the contract permits in-place mutation and preserving a compact prefix is useful. If mutation is forbidden or clarity matters more than allocation, creating a new output list may be the better engineering choice.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "contract",
                      "text": "contract permits in-place mutation",
                      "required": true
                    }
                  ]
                }
              }
            }
          ],
          "source_refs": [
            {
              "title": "MIT OpenCourseWare 6.006 — Lecture 2: Data Structures and Dynamic Arrays",
              "url": "https://ocw.mit.edu/courses/6-006-introduction-to-algorithms-spring-2020/resources/lecture-2-data-structures-and-dynamic-arrays/"
            },
            {
              "title": "MIT OpenCourseWare 6.006 — Lecture 1: Algorithms and Computation",
              "url": "https://ocw.mit.edu/courses/6-006-introduction-to-algorithms-spring-2020/resources/lecture-1-algorithms-and-computation/"
            }
          ]
        },
        {
          "id": "domain-3-fast-slow",
          "title": "Use relative pointer speed to expose cycles or distance",
          "concept_ids": [
            "dsa.two_pointers.fast_slow"
          ],
          "prerequisite_node_ids": [
            "domain-3-read-write"
          ],
          "map_position": {
            "x": 0.72,
            "y": 0.14
          },
          "prompts": [
            {
              "id": "what",
              "kind": "what",
              "label": "WHAT DOES FAST/SLOW TRACK?",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Two traversals move through the same linked progression at different rates or with a maintained gap. Their relative position can reveal structure without storing every visited node.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "relative",
                      "text": "relative position",
                      "required": true
                    },
                    {
                      "id": "no-store",
                      "text": "without storing every visited node",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "real-use",
              "kind": "connects_to",
              "label": "REAL USE: DETECT A LOOP IN A LINKED WORKFLOW CHAIN",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "If each workflow state points to its next state, a corrupted configuration can accidentally form a cycle. A slow pointer moving one step and a fast pointer moving two steps will eventually meet if both remain inside the same finite cycle.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "cycle",
                      "text": "will eventually meet",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "comparison",
              "kind": "not_this",
              "label": "FAST/SLOW VS VISITED SET",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "comparison",
                "columns": [
                  {
                    "title": "Fast/slow",
                    "items": [
                      "O(1) extra pointer state",
                      "Works when traversal follows one next link at a time",
                      "Good for cycle/midpoint/gap relationships"
                    ]
                  },
                  {
                    "title": "Visited set",
                    "items": [
                      "Stores encountered identities",
                      "Works for more general traversal shapes",
                      "Uses O(number of visited items) extra memory"
                    ]
                  }
                ]
              }
            },
            {
              "id": "warning",
              "kind": "not_this",
              "label": "DO NOT GENERALIZE IT TO ARBITRARY GRAPHS",
              "placeholder": "",
              "required": false,
              "reveal": {
                "type": "text",
                "text": "The classic fast/slow technique assumes a single deterministic next step from each current state. General graph cycle detection needs different traversal state.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "single-next",
                      "text": "single deterministic next step",
                      "required": true
                    }
                  ]
                }
              }
            }
          ],
          "source_refs": [
            {
              "title": "Wikipedia — Cycle detection",
              "url": "https://en.wikipedia.org/wiki/Cycle_detection"
            },
            {
              "title": "MIT OpenCourseWare 6.006 — Lecture 1: Algorithms and Computation",
              "url": "https://ocw.mit.edu/courses/6-006-introduction-to-algorithms-spring-2020/resources/lecture-1-algorithms-and-computation/"
            }
          ]
        }
      ]
    },
