          "id": "domain-3-interval-sort-merge",
          "title": "Sort intervals before merging overlap",
          "concept_ids": [
            "dsa.intervals.sort_merge"
          ],
          "prerequisite_node_ids": [],
          "map_position": {
            "x": 0.12,
            "y": 0.82
          },
          "prompts": [
            {
              "id": "what",
              "kind": "what",
              "label": "WHY SORT INTERVALS FIRST?",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Sorting by start boundary turns a global overlap problem into a local scan. After sorting, if the next interval starts after the current merged end, it cannot overlap that current merged interval.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "local",
                      "text": "global overlap problem into a local scan",
                      "required": true
                    },
                    {
                      "id": "frontier",
                      "text": "current merged end",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "real-use",
              "kind": "connects_to",
              "label": "REAL USE: CONSOLIDATE MAINTENANCE WINDOWS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "merge_windows.py",
                "language": "python",
                "code": "intervals.sort(key=lambda x: x[0])\nmerged = []\nfor start, end in intervals:\n    if not merged or start > merged[-1][1]:\n        merged.append([start, end])\n    else:\n        merged[-1][1] = max(merged[-1][1], end)\n",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "sort",
                    "anchor": {
                      "line": 1,
                      "text": "intervals.sort",
                      "occurrence": 1
                    },
                    "title": "Establish start order",
                    "explanation": "Once starts are nondecreasing, any overlap with the processed frontier can be decided against the last merged interval.",
                    "required": true
                  },
                  {
                    "id": "merge",
                    "anchor": {
                      "line": 7,
                      "text": "max(merged[-1][1], end)",
                      "occurrence": 1
                    },
                    "title": "Extend the current union",
                    "explanation": "An overlapping interval can only extend the merged end; it never moves the start backward after sorting.",
                    "required": true
                  }
                ]
              }
            },
            {
              "id": "complexity",
              "kind": "mental_model",
              "label": "COST",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "The scan is linear after sorting. The dominant cost is usually the O(n log n) comparison sort, followed by O(n) merging.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "sort-cost",
                      "text": "O(n log n)",
                      "required": true
                    },
                    {
                      "id": "scan-cost",
                      "text": "O(n)",
                      "required": true
                    }
                  ]
                }
              }
            }
          ],
