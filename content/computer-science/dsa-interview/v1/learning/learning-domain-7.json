  "glossary": [
    {
      "term": "frontier",
      "definition": "Discovered graph vertices waiting to be processed."
    },
    {
      "term": "component",
      "definition": "A set of vertices connected to one another under the graph's connectivity rule."
    },
    {
      "term": "topological order",
      "definition": "An ordering of a DAG where every prerequisite appears before each dependent vertex."
    },
    {
      "term": "relaxation",
      "definition": "Trying an edge to see whether it improves the best known path cost to its destination."
    },
    {
      "term": "tentative distance",
      "definition": "The best path cost to a vertex known so far, before finalization."
    }
