              "label": "WHAT DOES DIJKSTRA FINALIZE?",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Dijkstra repeatedly selects the unsettled vertex with the smallest tentative distance. With non-negative edge weights, once that vertex is selected, no later path through a more distant unsettled vertex can improve it.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "smallest",
                      "text": "smallest tentative distance",
                      "required": true
                    },
                    {
