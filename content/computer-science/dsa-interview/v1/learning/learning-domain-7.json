        {
          "id": "domain-7-graph-model",
          "title": "Model relationships explicitly and mark discoveries",
          "concept_ids": [
            "dsa.graph.model_visited"
          ],
          "prerequisite_node_ids": [],
          "map_position": {
            "x": 0.12,
            "y": 0.14
          },
          "prompts": [
            {
              "id": "what",
              "kind": "what",
              "label": "WHEN IS SOMETHING A GRAPH?",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Use a graph model when entities can relate to many other entities rather than forming one simple sequence or hierarchy. Vertices represent entities; edges represent relationships or allowed transitions.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "vertices",
                      "text": "Vertices represent entities",
                      "required": true
                    },
                    {
                      "id": "edges",
                      "text": "edges represent relationships",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "real-use",
              "kind": "connects_to",
              "label": "REAL USE: SERVICE DEPENDENCY MAP",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Microservices form a graph when one service calls several others and a downstream service may be shared by multiple callers. A traversal can answer reachability such as 'which services could be affected if this dependency fails?'",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "shared",
                      "text": "shared by multiple callers",
                      "required": true
                    },
                    {
                      "id": "reach",
                      "text": "which services could be affected",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "visited",
              "kind": "mental_model",
              "label": "WHY VISITED STATE MATTERS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Graphs can contain cycles and multiple paths to the same vertex. Marking discovery prevents the traversal from repeatedly re-enqueuing or recursing into the same region.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "cycles",
                      "text": "cycles and multiple paths",
                      "required": true
                    },
                    {
                      "id": "mark",
                      "text": "Marking discovery prevents",
                      "required": true
                    }
                  ]
                }
              }
            }
          ],
          "source_refs": [
            {
              "title": "Princeton Algorithms — Graphs",
              "url": "https://algs4.cs.princeton.edu/40graphs/"
            },
            {
              "title": "MIT OpenCourseWare 6.006 — Breadth-First Search",
