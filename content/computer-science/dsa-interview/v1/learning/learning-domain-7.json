        {
          "id": "domain-7-bfs",
          "title": "Use BFS when edge count is the distance",
          "concept_ids": [
            "dsa.graph.bfs_unweighted"
          ],
          "prerequisite_node_ids": [
            "domain-7-graph-model"
          ],
          "map_position": {
            "x": 0.42,
            "y": 0.14
          },
          "prompts": [
            {
              "id": "what",
              "kind": "what",
              "label": "WHY DOES BFS FIND SHORTEST HOP COUNT?",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "A FIFO frontier discovers every vertex at distance d edges before any vertex at distance d+1. The first time an unweighted vertex is discovered therefore gives a shortest number-of-edges path from the source.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "fifo",
                      "text": "FIFO frontier",
                      "required": true
                    },
                    {
                      "id": "first",
                      "text": "first time an unweighted vertex is discovered",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "real-use",
              "kind": "connects_to",
              "label": "REAL USE: MINIMUM SERVICE HOPS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "If every service-to-service call counts as one hop, BFS can find the minimum number of dependency hops from an entry service to a target service. It answers hop distance, not latency.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "hop",
                      "text": "one hop",
                      "required": true
                    },
                    {
                      "id": "notlatency",
                      "text": "not latency",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "code",
              "kind": "mental_model",
              "label": "DISCOVER ON ENQUEUE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "bfs.py",
                "language": "python",
                "code": "from collections import deque\nq = deque([source])\ndist = {source: 0}\nwhile q:\n    u = q.popleft()\n    for v in graph[u]:\n        if v not in dist:\n            dist[v] = dist[u] + 1\n            q.append(v)\n",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "discover",
                    "anchor": {
                      "line": 7,
                      "text": "if v not in dist:",
                      "occurrence": 1
                    },
                    "title": "Discover once",
                    "explanation": "The first discovery already has the shortest hop distance in an unweighted graph.",
                    "required": true
                  },
                  {
                    "id": "distance",
                    "anchor": {
                      "line": 8,
                      "text": "dist[v] = dist[u] + 1",
                      "occurrence": 1
                    },
                    "title": "One more edge",
                    "explanation": "Every traversed edge contributes the same unit cost.",
                    "required": true
                  }
                ]
              }
            }
          ],
          "source_refs": [
            {
              "title": "MIT OpenCourseWare 6.006 — Breadth-First Search",
              "url": "https://ocw.mit.edu/courses/6-006-introduction-to-algorithms-spring-2020/pages/lecture-notes/"
            },
            {
              "title": "Princeton Algorithms — Graphs",
              "url": "https://algs4.cs.princeton.edu/40graphs/"
            }
          ]
        },
        {
          "id": "domain-7-dfs",
          "title": "Use DFS to expose deep structure and cycles",
          "concept_ids": [
            "dsa.graph.dfs_structure",
            "dsa.graph.cycle_state"
          ],
          "prerequisite_node_ids": [
            "domain-7-graph-model"
          ],
          "map_position": {
            "x": 0.72,
            "y": 0.14
          },
          "prompts": [
            {
              "id": "what",
              "kind": "what",
              "label": "WHAT DOES DFS TRACK?",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "DFS explores one branch until it cannot continue, then backtracks. For directed-cycle detection, it is useful to distinguish vertices currently on the active recursion path from vertices whose exploration is completely finished.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "deep",
                      "text": "one branch until it cannot continue",
                      "required": true
                    },
                    {
                      "id": "active",
                      "text": "currently on the active recursion path",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "real-use",
              "kind": "connects_to",
              "label": "REAL USE: DETECT A CYCLE IN MODULE IMPORTS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "If module A imports B, B imports C, and C imports A, there is a directed dependency cycle. During DFS, reaching an already-active ancestor is evidence of such a cycle.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "cycle",
                      "text": "reaching an already-active ancestor",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "not-this",
              "kind": "not_this",
              "label": "VISITED ALONE IS NOT ENOUGH FOR DIRECTED-CYCLE DETECTION",
              "placeholder": "",
              "required": false,
              "reveal": {
                "type": "text",
                "text": "A previously visited vertex may belong to a completely finished branch and does not by itself prove a cycle. The important distinction is active/on-path versus finished.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "distinction",
                      "text": "active/on-path versus finished",
                      "required": true
                    }
                  ]
                }
              }
            }
          ],
          "source_refs": [
            {
              "title": "MIT OpenCourseWare 6.006 — Depth-First Search",
              "url": "https://ocw.mit.edu/courses/6-006-introduction-to-algorithms-spring-2020/pages/lecture-notes/"
            },
            {
              "title": "Princeton Algorithms — Directed Graphs",
              "url": "https://algs4.cs.princeton.edu/42digraph/"
            }
          ]
        }
      ]
    },
