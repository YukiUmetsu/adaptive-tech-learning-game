              "kind": "connects_to",
              "label": "REAL USE: LOWEST-LATENCY SERVICE ROUTE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "If service-call edges carry non-negative latency estimates, Dijkstra can compute the minimum total estimated latency from one service to others. This is different from BFS, which minimizes edge count regardless of latency.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "latency",
                      "text": "minimum total estimated latency",
                      "required": true
                    },
