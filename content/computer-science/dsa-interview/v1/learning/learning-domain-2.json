          "prompts": [
            {
              "id": "what",
              "kind": "what",
              "label": "WHAT IS A COMPLEMENT LOOKUP?",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "When two values must satisfy a relationship such as a + b = target, the current value a tells you exactly what counterpart is needed: target - a. Store earlier values so that counterpart can be looked up directly.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "missing",
                      "text": "exactly what counterpart is needed",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "real-use",
              "kind": "connects_to",
              "label": "REAL USE: MATCH TWO ALLOCATIONS TO A FIXED CAPACITY",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Suppose two queued jobs must exactly fill a fixed capacity budget. For each job size, compute the remaining capacity and ask whether an earlier job had that size. The same structure appears in classic pair-sum interview problems.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "remaining",
                      "text": "compute the remaining capacity",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "code",
              "kind": "mental_model",
              "label": "STORE WHAT THE OUTPUT NEEDS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "pair_indices.py",
                "language": "python",
                "code": "seen_index = {}\nfor i, value in enumerate(values):\n    need = target - value\n    if need in seen_index:\n        return seen_index[need], i\n    seen_index[value] = i\n",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "lookup",
                    "anchor": {
                      "line": 4,
                      "text": "need in seen_index",
                      "occurrence": 1
                    },
                    "title": "Ask one direct question",
                    "explanation": "The current value determines the only counterpart that could complete the target.",
                    "required": true
                  },
                  {
                    "id": "index",
                    "anchor": {
                      "line": 6,
                      "text": "seen_index[value] = i",
                      "occurrence": 1
                    },
                    "title": "Map, not set",
                    "explanation": "The output needs indices, so the state stores an index for each earlier value.",
                    "required": true
                  }
                ]
