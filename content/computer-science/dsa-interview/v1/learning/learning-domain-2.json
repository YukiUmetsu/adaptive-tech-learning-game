          },
          "prompts": [
            {
              "id": "what",
              "kind": "what",
              "label": "WHAT IS SINGLE-PASS STATE?",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "As you scan left to right, maintain a small summary of the processed prefix instead of rescanning earlier items. The summary might be a count, best-so-far value, previous item, or a hash-based structure.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "summary",
                      "text": "maintain a small summary of the processed prefix",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "code",
              "kind": "mental_model",
              "label": "EXAMPLE: VALIDATE A MONOTONIC TELEMETRY SERIES",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "monotonic.py",
                "language": "python",
                "code": "def is_non_decreasing(readings):\n    for i in range(1, len(readings)):\n        if readings[i] < readings[i - 1]:\n            return False\n    return True\n",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "local-state",
                    "anchor": {
                      "line": 3,
                      "text": "readings[i] < readings[i - 1]",
                      "occurrence": 1
                    },
                    "title": "Only the previous position matters",
                    "explanation": "The property can be checked with one comparison per adjacent pair; there is no reason to rescan the whole prefix.",
                    "required": true
                  }
                ]
              }
            },
            {
              "id": "real-use",
              "kind": "connects_to",
              "label": "REAL USE: STREAM AND BATCH VALIDATION",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "The same reasoning appears when validating sorted timestamps, detecting a change from the previous record, computing a running maximum, or checking a stream for a local ordering violation.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "stream",
                      "text": "validating sorted timestamps",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "action",
              "kind": "action",
              "label": "ASK THIS DURING A SCAN",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "What fact from the already-processed prefix will the next item need? Store that fact directly instead of storing or rescanning more than necessary.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "fact",
                      "text": "What fact from the already-processed prefix will the next item need?",
                      "required": true
                    }
                  ]
                }
              }
            }
