      "nodes": [
        {
          "id": "domain-2-prefix-build",
          "title": "Store cumulative state at every boundary",
          "concept_ids": [
            "dsa.prefix.range_sum"
          ],
          "prerequisite_node_ids": [],
          "map_position": {
            "x": 0.18,
            "y": 0.82
          },
          "prompts": [
            {
              "id": "what",
              "kind": "what",
              "label": "WHAT IS A PREFIX SUM?",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "A prefix array stores cumulative totals at sequence boundaries. A convenient convention is prefix[0] = 0 and prefix[i + 1] = prefix[i] + values[i].",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "boundary",
                      "text": "at sequence boundaries",
                      "required": true
                    },
                    {
                      "id": "zero",
                      "text": "prefix[0] = 0",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "code",
              "kind": "mental_model",
              "label": "BUILD PREFIX TOTALS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "prefix.py",
                "language": "python",
                "code": "prefix = [0]\nfor value in values:\n    prefix.append(prefix[-1] + value)\n",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "empty-prefix",
                    "anchor": {
                      "line": 1,
                      "text": "prefix = [0]",
                      "occurrence": 1
                    },
                    "title": "Boundary before the first item",
                    "explanation": "The initial zero makes half-open ranges work cleanly, including ranges that start at index 0.",
                    "required": true
                  },
                  {
                    "id": "append",
                    "anchor": {
                      "line": 3,
                      "text": "prefix.append(prefix[-1] + value)",
                      "occurrence": 1
                    },
                    "title": "One cumulative update per value",
                    "explanation": "Building all prefix totals costs one pass over the input.",
                    "required": true
                  }
                ]
              }
            },
            {
              "id": "real-use",
              "kind": "connects_to",
              "label": "REAL USE: REPEATED DASHBOARD RANGE TOTALS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "If a static daily-usage array is queried many times for totals over different date ranges, precomputing prefix totals avoids summing the same days again for every query.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "many",
                      "text": "queried many times",
                      "required": true
                    },
                    {
                      "id": "avoid",
                      "text": "avoids summing the same days again",
                      "required": true
                    }
                  ]
                }
              }
            }
          ],
          "source_refs": [
            {
              "title": "Princeton Competitive Programming — Prefix Sums",
              "url": "https://competitive-programming.cs.princeton.edu/ps_s24"
            }
          ],
          "glossary": [
            {
              "term": "prefix",
              "definition": "The part of a sequence from the beginning up to a chosen boundary."
            },
            {
              "term": "half-open range",
              "definition": "A range [l, r) that includes l and excludes r."
            }
          ]
        },
        {
          "id": "domain-2-prefix-range-query",
          "title": "Answer a range from two prefix boundaries",
          "concept_ids": [
            "dsa.prefix.range_sum"
          ],
          "prerequisite_node_ids": [
            "domain-2-prefix-build"
          ],
          "map_position": {
            "x": 0.48,
            "y": 0.82
          },
          "prompts": [
            {
              "id": "what",
              "kind": "what",
              "label": "WHY DOES SUBTRACTION WORK?",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "For a half-open range [l, r), prefix[r] contains everything before r and prefix[l] contains everything before l. Subtracting removes the earlier part, leaving exactly the requested range.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "formula",
                      "text": "prefix[r]",
                      "required": true
                    },
                    {
                      "id": "remove",
                      "text": "Subtracting removes the earlier part",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "formula",
              "kind": "mental_model",
              "label": "THE RANGE FORMULA",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "table",
                "columns": [
                  {
                    "id": "piece",
                    "label": "Piece"
                  },
                  {
                    "id": "meaning",
                    "label": "Meaning"
                  }
                ],
                "rows": [
                  {
                    "id": "pr",
                    "cells": {
                      "piece": "prefix[r]",
                      "meaning": "sum of values[0:r]"
                    }
                  },
                  {
                    "id": "pl",
                    "cells": {
                      "piece": "prefix[l]",
                      "meaning": "sum of values[0:l]"
                    }
                  },
                  {
                    "id": "range",
                    "cells": {
                      "piece": "prefix[r] - prefix[l]",
                      "meaning": "sum of values[l:r]"
                    }
                  }
                ],
                "progressive_reveal": {
                  "mode": "row",
                  "initially_visible": {
                    "column_ids": [
                      "piece"
                    ],
                    "row_ids": [],
                    "cell_ids": []
                  }
                }
              }
            },
            {
              "id": "real-use",
              "kind": "connects_to",
              "label": "TRADE-OFF: FAST QUERIES, EXTRA PRECOMPUTATION",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Prefix sums are especially useful when the underlying values are static or change rarely and many range-sum queries follow. If values change frequently, a different data structure may be more appropriate.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "static",
                      "text": "static or change rarely",
                      "required": true
                    },
                    {
                      "id": "many-queries",
                      "text": "many range-sum queries",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "offbyone",
              "kind": "not_this",
              "label": "MOST COMMON FAILURE: MIXING RANGE CONVENTIONS",
              "placeholder": "",
              "required": false,
              "reveal": {
                "type": "text",
                "text": "Do not mix inclusive [l, r] indexing with the half-open prefix formula without adjusting the boundary. Pick one convention and state it.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "convention",
                      "text": "Pick one convention and state it",
                      "required": true
                    }
                  ]
                }
              }
            }
          ],
          "source_refs": [
            {
              "title": "Princeton Competitive Programming — Prefix Sums",
              "url": "https://competitive-programming.cs.princeton.edu/ps_s24"
            }
          ]
        },
        {
          "id": "domain-2-prefix-hash",
          "title": "Hash earlier prefix states to find target intervals",
          "concept_ids": [
            "dsa.prefix.hash_state"
          ],
          "prerequisite_node_ids": [
            "domain-2-prefix-range-query",
            "domain-2-hash-frequency"
          ],
          "map_position": {
            "x": 0.78,
            "y": 0.82
          },
          "prompts": [
            {
              "id": "what",
              "kind": "what",
              "label": "FROM RANGE SUM TO PREFIX RELATION",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "If prefix[j] - prefix[i] = target, then prefix[i] = prefix[j] - target. While scanning, the current prefix therefore tells you which earlier prefix value would make a matching contiguous interval.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "relation",
                      "text": "prefix[i] = prefix[j] - target",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "code",
              "kind": "mental_model",
              "label": "COUNT MATCHING CONTIGUOUS INTERVALS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "count_target_ranges.py",
                "language": "python",
                "code": "seen = {0: 1}\nprefix = 0\nmatches = 0\nfor value in values:\n    prefix += value\n    matches += seen.get(prefix - target, 0)\n    seen[prefix] = seen.get(prefix, 0) + 1\n",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "zero-state",
                    "anchor": {
                      "line": 1,
                      "text": "seen = {0: 1}",
                      "occurrence": 1
                    },
                    "title": "Prefix before the sequence",
                    "explanation": "The initial zero lets an interval starting at index 0 be counted.",
                    "required": true
                  },
                  {
                    "id": "need-prefix",
                    "anchor": {
                      "line": 6,
                      "text": "seen.get(prefix - target, 0)",
                      "occurrence": 1
                    },
                    "title": "Look up the needed earlier prefix",
                    "explanation": "Every earlier prefix equal to current_prefix - target defines one matching interval ending here.",
                    "required": true
                  },
                  {
                    "id": "frequency",
                    "anchor": {
                      "line": 7,
                      "text": "seen[prefix] = seen.get(prefix, 0) + 1",
                      "occurrence": 1
                    },
                    "title": "Counts matter",
                    "explanation": "The same prefix value can occur multiple times, so a frequency map is needed when counting all intervals.",
                    "required": true
                  }
                ]
              }
            },
            {
              "id": "real-use",
              "kind": "connects_to",
              "label": "REAL USE: FIND A CONTIGUOUS PERIOD WITH A TARGET NET CHANGE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "If a time-ordered series contains positive and negative deltas, the same prefix relation can detect or count contiguous periods whose net change equals a target without enumerating every possible period.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "deltas",
                      "text": "positive and negative deltas",
                      "required": true
                    },
                    {
                      "id": "period",
                      "text": "contiguous periods whose net change equals a target",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "not-sliding",
              "kind": "not_this",
              "label": "WHY THIS IS DIFFERENT FROM A VARIABLE WINDOW",
              "placeholder": "",
              "required": false,
              "reveal": {
                "type": "text",
                "text": "With arbitrary positive and negative values, growing or shrinking a window does not move the sum monotonically. Prefix-state lookup works without assuming that monotonic behavior.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "negative",
                      "text": "arbitrary positive and negative values",
                      "required": true
                    }
                  ]
                }
              }
            }
          ],
