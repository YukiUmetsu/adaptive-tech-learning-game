        {
          "id": "domain-2-sequence-semantics",
          "title": "Keep the sequence information the contract needs",
          "concept_ids": [
            "dsa.sequence.order_position"
          ],
          "prerequisite_node_ids": [],
          "map_position": {
            "x": 0.12,
            "y": 0.14
          },
          "prompts": [
            {
              "id": "what",
              "kind": "what",
              "label": "WHAT MAKES A SEQUENCE DIFFERENT FROM A SET?",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "A sequence gives each item a position. Order and duplicates may be part of the meaning. Replacing a sequence with a set is only safe when the contract truly does not need position, order, or duplicate counts.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "position",
                      "text": "gives each item a position",
                      "required": true
                    },
                    {
                      "id": "safe-set",
                      "text": "only safe when the contract truly does not need position, order, or duplicate counts",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "real-use",
              "kind": "connects_to",
              "label": "WHERE THIS SHOWS UP IN REAL SOFTWARE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "bullets",
                "items": [
                  "Audit logs: first occurrence and event order can matter.",
                  "API results: callers may rely on stable ordering and duplicate records may be meaningful data defects.",
                  "Text/token processing: character or token position can change meaning."
                ]
              }
            },
            {
              "id": "compare",
              "kind": "not_this",
              "label": "LIST/ARRAY VS SET",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "comparison",
                "columns": [
                  {
                    "title": "Keep sequence semantics",
                    "items": [
                      "Need original index or first/last occurrence",
                      "Need duplicates",
                      "Need adjacency or relative order"
                    ]
                  },
                  {
                    "title": "Set may fit",
                    "items": [
                      "Only unique membership matters",
                      "Original positions do not matter",
                      "Duplicate count does not matter"
                    ]
                  }
                ]
              }
            }
          ],
          "source_refs": [
            {
              "title": "MIT OpenCourseWare 6.006 — Lecture 2: Data Structures and Dynamic Arrays",
