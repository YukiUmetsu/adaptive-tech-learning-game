        {
          "id": "domain-2-single-pass-state",
          "title": "Scan once and carry only the state you need",
          "concept_ids": [
            "dsa.sequence.single_pass_state"
          ],
          "prerequisite_node_ids": [
            "domain-2-sequence-semantics"
