                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "real-use",
              "kind": "connects_to",
              "label": "REAL USE: IDEMPOTENCY AND EVENT DEDUPLICATION",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "dedupe.py",
                "language": "python",
                "code": "seen = set()\nfor event in events:\n    if event.request_id in seen:\n        continue\n    seen.add(event.request_id)\n    process(event)\n",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "membership",
                    "anchor": {
                      "line": 3,
                      "text": "event.request_id in seen",
                      "occurrence": 1
                    },
                    "title": "The expensive repeated question",
                    "explanation": "Membership state avoids rescanning all previously processed request IDs.",
                    "required": true
                  },
                  {
                    "id": "record",
