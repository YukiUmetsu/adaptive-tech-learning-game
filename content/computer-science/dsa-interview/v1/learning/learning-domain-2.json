              "label": "WHAT PROBLEM DOES MEMBERSHIP STATE REMOVE?",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "If the baseline repeatedly scans earlier items only to ask whether a key has appeared before, maintain the seen keys. A hash-based set is a natural implementation when only presence matters.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "question",
                      "text": "whether a key has appeared before",
                      "required": true
                    },
