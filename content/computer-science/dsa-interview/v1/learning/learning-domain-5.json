              "label": "WHAT DOES STABLE SORT MEAN?",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "A stable sort preserves the relative order of records whose sort keys compare equal. That matters when earlier ordering already encodes a secondary priority or arrival sequence.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "stable",
                      "text": "preserves the relative order",
                      "required": true
                    }
