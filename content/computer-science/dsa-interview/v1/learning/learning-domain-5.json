              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "If two changelog feeds are individually timestamp-sorted, compare only their front items. Emit the earlier one and advance that feed. This ordered frontier reasoning merges both in linear total work without resorting the combined data.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "front",
                      "text": "compare only their front items",
                      "required": true
                    }
                  ]
                }
