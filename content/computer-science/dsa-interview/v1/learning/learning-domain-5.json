              "id": "real-use",
              "kind": "connects_to",
              "label": "REAL USE: PRIORITY THEN ARRIVAL ORDER",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "If records are already in arrival order and you stably sort by priority, equal-priority records remain in arrival order. Python's sorting is stable, so multi-pass sorting can deliberately preserve earlier tie ordering.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "arrival",
                      "text": "equal-priority records remain in arrival order",
                      "required": true
                    }
