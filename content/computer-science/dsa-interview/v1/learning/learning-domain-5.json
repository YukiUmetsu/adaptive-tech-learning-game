      "nodes": [
        {
          "id": "domain-5-binary-exact",
          "title": "Use sorted order to eliminate half the candidates",
          "concept_ids": [
            "dsa.binary.exact"
          ],
          "prerequisite_node_ids": [],
          "map_position": {
            "x": 0.12,
            "y": 0.14
          },
          "prompts": [
            {
              "id": "what",
              "kind": "what",
              "label": "WHY DOES BINARY SEARCH NEED ORDER?",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "At a midpoint, sorted order tells you which half cannot contain the target. If the midpoint value is too small, every earlier value is also too small; if it is too large, every later value is also too large.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "half",
                      "text": "which half cannot contain the target",
                      "required": true
                    },
                    {
                      "id": "proof",
                      "text": "every earlier value is also too small",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "real-use",
              "kind": "connects_to",
              "label": "REAL USE: FIND AN EXACT TIMESTAMP OR VERSION IN A SORTED INDEX",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "A service may keep sorted timestamps, release versions, or sequence numbers. When the exact key is needed, binary search avoids scanning every record and can locate or reject the key in logarithmic comparisons.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "index",
                      "text": "sorted timestamps, release versions, or sequence numbers",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "code",
              "kind": "mental_model",
              "label": "EXACT-MATCH LOOP",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "binary_search.py",
                "language": "python",
                "code": "left, right = 0, len(values) - 1\nwhile left <= right:\n    mid = (left + right) // 2\n    if values[mid] == target:\n        return mid\n    if values[mid] < target:\n        left = mid + 1\n    else:\n        right = mid - 1\nreturn -1\n",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "discard-left",
                    "anchor": {
                      "line": 7,
                      "text": "left = mid + 1",
                      "occurrence": 1
                    },
                    "title": "Discard proven-too-small candidates",
                    "explanation": "Because the sequence is sorted, target cannot be at mid or anywhere left of mid.",
                    "required": true
                  },
                  {
                    "id": "discard-right",
                    "anchor": {
                      "line": 9,
                      "text": "right = mid - 1",
                      "occurrence": 1
                    },
                    "title": "Discard proven-too-large candidates",
                    "explanation": "The symmetric argument removes mid and everything to its right.",
                    "required": true
                  }
                ]
              }
            }
          ],
          "source_refs": [
            {
              "title": "MIT OpenCourseWare 6.006 — Lecture 1: Algorithms and Computation",
              "url": "https://ocw.mit.edu/courses/6-006-introduction-to-algorithms-spring-2020/resources/lecture-1-algorithms-and-computation/"
            },
            {
              "title": "Python documentation — bisect",
              "url": "https://docs.python.org/3/library/bisect.html"
            }
          ],
          "glossary": [
            {
              "term": "candidate interval",
              "definition": "The portion of the ordered search space that could still contain the answer."
            }
          ]
        },
        {
          "id": "domain-5-binary-progress",
          "title": "Define the interval convention and make it shrink",
          "concept_ids": [
            "dsa.binary.progress"
          ],
          "prerequisite_node_ids": [
            "domain-5-binary-exact"
          ],
          "map_position": {
            "x": 0.42,
            "y": 0.14
          },
          "prompts": [
            {
              "id": "what",
              "kind": "what",
              "label": "MOST BINARY-SEARCH BUGS ARE BOUNDARY BUGS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Choose one interval convention, such as inclusive `[left, right]` or half-open `[left, right)`, and make every loop condition and update consistent with it. Every non-terminal iteration must strictly shrink the candidate region.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "convention",
                      "text": "Choose one interval convention",
                      "required": true
                    },
                    {
                      "id": "shrink",
                      "text": "strictly shrink the candidate region",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "real-use",
              "kind": "connects_to",
              "label": "REAL USE: FIRST RECORD AT OR AFTER A REQUESTED TIME",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "A log index often needs insertion-point behavior: find the first timestamp that is not less than the requested time, even if no record has that exact timestamp. That requires a boundary search rather than only exact-match search.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "first",
                      "text": "first timestamp that is not less than the requested time",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "fault",
              "kind": "not_this",
              "label": "NO-PROGRESS UPDATE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "With an inclusive interval and `mid = (left + right) // 2`, writing `left = mid` when mid is too small can leave left unchanged when `mid == left`. `left = mid + 1` removes the midpoint and guarantees progress.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "stuck",
                      "text": "leave left unchanged",
                      "required": true
                    },
                    {
                      "id": "plus1",
                      "text": "`left = mid + 1`",
                      "required": true
                    }
                  ]
                }
              }
            }
          ],
          "source_refs": [
            {
              "title": "MIT OpenCourseWare 6.006 — Lecture 1: Algorithms and Computation",
              "url": "https://ocw.mit.edu/courses/6-006-introduction-to-algorithms-spring-2020/resources/lecture-1-algorithms-and-computation/"
            },
            {
              "title": "Python documentation — bisect",
              "url": "https://docs.python.org/3/library/bisect.html"
            }
          ]
        },
        {
          "id": "domain-5-binary-boundary",
          "title": "Search for the first true boundary",
          "concept_ids": [
            "dsa.binary.boundary",
            "dsa.binary.progress"
          ],
          "prerequisite_node_ids": [
            "domain-5-binary-progress"
          ],
          "map_position": {
            "x": 0.72,
            "y": 0.14
          },
          "prompts": [
            {
              "id": "what",
              "kind": "what",
              "label": "WHAT CHANGES IN A BOUNDARY SEARCH?",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Instead of stopping at any matching item, keep searching for the boundary: the first index where a monotonic condition becomes true, or the last index where it remains false/true depending on the chosen formulation.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "boundary",
                      "text": "keep searching for the boundary",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "real-use",
              "kind": "connects_to",
              "label": "REAL USE: FIRST COMPATIBLE RELEASE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Suppose release versions are ordered and compatibility becomes true from some version onward. The goal is not 'find a compatible version'; it is 'find the first compatible version.' That is a first-true boundary.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "first-compatible",
                      "text": "first compatible version",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "table",
              "kind": "mental_model",
