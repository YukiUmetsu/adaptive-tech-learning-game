      "nodes": [
        {
          "id": "domain-5-sort-preprocess",
          "title": "Sort when order turns repeated global work into a simple scan",
          "concept_ids": [
            "dsa.sort.preprocess"
          ],
          "prerequisite_node_ids": [],
          "map_position": {
            "x": 0.14,
            "y": 0.84
          },
          "prompts": [
            {
              "id": "what",
              "kind": "what",
              "label": "SORTING IS A PREPROCESSING TRADE-OFF",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Sorting costs time up front, usually O(n log n) for comparison sorting, but can expose adjacency, grouping, monotonicity, and merge structure that makes the remaining work much simpler.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "upfront",
                      "text": "costs time up front",
                      "required": true
                    },
                    {
                      "id": "expose",
                      "text": "expose adjacency, grouping, monotonicity, and merge structure",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "real-use",
              "kind": "connects_to",
              "label": "REAL USE: SORT AUDIT RECORDS BEFORE COALESCING EQUAL KEYS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "If records can be reordered and the task is to group equal keys, sorting by key places equal records together so one scan can form groups. If original arrival order is part of the output, preserve that metadata or use a different approach.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "together",
                      "text": "places equal records together",
                      "required": true
                    },
                    {
                      "id": "metadata",
                      "text": "preserve that metadata",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "comparison",
              "kind": "mental_model",
              "label": "WHEN TO PAY FOR SORTING",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "comparison",
                "columns": [
                  {
                    "title": "Sorting often helps",
                    "items": [
                      "Need adjacency between equal/nearby values",
                      "Need a merge/sweep in ordered order",
                      "Can reorder or preserve original metadata separately"
                    ]
                  },
                  {
                    "title": "Sorting may be wrong/overkill",
                    "items": [
                      "Original order is the result",
                      "One-pass hash state directly answers the query",
