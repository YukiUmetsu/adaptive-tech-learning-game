          "id": "domain-5-sort-key",
          "title": "Sort keys",
          "concept_ids": [
            "dsa.sort.key_contract"
          ],
          "prerequisite_node_ids": [
            "domain-5-sort-preprocess"
          ],
          "map_position": {
            "x": 0.47,
