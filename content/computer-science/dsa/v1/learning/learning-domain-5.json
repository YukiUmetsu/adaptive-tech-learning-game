        {
          "id": "domain-5-sort-stable-merge",
          "title": "Stable sort and merge",
          "concept_ids": [
            "dsa.sort.stability",
            "dsa.ordered.merge"
          ],
          "prerequisite_node_ids": [
            "domain-5-sort-key"
