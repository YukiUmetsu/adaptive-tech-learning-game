          },
          "prompts": [
            {
              "id": "problem",
              "kind": "what",
              "label": "PROBLEM",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "A simulator can test worker counts from `1` through `8`. Counts `1..5` miss the deadline; counts `6..8` meet it. Find the smallest worker count that passes."
              }
            },
            {
              "id": "definition",
              "kind": "what",
              "label": "WHAT IT IS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Binary search can search candidate answers, not only array indexes. This works when a boolean test changes in one direction, such as `False ... False, True ... True`."
              }
            },
            {
              "id": "step-1",
              "kind": "mental_model",
              "label": "STEP 1",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "bullets",
                "items": [
                  "Search candidates `1..8`.",
                  "Try `4` → false.",
                  "The minimum passing answer must be greater than `4`."
                ]
              }
            },
            {
              "id": "step-2",
              "kind": "mental_model",
              "label": "STEP 2",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "bullets",
                "items": [
                  "Search candidates `5..8`.",
                  "Try `6` → true.",
                  "Keep `6` as a possible answer and search smaller candidates."
                ]
              }
            },
            {
              "id": "step-3",
              "kind": "mental_model",
              "label": "STEP 3",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "bullets",
                "items": [
                  "Try `5` → false.",
                  "Boundary is between `5` and `6`.",
                  "Minimum passing count = `6`."
                ]
              }
            },
            {
              "id": "when",
              "kind": "when",
              "label": "WHEN TO USE IT",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Use answer-space binary search when you can cheaply test a candidate and the pass/fail result is monotonic across the ordered candidates."
              }
            },
            {
              "id": "rule",
              "kind": "look_for",
              "label": "RULE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Find the boundary between failing and passing candidate answers."
              }
            },
            {
              "id": "check",
              "kind": "action",
              "label": "CHECK",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "If candidates `1..5` fail and `6..8` pass, what is the first true candidate? Answer: `6`.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "answer",
                      "text": "`6`.",
                      "required": true
                    }
                  ]
                }
              }
            }
          ],
          "source_refs": [
