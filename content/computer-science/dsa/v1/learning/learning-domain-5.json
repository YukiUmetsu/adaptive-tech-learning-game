          "prompts": [
            {
              "id": "problem",
              "kind": "what",
              "label": "PROBLEM",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Two forms of existing order can be useful. First, equal-priority jobs should keep their arrival order. Second, two changelog feeds are already sorted by timestamp and need one combined sorted output."
              }
            },
            {
              "id": "definition",
              "kind": "what",
              "label": "WHAT IT IS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "A stable sort preserves the original relative order of records with equal keys. An ordered merge reuses the order already present in sorted inputs instead of sorting everything again."
              }
            },
            {
              "id": "stable",
              "kind": "mental_model",
              "label": "STABLE SORT",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "bullets",
                "items": [
                  "Arrival order: `A(priority 2), B(priority 1), C(priority 2)`",
                  "Stable sort by priority:",
                  "`B(priority 1), A(priority 2), C(priority 2)`",
                  "A still comes before C because their priority keys are equal."
                ]
              }
            },
            {
              "id": "merge",
              "kind": "mental_model",
              "label": "ORDERED MERGE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "bullets",
                "items": [
                  "Feed A: `[1, 4, 9]`",
                  "Feed B: `[2, 6, 8]`",
                  "Only the two current front values can be globally next.",
                  "Choose the smaller front, advance that feed, and repeat.",
                  "Merged: `[1, 2, 4, 6, 8, 9]`"
                ]
              }
            },
            {
              "id": "python-note",
              "kind": "connects_to",
              "label": "PYTHON",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Python's built-in sorting is stable, so equal-key records retain their original relative order."
              }
            },
            {
              "id": "when",
              "kind": "when",
              "label": "WHEN TO USE IT",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Require stability when tie order has meaning. Use ordered merge when inputs are already sorted and should be combined without a full re-sort."
              }
            },
            {
              "id": "rule",
              "kind": "look_for",
              "label": "RULE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Preserve useful order that the data already gives you."
              }
            },
            {
              "id": "check",
              "kind": "action",
              "label": "CHECK",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Two sorted feeds are being merged. Which items can be the next global output? Answer: Only the current front item from each feed.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "answer",
                      "text": "Only the current front item from each feed.",
                      "required": true
                    }
                  ]
                }
              }
            }
