          },
          "prompts": [
            {
              "id": "problem",
              "kind": "what",
              "label": "PROBLEM",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Sorted timestamps are `[10, 20, 20, 30]`. A request may not match exactly. Return the first index whose timestamp is greater than or equal to the requested value."
              }
            },
            {
              "id": "definition",
              "kind": "what",
              "label": "WHAT IT IS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "A boundary search looks for a transition position instead of any exact match. The lower bound is the first position where the value is `>= target`."
              }
            },
            {
              "id": "examples",
              "kind": "mental_model",
              "label": "EXAMPLES",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "table",
                "columns": [
                  {
                    "id": "target",
                    "label": "Target"
                  },
                  {
                    "id": "index",
                    "label": "First index >= target"
                  },
                  {
                    "id": "value",
                    "label": "Value"
                  }
                ],
                "rows": [
                  {
                    "id": "t20",
                    "cells": {
                      "target": "20",
                      "index": "1",
                      "value": "20"
                    }
                  },
                  {
                    "id": "t25",
                    "cells": {
                      "target": "25",
                      "index": "3",
                      "value": "30"
                    }
                  },
                  {
                    "id": "t31",
                    "cells": {
                      "target": "31",
                      "index": "4",
                      "value": "insertion after the list"
                    }
                  }
                ]
              }
            },
            {
              "id": "python",
              "kind": "action",
              "label": "PYTHON",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "lower_bound.py",
                "language": "python",
                "code": "from bisect import bisect_left\n\nvalues = [10, 20, 20, 30]\ni = bisect_left(values, 20)\n",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "bisect",
                    "anchor": {
                      "line": 4,
                      "text": "i = bisect_left(values, 20)",
                      "occurrence": 1
                    },
                    "title": "Find the left insertion boundary",
                    "explanation": "For an existing value, `bisect_left` returns a position before equal entries.",
                    "required": true
                  }
                ]
              }
            },
            {
              "id": "when",
              "kind": "when",
              "label": "WHEN TO USE IT",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Use boundary search for first `>= x`, first `> x`, first true, last false, or an insertion position. Do not stop at an arbitrary equal value when the contract asks for the first one."
              }
            },
            {
              "id": "rule",
              "kind": "look_for",
              "label": "RULE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Exact search asks 'is x here?'; boundary search asks 'where does the condition change?'"
              }
            },
            {
              "id": "check",
              "kind": "action",
              "label": "CHECK",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "For `[10, 20, 20, 30]`, what is the first index with value `>= 20`? Answer: `1`.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "answer",
                      "text": "`1`.",
                      "required": true
                    }
                  ]
                }
              }
            }
