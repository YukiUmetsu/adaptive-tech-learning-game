          "prompts": [
            {
              "id": "problem",
              "kind": "what",
              "label": "PROBLEM",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Jobs are records such as `{id: 'A', deadline: 30, payload: ...}`. Return job IDs ordered by deadline. The ID and payload must stay attached to the correct deadline."
              }
            },
            {
              "id": "definition",
              "kind": "what",
              "label": "WHAT IT IS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "A sort key is the value used to compare records. Sort the full records by that key instead of extracting and sorting detached key values."
              }
            },
            {
              "id": "bad",
              "kind": "not_this",
              "label": "BAD TRANSFORMATION",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "bullets",
                "items": [
                  "Extract deadlines only: `[30, 10, 20]`.",
                  "Sort them: `[10, 20, 30]`.",
                  "The ordering survives, but the connection to job IDs is gone."
                ]
              }
            },
            {
              "id": "code",
              "kind": "action",
              "label": "PYTHON",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "sort_jobs.py",
                "language": "python",
                "code": "jobs = [\n    {\"id\": \"A\", \"deadline\": 30},\n    {\"id\": \"B\", \"deadline\": 10},\n    {\"id\": \"C\", \"deadline\": 20},\n]\n\nordered = sorted(jobs, key=lambda job: job[\"deadline\"])\n",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "key",
                    "anchor": {
                      "line": 7,
                      "text": "key=lambda job: job[\"deadline\"]",
                      "occurrence": 1
                    },
                    "title": "Sort by deadline",
                    "explanation": "The entire record moves while deadline controls ordering.",
                    "required": true
                  }
                ]
              }
            },
            {
              "id": "when",
              "kind": "when",
              "label": "WHEN TO USE IT",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Use a key function when records contain many fields but one field, or a computed value, determines the requested order."
              }
            },
            {
              "id": "rule",
              "kind": "look_for",
              "label": "RULE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Sort the records; use the key only to decide their order."
              }
            },
            {
              "id": "check",
              "kind": "action",
              "label": "CHECK",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Need job IDs ordered by deadline. Should you sort detached deadlines alone? Answer: No.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "answer",
                      "text": "No.",
                      "required": true
                    }
                  ]
                }
              }
            }
