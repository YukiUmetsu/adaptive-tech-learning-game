          },
          "prompts": [
            {
              "id": "problem",
              "kind": "what",
              "label": "PROBLEM",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "A team wants to binary-search a concurrency limit. Measurements are: `4=pass, 5=pass, 6=pass, 7=fail, 8=pass`. Decide whether half-elimination is safe."
              }
            },
            {
              "id": "definition",
              "kind": "what",
              "label": "WHAT IT IS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "A predicate is monotonic when its boolean result changes at most once across the ordered search range. For first-true search, the shape must be `False ... False, True ... True`."
              }
            },
            {
              "id": "compare",
              "kind": "mental_model",
              "label": "SAFE VS UNSAFE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "table",
                "columns": [
                  {
                    "id": "case",
                    "label": "Case"
                  },
                  {
                    "id": "pattern",
                    "label": "Pattern"
                  },
                  {
                    "id": "binary",
                    "label": "Binary search?"
                  }
                ],
                "rows": [
                  {
                    "id": "safe",
                    "cells": {
                      "case": "Capacity threshold",
                      "pattern": "F F F T T T",
                      "binary": "Yes"
                    }
                  },
                  {
                    "id": "unsafe",
                    "cells": {
                      "case": "Measured concurrency",
                      "pattern": "T T T F T",
                      "binary": "No"
                    }
                  }
                ]
              }
            },
            {
              "id": "why",
              "kind": "not_this",
              "label": "WHY THE UNSAFE CASE FAILS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "At `7`, a failure does not prove that all larger values fail because `8` passes. One comparison therefore cannot safely discard an entire side."
              }
            },
            {
              "id": "when",
              "kind": "when",
              "label": "WHEN TO USE IT",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Prove or establish the monotonic relationship before binary-searching a numeric answer."
              }
            },
            {
              "id": "rule",
              "kind": "look_for",
              "label": "RULE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Numeric range alone is not enough. The pass/fail predicate must have one ordered transition."
              }
            },
            {
              "id": "check",
              "kind": "action",
              "label": "CHECK",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Pattern `F F T T T`: monotonic for first-true search? Answer: Yes.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "answer",
                      "text": "Yes.",
                      "required": true
                    }
                  ]
                }
              }
            }
          ],
          "source_refs": [
