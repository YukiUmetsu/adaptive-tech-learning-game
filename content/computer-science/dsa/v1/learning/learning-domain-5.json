      "nodes": [
        {
          "id": "domain-5-sort-preprocess",
          "title": "Sort then scan",
          "concept_ids": [
            "dsa.sort.preprocess"
          ],
          "prerequisite_node_ids": [],
          "map_position": {
            "x": 0.14,
            "y": 0.84
          },
          "prompts": [
            {
              "id": "problem",
              "kind": "what",
              "label": "PROBLEM",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Customer IDs arrive as `[B, A, C, A, B]`. The batch may be reordered, and you need to process each customer group once."
              }
            },
            {
              "id": "definition",
              "kind": "what",
              "label": "WHAT IT IS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Sorting can be useful preprocessing. It costs work up front but can place related records next to each other, turning a scattered grouping problem into one sequential scan."
              }
            },
            {
              "id": "example",
              "kind": "mental_model",
              "label": "EXAMPLE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "bullets",
                "items": [
                  "Before: `[B, A, C, A, B]`",
                  "Sort by customer ID: `[A, A, B, B, C]`",
                  "Equal IDs are now adjacent.",
                  "One scan can identify the A group, then B, then C."
                ]
              }
            },
            {
              "id": "compare",
              "kind": "connects_to",
              "label": "SORT OR HASH?",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "table",
                "columns": [
                  {
                    "id": "need",
                    "label": "Need"
                  },
                  {
                    "id": "choice",
                    "label": "Typical choice"
                  },
                  {
                    "id": "why",
                    "label": "Why"
                  }
                ],
                "rows": [
                  {
                    "id": "duplicate",
                    "cells": {
                      "need": "Only detect whether any duplicate exists; extra memory allowed",
                      "choice": "Set",
                      "why": "No need to pay for ordering"
                    }
                  },
                  {
                    "id": "groups",
                    "cells": {
                      "need": "Need ordered adjacent groups and reordering is allowed",
                      "choice": "Sort then scan",
                      "why": "Sorting creates useful adjacency"
                    }
                  }
                ]
              }
            },
            {
              "id": "when",
              "kind": "when",
              "label": "WHEN TO USE IT",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Sort first when reordering is allowed and sorted order makes later comparisons, grouping, merging, or scanning simpler."
              }
            },
            {
              "id": "rule",
              "kind": "look_for",
              "label": "RULE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Pay for a sort only when the order it creates is useful afterward."
              }
            },
            {
              "id": "check",
              "kind": "action",
              "label": "CHECK",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "If original arrival order must be preserved and you do not store original positions, is sorting safe? Answer: No.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "answer",
                      "text": "No.",
                      "required": true
                    }
                  ]
                }
              }
            }
          ],
          "source_refs": [
