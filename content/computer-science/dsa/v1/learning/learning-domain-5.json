      "nodes": [
        {
          "id": "domain-5-binary-exact",
          "title": "Exact search",
          "concept_ids": [
            "dsa.binary.exact"
          ],
          "prerequisite_node_ids": [],
          "map_position": {
            "x": 0.12,
            "y": 0.14
          },
          "prompts": [
            {
              "id": "problem",
              "kind": "what",
              "label": "PROBLEM",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "A sorted index is `[2, 5, 8, 12, 19]`. Find the index of target `12`, or return `-1` if it is absent."
              }
            },
            {
              "id": "definition",
              "kind": "what",
              "label": "WHAT IT IS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Binary search keeps a candidate interval in sorted data. Compare the target with the middle value, then discard the half that cannot contain the target."
              }
            },
            {
              "id": "step-1",
              "kind": "mental_model",
              "label": "STEP 1",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "bullets",
                "items": [
                  "Candidate indexes: `0..4`",
                  "mid = `2`, value = `8`",
                  "`12 > 8` → discard indexes `0..2`."
                ]
              }
            },
            {
              "id": "step-2",
              "kind": "mental_model",
              "label": "STEP 2",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "bullets",
                "items": [
                  "Candidate indexes: `3..4`",
                  "mid = `3`, value = `12`",
                  "Target found at index `3`."
                ]
              }
            },
            {
              "id": "code",
              "kind": "action",
              "label": "CODE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "binary_search.py",
                "language": "python",
                "code": "def binary_search(nums, target):\n    left, right = 0, len(nums) - 1\n    while left <= right:\n        mid = (left + right) // 2\n        if nums[mid] == target:\n            return mid\n        if nums[mid] < target:\n            left = mid + 1\n        else:\n            right = mid - 1\n    return -1\n",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "mid",
                    "anchor": {
                      "line": 4,
                      "text": "mid = (left + right) // 2",
                      "occurrence": 1
                    },
                    "title": "Check the middle candidate",
                    "explanation": "Sorted order lets one comparison discard a whole side.",
                    "required": true
                  },
                  {
                    "id": "move",
                    "anchor": {
                      "line": 8,
                      "text": "left = mid + 1",
                      "occurrence": 1
                    },
                    "title": "Remove mid and everything left of it",
                    "explanation": "Those values are too small.",
                    "required": true
                  }
                ]
              }
            },
            {
              "id": "when",
              "kind": "when",
              "label": "WHEN TO USE IT",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Use exact binary search when data is sorted and the question asks whether one exact key is present or where it is."
              }
            },
            {
              "id": "rule",
              "kind": "look_for",
              "label": "RULE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Compare at the middle; discard the impossible half."
              }
            },
            {
              "id": "check",
              "kind": "action",
              "label": "CHECK",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "For `[2, 5, 8, 12, 19]`, what index contains `12`? Answer: `3`.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "answer",
                      "text": "`3`.",
                      "required": true
                    }
                  ]
                }
              }
            }
          ],
          "source_refs": [
            {
              "title": "MIT OpenCourseWare 6.006 — Lecture 1: Algorithms and Computation",
              "url": "https://ocw.mit.edu/courses/6-006-introduction-to-algorithms-spring-2020/resources/lecture-1-algorithms-and-computation/"
            },
            {
              "title": "Python documentation — bisect",
              "url": "https://docs.python.org/3/library/bisect.html"
            }
          ],
          "glossary": [
            {
              "term": "candidate interval",
              "definition": "The part of the sorted search space that could still contain the answer."
            }
          ]
        },
        {
          "id": "domain-5-binary-progress",
          "title": "Search progress",
          "concept_ids": [
            "dsa.binary.progress"
          ],
          "prerequisite_node_ids": [
            "domain-5-binary-exact"
          ],
          "map_position": {
            "x": 0.42,
            "y": 0.14
          },
          "prompts": [
            {
              "id": "problem",
              "kind": "what",
              "label": "PROBLEM",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Search sorted values `[2, 9]` for target `9` using an inclusive interval `[left, right]`. Start with `left = 0`, `right = 1`, so `mid = 0`."
              }
            },
            {
              "id": "definition",
              "kind": "what",
              "label": "WHAT IT IS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Every binary-search update must make the candidate interval smaller. With an inclusive interval, a checked middle index must be excluded from the next interval when it is not the answer."
              }
            },
            {
              "id": "bad",
              "kind": "mental_model",
              "label": "BAD UPDATE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "bullets",
                "items": [
                  "`mid = 0`, value = `2`, target is larger.",
                  "If code sets `left = mid`, then `left` stays `0`.",
                  "Next loop: `left = 0`, `right = 1`, `mid = 0` again.",
                  "The same interval repeats."
                ]
              }
            },
            {
              "id": "good",
              "kind": "mental_model",
              "label": "GOOD UPDATE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "bullets",
                "items": [
                  "Set `left = mid + 1`.",
                  "New interval is `[1, 1]`.",
                  "Now `mid = 1`, value = `9`, so the target is found."
                ]
              }
            },
            {
              "id": "when",
              "kind": "when",
              "label": "WHEN TO USE IT",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Whenever you write binary search, choose an interval convention first and verify that every non-terminal branch strictly shrinks it."
              }
            },
            {
              "id": "rule",
              "kind": "look_for",
              "label": "RULE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "A checked `mid` that is not the answer must leave the next candidate interval."
              }
            },
            {
              "id": "check",
              "kind": "action",
              "label": "CHECK",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "With inclusive `[left, right]`, target is larger than `nums[mid]`. What should `left` become? Answer: `mid + 1`.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "answer",
                      "text": "`mid + 1`.",
                      "required": true
                    }
                  ]
                }
              }
            }
          ],
          "source_refs": [
            {
              "title": "MIT OpenCourseWare 6.006 — Lecture 1: Algorithms and Computation",
              "url": "https://ocw.mit.edu/courses/6-006-introduction-to-algorithms-spring-2020/resources/lecture-1-algorithms-and-computation/"
