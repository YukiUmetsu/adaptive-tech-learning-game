          "prompts": [
            {
              "id": "problem",
              "kind": "what",
              "label": "PROBLEM",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "We want to detect whether an event ID has appeared before. For ids = [\"A\", \"B\", \"C\", \"A\"], one solution rescans earlier IDs; another stores seen IDs in a set. What does the set use in exchange for less repeated searching? `extra memory`.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "answer",
                      "text": "`extra memory`",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "tradeoff",
              "kind": "mental_model",
              "label": "TIME VS SPACE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "table",
                "columns": [
                  {
                    "id": "approach",
                    "label": "Approach"
                  },
                  {
                    "id": "time",
                    "label": "Expected time"
                  },
                  {
                    "id": "space",
                    "label": "Extra space"
                  }
                ],
                "rows": [
                  {
                    "id": "rescan",
                    "cells": {
                      "approach": "Rescan earlier IDs",
                      "time": "O(n²)",
                      "space": "O(1)"
                    }
                  },
                  {
                    "id": "seen",
                    "cells": {
                      "approach": "Keep a seen set",
                      "time": "O(n)",
                      "space": "O(n)"
                    }
                  }
                ]
              }
            },
            {
              "id": "solution",
              "kind": "action",
              "label": "CODE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "has_duplicate.py",
                "language": "python",
                "code": "def has_duplicate(ids):\n    seen = set()\n    for event_id in ids:\n        if event_id in seen:\n            return True\n        seen.add(event_id)\n    return False\n",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "memory",
                    "anchor": {
                      "line": 2,
                      "text": "seen = set()",
                      "occurrence": 1
                    },
                    "title": "Extra memory",
                    "explanation": "The set can grow with the number of different IDs.",
                    "required": true
                  },
                  {
                    "id": "speed",
                    "anchor": {
                      "line": 4,
                      "text": "event_id in seen",
                      "occurrence": 1
                    },
                    "title": "Faster lookup",
                    "explanation": "The set avoids scanning all earlier IDs again.",
                    "required": true
                  }
                ]
              }
