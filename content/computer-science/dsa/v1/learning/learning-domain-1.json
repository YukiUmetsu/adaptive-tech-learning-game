            {
              "id": "solution",
              "kind": "action",
              "label": "CODE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "pair_sum_seen.py",
                "language": "python",
                "code": "def has_pair(nums, target):\n    seen = set()\n    for num in nums:\n        needed = target - num\n        if needed in seen:\n            return True\n        seen.add(num)\n    return False\n",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "needed",
                    "anchor": {
                      "line": 4,
                      "text": "needed = target - num",
                      "occurrence": 1
                    },
                    "title": "Compute the missing number",
                    "explanation": "If num is 5 and target is 25, the needed number is 20.",
                    "required": true
                  },
                  {
                    "id": "lookup",
                    "anchor": {
                      "line": 5,
                      "text": "needed in seen",
                      "occurrence": 1
                    },
                    "title": "Look it up",
                    "explanation": "The set checks whether that needed number appeared earlier.",
                    "required": true
                  },
                  {
                    "id": "remember",
                    "anchor": {
                      "line": 7,
                      "text": "seen.add(num)",
                      "occurrence": 1
                    },
                    "title": "Remember this number",
                    "explanation": "Future numbers can use it without searching the earlier part of the list again.",
                    "required": true
                  }
                ]
              }
            },
