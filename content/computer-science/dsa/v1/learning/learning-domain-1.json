              "reveal": {
                "type": "text",
                "text": "The simple pair-sum solution can check every unique pair. If a batch has 100,000 event IDs, about how many unique pair checks would that require? `5 billion pair checks`.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "answer",
                      "text": "`5 billion pair checks`",
