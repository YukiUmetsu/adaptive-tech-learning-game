          "title": "Lists vs sets",
          "concept_ids": [
            "dsa.reasoning.problem_contract"
          ],
          "prerequisite_node_ids": [],
          "map_position": {
            "x": 0.12,
            "y": 0.14
          },
          "prompts": [
            {
              "id": "problem",
              "kind": "what",
              "label": "PROBLEM",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "We need the index of the first repeated event ID. IDs = [\"evt-17\", \"evt-42\", \"evt-17\", \"evt-9\"]. Which index should we return? `2`.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "answer",
                      "text": "`2`",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "data",
              "kind": "mental_model",
              "label": "LIST VS SET",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "comparison",
                "columns": [
                  {
                    "title": "List",
                    "items": [
                      "[\"evt-17\", \"evt-42\", \"evt-17\", \"evt-9\"]",
                      "Keeps order",
                      "Keeps duplicate values",
                      "Lets you use indexes"
                    ]
                  },
                  {
                    "title": "Set",
                    "items": [
                      "{\"evt-17\", \"evt-42\", \"evt-9\"}",
                      "Keeps unique values",
                      "Fast membership checks",
                      "Does not keep duplicate positions"
                    ]
                  }
                ]
              }
            },
            {
              "id": "solution",
              "kind": "action",
              "label": "CODE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "first_repeat_index.py",
                "language": "python",
                "code": "def first_repeat_index(ids):\n    seen = set()\n    for i, event_id in enumerate(ids):\n        if event_id in seen:\n            return i\n        seen.add(event_id)\n    return -1\n",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "membership",
                    "anchor": {
                      "line": 4,
                      "text": "event_id in seen",
                      "occurrence": 1
                    },
                    "title": "Check the set",
                    "explanation": "The set answers whether this ID appeared earlier.",
                    "required": true
                  },
                  {
                    "id": "position",
                    "anchor": {
                      "line": 5,
                      "text": "return i",
                      "occurrence": 1
                    },
                    "title": "Keep the index",
                    "explanation": "The loop still scans the original list, so i is the duplicate position.",
                    "required": true
                  }
                ]
              }
            },
            {
              "id": "rule",
              "kind": "look_for",
              "label": "RULE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Use a List when order or position matters. Use a Set for uniqueness or membership checks."
              }
            }
          ],
