            {
              "id": "growth",
              "kind": "mental_model",
              "label": "WHY 5 BILLION?",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "sequence",
                "items": [
                  "With 4 IDs, each ID has 3 other IDs: 4 × 3 = 12 ordered comparisons.",
                  "That counts each pair twice: A-B and B-A. Divide by 2 to keep each pair once.",
                  "For 4 IDs: 4 × 3 / 2 = 6 unique pairs.",
                  "For 100,000 IDs: 100,000 × 99,999 / 2 = 4,999,950,000 ≈ 5 billion pairs."
                ]
              }
