              "required": true,
              "reveal": {
                "type": "text",
                "text": "We already built prefix = [0, 4, 11, 13, 18] for values = [4, 7, 2, 5]. Now find the sum from index 1 up to, but not including, index 3. What is 7 + 2? `9`.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "answer",
                      "text": "`9`",
                      "required": true
                    }
                  ]
                }
              }
