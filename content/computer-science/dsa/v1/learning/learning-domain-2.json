              "id": "problem",
              "kind": "what",
              "label": "PROBLEM",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "We need to remove duplicate event IDs without changing the order of their first appearance. Input = [\"A\", \"B\", \"A\", \"C\", \"B\"]. What should the output be? `[\"A\", \"B\", \"C\"]`.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "answer",
                      "text": "`[\"A\", \"B\", \"C\"]`",
                      "required": true
                    }
                  ]
                }
              }
            },
            {
              "id": "structures",
              "kind": "mental_model",
              "label": "LIST + SET",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "comparison",
                "columns": [
                  {
                    "title": "List",
                    "items": [
                      "Keeps order",
                      "Keeps duplicates",
                      "Supports positions and indexes"
                    ]
                  },
                  {
                    "title": "Set",
                    "items": [
                      "Keeps unique values",
                      "Fast membership checks",
                      "Does not keep duplicate positions"
                    ]
                  },
                  {
                    "title": "Use both",
                    "items": [
                      "Scan the original list in order",
                      "Use a set to skip values already used",
                      "Append new values to the output list"
                    ]
                  }
                ]
              }
            },
            {
              "id": "solution",
              "kind": "action",
              "label": "CODE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "dedupe_keep_order.py",
                "language": "python",
                "code": "def dedupe_keep_order(ids):\n    seen = set()\n    out = []\n    for event_id in ids:\n        if event_id not in seen:\n            seen.add(event_id)\n            out.append(event_id)\n    return out\n",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "unique",
                    "anchor": {
                      "line": 5,
                      "text": "event_id not in seen",
                      "occurrence": 1
                    },
                    "title": "Check uniqueness",
                    "explanation": "The set tells us whether this ID was already added.",
                    "required": true
                  },
                  {
                    "id": "order",
                    "anchor": {
                      "line": 7,
                      "text": "out.append(event_id)",
                      "occurrence": 1
                    },
                    "title": "Keep first-seen order",
                    "explanation": "Appending during the original left-to-right scan preserves the order.",
                    "required": true
                  }
                ]
              }
            },
            {
              "id": "rule",
              "kind": "look_for",
              "label": "RULE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Keep a List when order or positions matter. Add a Set when you also need fast duplicate checks."
              }
            }
          ],
