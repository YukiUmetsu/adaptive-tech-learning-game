                "type": "code_file",
                "filename": "build_prefix.py",
                "language": "python",
                "code": "def build_prefix(values):\n    prefix = [0]\n    for value in values:\n        prefix.append(prefix[-1] + value)\n    return prefix\n",
                "line_numbers": true,
                "annotations": [
