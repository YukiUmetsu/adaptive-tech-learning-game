            {
              "id": "solution",
              "kind": "action",
              "label": "CODE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "two_sum.py",
                "language": "python",
                "code": "def two_sum(nums, target):\n    index = {}\n    for i, num in enumerate(nums):\n        needed = target - num\n        if needed in index:\n            return [index[needed], i]\n        if num not in index:\n            index[num] = i\n    return None\n",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "need",
                    "anchor": {
                      "line": 4,
                      "text": "needed = target - num",
                      "occurrence": 1
                    },
                    "title": "Find the missing value",
                    "explanation": "For num=45 and target=64, needed=19.",
                    "required": true
                  },
