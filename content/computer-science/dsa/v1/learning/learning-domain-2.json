            {
              "id": "steps",
              "kind": "mental_model",
              "label": "STEP BY STEP",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "sequence",
                "items": [
                  "Start with 0: [0]",
                  "Add 4: 0 + 4 = 4 → [0, 4]",
                  "Add 7: 4 + 7 = 11 → [0, 4, 11]",
                  "Add 2: 11 + 2 = 13 → [0, 4, 11, 13]",
                  "Add 5: 13 + 5 = 18 → [0, 4, 11, 13, 18]"
                ]
              }
            },
