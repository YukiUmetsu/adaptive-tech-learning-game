                "type": "code_file",
                "filename": "target_subarray.py",
                "language": "python",
                "code": "def has_target_subarray(deltas, target):\n    seen_prefix = {0}\n    prefix = 0\n    for delta in deltas:\n        prefix += delta\n        needed = prefix - target\n        if needed in seen_prefix:\n            return True\n        seen_prefix.add(prefix)\n    return False\n",
