              "required": true,
              "reveal": {
                "type": "text",
                "text": "Now consider a different kind of repeated work: adding the same array values again for many range-sum queries. For values = [4, 7, 2, 5], build cumulative totals starting with 0. What prefix array do we get? `[0, 4, 11, 13, 18]`.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "answer",
                      "text": "`[0, 4, 11, 13, 18]`",
                      "required": true
                    }
