              "id": "formula",
              "kind": "mental_model",
              "label": "WHY SUBTRACT?",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "sequence",
                "items": [
                  "prefix[3] = 13 means 4 + 7 + 2.",
                  "prefix[1] = 4 means the part before index 1.",
                  "Subtract the part before the range: 13 - 4 = 9.",
                  "What remains is 7 + 2."
                ]
              }
            },
            {
              "id": "solution",
              "kind": "action",
              "label": "CODE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "range_sum.py",
                "language": "python",
                "code": "def range_sum(prefix, left, right):\n    return prefix[right] - prefix[left]\n",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "subtract",
                    "anchor": {
                      "line": 2,
                      "text": "prefix[right] - prefix[left]",
                      "occurrence": 1
                    },
                    "title": "Remove the earlier part",
                    "explanation": "prefix[right] contains everything before right; subtracting prefix[left] removes everything before left.",
                    "required": true
                  }
                ]
              }
            },
