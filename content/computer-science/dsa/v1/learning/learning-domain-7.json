          },
          "prompts": [
            {
              "id": "problem",
              "kind": "what",
              "label": "PROBLEM",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Weighted directed edges are `S→A = 4`, `S→B = 1`, `B→A = 2`, `A→T = 3`, `B→T = 7`. All weights are nonnegative. Find the minimum total cost from `S` to `T`."
              }
            },
            {
              "id": "definition",
              "kind": "what",
              "label": "WHAT IT IS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Dijkstra's algorithm keeps the best known distance to each vertex and repeatedly processes the unsettled vertex with the smallest known distance. The standard algorithm requires nonnegative edge weights."
              }
            },
            {
              "id": "step-1",
              "kind": "mental_model",
              "label": "STEP 1",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "bullets",
                "items": [
                  "Start: `dist[S] = 0`.",
                  "From S: `dist[A] = 4`, `dist[B] = 1`.",
                  "Next process `B` because `1` is smaller."
                ]
              }
            },
            {
              "id": "step-2",
              "kind": "mental_model",
              "label": "STEP 2",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "bullets",
                "items": [
                  "Through B: candidate to A = `1 + 2 = 3` → improve A from `4` to `3`.",
                  "Candidate to T = `1 + 7 = 8` → set T to `8`."
                ]
              }
            },
            {
              "id": "step-3",
              "kind": "mental_model",
              "label": "STEP 3",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "bullets",
                "items": [
                  "Next process A at distance `3`.",
                  "Through A: candidate to T = `3 + 3 = 6` → improve T from `8` to `6`.",
                  "Shortest total cost = `6` via `S → B → A → T`."
                ]
              }
            },
            {
              "id": "negative",
              "kind": "not_this",
              "label": "NEGATIVE EDGE WARNING",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "With a negative edge, a vertex that looked final can later receive a cheaper route. That breaks the finalization logic used by standard Dijkstra."
              }
            },
            {
              "id": "rule",
              "kind": "look_for",
              "label": "RULE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Nonnegative weights + minimum total edge cost → Dijkstra."
              }
            },
            {
              "id": "check",
              "kind": "action",
              "label": "CHECK",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Why is BFS not enough when edge weights differ? Answer: Fewest edges may not have the smallest total weight.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "answer",
                      "text": "Fewest edges may not have the smallest total weight.",
                      "required": true
                    }
                  ]
                }
              }
            }
          ],
