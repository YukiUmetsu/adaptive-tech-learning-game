        {
          "id": "domain-7-bfs",
          "title": "BFS",
          "concept_ids": [
            "dsa.graph.bfs_unweighted"
          ],
          "prerequisite_node_ids": [
            "domain-7-graph-model"
          ],
          "map_position": {
            "x": 0.42,
            "y": 0.14
          },
          "prompts": [
            {
              "id": "problem",
              "kind": "what",
              "label": "PROBLEM",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Every service-to-service call counts as one hop. Edges are `A→B`, `A→C`, `B→D`, `C→E`. Find the fewest hops from `A` to `E`."
              }
            },
            {
              "id": "definition",
              "kind": "what",
              "label": "WHAT IT IS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Breadth-first search (BFS) explores vertices in layers of increasing edge count. For an unweighted graph, the first time BFS reaches a vertex gives a shortest path by number of edges."
              }
            },
            {
              "id": "step-1",
              "kind": "mental_model",
              "label": "LEVEL 0",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "bullets",
                "items": [
                  "Start at `A`.",
                  "distance(A) = `0`."
                ]
              }
            },
            {
              "id": "step-2",
              "kind": "mental_model",
              "label": "LEVEL 1",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "bullets",
                "items": [
                  "Discover `B` and `C`.",
                  "distance = `1` hop."
                ]
              }
            },
            {
              "id": "step-3",
              "kind": "mental_model",
              "label": "LEVEL 2",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "bullets",
                "items": [
                  "From `C`, discover `E`.",
                  "distance(A, E) = `2` hops.",
                  "One shortest route is `A → C → E`."
                ]
              }
            },
            {
              "id": "when",
              "kind": "when",
              "label": "WHEN TO USE IT",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Use BFS for fewest-edge or fewest-hop paths when every edge has equal cost."
              }
            },
            {
              "id": "rule",
              "kind": "look_for",
              "label": "RULE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Equal edge cost + minimum hops → BFS."
              }
            },
            {
              "id": "check",
              "kind": "action",
              "label": "CHECK",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "In the graph above, how many hops from `A` to `E`? Answer: `2`.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "answer",
                      "text": "`2`.",
                      "required": true
                    }
                  ]
                }
              }
            }
          ],
          "source_refs": [
