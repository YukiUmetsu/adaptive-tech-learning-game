        {
          "id": "domain-7-relaxation",
          "title": "Relax an edge",
          "concept_ids": [
            "dsa.graph.relaxation",
            "dsa.graph.dijkstra"
          ],
          "prerequisite_node_ids": [
            "domain-7-dijkstra"
          ],
          "map_position": {
            "x": 0.46,
            "y": 0.84
          },
          "prompts": [
            {
              "id": "problem",
              "kind": "what",
              "label": "PROBLEM",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Current best distances are `dist[A] = 4` and `dist[B] = 12`. Edge `A→B` has weight `3`. We also want to reconstruct the actual shortest route later."
              }
            },
            {
              "id": "definition",
              "kind": "what",
              "label": "WHAT IT IS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Relaxation tests whether going to `B` through `A` gives a cheaper route than the best route currently known for `B`."
              }
            },
            {
              "id": "math",
              "kind": "mental_model",
              "label": "COMPARE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "bullets",
                "items": [
                  "Candidate through A = `dist[A] + weight(A,B)`.",
                  "`4 + 3 = 7`.",
                  "Current `dist[B] = 12`.",
                  "`7 < 12`, so update `dist[B] = 7`."
                ]
              }
            },
            {
              "id": "route",
              "kind": "action",
              "label": "KEEP THE PREDECESSOR",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "bullets",
                "items": [
                  "Because A produced the improvement, also record `prev[B] = A`.",
                  "Following predecessor links backward later reconstructs the chosen route."
                ]
              }
            },
            {
              "id": "code",
              "kind": "action",
              "label": "CORE UPDATE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "relax.py",
                "language": "python",
                "code": "candidate = dist[u] + weight\nif candidate < dist[v]:\n    dist[v] = candidate\n    prev[v] = u\n",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "candidate",
                    "anchor": {
                      "line": 1,
                      "text": "candidate = dist[u] + weight",
                      "occurrence": 1
                    },
                    "title": "Try the edge",
                    "explanation": "Compute the path cost to v through u.",
                    "required": true
                  },
                  {
                    "id": "update",
                    "anchor": {
                      "line": 3,
                      "text": "dist[v] = candidate",
                      "occurrence": 1
                    },
                    "title": "Keep only an improvement",
                    "explanation": "Replace the stored best distance only when the new route is cheaper.",
                    "required": true
                  }
                ]
              }
            },
            {
              "id": "rule",
              "kind": "look_for",
              "label": "RULE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Relax `u→v` when `dist[u] + weight(u,v) < dist[v]`; update the predecessor at the same time if the route is needed."
              }
            },
            {
              "id": "check",
              "kind": "action",
              "label": "CHECK",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "With `dist[A]=4`, `dist[B]=12`, and edge weight `3`, what becomes the new `dist[B]`? Answer: `7`.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "answer",
                      "text": "`7`.",
                      "required": true
                    }
                  ]
                }
              }
            }
