        {
          "id": "domain-7-graph-model",
          "title": "Graph model",
          "concept_ids": [
            "dsa.graph.model_visited"
          ],
          "prerequisite_node_ids": [],
          "map_position": {
            "x": 0.12,
            "y": 0.14
          },
          "prompts": [
            {
              "id": "problem",
              "kind": "what",
              "label": "PROBLEM",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Service `A` calls `B` and `C`. Both `B` and `C` call `D`, and `D` can call `B`. The relationships can branch, merge, and form cycles."
              }
            },
            {
              "id": "definition",
              "kind": "what",
              "label": "WHAT IT IS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "A graph represents entities as vertices and relationships as edges. Unlike a tree, a graph can have shared destinations and cycles."
              }
            },
            {
              "id": "visual",
              "kind": "mental_model",
              "label": "CONNECTIONS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "bullets",
                "items": [
                  "`A → B`",
                  "`A → C`",
                  "`B → D`",
                  "`C → D`",
                  "`D → B`  ← cycle"
                ]
              }
            },
            {
              "id": "visited",
              "kind": "action",
              "label": "WHY TRACK VISITED",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "A traversal marks a vertex when it is discovered. Without visited state, the cycle `B → D → B → ...` can be followed repeatedly."
              }
            },
            {
              "id": "when",
              "kind": "when",
              "label": "WHEN TO USE IT",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Use a graph when relationships are not a strict hierarchy and may contain multiple parents, cross-links, or cycles."
              }
            },
            {
              "id": "rule",
              "kind": "look_for",
              "label": "RULE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Graph traversal needs both a frontier of work and state that prevents unwanted revisits."
              }
            },
            {
              "id": "check",
              "kind": "action",
              "label": "CHECK",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Why is a visited set useful in the graph above? Answer: It prevents repeated traversal of the `B ↔ D` cycle.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "answer",
                      "text": "It prevents repeated traversal of the `B ↔ D` cycle.",
                      "required": true
                    }
                  ]
                }
              }
            }
          ],
          "source_refs": [
            {
              "title": "Princeton Algorithms — 4.1 Undirected Graphs",
