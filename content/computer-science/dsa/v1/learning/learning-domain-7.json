        {
          "id": "domain-7-dfs",
          "title": "DFS cycle state",
          "concept_ids": [
            "dsa.graph.dfs_structure",
            "dsa.graph.cycle_state"
          ],
          "prerequisite_node_ids": [
            "domain-7-graph-model"
          ],
          "map_position": {
            "x": 0.72,
            "y": 0.14
          },
          "prompts": [
            {
              "id": "problem",
              "kind": "what",
              "label": "PROBLEM",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Directed dependencies are `A→B`, `B→C`, `C→A`. We need to detect whether the dependency graph contains a cycle."
              }
            },
            {
              "id": "definition",
              "kind": "what",
              "label": "WHAT IT IS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Depth-first search (DFS) follows one path deeply before returning. For directed-cycle detection, track both vertices already seen and vertices still active on the current DFS path."
              }
            },
            {
              "id": "step-1",
              "kind": "mental_model",
              "label": "STEP 1",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "bullets",
                "items": [
                  "Enter `A` → active path `{A}`.",
                  "Follow `A→B` → active path `{A, B}`.",
                  "Follow `B→C` → active path `{A, B, C}`."
                ]
              }
            },
            {
              "id": "step-2",
              "kind": "mental_model",
              "label": "STEP 2",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "bullets",
                "items": [
                  "From `C`, edge `C→A` points to a vertex still active on the current path.",
                  "That back edge proves a directed cycle."
                ]
              }
            },
            {
              "id": "why",
              "kind": "connects_to",
              "label": "WHY `VISITED` ALONE IS NOT ENOUGH",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "An edge to a previously visited vertex is not automatically a cycle if that vertex belongs to a finished DFS branch. For this directed-cycle method, the decisive signal is an edge to a vertex still active on the current recursion path."
              }
            },
            {
              "id": "rule",
              "kind": "look_for",
              "label": "RULE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Directed DFS cycle detection: edge to an active-path vertex → cycle."
              }
            },
            {
              "id": "check",
              "kind": "action",
              "label": "CHECK",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "DFS sees an edge to a vertex that is still active on the current path. What does that indicate? Answer: A directed cycle.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "answer",
                      "text": "A directed cycle.",
                      "required": true
                    }
                  ]
                }
              }
            }
          ],
          "source_refs": [
            {
              "title": "MIT OpenCourseWare 6.006 — Lecture notes index (BFS, DFS, shortest paths, DP)",
              "url": "https://ocw.mit.edu/courses/6-006-introduction-to-algorithms-spring-2020/pages/lecture-notes/"
            },
