      "nodes": [
        {
          "id": "domain-7-topological",
          "title": "Topological order",
          "concept_ids": [
            "dsa.graph.topological",
            "dsa.graph.cycle_state"
          ],
          "prerequisite_node_ids": [],
          "map_position": {
            "x": 0.12,
            "y": 0.5
          },
          "prompts": [
            {
              "id": "problem",
              "kind": "what",
              "label": "PROBLEM",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Deployment dependencies are `schema → api → smoke`. An arrow means the left task must finish before the right task."
              }
            },
            {
              "id": "definition",
              "kind": "what",
              "label": "WHAT IT IS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "A topological order is an ordering of a directed acyclic graph (DAG) where every prerequisite appears before each dependent task."
              }
            },
            {
              "id": "example",
              "kind": "mental_model",
              "label": "EXAMPLE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "bullets",
                "items": [
                  "Valid order: `schema, api, smoke`.",
                  "`api` cannot appear before `schema`.",
                  "`smoke` cannot appear before `api`."
                ]
              }
            },
            {
              "id": "cycle",
              "kind": "not_this",
              "label": "WHAT IF THERE IS A CYCLE?",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "bullets",
                "items": [
                  "Suppose `A→B`, `B→C`, and `C→A`.",
                  "Each task requires another task in the cycle to come first.",
                  "No complete topological order exists."
                ]
              }
            },
            {
              "id": "when",
              "kind": "when",
              "label": "WHEN TO USE IT",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Use topological ordering when directed edges mean prerequisites and all prerequisites must be respected in one execution order."
              }
            },
            {
              "id": "rule",
              "kind": "look_for",
              "label": "RULE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Topological order exists only for a DAG."
              }
            },
            {
              "id": "check",
              "kind": "action",
              "label": "CHECK",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "For `schema → api → smoke`, which task must come first? Answer: `schema`.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "answer",
                      "text": "`schema`.",
                      "required": true
                    }
                  ]
                }
              }
            }
          ],
          "source_refs": [
            {
              "title": "Princeton Algorithms — 4.2 Directed Graphs",
              "url": "https://algs4.cs.princeton.edu/42digraph/"
            },
            {
              "title": "MIT OpenCourseWare 6.006 — Lecture notes index (BFS, DFS, shortest paths, DP)",
              "url": "https://ocw.mit.edu/courses/6-006-introduction-to-algorithms-spring-2020/pages/lecture-notes/"
            }
          ]
        },
        {
          "id": "domain-7-union-find",
          "title": "Union-find",
          "concept_ids": [
            "dsa.graph.union_find"
          ],
          "prerequisite_node_ids": [
            "domain-7-topological"
          ],
          "map_position": {
            "x": 0.44,
            "y": 0.5
          },
          "prompts": [
            {
              "id": "problem",
              "kind": "what",
              "label": "PROBLEM",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Network links are added over time: connect `(A,B)`, then `(C,D)`, then `(B,C)`. After each addition, the system repeatedly asks whether two devices are in the same connected component. It does not need the route."
              }
            },
            {
              "id": "definition",
              "kind": "what",
              "label": "WHAT IT IS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Union-find, also called disjoint-set union, maintains groups under repeated merges. `union(a,b)` merges two components; `find(x)` identifies the component containing `x`."
              }
            },
            {
              "id": "step-1",
              "kind": "mental_model",
              "label": "STEP 1",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "bullets",
                "items": [
                  "`union(A, B)` → component `{A, B}`.",
                  "`union(C, D)` → component `{C, D}`."
                ]
              }
            },
            {
              "id": "step-2",
              "kind": "mental_model",
              "label": "STEP 2",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "bullets",
                "items": [
                  "`union(B, C)` merges the two groups.",
                  "Now `{A, B, C, D}` is one component.",
                  "`find(A)` and `find(D)` identify the same component."
                ]
              }
            },
            {
              "id": "limit",
              "kind": "not_this",
              "label": "LIMITATION",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Union-find answers connectivity questions efficiently, but it does not preserve the exact path between two vertices. If the route itself is required, use a graph traversal or path algorithm."
              }
            },
            {
              "id": "when",
              "kind": "when",
              "label": "WHEN TO USE IT",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Use union-find for repeated 'same component?' queries when connections are being added and exact routes are unnecessary."
              }
            },
            {
              "id": "rule",
              "kind": "look_for",
              "label": "RULE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Need connectivity under repeated unions, not the path → union-find."
              }
            },
            {
              "id": "check",
              "kind": "action",
              "label": "CHECK",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Can union-find by itself return the shortest path from `A` to `D`? Answer: No.",
                "progressive_reveal": {
                  "spans": [
                    {
                      "id": "answer",
                      "text": "No.",
                      "required": true
                    }
                  ]
                }
              }
            }
          ],
          "source_refs": [
