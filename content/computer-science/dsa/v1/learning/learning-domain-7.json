          "id": "domain-7-dijkstra-practice",
          "title": "Stale heap entries",
          "concept_ids": [
            "dsa.graph.dijkstra",
            "dsa.graph.relaxation",
            "dsa.graph.algorithm_choice"
          ],
          "prerequisite_node_ids": [
