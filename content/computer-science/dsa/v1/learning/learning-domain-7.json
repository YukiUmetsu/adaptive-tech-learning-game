          "id": "domain-7-dijkstra",
          "title": "Dijkstra",
          "concept_ids": [
            "dsa.graph.dijkstra"
          ],
          "prerequisite_node_ids": [
            "domain-7-algorithm-choice"
          ],
          "map_position": {
            "x": 0.12,
