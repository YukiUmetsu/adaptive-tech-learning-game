          },
          "prompts": [
            {
              "id": "problem",
              "kind": "what",
              "label": "PROBLEM",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "A heap-based Dijkstra run first pushes `(20, V)`. Later, another route improves `V` to distance `8`, so it also pushes `(8, V)`. Both heap entries remain until popped."
              }
            },
            {
              "id": "definition",
              "kind": "what",
              "label": "WHAT IT IS",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "A simple heap implementation may insert a new entry whenever a distance improves instead of editing the old heap entry. The distance map stores the current best value; an older heap entry can therefore become stale."
              }
            },
            {
              "id": "step-1",
              "kind": "mental_model",
              "label": "STEP 1",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "bullets",
                "items": [
                  "Heap contains `(8, V)` and `(20, V)`.",
                  "Current distance map says `dist[V] = 8`."
                ]
              }
            },
            {
              "id": "step-2",
              "kind": "mental_model",
              "label": "STEP 2",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "bullets",
                "items": [
                  "Pop `(8, V)` first and process it.",
                  "Later pop `(20, V)`.",
                  "`20 != dist[V]`, so this entry is stale and can be skipped."
                ]
              }
            },
            {
              "id": "code",
              "kind": "action",
              "label": "SKIP STALE WORK",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "dijkstra_heap.py",
                "language": "python",
                "code": "while heap:\n    popped_dist, u = heapq.heappop(heap)\n    if popped_dist != dist[u]:\n        continue\n    # relax outgoing edges from u\n",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "pop",
                    "anchor": {
                      "line": 2,
                      "text": "popped_dist, u = heapq.heappop(heap)",
                      "occurrence": 1
                    },
                    "title": "Take the cheapest heap entry",
                    "explanation": "The heap may still contain older entries for the same vertex.",
                    "required": true
                  },
                  {
                    "id": "skip",
                    "anchor": {
                      "line": 3,
                      "text": "if popped_dist != dist[u]:",
                      "occurrence": 1
                    },
                    "title": "Compare with current truth",
                    "explanation": "If the values differ, a better route was recorded after this heap entry was created.",
                    "required": true
                  }
                ]
              }
            },
            {
              "id": "when",
              "kind": "when",
              "label": "WHEN TO USE IT",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "This lazy duplicate-entry pattern is useful with heaps that do not update an existing priority in place."
              }
            },
            {
              "id": "rule",
              "kind": "look_for",
              "label": "RULE",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Heap entry is work history; `dist` is the current best distance."
              }
            },
            {
              "id": "check",
              "kind": "action",
              "label": "CHECK",
              "placeholder": "",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Heap pops `(20,V)` but `dist[V]` is `8`. Process or skip? Answer: Skip it.",
