    {
      "id": "demo-reconstruction-cloudwatch-001",
      "content_version": "soa-c03-demo-content-v1",
      "certification_version": "soa-c03-demo",
      "domain_id": "domain-1",
      "task_id": "D1.1",
      "assessment_mode": "structural_reconstruction",
      "interaction_type": "reconstruction",
      "difficulty_prior": 0.45,
      "prompt": "Rebuild the path from a metric crossing its threshold to an operator notification.",
      "interaction": {
        "type": "reconstruction",
        "layout": "linear",
        "fixed_nodes": [
          {
            "id": "metric_threshold",
            "label": "Metric crosses threshold",
            "position": "start"
          }
        ],
        "pieces": [
          { "id": "cloudwatch_alarm", "label": "CloudWatch alarm" },
          { "id": "sns_topic", "label": "SNS topic" },
          { "id": "operator", "label": "Operator notification" },
          { "id": "cloudtrail", "label": "CloudTrail" },
          { "id": "config", "label": "AWS Config" }
        ],
        "slots": [{ "id": "slot_1" }, { "id": "slot_2" }, { "id": "slot_3" }]
      },
      "canonical_answer": {
        "type": "reconstruction",
        "placements": {
          "slot_1": "cloudwatch_alarm",
          "slot_2": "sns_topic",
          "slot_3": "operator"
        }
      },
      "concepts": [
        { "concept_id": "aws.cloudwatch.alarm", "weight": 0.5 },
        { "concept_id": "aws.cloudwatch.alarm_actions", "weight": 0.3 },
        { "concept_id": "aws.sns", "weight": 0.2 }
      ],
      "explanation": "A metric crossing its threshold moves the alarm into ALARM, the alarm action publishes to an SNS topic, and SNS delivers the notification to the operator. CloudTrail and AWS Config record activity but are not part of the notification path.",
      "hints": [
        "The alarm needs a metric before it can change state, and SNS is what reaches the operator."
      ],
      "error_codes": [
        {
          "code": "reconstruction_wrong_component",
          "description": "A piece that is not part of the correct structure was placed in a slot."
        },
        {
          "code": "reconstruction_wrong_position",
          "description": "A required piece was placed in the wrong slot."
        },
        {
          "code": "reconstruction_missing_component",
          "description": "A required piece was never placed."
        },
        {
          "code": "reconstruction_unfilled_slot",
          "description": "A slot was left empty."
        }
      ],
      "source_refs": [
        {
          "title": "Using Amazon CloudWatch alarms",
          "url": "https://docs.aws.amazon.com/AmazonCloudWatch/latest/monitoring/AlarmThatSendsEmail.html"
        },
        {
          "title": "What is Amazon SNS?",
          "url": "https://docs.aws.amazon.com/sns/latest/dg/welcome.html"
        }
      ]
    },
    {
