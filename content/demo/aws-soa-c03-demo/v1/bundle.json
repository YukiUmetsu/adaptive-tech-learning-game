    {
      "id": "demo-troubleshooting-alb-001",
      "content_version": "soa-c03-demo-content-v1",
      "certification_version": "soa-c03-demo",
      "domain_id": "domain-2",
      "task_id": "D2.1",
      "assessment_mode": "application",
      "interaction_type": "troubleshooting",
      "difficulty_prior": 0.65,
      "prompt": "Users report HTTP 503 responses from an Application Load Balancer. Work through the incident and choose the best action at each step.",
      "interaction": {
        "type": "troubleshooting",
        "start_step_id": "diagnose",
        "steps": [
          {
            "id": "diagnose",
            "prompt": "The ALB is reachable and HealthyHostCount is 0. What do you inspect first?",
            "stage": "diagnosis",
            "choices": [
              {
                "id": "check_target_health",
                "label": "Target health reasons in the target group"
              },
              {
                "id": "check_listener_rules",
                "label": "Listener rules and certificate configuration"
              },
              {
                "id": "check_rds_metrics",
                "label": "RDS Performance Insights"
              }
            ],
            "next_step_by_choice": {
              "check_target_health": "remediate",
              "check_listener_rules": "remediate",
              "check_rds_metrics": "remediate"
            }
          },
          {
            "id": "remediate",
            "prompt": "Target health reports that every target fails its health check with HTTP 404. What do you do?",
            "stage": "remediation",
            "choices": [
              {
                "id": "fix_health_path",
                "label": "Point the health check at a path the application serves"
              },
              {
                "id": "restart_targets",
                "label": "Restart every registered target"
              },
              {
                "id": "increase_timeout",
                "label": "Raise the health check timeout to 60 seconds"
              }
            ],
            "next_step_by_choice": {}
          }
        ]
      },
      "canonical_answer": {
        "type": "troubleshooting",
        "correct_choice_ids": {
          "diagnose": ["check_target_health"],
          "remediate": ["fix_health_path"]
        },
        "expected_path": ["check_target_health", "fix_health_path"]
      },
      "concepts": [{ "concept_id": "aws.elb.target_health", "weight": 1.0 }],
      "explanation": "HealthyHostCount = 0 points directly at target health, not at the listener or an unrelated database. Once the health check path is identified as wrong, correcting the path is the remediation; restarting healthy processes or extending the timeout does not fix a 404.",
      "hints": [
        "Start from the signal that already says the targets are unhealthy."
      ],
      "error_codes": [
        {
          "code": "troubleshooting_wrong_diagnosis",
          "description": "A diagnostic decision was incorrect."
        },
        {
          "code": "troubleshooting_wrong_next_action",
          "description": "A next-action decision was incorrect."
        },
        {
          "code": "troubleshooting_wrong_remediation",
          "description": "A remediation decision was incorrect."
        },
        {
          "code": "troubleshooting_incomplete_path",
          "description": "The scenario ended before all decisions were made."
        }
      ],
      "source_refs": [
        {
          "title": "Health checks for Application Load Balancer target groups",
          "url": "https://docs.aws.amazon.com/elasticloadbalancing/latest/application/target-group-health-checks.html"
        }
      ]
    },
    {
      "id": "demo-scenario-alarm-001",
      "content_version": "soa-c03-demo-content-v1",
      "certification_version": "soa-c03-demo",
      "domain_id": "domain-2",
      "task_id": "D2.1",
      "assessment_mode": "application",
