          {
            "id": "alarm",
            "prompt": "The alarm has just fired. What do you inspect first?",
            "stage": "diagnosis",
            "choices": [
              {
                "id": "inspect_metric",
                "label": "The CPU metric, its statistic, and its time range"
              },
              {
                "id": "terminate_busiest",
                "label": "Terminate the busiest instance immediately"
              }
            ],
            "next_step_by_choice": {
              "inspect_metric": "respond",
              "terminate_busiest": "respond"
            }
          },
          {
            "id": "respond",
            "prompt": "The metric has been above threshold for 30 minutes and request latency is rising. What is the best next action?",
            "stage": "action",
            "choices": [
              {
                "id": "scale_out",
                "label": "Scale the Auto Scaling group out"
              },
              {
                "id": "disable_alarm",
                "label": "Disable the alarm until traffic drops"
              }
            ],
            "next_step_by_choice": {}
          }
        ]
      },
      "canonical_answer": {
        "type": "scenario_choice_chain",
        "correct_choice_ids": {
          "alarm": ["inspect_metric"],
          "respond": ["scale_out"]
        },
        "expected_path": ["inspect_metric", "scale_out"]
      },
      "concepts": [
        { "concept_id": "aws.cloudwatch.alarm", "weight": 0.6 },
        { "concept_id": "aws.elb.target_health", "weight": 0.4 }
      ],
      "explanation": "Confirm the signal before acting, then relieve the load by scaling out. Terminating instances or disabling the alarm removes the symptom without addressing capacity.",
      "hints": [
        "Verify the metric before changing capacity, and prefer reversible actions."
      ],
