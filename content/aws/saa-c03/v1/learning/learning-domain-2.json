          "id": "domain-2-stateless-scaling",
          "title": "Stateless services and horizontal scaling",
          "concept_ids": [
            "aws.saa.stateless_scaling"
          ],
          "prerequisite_node_ids": [],
          "map_position": {
            "x": 0.12,
            "y": 0.16
          },
          "prompts": [
            {
              "id": "stateless-scaling-what",
              "kind": "what",
              "label": "WHAT?",
              "placeholder": "What should this concept make you think of?",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Stateless application tiers keep session state outside individual compute instances so capacity can scale out and replace instances safely."
              }
            },
            {
              "id": "stateless-scaling-task-table",
              "kind": "connects_to",
              "label": "TASK MAP",
              "placeholder": "Reveal each row and compare neighboring architecture choices.",
              "required": true,
              "reveal": {
                "type": "table",
                "columns": [
                  {
                    "id": "choice",
                    "label": "Choice / concept"
                  },
                  {
                    "id": "best_for",
                    "label": "What distinguishes it"
                  }
                ],
                "rows": [
                  {
                    "id": "r1",
                    "cells": {
                      "choice": "horizontal scaling",
                      "best_for": "Stateless application tiers keep session state outside individual compute instances so capacity can scale out and replace instances safely."
                    }
                  },
                  {
                    "id": "r2",
                    "cells": {
                      "choice": "Auto Scaling group",
                      "best_for": "Elastic Load Balancing distributes requests across healthy targets, and EC2 Auto Scaling adjusts the number of instances to match demand."
                    }
                  },
                  {
                    "id": "r3",
                    "cells": {
                      "choice": "Amazon SQS",
                      "best_for": "Amazon SQS stores messages durably so producers and consumers can operate at different rates without a direct synchronous dependency."
                    }
                  },
                  {
                    "id": "r4",
                    "cells": {
                      "choice": "Amazon SNS",
                      "best_for": "Amazon SNS publishes one message to multiple subscribers or downstream endpoints through a topic."
                    }
                  },
                  {
                    "id": "r5",
                    "cells": {
                      "choice": "Amazon EventBridge",
                      "best_for": "Amazon EventBridge routes events from AWS services, custom applications, and partners to targets by matching event patterns."
                    }
                  },
                  {
                    "id": "r6",
                    "cells": {
                      "choice": "AWS Step Functions",
                      "best_for": "AWS Step Functions coordinates multi-step workflows with explicit states, branching, retries, timeouts, and service integrations."
                    }
                  },
                  {
                    "id": "r7",
                    "cells": {
                      "choice": "AWS Lambda",
                      "best_for": "AWS Lambda runs event-driven code without managing servers and scales concurrent execution in response to incoming work within service limits."
                    }
                  },
                  {
                    "id": "r8",
                    "cells": {
                      "choice": "AWS Fargate",
                      "best_for": "Amazon ECS and Amazon EKS orchestrate containers, while AWS Fargate supplies serverless container compute for supported ECS and EKS workloads."
                    }
                  },
                  {
                    "id": "r9",
                    "cells": {
                      "choice": "Amazon API Gateway",
                      "best_for": "Amazon API Gateway provides managed endpoints for REST, HTTP, and WebSocket APIs and integrates with backends such as Lambda or private services."
                    }
                  }
                ],
