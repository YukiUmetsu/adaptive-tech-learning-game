              "required": true,
              "reveal": {
                "type": "text",
                "text": "AWS Step Functions coordinates multi-step workflows with explicit states, branching, retries, timeouts, and service integrations."
              }
            },
            {
              "id": "step-functions-code",
              "kind": "look_for",
              "label": "READ THE CONFIG",
              "placeholder": "Click the important parts of this configuration before revealing the explanation.",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "state-machine.json",
                "language": "json",
                "code": "{\n  \"StartAt\": \"Charge\",\n  \"States\": {\n    \"Charge\": {\n      \"Type\": \"Task\",\n      \"Next\": \"Ship\",\n      \"Retry\": [{\"ErrorEquals\": [\"States.ALL\"], \"MaxAttempts\": 3}]\n    },\n    \"Ship\": {\"Type\": \"Task\", \"End\": true}\n  }\n}",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "a1",
                    "anchor": {
                      "line": 2,
                      "text": "\"StartAt\"",
                      "occurrence": 1
                    },
                    "title": "Explicit workflow entry",
                    "explanation": "A state machine has an explicit starting state.",
                    "required": true
                  },
                  {
                    "id": "a2",
                    "anchor": {
                      "line": 6,
                      "text": "\"Next\"",
                      "occurrence": 1
                    },
                    "title": "Explicit transition",
                    "explanation": "Next makes workflow sequencing visible rather than burying orchestration in application code.",
                    "required": true
                  },
                  {
                    "id": "a3",
                    "anchor": {
                      "line": 7,
                      "text": "\"Retry\"",
                      "occurrence": 1
                    },
                    "title": "Built-in retry policy",
                    "explanation": "Step Functions can declaratively retry failed task states.",
                    "required": true
                  }
                ]
              }
            },
