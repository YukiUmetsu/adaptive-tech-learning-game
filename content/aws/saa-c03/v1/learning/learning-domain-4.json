          "id": "domain-4-s3-classes",
          "title": "S3 storage classes and lifecycle",
          "concept_ids": [
            "aws.saa.s3_classes"
          ],
          "prerequisite_node_ids": [],
          "map_position": {
            "x": 0.12,
            "y": 0.16
          },
          "prompts": [
            {
              "id": "s3-classes-what",
              "kind": "what",
              "label": "WHAT?",
              "placeholder": "What should this concept make you think of?",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "S3 storage classes trade storage price, retrieval price, minimum duration, availability design, and retrieval latency for different access patterns."
              }
            },
            {
              "id": "s3-classes-code",
              "kind": "look_for",
              "label": "READ THE CONFIG",
              "placeholder": "Click the important parts of this configuration before revealing the explanation.",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "lifecycle.json",
                "language": "json",
                "code": "{\n  \"Rules\": [{\n    \"Status\": \"Enabled\",\n    \"Transitions\": [\n      {\"Days\": 30, \"StorageClass\": \"STANDARD_IA\"},\n      {\"Days\": 90, \"StorageClass\": \"GLACIER\"}\n    ]\n  }]\n}",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "a1",
                    "anchor": {
                      "line": 5,
                      "text": "\"Days\": 30",
                      "occurrence": 1
                    },
                    "title": "Age-based transition",
                    "explanation": "Lifecycle rules can move objects to a lower-cost class after a defined age.",
                    "required": true
                  },
                  {
                    "id": "a2",
                    "anchor": {
                      "line": 6,
                      "text": "\"StorageClass\": \"GLACIER\"",
                      "occurrence": 1
                    },
                    "title": "Archive transition",
                    "explanation": "Archive tiers reduce storage cost when slower retrieval and retrieval charges are acceptable.",
                    "required": true
                  }
                ]
              }
            },
            {
              "id": "s3-classes-clue",
              "kind": "exam_clue",
              "label": "EXAM CLUE",
              "placeholder": "What phrase should make this answer jump out?",
              "required": true,
              "reveal": {
                "type": "keywords",
                "items": [
