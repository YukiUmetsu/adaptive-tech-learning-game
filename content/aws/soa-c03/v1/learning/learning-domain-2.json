          "concept_ids": [
            "aws.autoscaling.instance_warmup",
            "aws.autoscaling.health_check_grace"
          ],
          "prompts": [
            {
              "id": "timers",
              "kind": "not_this",
              "label": "DON'T CONFUSE THE TIMERS",
              "placeholder": "What question does each timer answer?",
              "required": true,
              "reveal": {
                "type": "comparison",
                "columns": [
                  {
                    "title": "Instance warmup",
                    "items": [
                      "When should a newly launched instance contribute fully to scaling metrics/decisions?",
                      "Prevents fresh instances from causing premature additional scaling"
                    ]
                  },
                  {
                    "title": "Health check grace period",
                    "items": [
                      "How long should Auto Scaling wait before acting on health-check failures for a new instance?",
                      "Allows initialization before replacement decisions"
                    ]
                  }
                ]
              }
            },
            {
              "id": "design",
              "kind": "what",
              "label": "SET THEM FROM STARTUP REALITY",
              "placeholder": "What should determine the values?",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Base the timers on actual application boot, registration, and stabilization behavior. If the application needs several minutes to become ready, zero or very short timers can cause churn."
              }
            }
