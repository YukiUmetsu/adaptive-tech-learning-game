                  },
                  {
                    "id": "why",
                    "label": "Why"
                  }
                ],
                "rows": [
                  {
                    "id": "console",
                    "cells": {
                      "risk": "Password compromise",
                      "control": "MFA",
                      "why": "Requires an additional authentication factor."
                    }
                  },
                  {
                    "id": "longterm",
                    "cells": {
                      "risk": "Long-lived access keys",
                      "control": "Prefer roles / temporary credentials",
                      "why": "Reduces dependence on static secrets."
                    }
                  },
                  {
                    "id": "unused",
                    "cells": {
                      "risk": "Old credentials",
                      "control": "Credential reports / access review / rotation or removal",
                      "why": "Reduces unnecessary standing access."
                    }
                  }
                ],
                "progressive_reveal": {
                  "mode": "row",
