        {
          "id": "d4-organizations-scp",
          "title": "AWS Organizations and SCPs",
          "concept_ids": [
            "aws.organizations",
            "aws.organizations.scp"
          ],
          "prompts": [
            {
              "id": "boundary",
              "kind": "what",
              "label": "SCP = PERMISSION GUARDRAIL",
              "placeholder": "What does an SCP do?",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "A service control policy defines the maximum permissions available to affected member accounts/organizational units. It does not itself grant permissions to IAM principals."
              }
            },
            {
              "id": "scp",
              "kind": "look_for",
              "label": "INSPECT AN SCP",
              "placeholder": "Click the denied action and resource scope.",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "deny-leave-org.json",
                "language": "json",
                "code": "{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [{\n    \"Effect\": \"Deny\",\n    \"Action\": \"organizations:LeaveOrganization\",\n    \"Resource\": \"*\"\n  }]\n}",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "deny",
                    "anchor": {
                      "line": 4,
                      "text": "\"Deny\"",
                      "occurrence": 1
                    },
                    "title": "Guardrail effect",
                    "explanation": "An explicit deny in an applicable SCP constrains permissions in affected accounts.",
                    "required": true
                  },
                  {
                    "id": "action",
                    "anchor": {
                      "line": 5,
                      "text": "organizations:LeaveOrganization",
                      "occurrence": 1
                    },
                    "title": "Denied action",
                    "explanation": "This guardrail prevents the listed Organizations API action.",
                    "required": true
                  },
                  {
                    "id": "resource",
                    "anchor": {
                      "line": 6,
                      "text": "\"*\"",
                      "occurrence": 1
                    },
                    "title": "Resource scope",
                    "explanation": "The statement applies across the resource scope supported by this action.",
                    "required": true
                  }
                ]
              }
            }
          ],
          "prerequisite_node_ids": [
            "d4-access-tools"
          ],
          "map_position": {
            "x": 0.36,
            "y": 0.12
          },
          "source_refs": []
        },
        {
          "id": "d4-identity-center",
          "title": "IAM Identity Center",
          "concept_ids": [
            "aws.identitycenter"
          ],
          "prompts": [
            {
              "id": "purpose",
              "kind": "what",
              "label": "WHAT DOES IDENTITY CENTER SOLVE?",
              "placeholder": "Why use it in a multi-account environment?",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "IAM Identity Center centralizes workforce access to AWS accounts and applications, commonly using permission sets to create controlled account-role access for users and groups."
              }
            },
            {
              "id": "flow",
              "kind": "action",
              "label": "WORKFORCE ACCESS FLOW",
              "placeholder": "How does the access model fit together?",
              "required": true,
              "reveal": {
                "type": "sequence",
                "items": [
                  "User/group in identity source",
                  "Assignment to account + permission set",
                  "IAM Identity Center provisions account access",
                  "User obtains temporary role credentials"
                ]
              }
            }
          ],
