      "id": "d4-iam-basics",
      "title": "IAM Authorization Foundations",
      "order": 1,
      "task_ids": [
        "4.1"
      ],
      "skill_ids": [
        "4.1.1"
      ],
      "prerequisite_module_ids": [],
      "nodes": [
        {
          "id": "d4-iam-model",
          "title": "IAM policy evaluation",
          "concept_ids": [
            "aws.iam"
          ],
          "prompts": [
            {
              "id": "decision",
              "kind": "what",
              "label": "UNDERSTAND THE DECISION",
              "placeholder": "Reveal the decision logic one row at a time.",
              "required": true,
              "reveal": {
                "type": "table",
                "columns": [
                  {
                    "id": "case",
                    "label": "Evaluation result"
                  },
                  {
                    "id": "condition",
                    "label": "When it happens"
                  },
                  {
                    "id": "effect",
                    "label": "Effect"
                  }
                ],
                "rows": [
                  {
                    "id": "deny",
                    "cells": {
                      "case": "Explicit deny",
                      "condition": "Any applicable policy explicitly denies the request",
                      "effect": "Request is denied even if another policy allows it."
                    }
                  },
                  {
                    "id": "allow",
                    "cells": {
                      "case": "Allow",
                      "condition": "An applicable allow exists and no applicable explicit deny overrides it",
                      "effect": "Request can be authorized, subject to all policy/control layers."
                    }
                  },
                  {
                    "id": "implicit",
                    "cells": {
                      "case": "Implicit deny",
                      "condition": "No applicable allow grants the request",
                      "effect": "Request is denied by default."
                    }
                  }
                ],
                "progressive_reveal": {
                  "mode": "row",
                  "initially_visible": {
                    "column_ids": [
                      "case"
                    ],
                    "row_ids": [],
                    "cell_ids": []
                  }
                }
              }
            },
            {
              "id": "layers",
              "kind": "what",
              "label": "AUTHORIZATION CAN HAVE MULTIPLE LAYERS",
              "placeholder": "What else can constrain a request?",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Identity policies, resource policies, permissions boundaries, session policies, SCPs, and service-specific controls can all affect the final authorization result depending on the scenario."
              }
            }
          ],
          "prerequisite_node_ids": [],
          "map_position": {
            "x": 0.12,
            "y": 0.12
          },
          "source_refs": []
        },
        {
          "id": "d4-roles",
          "title": "IAM roles",
          "concept_ids": [
            "aws.iam.roles"
          ],
          "prompts": [
            {
              "id": "role",
              "kind": "what",
              "label": "ROLE = TRUST + PERMISSIONS",
              "placeholder": "What two questions must you answer for an IAM role?",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "The trust policy answers who or what may assume the role. The role's permissions policies answer what the resulting role session may do."
              }
            },
            {
              "id": "trust",
              "kind": "look_for",
              "label": "INSPECT A TRUST POLICY",
              "placeholder": "Click the fields that determine who can assume this role.",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "trust-policy.json",
                "language": "json",
                "code": "{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [{\n    \"Effect\": \"Allow\",\n    \"Principal\": {\"Service\": \"ec2.amazonaws.com\"},\n    \"Action\": \"sts:AssumeRole\"\n  }]\n}",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "principal",
                    "anchor": {
                      "line": 5,
                      "text": "Principal",
                      "occurrence": 1
                    },
                    "title": "Trusted principal",
                    "explanation": "Principal identifies who or what is trusted to assume the role.",
                    "required": true
                  },
                  {
                    "id": "service",
                    "anchor": {
                      "line": 5,
                      "text": "ec2.amazonaws.com",
                      "occurrence": 1
                    },
                    "title": "AWS service principal",
                    "explanation": "This trust policy allows the EC2 service to assume the role.",
                    "required": true
                  },
                  {
                    "id": "action",
                    "anchor": {
                      "line": 6,
                      "text": "sts:AssumeRole",
                      "occurrence": 1
                    },
                    "title": "Assume-role action",
                    "explanation": "The trust relationship allows the STS AssumeRole operation for the trusted principal.",
                    "required": true
                  }
                ]
              }
            }
          ],
          "prerequisite_node_ids": [
            "d4-iam-model"
          ],
          "map_position": {
            "x": 0.36,
            "y": 0.12
          },
          "source_refs": []
        },
        {
          "id": "d4-resource-policies",
          "title": "Resource-based policies",
          "concept_ids": [
            "aws.iam.resource_policies"
          ],
          "prompts": [
            {
              "id": "bucket",
              "kind": "look_for",
              "label": "INSPECT A RESOURCE POLICY",
              "placeholder": "Click the fields that scope this S3 bucket policy statement.",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "bucket-policy.json",
                "language": "json",
                "code": "{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [{\n    \"Effect\": \"Allow\",\n    \"Principal\": {\"AWS\": \"arn:aws:iam::111122223333:role/Reader\"},\n    \"Action\": \"s3:GetObject\",\n    \"Resource\": \"arn:aws:s3:::reports/*\"\n  }]\n}",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "principal",
                    "anchor": {
                      "line": 5,
                      "text": "Principal",
                      "occurrence": 1
                    },
                    "title": "Who receives the resource permission",
                    "explanation": "A resource-based policy can name the principal that receives access.",
                    "required": true
                  },
                  {
                    "id": "action",
                    "anchor": {
                      "line": 6,
                      "text": "s3:GetObject",
                      "occurrence": 1
                    },
                    "title": "Allowed action",
                    "explanation": "The statement permits only the specified S3 API action.",
                    "required": true
                  },
                  {
                    "id": "resource",
                    "anchor": {
                      "line": 7,
                      "text": "reports/*",
                      "occurrence": 1
                    },
                    "title": "Resource scope",
                    "explanation": "The ARN limits the permission to objects under the reports bucket path.",
                    "required": true
                  }
                ]
              }
            },
            {
              "id": "crossaccount",
              "kind": "what",
              "label": "WHY RESOURCE POLICIES MATTER",
              "placeholder": "What is a common use case?",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Resource-based policies are often used to grant access directly on a resource, including cross-account scenarios where the resource owner defines who may access it."
              }
            }
          ],
          "prerequisite_node_ids": [
            "d4-roles"
          ],
          "map_position": {
            "x": 0.6,
            "y": 0.12
          },
          "source_refs": []
        },
        {
          "id": "d4-conditions",
          "title": "IAM conditions",
          "concept_ids": [
            "aws.iam.conditions"
          ],
          "prompts": [
            {
              "id": "condition",
              "kind": "look_for",
              "label": "INSPECT A CONDITION",
              "placeholder": "Click the condition pieces and infer when the statement applies.",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "secure-transport.json",
                "language": "json",
                "code": "{\n  \"Effect\": \"Deny\",\n  \"Action\": \"s3:*\",\n  \"Resource\": [\n    \"arn:aws:s3:::reports\",\n    \"arn:aws:s3:::reports/*\"\n  ],\n  \"Condition\": {\n    \"Bool\": {\n      \"aws:SecureTransport\": \"false\"\n    }\n  }\n}",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "deny",
                    "anchor": {
                      "line": 2,
                      "text": "\"Deny\"",
                      "occurrence": 1
                    },
                    "title": "Explicit deny",
                    "explanation": "This statement denies matching requests.",
                    "required": true
                  },
                  {
                    "id": "condition",
                    "anchor": {
                      "line": 8,
                      "text": "Condition",
                      "occurrence": 1
                    },
                    "title": "Conditional application",
                    "explanation": "The statement only applies when the condition evaluates as configured.",
                    "required": true
                  },
                  {
                    "id": "key",
                    "anchor": {
                      "line": 10,
                      "text": "aws:SecureTransport",
                      "occurrence": 1
                    },
                    "title": "Global condition key",
                    "explanation": "aws:SecureTransport indicates whether the request used TLS.",
                    "required": true
                  },
                  {
                    "id": "false",
                    "anchor": {
                      "line": 10,
                      "text": "\"false\"",
                      "occurrence": 1
                    },
                    "title": "Denied case",
                    "explanation": "The deny applies when SecureTransport is false, enforcing encrypted transport.",
                    "required": true
                  }
                ]
              }
            }
          ],
          "prerequisite_node_ids": [
            "d4-resource-policies"
          ],
          "map_position": {
            "x": 0.84,
            "y": 0.12
          },
          "source_refs": []
        },
