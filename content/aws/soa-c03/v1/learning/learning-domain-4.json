        {
          "id": "d4-kms",
          "title": "AWS KMS encryption at rest",
          "concept_ids": [
            "aws.kms"
          ],
          "prompts": [
            {
              "id": "model",
              "kind": "what",
              "label": "KMS KEY MENTAL MODEL",
              "placeholder": "What does KMS provide?",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "AWS KMS manages cryptographic keys and integrates with AWS services for encryption. Service-side encryption often uses envelope encryption, where data keys protect data and KMS keys protect those data keys."
              }
            },
            {
              "id": "envelope",
              "kind": "action",
              "label": "ENVELOPE ENCRYPTION",
              "placeholder": "How does the pattern work?",
              "required": true,
              "reveal": {
                "type": "sequence",
                "items": [
                  "KMS key protects a data key",
                  "Data key encrypts application/service data",
                  "Encrypted data key can be stored with ciphertext",
                  "Authorized use of the KMS key decrypts/unwraps the data key"
                ]
              }
            }
          ],
          "prerequisite_node_ids": [
            "d4-classification"
          ],
          "map_position": {
            "x": 0.36,
            "y": 0.12
          },
          "source_refs": []
        },
        {
          "id": "d4-kms-auth",
          "title": "KMS key authorization",
          "concept_ids": [
            "aws.kms.permissions"
          ],
          "prompts": [
            {
              "id": "policy",
              "kind": "look_for",
              "label": "INSPECT A KEY POLICY STATEMENT",
              "placeholder": "Click the fields that grant a principal use of this key.",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "key-policy.json",
                "language": "json",
                "code": "{\n  \"Effect\": \"Allow\",\n  \"Principal\": {\"AWS\": \"arn:aws:iam::111122223333:role/AppRole\"},\n  \"Action\": [\n    \"kms:Decrypt\",\n    \"kms:GenerateDataKey\"\n  ],\n  \"Resource\": \"*\"\n}",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "principal",
                    "anchor": {
                      "line": 3,
                      "text": "Principal",
                      "occurrence": 1
                    },
                    "title": "Authorized principal",
                    "explanation": "The key policy names the role allowed by this statement.",
                    "required": true
                  },
                  {
                    "id": "decrypt",
                    "anchor": {
                      "line": 5,
                      "text": "kms:Decrypt",
                      "occurrence": 1
                    },
                    "title": "Decrypt permission",
                    "explanation": "Allows the principal to ask KMS to decrypt ciphertext/data keys under the key, subject to the full authorization context.",
                    "required": true
                  },
                  {
                    "id": "generate",
                    "anchor": {
                      "line": 6,
                      "text": "kms:GenerateDataKey",
                      "occurrence": 1
                    },
                    "title": "Data-key generation",
                    "explanation": "Allows generation of data keys for envelope-encryption workflows.",
                    "required": true
                  }
                ]
              }
            },
            {
              "id": "both",
              "kind": "what",
              "label": "DON'T CHECK IAM ALONE",
              "placeholder": "Why can KMS authorization be confusing?",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "KMS authorization involves the key policy and, depending on the design, IAM policies, grants, and service integrations. Troubleshooting should evaluate all applicable permission layers."
              }
            }
          ],
