  "questions": [
    {
      "id": "monitoring-classification-001",
      "content_version": "soa-c03-content-v1",
      "certification_version": "soa-c03",
      "domain_id": "domain-1",
      "task_id": "1.1",
      "assessment_mode": "recognition",
      "interaction_type": "classification",
      "difficulty_prior": 0.25,
      "prompt": "Classify each operational signal by what it primarily is.",
      "interaction": {
        "type": "classification",
        "items": [
          {
            "id": "metric_cpu",
            "label": "CPU utilization reported as a numeric time series"
          },
          {
            "id": "log_api_call",
            "label": "A timestamped record of an AWS API call, including who made it and when"
          },
          {
            "id": "action_email",
            "label": "An email delivered to an operator after an alarm fires"
          },
          {
            "id": "metric_memory",
            "label": "Memory used percent published by the CloudWatch agent"
          },
          {
            "id": "log_error",
            "label": "A timestamped application error line stored in a log group"
          }
        ],
        "categories": [
          {
            "id": "metric",
            "label": "Metric — numeric time series"
          },
          {
            "id": "log",
            "label": "Log or event record — timestamped detail"
          },
          {
            "id": "action",
            "label": "Notification or action — delivery or trigger"
          }
        ]
      },
      "canonical_answer": {
        "type": "classification",
        "placements": {
          "metric_cpu": "metric",
          "log_api_call": "log",
          "action_email": "action",
          "metric_memory": "metric",
          "log_error": "log"
        }
      },
      "concepts": [
        {
          "concept_id": "aws.monitoring_vs_logging",
          "weight": 1.0
        }
      ],
      "explanation": "Metrics are numeric time series used for trends and alarms. Logs and event records are timestamped detail. A notification or action is the delivery or trigger step, not the raw signal.",
      "hints": [
        "Ask whether the value is a number over time, a timestamped record, or something being delivered."
      ],
      "error_codes": [
        {
          "code": "classification_misplaced",
          "description": "At least one item was placed in the wrong category."
        },
        {
          "code": "classification_incomplete",
          "description": "At least one item was not placed in any category."
        }
      ],
