        {
          "id": "d3-practical-loop",
          "title": "A practical local working-directory loop",
          "concept_ids": [
            "tf.workflow",
            "tf.cli.init",
            "tf.cli.validate",
            "tf.cli.fmt",
            "tf.cli.plan",
            "tf.cli.apply"
          ],
          "prerequisite_node_ids": [
            "d3-core-loop"
          ],
          "map_position": {
            "x": 0.34,
            "y": 0.18
          },
          "prompts": [
            {
              "id": "first-run",
              "kind": "action",
              "label": "READ THE PRACTICAL LOOP",
              "placeholder": "This is a sensible first-run sequence, but each command has a different job. Click every command to understand why it is present.",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "first-run.sh",
                "language": "bash",
                "code": "terraform init\nterraform fmt\nterraform validate\nterraform plan\nterraform apply",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "init",
                    "anchor": {
                      "line": 1,
                      "text": "terraform init",
                      "occurrence": 1
                    },
                    "title": "Prepare the working directory",
                    "explanation": "Initializes backend settings and installs required providers/modules. Rerun it when those dependencies or backend settings change.",
                    "required": true
                  },
                  {
                    "id": "fmt",
                    "anchor": {
                      "line": 2,
                      "text": "terraform fmt",
                      "occurrence": 1
                    },
                    "title": "Format configuration",
                    "explanation": "Rewrites Terraform files into canonical style. It is a style tool, not semantic validation.",
                    "required": true
                  },
                  {
                    "id": "validate",
                    "anchor": {
                      "line": 3,
                      "text": "terraform validate",
                      "occurrence": 1
                    },
                    "title": "Validate configuration",
                    "explanation": "Checks syntax and internal consistency. It does not prove that provider APIs will accept the planned changes.",
                    "required": true
                  },
                  {
                    "id": "plan",
                    "anchor": {
                      "line": 4,
                      "text": "terraform plan",
                      "occurrence": 1
                    },
                    "title": "Preview changes",
                    "explanation": "Builds an execution plan so you can review creates, updates, replacements, and destroys before modifying remote infrastructure.",
                    "required": true
                  },
                  {
                    "id": "apply",
                    "anchor": {
                      "line": 5,
                      "text": "terraform apply",
                      "occurrence": 1
                    },
                    "title": "Execute changes",
                    "explanation": "Without a saved plan argument, apply generates a fresh plan, asks for approval, and then performs the approved actions.",
                    "required": true
                  }
                ]
              }
            }
          ],
          "source_refs": [
            {
              "title": "Core Terraform workflow",
              "url": "https://developer.hashicorp.com/terraform/intro/core-workflow"
            },
            {
              "title": "terraform init",
              "url": "https://developer.hashicorp.com/terraform/cli/commands/init"
            }
          ]
        },
        {
          "id": "d3-init",
          "title": "terraform init prepares dependencies",
          "concept_ids": [
            "tf.cli.init"
          ],
          "prerequisite_node_ids": [
            "d3-practical-loop"
          ],
          "map_position": {
            "x": 0.56,
            "y": 0.28
          },
          "prompts": [
            {
              "id": "init-jobs",
              "kind": "what",
              "label": "WHAT INIT PREPARES",
              "placeholder": "What does terraform init prepare in a working directory?",
              "required": true,
              "reveal": {
                "type": "table",
                "columns": [
                  {
                    "id": "area",
                    "label": "Area"
                  },
                  {
                    "id": "behavior",
                    "label": "What init does"
                  }
                ],
                "rows": [
                  {
                    "cells": {
                      "area": "Backend",
                      "behavior": "Initializes or reconfigures state storage settings"
                    }
                  },
                  {
                    "cells": {
                      "area": "Providers",
                      "behavior": "Selects and installs provider plugins, consulting the dependency lock file"
                    }
                  },
                  {
                    "cells": {
                      "area": "Modules",
                      "behavior": "Downloads child modules referenced by source addresses"
                    }
                  },
                  {
                    "cells": {
                      "area": "Working directory",
                      "behavior": "Creates local initialization data under .terraform as needed"
                    }
                  }
                ]
              }
            },
            {
              "id": "init-flags",
              "kind": "when",
              "label": "COMMON INIT VARIANTS",
              "placeholder": "When backend or dependency behavior changes, which init option fits the intent?",
              "required": true,
              "reveal": {
                "type": "table",
                "columns": [
                  {
                    "id": "command",
                    "label": "Command"
                  },
                  {
                    "id": "use",
                    "label": "Use it when"
                  }
                ],
                "rows": [
                  {
                    "cells": {
                      "command": "terraform init",
                      "use": "Normal initialization or safe rerun"
                    }
                  },
                  {
                    "cells": {
                      "command": "terraform init -upgrade",
                      "use": "Reselect newer providers/modules within configured constraints"
                    }
                  },
                  {
                    "cells": {
                      "command": "terraform init -migrate-state",
                      "use": "Backend configuration changed and existing state should migrate"
                    }
                  },
                  {
                    "cells": {
                      "command": "terraform init -reconfigure",
                      "use": "Forget prior backend initialization and use the current backend settings without automatic migration"
                    }
                  },
                  {
                    "cells": {
                      "command": "terraform init -backend=false",
                      "use": "Prepare modules/providers while intentionally skipping backend initialization"
                    }
                  }
                ]
              }
            }
          ],
          "source_refs": [
            {
              "title": "terraform init",
              "url": "https://developer.hashicorp.com/terraform/cli/commands/init"
            }
          ]
        }
      ]
