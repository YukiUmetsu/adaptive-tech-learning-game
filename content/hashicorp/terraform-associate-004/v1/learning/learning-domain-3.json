        {
          "id": "d3-core-loop",
          "title": "The core workflow is Write -> Plan -> Apply",
          "concept_ids": [
            "tf.workflow"
          ],
          "prerequisite_node_ids": [],
          "map_position": {
            "x": 0.12,
            "y": 0.22
          },
          "prompts": [
            {
              "id": "core-three",
              "kind": "what",
              "label": "CORE WORKFLOW",
              "placeholder": "What are the three conceptual stages HashiCorp uses to describe the Terraform workflow?",
              "required": true,
              "reveal": {
                "type": "sequence",
                "items": [
                  "WRITE - author or change infrastructure configuration",
                  "PLAN - preview the actions Terraform proposes",
                  "APPLY - execute the approved actions against real infrastructure"
                ]
              }
            },
            {
              "id": "concept-vs-tools",
              "kind": "connects_to",
              "label": "CONCEPT VS SUPPORTING COMMANDS",
              "placeholder": "Where do init, fmt, and validate fit if the conceptual workflow is only Write, Plan, Apply?",
              "required": true,
              "reveal": {
                "type": "table",
                "columns": [
                  {
                    "id": "concept",
                    "label": "Conceptual stage"
                  },
                  {
                    "id": "support",
                    "label": "Useful supporting activity"
                  },
                  {
                    "id": "purpose",
                    "label": "Purpose"
                  }
                ],
                "rows": [
                  {
                    "cells": {
                      "concept": "Write",
                      "support": "terraform fmt",
                      "purpose": "Normalize Terraform source formatting"
                    }
                  },
                  {
                    "cells": {
                      "concept": "Write",
                      "support": "terraform validate",
                      "purpose": "Check syntax and internal consistency"
                    }
                  },
                  {
                    "cells": {
                      "concept": "Working-directory setup",
                      "support": "terraform init",
                      "purpose": "Prepare backend, providers, and modules before planning/applying"
                    }
                  },
                  {
                    "cells": {
                      "concept": "Plan",
                      "support": "terraform plan",
                      "purpose": "Produce an explicit preview for review"
                    }
                  },
                  {
                    "cells": {
                      "concept": "Apply",
                      "support": "terraform apply",
                      "purpose": "Perform the selected changes"
                    }
                  }
                ]
              }
            }
          ],
