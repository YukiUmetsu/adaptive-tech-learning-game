      "nodes": [
        {
          "id": "d3-fmt-validate",
          "title": "Formatting and validation solve different problems",
          "concept_ids": [
            "tf.cli.fmt",
            "tf.cli.validate"
          ],
          "prerequisite_node_ids": [],
          "map_position": {
            "x": 0.12,
            "y": 0.22
          },
          "prompts": [
            {
              "id": "fmt-validate",
              "kind": "not_this",
              "label": "FMT IS NOT VALIDATE",
              "placeholder": "Which command should you use for style versus configuration correctness?",
              "required": true,
              "reveal": {
                "type": "table",
                "columns": [
                  {
                    "id": "need",
                    "label": "Need"
                  },
                  {
                    "id": "command",
                    "label": "Command"
                  },
                  {
                    "id": "effect",
                    "label": "Effect"
                  }
                ],
                "rows": [
                  {
                    "cells": {
                      "need": "Rewrite files to canonical style",
                      "command": "terraform fmt",
                      "effect": "Modifies formatting in-place"
                    }
                  },
                  {
                    "cells": {
                      "need": "Check formatting in CI",
                      "command": "terraform fmt -check",
                      "effect": "Reports files needing formatting without rewriting them"
                    }
                  },
                  {
                    "cells": {
                      "need": "Check syntax and internal consistency",
                      "command": "terraform validate",
                      "effect": "Validates the configuration without planning infrastructure changes"
                    }
                  }
                ]
              }
            },
            {
              "id": "validate-limit",
              "kind": "not_this",
              "label": "VALIDATE HAS LIMITS",
              "placeholder": "Does terraform validate prove that a remote API will accept your configuration?",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "No. validate checks the configuration itself. Provider/API behavior, permissions, quotas, and current remote conditions are evaluated later during planning or applying."
              }
            }
          ],
          "source_refs": [
            {
              "title": "terraform fmt",
              "url": "https://developer.hashicorp.com/terraform/cli/commands/fmt"
            },
            {
              "title": "terraform validate",
              "url": "https://developer.hashicorp.com/terraform/cli/commands/validate"
            }
          ]
        },
        {
          "id": "d3-plan",
          "title": "terraform plan is a proposal, not a change",
          "concept_ids": [
            "tf.cli.plan"
          ],
          "prerequisite_node_ids": [
            "d3-fmt-validate"
          ],
          "map_position": {
            "x": 0.34,
            "y": 0.18
          },
          "prompts": [
            {
              "id": "plan-inputs",
              "kind": "connects_to",
              "label": "WHAT PLAN COMPARES",
              "placeholder": "What information does a normal plan bring together before proposing actions?",
              "required": true,
              "reveal": {
                "type": "table",
                "columns": [
                  {
                    "id": "input",
                    "label": "Input"
                  },
                  {
                    "id": "role",
                    "label": "Role in planning"
                  }
                ],
                "rows": [
                  {
                    "cells": {
                      "input": "Configuration",
                      "role": "Desired infrastructure"
                    }
                  },
                  {
                    "cells": {
                      "input": "Prior state",
                      "role": "Tracked addresses, object bindings, and prior known values"
                    }
                  },
                  {
                    "cells": {
                      "input": "Refreshed remote objects",
                      "role": "Current real-world values read through providers"
                    }
                  },
                  {
                    "cells": {
                      "input": "Dependency graph",
                      "role": "Orders and relates operations based on references and explicit dependencies"
                    }
                  }
                ]
              }
            },
            {
              "id": "plan-symbols",
              "kind": "look_for",
              "label": "READ THE ACTIONS",
              "placeholder": "What kind of infrastructure change should you look for while reviewing a plan?",
              "required": true,
              "reveal": {
                "type": "table",
                "columns": [
                  {
                    "id": "action",
                    "label": "Plan action"
                  },
                  {
                    "id": "meaning",
                    "label": "Meaning"
                  }
                ],
                "rows": [
                  {
                    "cells": {
                      "action": "Create",
                      "meaning": "A configured object is not currently managed/present and Terraform proposes creation"
                    }
                  },
                  {
                    "cells": {
                      "action": "Update in-place",
                      "meaning": "An existing object can be changed without replacement"
                    }
                  },
                  {
                    "cells": {
                      "action": "Replace",
                      "meaning": "A change requires destroying/recreating the managed object"
                    }
                  },
                  {
                    "cells": {
                      "action": "Destroy",
                      "meaning": "Terraform proposes deleting a managed remote object"
                    }
                  }
                ]
              }
            },
            {
              "id": "plan-no-change",
              "kind": "not_this",
              "label": "NO REMOTE MODIFICATION",
              "placeholder": "What is the critical safety property of terraform plan?",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "It proposes actions but does not perform the planned infrastructure changes. Review the plan before apply, especially replacements and destroys."
              }
            }
          ],
          "source_refs": [
            {
              "title": "terraform plan",
              "url": "https://developer.hashicorp.com/terraform/cli/commands/plan"
            }
          ]
        },
        {
          "id": "d3-plan-modes",
          "title": "Useful plan modes for CI and drift",
          "concept_ids": [
            "tf.cli.plan"
          ],
          "prerequisite_node_ids": [
            "d3-plan"
          ],
          "map_position": {
            "x": 0.56,
            "y": 0.28
          },
          "prompts": [
            {
              "id": "modes",
              "kind": "when",
              "label": "PLAN MODES",
              "placeholder": "Which plan option changes the question Terraform is answering?",
              "required": true,
              "reveal": {
                "type": "table",
                "columns": [
                  {
                    "id": "mode",
                    "label": "Mode"
                  },
                  {
                    "id": "purpose",
                    "label": "Purpose"
                  }
                ],
                "rows": [
                  {
                    "cells": {
                      "mode": "terraform plan",
                      "purpose": "Normal reconciliation toward configuration"
                    }
                  },
                  {
                    "cells": {
                      "mode": "terraform plan -refresh-only",
                      "purpose": "Preview accepting current remote reality into state/outputs without changing remote objects"
                    }
                  },
                  {
                    "cells": {
                      "mode": "terraform plan -destroy",
                      "purpose": "Preview destroying all managed objects"
                    }
                  },
                  {
                    "cells": {
                      "mode": "terraform plan -refresh=false",
                      "purpose": "Skip refreshing remote objects; faster in some cases but can miss drift"
                    }
                  },
                  {
                    "cells": {
                      "mode": "terraform plan -detailed-exitcode",
                      "purpose": "Return 0 for no changes, 1 for error, 2 for successful plan with changes"
                    }
                  }
                ]
              }
            }
          ],
          "source_refs": [
            {
              "title": "terraform plan",
              "url": "https://developer.hashicorp.com/terraform/cli/commands/plan"
            }
          ]
        }
      ]
    },
    {
      "id": "d3-module-3",
      "title": "Apply, recover, and destroy",
      "order": 3,
      "task_ids": [
        "3e",
        "3f"
      ],
      "skill_ids": [
        "3e.1",
        "3f.1"
      ],
      "prerequisite_module_ids": [
        "d3-module-2"
      ],
      "nodes": [
        {
          "id": "d3-saved-plan",
          "title": "Saved plans separate review from execution",
          "concept_ids": [
            "tf.saved.plan",
            "tf.cli.plan",
            "tf.cli.apply"
          ],
          "prerequisite_node_ids": [],
          "map_position": {
            "x": 0.12,
            "y": 0.22
          },
          "prompts": [
            {
              "id": "saved-plan-code",
              "kind": "action",
              "label": "SAVED PLAN WORKFLOW",
              "placeholder": "This sequence creates one concrete plan artifact, inspects it, and then applies that exact plan. Click each command.",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "release.sh",
                "language": "bash",
                "code": "terraform plan -out=tfplan\nterraform show tfplan\nterraform apply tfplan",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "save",
                    "anchor": {
                      "line": 1,
                      "text": "terraform plan -out=tfplan",
                      "occurrence": 1
                    },
                    "title": "Save the concrete plan",
                    "explanation": "-out writes a saved plan containing the proposed actions and values for later execution.",
                    "required": true
                  },
                  {
                    "id": "show",
                    "anchor": {
                      "line": 2,
                      "text": "terraform show tfplan",
                      "occurrence": 1
                    },
                    "title": "Inspect the saved plan",
                    "explanation": "terraform show can render a saved plan for human inspection before execution.",
                    "required": true
                  },
                  {
                    "id": "apply",
                    "anchor": {
                      "line": 3,
                      "text": "terraform apply tfplan",
                      "occurrence": 1
                    },
                    "title": "Apply exactly that plan",
                    "explanation": "Supplying a saved plan executes it directly without creating a new plan or asking for the normal approval prompt.",
                    "required": true
                  }
                ]
              }
            },
            {
              "id": "saved-risk",
              "kind": "not_this",
              "label": "TREAT THE FILE AS SENSITIVE",
              "placeholder": "What should you remember about a saved plan artifact?",
              "required": true,
              "reveal": {
                "type": "bullets",
                "items": [
                  "It can contain sensitive configuration and planned values.",
                  "Protect it like other deployment artifacts.",
                  "You cannot add new planning options or variable values while applying the already-saved plan.",
                  "If reality or configuration changes materially, generate a fresh plan rather than assuming an old one remains appropriate."
                ]
              }
            }
          ],
          "source_refs": [
            {
              "title": "terraform plan",
              "url": "https://developer.hashicorp.com/terraform/cli/commands/plan"
            },
            {
              "title": "terraform apply",
              "url": "https://developer.hashicorp.com/terraform/cli/commands/apply"
            }
          ]
        },
        {
          "id": "d3-apply",
          "title": "Apply executes real changes and can partially succeed",
          "concept_ids": [
            "tf.cli.apply"
          ],
          "prerequisite_node_ids": [
            "d3-saved-plan"
          ],
          "map_position": {
            "x": 0.34,
            "y": 0.18
          },
          "prompts": [
            {
              "id": "apply-modes",
              "kind": "what",
              "label": "APPLY BEHAVIOR",
              "placeholder": "How does normal apply differ from applying a saved plan?",
              "required": true,
              "reveal": {
                "type": "table",
                "columns": [
                  {
                    "id": "form",
                    "label": "Command form"
                  },
                  {
                    "id": "planning",
                    "label": "Planning behavior"
                  },
                  {
                    "id": "approval",
                    "label": "Approval behavior"
                  }
                ],
                "rows": [
                  {
                    "cells": {
                      "form": "terraform apply",
                      "planning": "Creates a fresh plan first",
                      "approval": "Prompts for approval unless explicitly configured otherwise"
                    }
                  },
                  {
                    "cells": {
                      "form": "terraform apply tfplan",
                      "planning": "Uses the previously saved plan",
                      "approval": "Executes the saved plan without the normal approval prompt"
                    }
                  }
                ]
              }
            },
            {
              "id": "partial-failure",
              "kind": "when",
              "label": "IF APPLY FAILS PARTWAY",
              "placeholder": "Terraform created some resources successfully and then a later API call failed. What is the safe recovery model?",
              "required": true,
              "reveal": {
                "type": "sequence",
                "items": [
                  "Keep the state updates Terraform successfully recorded",
                  "Read the actual error and inspect current remote reality",
                  "Fix configuration, credentials, quota, or provider/API issue",
                  "Generate a fresh plan from the new current state",
                  "Apply the remaining intended changes"
                ]
              }
            }
          ],
          "source_refs": [
            {
              "title": "terraform apply",
              "url": "https://developer.hashicorp.com/terraform/cli/commands/apply"
            }
          ]
        },
        {
          "id": "d3-destroy",
          "title": "Destroy is still a plan-and-apply operation",
          "concept_ids": [
            "tf.cli.destroy"
          ],
          "prerequisite_node_ids": [
            "d3-apply"
          ],
          "map_position": {
            "x": 0.56,
            "y": 0.28
          },
          "prompts": [
            {
              "id": "destroy-code",
              "kind": "action",
              "label": "DESTRUCTION COMMANDS",
              "placeholder": "Both commands are about remote destruction, not merely forgetting state. Click them before treating them as equivalent to state removal.",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "destroy.sh",
                "language": "bash",
                "code": "terraform plan -destroy\nterraform destroy",
                "line_numbers": true,
