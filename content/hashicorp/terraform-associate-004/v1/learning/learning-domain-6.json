      "nodes": [
        {
          "id": "d6-state-cli",
          "title": "State CLI: inspection versus surgery",
          "concept_ids": [
            "tf.state.cli"
          ],
          "prerequisite_node_ids": [],
          "map_position": {
            "x": 0.12,
            "y": 0.22
          },
          "prompts": [
            {
              "id": "state-commands",
              "kind": "what",
              "label": "STATE COMMAND RISK",
              "placeholder": "Which state subcommands are primarily inspection, and which change bindings/state?",
              "required": true,
              "reveal": {
                "type": "table",
                "columns": [
                  {
                    "id": "command",
                    "label": "Command"
                  },
                  {
                    "id": "intent",
                    "label": "Primary intent"
                  },
                  {
                    "id": "risk",
                    "label": "Risk level"
                  }
                ],
                "rows": [
                  {
                    "cells": {
                      "command": "terraform state list",
                      "intent": "List tracked resource addresses",
                      "risk": "Low / read-oriented"
                    }
                  },
                  {
                    "cells": {
                      "command": "terraform state show ADDRESS",
                      "intent": "Inspect one tracked object",
                      "risk": "Low / read-oriented"
                    }
                  },
                  {
                    "cells": {
                      "command": "terraform state pull",
                      "intent": "Download raw state snapshot",
                      "risk": "Read-oriented but contains sensitive data"
                    }
                  },
                  {
                    "cells": {
                      "command": "terraform state mv",
                      "intent": "Move a binding/address imperatively",
                      "risk": "Mutating; review carefully"
                    }
                  },
                  {
                    "cells": {
                      "command": "terraform state rm",
                      "intent": "Remove a binding without deleting remote object",
                      "risk": "Mutating; can create unmanaged infrastructure"
                    }
                  },
                  {
                    "cells": {
                      "command": "terraform state push",
                      "intent": "Replace backend state with a local snapshot",
                      "risk": "High-risk recovery operation"
                    }
                  }
                ]
              }
            },
            {
              "id": "prefer-config",
              "kind": "action",
              "label": "PREFER REVIEWABLE CONFIGURATION WHEN POSSIBLE",
              "placeholder": "For address refactors and planned removals, why prefer moved/removed blocks over one-off state surgery when the language feature fits?",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Configuration-driven transitions are reviewable, repeatable, and visible in plans. State subcommands remain useful, but they directly mutate Terraform’s tracking and require more operational care."
              }
            }
          ],
          "source_refs": [
            {
              "title": "State CLI",
              "url": "https://developer.hashicorp.com/terraform/cli/commands/state"
            },
            {
              "title": "Refactoring",
              "url": "https://developer.hashicorp.com/terraform/language/modules/develop/refactoring"
            }
          ]
        },
        {
          "id": "d6-force-unlock",
          "title": "Force-unlock only stale locks",
          "concept_ids": [
            "tf.locking",
            "tf.state.cli"
          ],
          "prerequisite_node_ids": [
            "d6-state-cli"
          ],
          "map_position": {
            "x": 0.34,
            "y": 0.18
          },
          "prompts": [
            {
              "id": "stale-lock",
              "kind": "action",
              "label": "SAFE STALE-LOCK RESPONSE",
              "placeholder": "Terraform says the state is locked. What sequence minimizes the chance of corrupting an active run?",
              "required": true,
              "reveal": {
                "type": "sequence",
                "items": [
                  "Identify the lock holder and operation",
                  "Verify no plan/apply/state write is still active",
                  "Wait for the active operation if the lock is legitimate",
                  "Only if the lock is confirmed stale, use terraform force-unlock with the lock ID",
                  "Resume normal Terraform operations with locking enabled"
                ]
              }
            }
          ],
          "source_refs": [
            {
              "title": "State locking",
              "url": "https://developer.hashicorp.com/terraform/language/state/locking"
            }
          ]
        },
        {
          "id": "d6-backup-security",
          "title": "Treat state as sensitive infrastructure data",
          "concept_ids": [
            "tf.backend.remote",
            "tf.state.cli"
          ],
          "prerequisite_node_ids": [
            "d6-force-unlock"
          ],
          "map_position": {
            "x": 0.56,
            "y": 0.28
          },
          "prompts": [
            {
              "id": "state-security",
              "kind": "look_for",
              "label": "STATE SECURITY",
              "placeholder": "Why should state storage and state snapshots be protected?",
              "required": true,
              "reveal": {
                "type": "bullets",
                "items": [
                  "State can contain resource attributes and values that are sensitive even when normal CLI output redacts them.",
                  "Anyone able to replace or corrupt state can disrupt Terraform’s understanding of resource identity.",
                  "Remote backends can centralize access controls, encryption, versioning, and collaboration depending on backend capabilities.",
                  "Before manual state operations, preserve a recoverable copy or rely on backend version history where available."
                ]
              }
            }
          ],
          "source_refs": [
            {
              "title": "Backends",
              "url": "https://developer.hashicorp.com/terraform/language/state/backends"
            },
            {
              "title": "Manage sensitive data",
              "url": "https://developer.hashicorp.com/terraform/language/manage-sensitive-data"
            }
          ]
        }
      ]
