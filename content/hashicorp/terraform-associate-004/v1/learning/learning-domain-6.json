      "nodes": [
        {
          "id": "d6-backend-role",
          "title": "A backend decides where state lives",
          "concept_ids": [
            "tf.backend",
            "tf.backend.local",
            "tf.backend.remote"
          ],
          "prerequisite_node_ids": [],
          "map_position": {
            "x": 0.12,
            "y": 0.22
          },
          "prompts": [
            {
              "id": "backend-jobs",
              "kind": "what",
              "label": "BACKEND RESPONSIBILITIES",
              "placeholder": "What does a Terraform backend control?",
              "required": true,
              "reveal": {
                "type": "table",
                "columns": [
                  {
                    "id": "responsibility",
                    "label": "Responsibility"
                  },
                  {
                    "id": "detail",
                    "label": "Meaning"
                  }
                ],
                "rows": [
                  {
                    "cells": {
                      "responsibility": "State storage",
                      "detail": "Where Terraform reads/writes the state snapshot"
                    }
                  },
                  {
                    "cells": {
                      "responsibility": "Locking API when supported",
                      "detail": "How Terraform prevents concurrent state writes"
                    }
                  },
                  {
                    "cells": {
                      "responsibility": "Remote collaboration behavior",
                      "detail": "Remote backends can centralize shared state instead of leaving it on one engineer’s disk"
                    }
                  }
                ]
              }
            },
            {
              "id": "local-remote",
              "kind": "not_this",
              "label": "LOCAL VS REMOTE",
              "placeholder": "What changes when state moves from the default local backend to a remote backend?",
              "required": true,
              "reveal": {
                "type": "table",
                "columns": [
                  {
                    "id": "backend",
                    "label": "Backend"
                  },
                  {
                    "id": "state_location",
                    "label": "State location"
                  },
                  {
                    "id": "collaboration",
                    "label": "Collaboration"
                  }
                ],
                "rows": [
                  {
                    "cells": {
                      "backend": "Local",
                      "state_location": "Local disk, normally terraform.tfstate",
                      "collaboration": "Simple but tied to the local working context"
                    }
                  },
                  {
                    "cells": {
                      "backend": "Remote",
                      "state_location": "Backend service/object store depending on backend",
                      "collaboration": "Central state access; locking/security depend on backend capabilities"
                    }
                  }
                ]
              }
            }
          ],
          "source_refs": [
            {
              "title": "Backends",
              "url": "https://developer.hashicorp.com/terraform/language/state/backends"
            }
