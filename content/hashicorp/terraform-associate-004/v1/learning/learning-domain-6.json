        {
          "id": "d6-remote-backend",
          "title": "Remote backend configuration",
          "concept_ids": [
            "tf.backend.remote",
            "tf.backend"
          ],
          "prerequisite_node_ids": [
            "d6-backend-role"
          ],
          "map_position": {
            "x": 0.34,
            "y": 0.18
          },
          "prompts": [
            {
              "id": "backend-code",
              "kind": "look_for",
              "label": "INSPECT backend.tf",
              "placeholder": "Backend configuration lives inside the terraform block. Click the backend type and the state object key.",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "backend.tf",
                "language": "hcl",
                "code": "terraform {\n  backend \"s3\" {\n    bucket = \"company-terraform-state\"\n    key    = \"network/prod.tfstate\"\n    region = \"us-east-1\"\n  }\n}",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "backend",
                    "anchor": {
                      "line": 2,
                      "text": "backend \"s3\"",
                      "occurrence": 1
                    },
                    "title": "Backend type",
                    "explanation": "The backend type selects the state storage implementation. Backend-specific arguments configure how Terraform reaches that storage.",
                    "required": true
                  },
                  {
                    "id": "key",
                    "anchor": {
                      "line": 4,
                      "text": "key    = \"network/prod.tfstate\"",
                      "occurrence": 1
                    },
                    "title": "State location within the backend",
                    "explanation": "The backend key/path identifies the state object for this configuration within the remote storage system.",
                    "required": true
                  }
                ]
              }
            },
            {
              "id": "backend-init",
              "kind": "action",
              "label": "BACKEND CHANGE REQUIRES INIT",
              "placeholder": "After adding or changing backend configuration, what must you run before normal plan/apply?",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Run terraform init. Use migration or reconfiguration options deliberately when switching from an already-initialized backend."
              }
            }
          ],
          "source_refs": [
            {
              "title": "Backends",
              "url": "https://developer.hashicorp.com/terraform/language/state/backends"
            },
            {
              "title": "terraform init",
              "url": "https://developer.hashicorp.com/terraform/cli/commands/init"
            }
          ]
        },
        {
          "id": "d6-locking",
          "title": "State locking protects concurrent writes",
          "concept_ids": [
            "tf.locking"
          ],
          "prerequisite_node_ids": [
            "d6-remote-backend"
          ],
          "map_position": {
            "x": 0.56,
            "y": 0.28
          },
          "prompts": [
            {
              "id": "locking",
              "kind": "what",
              "label": "LOCKING BEHAVIOR",
              "placeholder": "What should you assume about state locking?",
              "required": true,
              "reveal": {
                "type": "table",
                "columns": [
                  {
                    "id": "fact",
                    "label": "Fact"
                  },
                  {
                    "id": "meaning",
                    "label": "Meaning"
                  }
                ],
                "rows": [
                  {
                    "cells": {
                      "fact": "Automatic when supported",
                      "meaning": "Terraform locks state for operations that could write it"
                    }
                  },
                  {
                    "cells": {
                      "fact": "Backend capability matters",
                      "meaning": "Not every backend offers the same locking implementation"
                    }
                  },
                  {
                    "cells": {
                      "fact": "Lock contention is a safety signal",
                      "meaning": "A second writer should normally wait or stop instead of bypassing an active operation"
                    }
                  },
                  {
                    "cells": {
                      "fact": "force-unlock is exceptional",
                      "meaning": "Use it only after verifying the lock is stale and no active operation owns it"
                    }
                  }
                ]
              }
            }
          ],
          "source_refs": [
            {
              "title": "State locking",
              "url": "https://developer.hashicorp.com/terraform/language/state/locking"
            }
          ]
        }
      ]
