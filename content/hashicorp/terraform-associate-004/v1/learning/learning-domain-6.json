        },
        {
          "id": "d6-refresh-only",
          "title": "Refresh-only accepts remote reality into state",
          "concept_ids": [
            "tf.refresh_only",
            "tf.drift"
          ],
          "prerequisite_node_ids": [
            "d6-drift"
          ],
          "map_position": {
            "x": 0.34,
            "y": 0.18
          },
          "prompts": [
            {
              "id": "refresh-only",
              "kind": "not_this",
              "label": "NORMAL PLAN VS REFRESH-ONLY",
              "placeholder": "What changes when you use refresh-only mode?",
              "required": true,
              "reveal": {
                "type": "table",
                "columns": [
                  {
                    "id": "mode",
                    "label": "Mode"
                  },
                  {
                    "id": "remote_objects",
                    "label": "Remote infrastructure"
                  },
                  {
                    "id": "state",
                    "label": "State/outputs"
                  }
                ],
                "rows": [
                  {
                    "cells": {
                      "mode": "Normal plan/apply",
                      "remote_objects": "May propose and perform changes to reconcile toward configuration",
                      "state": "Updated as operations and refresh occur"
                    }
                  },
                  {
                    "cells": {
                      "mode": "Refresh-only plan/apply",
                      "remote_objects": "Does not propose normal infrastructure changes",
                      "state": "Updates state and root outputs to match the refreshed remote reality"
                    }
                  }
                ]
              }
            },
            {
              "id": "use-carefully",
              "kind": "when",
              "label": "WHEN IT FITS",
              "placeholder": "When is refresh-only useful?",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Use it when an intentional out-of-band change should be accepted into Terraform’s recorded view rather than immediately changed back to the current configuration. Review the resulting state/output changes carefully."
              }
            }
          ],
          "source_refs": [
            {
              "title": "terraform plan",
              "url": "https://developer.hashicorp.com/terraform/cli/commands/plan"
            }
          ]
        },
        {
          "id": "d6-moved",
          "title": "moved preserves identity across address refactors",
          "concept_ids": [
            "tf.moved"
          ],
          "prerequisite_node_ids": [
            "d6-refresh-only"
          ],
          "map_position": {
            "x": 0.56,
            "y": 0.28
          },
          "prompts": [
            {
              "id": "moved-code",
              "kind": "look_for",
              "label": "INSPECT moved BLOCK",
              "placeholder": "The object is not changing; only its Terraform address is moving into a module. Click from and to.",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "moved.tf",
                "language": "hcl",
                "code": "moved {\n  from = aws_instance.web\n  to   = module.app.aws_instance.web\n}",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "from",
                    "anchor": {
                      "line": 2,
                      "text": "from = aws_instance.web",
                      "occurrence": 1
                    },
                    "title": "Old Terraform address",
                    "explanation": "from identifies the address currently recorded in state.",
                    "required": true
                  },
                  {
                    "id": "to",
                    "anchor": {
                      "line": 3,
                      "text": "to   = module.app.aws_instance.web",
                      "occurrence": 1
                    },
                    "title": "New Terraform address",
                    "explanation": "to declares where that same object should be tracked after the refactor.",
                    "required": true
                  }
                ]
              }
            },
            {
              "id": "not-ignore",
              "kind": "not_this",
              "label": "MOVED DOES NOT HIDE OTHER CHANGES",
              "placeholder": "Does a moved block suppress every other difference in the resource?",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "No. It prevents replacement caused only by the address change. Terraform still plans real argument/lifecycle changes, so review the plan."
              }
            }
          ],
          "source_refs": [
            {
              "title": "Refactor modules/resources",
              "url": "https://developer.hashicorp.com/terraform/language/modules/develop/refactoring"
            }
          ]
        },
        {
          "id": "d6-removed",
          "title": "removed can stop management without destroying the object",
          "concept_ids": [
            "tf.removed"
          ],
          "prerequisite_node_ids": [
            "d6-moved"
          ],
          "map_position": {
            "x": 0.78,
            "y": 0.2
          },
          "prompts": [
            {
              "id": "removed-code",
              "kind": "look_for",
              "label": "INSPECT removed BLOCK",
              "placeholder": "This configuration wants Terraform to forget a bucket while leaving the real bucket intact. Click the address and destroy setting.",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "removed.tf",
                "language": "hcl",
                "code": "removed {\n  from = aws_s3_bucket.logs\n\n  lifecycle {\n    destroy = false\n  }\n}",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "from",
                    "anchor": {
                      "line": 2,
                      "text": "from = aws_s3_bucket.logs",
                      "occurrence": 1
                    },
                    "title": "Address leaving management",
                    "explanation": "from identifies the managed object Terraform should remove from its state tracking.",
                    "required": true
                  },
                  {
                    "id": "destroy-false",
                    "anchor": {
                      "line": 5,
                      "text": "destroy = false",
                      "occurrence": 1
                    },
                    "title": "Keep the remote object",
                    "explanation": "destroy = false means Terraform removes the binding without deleting the real infrastructure object.",
                    "required": true
                  }
                ]
              }
            },
            {
              "id": "removed-vs-delete",
              "kind": "not_this",
              "label": "STOP MANAGING VS DESTROY",
              "placeholder": "Choose the intent before using a state/removal mechanism.",
              "required": true,
              "reveal": {
                "type": "table",
                "columns": [
                  {
                    "id": "intent",
                    "label": "Intent"
                  },
                  {
                    "id": "tool",
                    "label": "Configuration/command"
                  }
                ],
                "rows": [
                  {
                    "cells": {
                      "intent": "Delete the real object",
                      "tool": "Normal configuration removal with destroy allowed, or terraform destroy for full teardown"
                    }
                  },
                  {
                    "cells": {
                      "intent": "Keep the object but stop managing it",
                      "tool": "removed block with destroy = false, or carefully use state rm for an imperative state-only change"
                    }
                  }
                ]
              }
            }
          ],
          "source_refs": [
            {
              "title": "Removing resources",
