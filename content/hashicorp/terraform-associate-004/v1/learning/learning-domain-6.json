          "id": "d6-drift",
          "title": "Drift is a three-layer mismatch",
          "concept_ids": [
            "tf.drift"
          ],
          "prerequisite_node_ids": [],
          "map_position": {
            "x": 0.12,
            "y": 0.22
          },
          "prompts": [
            {
              "id": "drift-layers",
              "kind": "connects_to",
              "label": "COMPARE THE THREE LAYERS",
              "placeholder": "When diagnosing drift, what should you compare?",
              "required": true,
              "reveal": {
                "type": "table",
                "columns": [
                  {
                    "id": "layer",
                    "label": "Layer"
                  },
                  {
                    "id": "example_question",
                    "label": "Question"
                  }
                ],
                "rows": [
                  {
                    "cells": {
                      "layer": "Configuration",
                      "example_question": "What do the .tf files say should exist?"
                    }
                  },
                  {
                    "cells": {
                      "layer": "State",
                      "example_question": "Which remote object is this resource address currently bound to, and what was recorded?"
                    }
                  },
                  {
                    "cells": {
                      "layer": "Remote API",
                      "example_question": "What values and objects exist now outside Terraform’s stored view?"
                    }
                  }
                ]
              }
            },
            {
              "id": "normal-plan",
              "kind": "action",
              "label": "NORMAL PLAN RECONCILES TO CONFIGURATION",
              "placeholder": "If someone changes a managed remote setting manually and the configuration stays unchanged, what will a normal plan generally try to do?",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "After refreshing remote values, Terraform normally proposes actions that move the remote object back toward the configuration’s desired state."
              }
            }
          ],
          "source_refs": [
            {
              "title": "Terraform plan",
              "url": "https://developer.hashicorp.com/terraform/cli/commands/plan"
