  "authoring_notes": "Targets Terraform Associate 004 / Terraform 1.12. Domain weight 0.125 is an internal planning weight because HashiCorp does not publish objective percentages. This v2 learning content uses real tables and interactive syntax-highlighted code_file reveals; generic exam-clue and generic mental-model prompts were intentionally removed.",
  "modules": [
    {
      "id": "d1-module-1",
      "title": "Why Infrastructure as Code works",
      "order": 1,
      "task_ids": [
        "1a",
        "1b"
      ],
      "skill_ids": [
        "1a.1",
        "1b.1"
      ],
      "prerequisite_module_ids": [],
      "nodes": [
        {
          "id": "d1-iac-problem",
          "title": "Why Infrastructure as Code exists",
          "concept_ids": [
            "tf.iac"
          ],
          "prerequisite_node_ids": [],
          "map_position": {
            "x": 0.12,
            "y": 0.22
          },
          "prompts": [
            {
              "id": "manual-vs-iac",
              "kind": "what",
              "label": "MANUAL VS IAC",
              "placeholder": "What changes when infrastructure moves from undocumented console actions into version-controlled configuration?",
              "required": true,
              "reveal": {
                "type": "comparison",
                "columns": [
                  {
                    "title": "Manual-only changes",
                    "items": [
                      "Intent may exist only in a person’s memory or ticket.",
                      "Recreating the same environment depends on repeating human steps.",
                      "Review often happens after the change, if at all."
                    ]
                  },
                  {
                    "title": "Infrastructure as Code",
                    "items": [
                      "Desired infrastructure is represented in machine-readable files.",
                      "The same configuration can be reviewed, reused, and automated.",
                      "Change history can live beside application code in version control."
                    ]
                  }
                ]
              }
            },
            {
              "id": "benefit-map",
              "kind": "connects_to",
              "label": "WHY IT HELPS",
              "placeholder": "Which common infrastructure problems does IaC reduce, and what mechanism provides the benefit?",
              "required": true,
              "reveal": {
                "type": "table",
                "columns": [
                  {
                    "id": "problem",
                    "label": "Problem"
                  },
                  {
                    "id": "mechanism",
                    "label": "IaC mechanism"
                  },
                  {
                    "id": "benefit",
                    "label": "Result"
                  }
                ],
                "rows": [
                  {
                    "cells": {
                      "problem": "Different engineers click different settings",
                      "mechanism": "Shared configuration",
                      "benefit": "More consistent environments"
                    }
                  },
                  {
                    "cells": {
                      "problem": "No one knows what changed last week",
                      "mechanism": "Version history and code review",
                      "benefit": "Auditable change history"
                    }
                  },
                  {
                    "cells": {
                      "problem": "Rebuilding staging takes a long checklist",
                      "mechanism": "Reusable configuration and automation",
                      "benefit": "Repeatable provisioning"
                    }
                  },
                  {
                    "cells": {
                      "problem": "A risky change is hard to preview",
                      "mechanism": "Terraform plan",
                      "benefit": "Review before apply"
                    }
                  }
                ]
              }
            }
          ],
          "source_refs": [
            {
              "title": "What is Terraform?",
              "url": "https://developer.hashicorp.com/terraform/intro"
            },
            {
              "title": "Core Terraform workflow",
              "url": "https://developer.hashicorp.com/terraform/intro/core-workflow"
            }
          ]
        },
        {
          "id": "d1-declarative",
          "title": "Declarative desired state",
          "concept_ids": [
            "tf.declarative"
          ],
          "prerequisite_node_ids": [
            "d1-iac-problem"
          ],
          "map_position": {
            "x": 0.34,
            "y": 0.18
          },
          "prompts": [
            {
              "id": "declarative-idea",
              "kind": "what",
              "label": "DECLARATIVE IDEA",
              "placeholder": "If Terraform is declarative, what does the configuration describe?",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "It describes the end state you want. Terraform Core and providers determine the operations needed to move managed infrastructure toward that state."
              }
            },
            {
              "id": "desired-code",
              "kind": "look_for",
              "label": "INSPECT THE DESIRED STATE",
              "placeholder": "This file declares what should exist. Click the important parts to see what Terraform learns from the configuration.",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "main.tf",
                "language": "hcl",
                "code": "resource \"aws_s3_bucket\" \"logs\" {\n  bucket = \"example-company-logs\"\n\n  tags = {\n    Environment = \"staging\"\n  }\n}",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "resource-block",
                    "anchor": {
                      "line": 1,
                      "text": "resource",
                      "occurrence": 1
                    },
                    "title": "Managed object declaration",
                    "explanation": "A resource block tells Terraform that this configuration should manage the lifecycle of a remote object.",
                    "required": true
                  },
                  {
                    "id": "resource-address",
                    "anchor": {
                      "line": 1,
                      "text": "\"aws_s3_bucket\" \"logs\"",
                      "occurrence": 1
                    },
                    "title": "Resource type and local name",
                    "explanation": "Together these labels form the local address aws_s3_bucket.logs inside the module.",
                    "required": true
                  },
                  {
                    "id": "desired-argument",
                    "anchor": {
                      "line": 2,
                      "text": "bucket = \"example-company-logs\"",
                      "occurrence": 1
                    },
                    "title": "Desired argument value",
                    "explanation": "Arguments describe the desired configuration. Terraform compares this intent with tracked state and remote reality during planning.",
                    "required": true
                  },
                  {
                    "id": "tag-value",
                    "anchor": {
                      "line": 5,
                      "text": "Environment = \"staging\"",
                      "occurrence": 1
                    },
                    "title": "Desired metadata",
                    "explanation": "Changing this value changes configuration intent; the next plan determines whether a remote update is needed.",
                    "required": true
                  }
                ]
              }
            }
          ],
          "source_refs": [
            {
              "title": "What is Terraform?",
              "url": "https://developer.hashicorp.com/terraform/intro"
            },
            {
              "title": "Resources",
              "url": "https://developer.hashicorp.com/terraform/language/resources"
            }
          ]
        },
        {
          "id": "d1-version-control",
          "title": "Repeatability, review, and history",
          "concept_ids": [
            "tf.repeatability"
          ],
          "prerequisite_node_ids": [
            "d1-declarative"
          ],
          "map_position": {
            "x": 0.56,
            "y": 0.28
          },
          "prompts": [
            {
              "id": "review-loop",
              "kind": "action",
              "label": "CHANGE LOOP",
              "placeholder": "How does a team turn an infrastructure edit into a reviewable change?",
              "required": true,
              "reveal": {
                "type": "sequence",
                "items": [
                  "Edit Terraform configuration in a version-controlled branch",
                  "Generate a plan to preview infrastructure changes",
                  "Review configuration and plan together",
                  "Apply the approved change",
                  "Keep configuration history for later comparison and reuse"
                ]
              }
            },
            {
              "id": "limits",
              "kind": "not_this",
              "label": "WHAT IAC DOES NOT GUARANTEE",
              "placeholder": "Which problems can still happen even when a team uses IaC correctly?",
              "required": true,
              "reveal": {
                "type": "bullets",
                "items": [
                  "Someone can still change infrastructure outside Terraform, creating drift.",
                  "Provider or remote API operations can still fail during apply.",
                  "Bad configuration can still describe the wrong desired state.",
                  "IaC improves control and reproducibility; it does not make infrastructure infallible."
                ]
              }
            }
          ],
          "source_refs": [
            {
              "title": "Core Terraform workflow",
              "url": "https://developer.hashicorp.com/terraform/intro/core-workflow"
            },
            {
              "title": "Terraform Associate 004 - official exam content",
              "url": "https://developer.hashicorp.com/terraform/tutorials/certification-004/associate-review-004"
            }
          ]
        },
        {
          "id": "d1-drift-loop",
          "title": "Configuration, state, and remote reality",
          "concept_ids": [
            "tf.declarative",
            "tf.repeatability"
          ],
          "prerequisite_node_ids": [
            "d1-version-control"
          ],
          "map_position": {
            "x": 0.78,
            "y": 0.2
          },
          "prompts": [
            {
              "id": "three-layers",
              "kind": "connects_to",
              "label": "THREE LAYERS",
              "placeholder": "When Terraform plans a change, what role does each layer play?",
              "required": true,
              "reveal": {
                "type": "table",
                "columns": [
                  {
                    "id": "layer",
                    "label": "Layer"
                  },
                  {
                    "id": "contains",
                    "label": "What it represents"
                  },
                  {
                    "id": "question",
                    "label": "Question it answers"
                  }
                ],
                "rows": [
                  {
                    "cells": {
                      "layer": "Configuration",
                      "contains": "Desired infrastructure declared in .tf files",
                      "question": "What should exist?"
                    }
                  },
                  {
                    "cells": {
                      "layer": "State",
                      "contains": "Terraform’s recorded bindings and metadata",
                      "question": "What objects is Terraform tracking?"
                    }
                  },
                  {
                    "cells": {
                      "layer": "Remote system",
                      "contains": "What currently exists in the provider API",
                      "question": "What exists right now?"
                    }
                  }
                ]
              }
            },
            {
              "id": "drift",
              "kind": "look_for",
              "label": "WHEN THEY DISAGREE",
              "placeholder": "Suppose configuration and state expect one setting, but someone changed the remote object manually. What is that difference called?",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "That is drift. A normal plan refreshes Terraform’s view of managed objects and can propose changes that reconcile remote reality back toward configuration."
              }
            }
          ],
          "source_refs": [
            {
              "title": "Terraform state purpose",
              "url": "https://developer.hashicorp.com/terraform/language/state/purpose"
            },
            {
              "title": "Terraform plan",
              "url": "https://developer.hashicorp.com/terraform/cli/commands/plan"
            }
          ]
        }
      ]
    },
    {
      "id": "d1-module-2",
      "title": "How Terraform spans many APIs",
      "order": 2,
      "task_ids": [
        "1c"
      ],
