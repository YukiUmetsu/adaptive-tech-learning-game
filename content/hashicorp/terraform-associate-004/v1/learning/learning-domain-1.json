      "nodes": [
        {
          "id": "d1-core-provider-separation",
          "title": "Terraform Core and providers",
          "concept_ids": [
            "tf.multicloud"
          ],
          "prerequisite_node_ids": [],
          "map_position": {
            "x": 0.12,
            "y": 0.22
          },
          "prompts": [
            {
              "id": "roles",
              "kind": "connects_to",
              "label": "WHO DOES WHAT",
              "placeholder": "How are responsibilities split between Terraform Core and provider plugins?",
              "required": true,
              "reveal": {
                "type": "table",
                "columns": [
                  {
                    "id": "part",
                    "label": "Part"
                  },
                  {
                    "id": "responsibility",
                    "label": "Primary responsibility"
                  }
                ],
                "rows": [
                  {
                    "cells": {
                      "part": "Terraform Core",
                      "responsibility": "Reads configuration, builds the dependency graph, coordinates planning/apply, and manages state interactions"
                    }
                  },
                  {
                    "cells": {
                      "part": "Provider plugin",
                      "responsibility": "Defines resource/data-source behavior and translates Terraform operations into API calls"
                    }
                  },
                  {
                    "cells": {
                      "part": "Remote API",
                      "responsibility": "Creates, reads, updates, or deletes the real platform object"
                    }
                  }
                ]
              }
            },
            {
              "id": "request-path",
              "kind": "action",
              "label": "REQUEST PATH",
              "placeholder": "What path does a typical resource operation follow?",
              "required": true,
              "reveal": {
                "type": "sequence",
                "items": [
                  "Terraform configuration",
                  "Terraform Core evaluates the graph",
                  "Provider plugin receives the resource operation",
                  "Provider calls the target platform API",
                  "Terraform records the resulting managed-object information in state"
                ]
              }
            }
          ],
          "source_refs": [
            {
              "title": "Providers",
              "url": "https://developer.hashicorp.com/terraform/language/providers"
            },
            {
              "title": "Provider requirements",
              "url": "https://developer.hashicorp.com/terraform/language/providers/requirements"
            }
          ]
        },
        {
          "id": "d1-multicloud-code",
          "title": "One configuration can use several APIs",
          "concept_ids": [
            "tf.multicloud"
          ],
          "prerequisite_node_ids": [
            "d1-core-provider-separation"
          ],
          "map_position": {
            "x": 0.34,
            "y": 0.18
          },
          "prompts": [
            {
              "id": "multi-provider-file",
              "kind": "look_for",
              "label": "INSPECT MULTI-PROVIDER CONFIGURATION",
              "placeholder": "This example needs two independent APIs. Click the provider requirements and resource types to see why Terraform can still use one workflow.",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "versions.tf",
                "language": "hcl",
                "code": "terraform {\n  required_providers {\n    aws = {\n      source = \"hashicorp/aws\"\n    }\n    cloudflare = {\n      source = \"cloudflare/cloudflare\"\n    }\n  }\n}\n\nresource \"aws_vpc\" \"app\" {\n  cidr_block = \"10.0.0.0/16\"\n}\n\nresource \"cloudflare_record\" \"app\" {\n  name  = \"app\"\n  type  = \"A\"\n  value = \"203.0.113.10\"\n}",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "required-providers",
                    "anchor": {
                      "line": 2,
                      "text": "required_providers",
                      "occurrence": 1
                    },
                    "title": "Provider dependency list",
                    "explanation": "The module declares the provider plugins it needs. Terraform can install and coordinate more than one provider.",
                    "required": true
                  },
                  {
                    "id": "aws-source",
                    "anchor": {
                      "line": 4,
                      "text": "\"hashicorp/aws\"",
                      "occurrence": 1
                    },
                    "title": "AWS provider source",
                    "explanation": "This source address identifies the provider plugin that implements AWS resource behavior.",
                    "required": true
                  },
                  {
                    "id": "cf-source",
                    "anchor": {
                      "line": 7,
                      "text": "\"cloudflare/cloudflare\"",
                      "occurrence": 1
                    },
                    "title": "Cloudflare provider source",
                    "explanation": "A second provider can participate in the same Terraform graph even though it talks to a different API.",
                    "required": true
                  },
                  {
                    "id": "aws-resource",
                    "anchor": {
                      "line": 12,
                      "text": "resource \"aws_vpc\"",
                      "occurrence": 1
                    },
                    "title": "Resource handled by one provider",
                    "explanation": "The aws_ prefix associates this resource type with the AWS provider local name.",
                    "required": true
                  },
                  {
                    "id": "cf-resource",
                    "anchor": {
                      "line": 16,
                      "text": "resource \"cloudflare_record\"",
                      "occurrence": 1
                    },
                    "title": "Resource handled by another provider",
                    "explanation": "This resource type is implemented by the Cloudflare provider. Terraform Core still coordinates dependencies across the whole graph.",
                    "required": true
                  }
                ]
              }
            }
          ],
          "source_refs": [
            {
              "title": "Provider requirements",
              "url": "https://developer.hashicorp.com/terraform/language/providers/requirements"
            },
            {
              "title": "Providers",
              "url": "https://developer.hashicorp.com/terraform/language/providers"
            }
          ]
        },
        {
          "id": "d1-service-agnostic",
