                    }
                  }
                ]
              }
            },
            {
              "id": "bridge-next",
              "kind": "connects_to",
              "label": "WHERE FUNDAMENTALS START",
              "placeholder": "What must Terraform know before it can install and use a provider?",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "The configuration declares provider requirements: a provider local name, its source address, and usually a version constraint. That is the bridge into Terraform fundamentals."
              }
            }
          ],
