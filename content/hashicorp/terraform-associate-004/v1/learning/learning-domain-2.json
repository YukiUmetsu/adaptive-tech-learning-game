  "authoring_notes": "Targets Terraform Associate 004 / Terraform 1.12. Domain weight 0.125 is an internal planning weight because HashiCorp does not publish objective percentages. This v2 learning content uses real tables and interactive syntax-highlighted code_file reveals; generic exam-clue and generic mental-model prompts were intentionally removed.",
  "modules": [
    {
      "id": "d2-module-1",
      "title": "Providers, versions, and installation",
      "order": 1,
      "task_ids": [
        "2a",
        "2b"
      ],
      "skill_ids": [
        "2a.1",
        "2b.1"
      ],
      "prerequisite_module_ids": [],
      "nodes": [
        {
          "id": "d2-provider-role",
          "title": "Providers are Terraform API adapters",
          "concept_ids": [
            "tf.providers"
          ],
          "prerequisite_node_ids": [],
          "map_position": {
            "x": 0.12,
            "y": 0.22
          },
          "prompts": [
            {
              "id": "provider-role",
              "kind": "what",
              "label": "PROVIDER ROLE",
              "placeholder": "Terraform Core understands the workflow, but who knows how to create a specific cloud resource?",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "The provider plugin. Providers implement resource and data-source types and translate Terraform operations into calls to external APIs."
              }
            },
            {
              "id": "provider-flow",
              "kind": "connects_to",
              "label": "OPERATION FLOW",
              "placeholder": "How does a resource change reach a remote API?",
              "required": true,
              "reveal": {
                "type": "sequence",
                "items": [
                  "Terraform Core evaluates configuration and dependencies",
                  "Core asks the selected provider to plan or apply the resource operation",
                  "The provider calls the target API",
                  "The provider returns results to Terraform",
                  "Terraform updates its state information for completed operations"
                ]
              }
            }
          ],
          "source_refs": [
            {
              "title": "Providers",
              "url": "https://developer.hashicorp.com/terraform/language/providers"
            },
            {
              "title": "Provider requirements",
              "url": "https://developer.hashicorp.com/terraform/language/providers/requirements"
            }
          ]
        },
        {
          "id": "d2-requirements",
          "title": "Terraform CLI vs provider requirements",
          "concept_ids": [
            "tf.provider.requirements",
            "tf.versions"
          ],
          "prerequisite_node_ids": [
            "d2-provider-role"
          ],
          "map_position": {
            "x": 0.34,
            "y": 0.18
          },
          "prompts": [
            {
              "id": "versions-file",
              "kind": "look_for",
              "label": "INSPECT versions.tf",
              "placeholder": "This file contains two different kinds of version rules. Click each important field and separate the Terraform CLI rule from the provider plugin rule.",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "versions.tf",
                "language": "hcl",
                "code": "terraform {\n  required_version = \"~> 1.12.0\"\n\n  required_providers {\n    aws = {\n      source  = \"hashicorp/aws\"\n      version = \"~> 5.80\"\n    }\n  }\n}",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "required-version",
                    "anchor": {
                      "line": 2,
                      "text": "required_version",
                      "occurrence": 1
                    },
                    "title": "Terraform CLI constraint",
                    "explanation": "required_version controls which Terraform CLI versions may run this configuration.",
                    "required": true
                  },
                  {
                    "id": "required-providers",
                    "anchor": {
                      "line": 4,
                      "text": "required_providers",
                      "occurrence": 1
                    },
                    "title": "Provider requirements block",
                    "explanation": "required_providers declares which provider plugins the module needs.",
                    "required": true
                  },
                  {
                    "id": "source",
                    "anchor": {
                      "line": 6,
                      "text": "source  = \"hashicorp/aws\"",
                      "occurrence": 1
                    },
                    "title": "Provider source address",
                    "explanation": "The source address identifies where Terraform should obtain the provider plugin.",
                    "required": true
                  },
                  {
                    "id": "provider-version",
                    "anchor": {
                      "line": 7,
                      "text": "version = \"~> 5.80\"",
                      "occurrence": 1
                    },
                    "title": "Provider version constraint",
                    "explanation": "This version rule applies to the AWS provider plugin, not to the Terraform CLI.",
                    "required": true
                  }
                ]
              }
            },
            {
              "id": "version-roles",
              "kind": "not_this",
              "label": "DO NOT MIX THESE UP",
              "placeholder": "Which file setting controls which executable or dependency?",
              "required": true,
              "reveal": {
                "type": "table",
                "columns": [
                  {
                    "id": "setting",
                    "label": "Setting"
                  },
                  {
                    "id": "controls",
                    "label": "Controls"
                  },
                  {
                    "id": "does_not",
                    "label": "Does not control"
                  }
                ],
                "rows": [
                  {
                    "cells": {
                      "setting": "required_version",
                      "controls": "Terraform CLI versions",
                      "does_not": "Provider plugin versions"
                    }
                  },
                  {
                    "cells": {
                      "setting": "required_providers.version",
                      "controls": "Allowed provider plugin versions",
                      "does_not": "Terraform CLI version"
                    }
                  },
                  {
                    "cells": {
                      "setting": ".terraform.lock.hcl",
                      "controls": "Selected provider versions and checksums",
                      "does_not": "Module version selections"
                    }
                  }
                ]
              }
            }
          ],
          "source_refs": [
            {
              "title": "Provider requirements",
              "url": "https://developer.hashicorp.com/terraform/language/providers/requirements"
            },
            {
              "title": "Dependency lock file",
              "url": "https://developer.hashicorp.com/terraform/language/files/dependency-lock"
            }
          ]
        },
        {
          "id": "d2-version-constraints",
          "title": "Read version constraints by examples",
          "concept_ids": [
            "tf.versions"
          ],
          "prerequisite_node_ids": [
            "d2-requirements"
          ],
          "map_position": {
            "x": 0.56,
            "y": 0.28
          },
          "prompts": [
            {
              "id": "constraint-table",
              "kind": "what",
              "label": "VERSION CONSTRAINTS",
              "placeholder": "Instead of memorizing shorthand, compare concrete allowed and rejected versions.",
              "required": true,
              "reveal": {
                "type": "table",
                "columns": [
                  {
                    "id": "constraint",
                    "label": "Constraint"
                  },
                  {
                    "id": "allows",
                    "label": "Example allowed"
                  },
                  {
                    "id": "rejects",
                    "label": "Example rejected"
                  },
                  {
                    "id": "meaning",
                    "label": "Practical meaning"
                  }
                ],
                "rows": [
                  {
                    "cells": {
                      "constraint": "= 1.2.3",
                      "allows": "1.2.3",
                      "rejects": "1.2.4",
                      "meaning": "Exact version only"
                    }
                  },
                  {
                    "cells": {
                      "constraint": ">= 1.2.0",
                      "allows": "1.8.0",
                      "rejects": "1.1.9",
                      "meaning": "At least this version"
                    }
                  },
                  {
                    "cells": {
                      "constraint": ">= 1.2, < 2.0",
                      "allows": "1.9.5",
                      "rejects": "2.0.0",
                      "meaning": "Explicit lower and upper bounds"
                    }
                  },
                  {
                    "cells": {
                      "constraint": "~> 1.2.3",
                      "allows": "1.2.9",
                      "rejects": "1.3.0",
                      "meaning": "Patch updates within 1.2"
                    }
                  },
                  {
                    "cells": {
                      "constraint": "~> 1.2",
                      "allows": "1.9.0",
                      "rejects": "2.0.0",
                      "meaning": "Minor and patch updates within major version 1"
                    }
                  }
                ]
              }
            },
            {
              "id": "pessimistic",
              "kind": "look_for",
              "label": "HOW TO READ ~>",
              "placeholder": "What is the easiest way to reason about the pessimistic operator?",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "The final written component may increase while earlier written components stay fixed. So ~> 1.2.3 stays in 1.2.x, while ~> 1.2 stays in 1.x."
              }
            }
          ],
          "source_refs": [
            {
              "title": "Provider requirements - version constraints",
              "url": "https://developer.hashicorp.com/terraform/language/providers/requirements"
            }
          ]
        },
        {
          "id": "d2-lockfile",
          "title": "Dependency lock file",
          "concept_ids": [
            "tf.provider.lock",
            "tf.versions"
          ],
          "prerequisite_node_ids": [
            "d2-version-constraints"
          ],
          "map_position": {
            "x": 0.78,
            "y": 0.2
          },
          "prompts": [
            {
              "id": "lock-file",
              "kind": "look_for",
              "label": "INSPECT .terraform.lock.hcl",
              "placeholder": "Terraform generated this lock entry after provider selection. Click the fields to see what is remembered between runs.",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": ".terraform.lock.hcl",
                "language": "hcl",
                "code": "provider \"registry.terraform.io/hashicorp/aws\" {\n  version     = \"5.80.0\"\n  constraints = \"~> 5.80\"\n  hashes = [\n    \"h1:example-checksum\"\n  ]\n}",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "provider-address",
                    "anchor": {
                      "line": 1,
                      "text": "registry.terraform.io/hashicorp/aws",
                      "occurrence": 1
                    },
                    "title": "Locked provider dependency",
                    "explanation": "The lock file currently records provider dependencies. It does not lock remote module selections.",
                    "required": true
                  },
                  {
                    "id": "selected-version",
                    "anchor": {
                      "line": 2,
                      "text": "version     = \"5.80.0\"",
                      "occurrence": 1
                    },
                    "title": "Concrete selected version",
                    "explanation": "Terraform normally reuses this selected provider version on later init runs when it still satisfies the configuration constraints.",
                    "required": true
                  },
                  {
                    "id": "constraints",
                    "anchor": {
                      "line": 3,
                      "text": "constraints = \"~> 5.80\"",
                      "occurrence": 1
                    },
                    "title": "Recorded constraint context",
                    "explanation": "The configuration constraint defines compatibility; the lock file records the specific selection made within it.",
                    "required": true
                  },
                  {
                    "id": "hashes",
                    "anchor": {
                      "line": 4,
                      "text": "hashes = [",
                      "occurrence": 1
                    },
                    "title": "Package checksums",
                    "explanation": "Checksums let Terraform verify that downloaded provider packages match the recorded dependency selection.",
                    "required": true
                  }
                ]
              }
            },
            {
              "id": "upgrade-path",
              "kind": "action",
              "label": "WHEN YOU WANT A NEWER PROVIDER",
              "placeholder": "A newer provider satisfies the configured constraint, but normal terraform init keeps the locked version. What changes the selection?",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Run terraform init -upgrade. Terraform reselects newer provider versions that still satisfy the configured constraints and updates the lock file."
              }
            }
          ],
          "source_refs": [
            {
              "title": "Dependency lock file",
              "url": "https://developer.hashicorp.com/terraform/language/files/dependency-lock"
            },
            {
              "title": "Provider requirements",
              "url": "https://developer.hashicorp.com/terraform/language/providers/requirements"
            }
          ]
        },
        {
          "id": "d2-init-install",
          "title": "How providers get installed",
          "concept_ids": [
            "tf.providers",
            "tf.provider.requirements",
            "tf.provider.lock"
          ],
          "prerequisite_node_ids": [
            "d2-lockfile"
          ],
          "map_position": {
            "x": 0.88,
            "y": 0.3
          },
          "prompts": [
            {
              "id": "install-seq",
              "kind": "action",
              "label": "INIT SELECTION FLOW",
              "placeholder": "What happens when Terraform initializes provider dependencies?",
              "required": true,
              "reveal": {
                "type": "sequence",
                "items": [
                  "Read required_providers declarations across the configuration",
                  "Combine compatible version constraints for each provider",
                  "Consult .terraform.lock.hcl for an existing compatible selection",
                  "Download/install the selected provider package",
                  "Create or update the lock file if the selection changed"
                ]
              }
            },
            {
              "id": "rerun",
              "kind": "when",
              "label": "WHEN TO RERUN INIT",
              "placeholder": "When provider requirements, module sources, or backend settings change, which command should you expect to rerun?",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "terraform init. Initialization is designed to be safe to rerun as a working directory changes."
              }
            }
          ],
          "source_refs": [
            {
              "title": "terraform init",
              "url": "https://developer.hashicorp.com/terraform/cli/commands/init"
            },
            {
              "title": "Provider requirements",
              "url": "https://developer.hashicorp.com/terraform/language/providers/requirements"
            }
          ]
        }
      ]
    },
    {
      "id": "d2-module-2",
      "title": "Provider instances and Terraform state",
      "order": 2,
      "task_ids": [
        "2c",
        "2d"
      ],
      "skill_ids": [
        "2c.1",
        "2d.1"
      ],
      "prerequisite_module_ids": [
        "d2-module-1"
      ],
      "nodes": [
        {
          "id": "d2-provider-config",
          "title": "Provider configuration vs requirement",
          "concept_ids": [
            "tf.providers",
            "tf.provider.aliases"
          ],
          "prerequisite_node_ids": [],
          "map_position": {
            "x": 0.12,
            "y": 0.22
          },
          "prompts": [
            {
              "id": "provider-file",
              "kind": "look_for",
              "label": "INSPECT providers.tf",
              "placeholder": "Provider requirements say which plugin is needed; provider blocks configure instances of that plugin. Click the default, alias, and selection.",
              "required": true,
              "reveal": {
                "type": "code_file",
                "filename": "providers.tf",
                "language": "hcl",
                "code": "provider \"aws\" {\n  region = \"us-east-1\"\n}\n\nprovider \"aws\" {\n  alias  = \"west\"\n  region = \"us-west-2\"\n}\n\nresource \"aws_s3_bucket\" \"west_logs\" {\n  provider = aws.west\n  bucket   = \"example-west-logs\"\n}",
                "line_numbers": true,
                "annotations": [
                  {
                    "id": "default-provider",
                    "anchor": {
                      "line": 1,
                      "text": "provider \"aws\" {",
                      "occurrence": 1
                    },
                    "title": "Default provider configuration",
                    "explanation": "An unaliased provider block is the default configuration for resources that do not choose another instance.",
                    "required": true
                  },
                  {
                    "id": "alias",
                    "anchor": {
                      "line": 6,
                      "text": "alias  = \"west\"",
                      "occurrence": 1
                    },
                    "title": "Aliased provider configuration",
                    "explanation": "alias creates another configuration of the same provider. Its reference is aws.west.",
                    "required": true
                  },
                  {
                    "id": "region-west",
                    "anchor": {
                      "line": 7,
                      "text": "region = \"us-west-2\"",
                      "occurrence": 1
                    },
                    "title": "Provider-specific settings",
                    "explanation": "Provider blocks hold configuration such as region, endpoints, or other provider-defined settings.",
                    "required": true
                  },
                  {
                    "id": "provider-selection",
                    "anchor": {
                      "line": 11,
                      "text": "provider = aws.west",
                      "occurrence": 1
                    },
                    "title": "Resource selects an alias",
                    "explanation": "Provider selections are references, not quoted strings. This resource explicitly uses the aliased aws.west configuration.",
                    "required": true
                  }
                ]
              }
            },
            {
              "id": "empty-default",
              "kind": "not_this",
              "label": "ALL PROVIDERS ALIASED?",
              "placeholder": "What happens if every configuration for a provider has an alias and no unaliased provider block exists?",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Terraform can synthesize an empty default provider configuration. Resources that rely on the default may then fail if the provider requires settings such as a region."
              }
            }
          ],
          "source_refs": [
            {
              "title": "Provider configuration",
              "url": "https://developer.hashicorp.com/terraform/language/providers/configuration"
            },
            {
              "title": "Providers",
              "url": "https://developer.hashicorp.com/terraform/language/providers"
            }
          ]
        },
        {
          "id": "d2-state-purpose",
          "title": "Why Terraform needs state",
          "concept_ids": [
            "tf.state.purpose"
          ],
          "prerequisite_node_ids": [
            "d2-provider-config"
          ],
          "map_position": {
            "x": 0.34,
            "y": 0.18
          },
          "prompts": [
            {
              "id": "state-jobs",
              "kind": "what",
              "label": "STATE RESPONSIBILITIES",
              "placeholder": "State is more than a cache. What important jobs does it perform?",
              "required": true,
              "reveal": {
                "type": "table",
                "columns": [
                  {
                    "id": "job",
                    "label": "State job"
                  },
                  {
                    "id": "why",
                    "label": "Why Terraform needs it"
                  }
                ],
                "rows": [
                  {
                    "cells": {
                      "job": "Resource binding",
                      "why": "Maps Terraform addresses such as aws_instance.web to specific remote objects"
                    }
                  },
                  {
                    "cells": {
                      "job": "Metadata",
                      "why": "Stores information Terraform needs to reason about managed objects and dependencies"
                    }
                  },
                  {
                    "cells": {
                      "job": "Performance and planning context",
                      "why": "Avoids rediscovering every relationship from scratch and supports change calculation"
                    }
                  },
                  {
                    "cells": {
                      "job": "Values",
                      "why": "Can retain resource attributes and may contain sensitive data"
                    }
                  }
                ]
              }
            },
            {
              "id": "three-way",
              "kind": "connects_to",
              "label": "PLAN COMPARISON",
              "placeholder": "What information is brought together during normal planning?",
              "required": true,
              "reveal": {
                "type": "sequence",
                "items": [
                  "Configuration: desired state",
                  "Prior Terraform state: tracked identities and known attributes",
                  "Refreshed remote objects: current provider/API reality",
                  "Plan: proposed actions needed to reconcile toward configuration"
                ]
              }
            }
          ],
          "source_refs": [
            {
              "title": "Terraform state purpose",
              "url": "https://developer.hashicorp.com/terraform/language/state/purpose"
            },
            {
              "title": "Terraform plan",
              "url": "https://developer.hashicorp.com/terraform/cli/commands/plan"
            }
          ]
        }
      ]
    }
  ]
}
