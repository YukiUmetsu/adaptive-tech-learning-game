        {
          "id": "d8-run-triggers",
          "title": "Run triggers coordinate workspace run order",
          "concept_ids": [
            "tf.hcp.runtriggers"
          ],
          "prerequisite_node_ids": [
            "d8-variables"
          ],
          "map_position": {
            "x": 0.56,
            "y": 0.28
          },
          "prompts": [
            {
              "id": "trigger-flow",
              "kind": "connects_to",
              "label": "RUN TRIGGER FLOW",
              "placeholder": "What does a run trigger do?",
              "required": true,
              "reveal": {
                "type": "sequence",
                "items": [
                  "An upstream workspace completes a successful apply",
                  "HCP Terraform queues a run in a configured downstream workspace",
                  "The downstream workspace evaluates its own configuration, variables, and state",
                  "If the downstream needs upstream data, it must obtain that data through an explicit data-sharing mechanism"
                ]
              }
            },
            {
              "id": "not-data",
              "kind": "not_this",
              "label": "TRIGGERS DO NOT PASS OUTPUTS",
              "placeholder": "Does a run trigger automatically carry the upstream workspace outputs into the downstream workspace?",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "No. Run triggers coordinate when a run is queued; they are not a data transport mechanism."
              }
            }
          ],
          "source_refs": [
            {
              "title": "HCP workspace settings - run triggers",
              "url": "https://developer.hashicorp.com/terraform/cloud-docs/workspaces/settings"
            }
          ]
        },
