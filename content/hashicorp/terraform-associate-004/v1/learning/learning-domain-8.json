      "nodes": [
        {
          "id": "d8-run-workflows",
          "title": "VCS-, CLI-, and API-driven workflows can trigger runs",
          "concept_ids": [
            "tf.hcp.runs"
          ],
          "prerequisite_node_ids": [],
          "map_position": {
            "x": 0.12,
            "y": 0.22
          },
          "prompts": [
            {
              "id": "run-workflows",
              "kind": "what",
              "label": "HOW A RUN STARTS",
              "placeholder": "Which workflow fits the system that decides when a Terraform run should start?",
              "required": true,
              "reveal": {
                "type": "table",
                "columns": [
                  {
                    "id": "workflow",
                    "label": "Workflow"
                  },
                  {
                    "id": "trigger",
                    "label": "How configuration/run starts"
                  },
                  {
                    "id": "good_fit",
                    "label": "Good fit"
                  }
                ],
                "rows": [
                  {
                    "cells": {
                      "workflow": "VCS-driven",
                      "trigger": "Commit/pull-request events from a connected repository",
                      "good_fit": "Git-centered team workflow"
                    }
                  },
                  {
                    "cells": {
                      "workflow": "CLI-driven",
                      "trigger": "terraform plan/apply from a local CLI uploads/starts a remote run",
                      "good_fit": "Developers or CI that want familiar CLI commands"
                    }
                  },
                  {
                    "cells": {
                      "workflow": "API-driven",
                      "trigger": "External tooling uploads configuration and creates runs through HCP APIs",
                      "good_fit": "Custom automation and unsupported VCS/integration flows"
                    }
                  }
                ]
              }
            },
            {
              "id": "remote-exec",
              "kind": "connects_to",
              "label": "TRIGGER VS EXECUTION",
              "placeholder": "Does CLI-driven mean Terraform necessarily executes on the engineer’s laptop?",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "No. In the normal HCP CLI-driven workflow, standard CLI commands can start remote HCP Terraform runs and stream their output back to the terminal. Execution mode can also be configured differently."
              }
            }
          ],
          "source_refs": [
            {
              "title": "CLI-driven runs",
              "url": "https://developer.hashicorp.com/terraform/cloud-docs/workspaces/run/cli"
            },
            {
              "title": "API-driven runs",
              "url": "https://developer.hashicorp.com/terraform/cloud-docs/workspaces/run/api"
            }
          ]
        },
        {
