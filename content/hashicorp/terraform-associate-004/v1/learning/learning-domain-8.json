            "y": 0.18
          },
          "prompts": [
            {
              "id": "workspace-compare",
              "kind": "not_this",
              "label": "HCP WORKSPACE VS CLI WORKSPACE",
              "placeholder": "The word workspace means two different things. How do they differ?",
              "required": true,
              "reveal": {
                "type": "table",
                "columns": [
                  {
                    "id": "kind",
                    "label": "Workspace type"
                  },
                  {
                    "id": "boundary",
                    "label": "What it separates"
                  },
                  {
                    "id": "features",
                    "label": "Typical capabilities"
                  }
                ],
                "rows": [
                  {
                    "cells": {
                      "kind": "Terraform CLI workspace",
                      "boundary": "Multiple state instances for one configuration/backend",
                      "features": "Primarily state separation within the same configuration/backend context"
                    }
                  },
                  {
                    "cells": {
                      "kind": "HCP Terraform workspace",
                      "boundary": "A managed infrastructure collection / operational unit",
                      "features": "Own state, variables, run history, permissions, settings, integrations, and execution mode"
                    }
                  }
                ]
              }
            },
            {
              "id": "directory-analogy",
              "kind": "connects_to",
              "label": "WORKING DIRECTORY ANALOGY",
              "placeholder": "What is a useful mental comparison for an HCP Terraform workspace?",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "It is similar to a persistent shared working-directory boundary: it groups the state, variables, configuration/run context, and settings for one collection of infrastructure."
              }
            }
          ],
          "source_refs": [
            {
              "title": "HCP workspaces",
              "url": "https://developer.hashicorp.com/terraform/cloud-docs/workspaces"
            }
          ]
        },
