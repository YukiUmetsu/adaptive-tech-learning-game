                  {
                    "cells": {
                      "object": "Project",
                      "role": "Groups workspaces/Stacks and can scope team access and variable sets"
                    }
                  },
                  {
                    "cells": {
                      "object": "Workspace",
                      "role": "Run/state/variable boundary for one managed infrastructure collection"
                    }
