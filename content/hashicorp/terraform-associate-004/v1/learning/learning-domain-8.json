        {
          "id": "d8-hcp-purpose",
          "title": "HCP Terraform adds a shared control plane",
          "concept_ids": [
            "tf.hcp"
          ],
          "prerequisite_node_ids": [],
          "map_position": {
            "x": 0.12,
            "y": 0.22
          },
          "prompts": [
            {
              "id": "hcp-value",
              "kind": "what",
              "label": "WHAT HCP TERRAFORM ADDS",
              "placeholder": "What responsibilities can move from individual laptops into HCP Terraform?",
              "required": true,
              "reveal": {
                "type": "table",
                "columns": [
                  {
                    "id": "capability",
                    "label": "Capability"
                  },
                  {
                    "id": "value",
                    "label": "Why teams use it"
                  }
                ],
                "rows": [
                  {
                    "cells": {
                      "capability": "Remote/shared state",
                      "value": "Central state history and controlled access"
                    }
                  },
                  {
                    "cells": {
                      "capability": "Remote runs",
                      "value": "Consistent plan/apply execution with shared logs and run history"
                    }
                  },
                  {
                    "cells": {
                      "capability": "Variables and variable sets",
                      "value": "Centralized run inputs at workspace/project/organization scopes"
                    }
                  },
                  {
                    "cells": {
                      "capability": "Teams and permissions",
                      "value": "Control who can read, plan, apply, or administer"
                    }
                  },
                  {
                    "cells": {
                      "capability": "Policy/health/governance features",
                      "value": "Evaluate guardrails and surface drift/compliance issues"
                    }
                  }
                ]
              }
            },
            {
              "id": "not-provider",
              "kind": "not_this",
              "label": "HCP TERRAFORM DOES NOT REPLACE PROVIDERS",
              "placeholder": "Does HCP Terraform eliminate provider plugins or Terraform state?",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "No. It hosts and coordinates Terraform workflows. Providers still integrate with target APIs, and each workspace still has state for its managed infrastructure."
              }
            }
          ],
          "source_refs": [
            {
              "title": "HCP Terraform overview",
              "url": "https://developer.hashicorp.com/terraform/cloud-docs/overview"
            }
          ]
        },
        {
          "id": "d8-workspace",
          "title": "HCP workspace is an operational boundary",
          "concept_ids": [
            "tf.hcp.workspace",
            "tf.cli.workspaces"
          ],
          "prerequisite_node_ids": [
            "d8-hcp-purpose"
