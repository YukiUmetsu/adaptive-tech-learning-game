        {
          "id": "d8-execution-mode",
          "title": "Remote, local, and agent execution are different boundaries",
          "concept_ids": [
            "tf.hcp.runs",
            "tf.hcp.workspace"
          ],
          "prerequisite_node_ids": [
            "d8-cloud-block"
          ],
          "map_position": {
            "x": 0.56,
            "y": 0.28
          },
          "prompts": [
            {
              "id": "execution",
              "kind": "what",
              "label": "EXECUTION MODES",
              "placeholder": "Where does the Terraform process run for each HCP workspace execution mode?",
              "required": true,
              "reveal": {
                "type": "table",
                "columns": [
                  {
                    "id": "mode",
                    "label": "Execution mode"
                  },
                  {
                    "id": "where",
                    "label": "Where Terraform runs"
                  },
                  {
                    "id": "state",
                    "label": "State relationship"
                  }
                ],
                "rows": [
                  {
                    "cells": {
                      "mode": "Remote",
                      "where": "HCP Terraform-managed run environment",
                      "state": "Workspace state remains in HCP Terraform"
                    }
                  },
                  {
                    "cells": {
                      "mode": "Local",
                      "where": "Your local/CI environment",
                      "state": "CLI integration can still use HCP Terraform workspace state"
                    }
                  },
                  {
                    "cells": {
                      "mode": "Agent",
                      "where": "Self-hosted HCP Terraform agent pool",
