            },
            {
              "id": "project-choice",
              "kind": "when",
              "label": "WHEN TO CREATE PROJECT BOUNDARIES",
              "placeholder": "What is a practical reason to separate workspaces into projects?",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "Use projects when groups of workspaces need distinct ownership, access rules, or shared project-scoped settings/variable sets, such as different teams or business units."
