        {
          "id": "d8-dynamic-creds",
          "title": "Dynamic credentials replace long-lived cloud keys",
          "concept_ids": [
            "tf.hcp.dynamic_creds",
            "tf.hcp.governance"
          ],
          "prerequisite_node_ids": [],
          "map_position": {
            "x": 0.12,
            "y": 0.22
          },
          "prompts": [
            {
              "id": "dynamic-flow",
              "kind": "action",
              "label": "DYNAMIC CREDENTIAL FLOW",
              "placeholder": "How does HCP Terraform obtain short-lived provider credentials for a run?",
              "required": true,
              "reveal": {
                "type": "sequence",
                "items": [
                  "Configure a trust relationship between the cloud platform and HCP Terraform",
                  "A Terraform run starts for an authorized workspace",
                  "HCP Terraform presents a workload identity token",
                  "The cloud platform exchanges/accepts that identity for short-lived scoped credentials",
                  "The provider uses those temporary credentials during the run"
                ]
              }
            },
            {
              "id": "dynamic-benefit",
              "kind": "not_this",
              "label": "WHAT THIS SOLVES",
              "placeholder": "What changes compared with static cloud access keys stored as workspace variables?",
              "required": true,
              "reveal": {
                "type": "table",
                "columns": [
                  {
                    "id": "approach",
                    "label": "Approach"
                  },
                  {
                    "id": "secret_lifetime",
                    "label": "Credential lifetime"
                  },
                  {
                    "id": "management",
                    "label": "Management burden"
                  }
                ],
                "rows": [
                  {
                    "cells": {
                      "approach": "Static provider credentials",
                      "secret_lifetime": "Long-lived until rotated/revoked",
                      "management": "Store and rotate secrets manually"
                    }
                  },
                  {
                    "cells": {
                      "approach": "Dynamic provider credentials",
                      "secret_lifetime": "Short-lived per run/session",
                      "management": "Trust configuration issues credentials automatically based on run identity"
                    }
                  }
                ]
              }
            }
          ],
          "source_refs": [
            {
              "title": "Dynamic provider credentials",
              "url": "https://developer.hashicorp.com/terraform/cloud-docs/dynamic-provider-credentials"
            }
          ]
        },
