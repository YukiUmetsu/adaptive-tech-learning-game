          "map_position": {
            "x": 0.34,
            "y": 0.18
          },
          "prompts": [
            {
              "id": "variable-scope",
              "kind": "what",
              "label": "VARIABLE SET SCOPE",
              "placeholder": "Where should a reusable HCP Terraform variable set be scoped?",
              "required": true,
              "reveal": {
                "type": "table",
                "columns": [
                  {
                    "id": "scope",
                    "label": "Scope"
                  },
                  {
                    "id": "use",
                    "label": "Use when"
                  }
                ],
                "rows": [
                  {
                    "cells": {
                      "scope": "Workspace",
                      "use": "Only one workspace needs the shared values"
                    }
                  },
                  {
                    "cells": {
                      "scope": "Project",
                      "use": "Current and future workspaces in one project should receive the shared values"
                    }
                  },
                  {
                    "cells": {
                      "scope": "Organization / broader scope",
                      "use": "Many workspaces across projects need centrally managed shared values, subject to HCP capabilities/permissions"
                    }
                  }
                ]
              }
            },
            {
              "id": "not-state",
              "kind": "not_this",
              "label": "VARIABLE SETS DO NOT MERGE STATE",
              "placeholder": "If ten workspaces share one variable set, do they share one Terraform state?",
              "required": true,
              "reveal": {
                "type": "text",
                "text": "No. Variable sets share input values; each HCP workspace still keeps its own state and run history."
              }
            }
          ],
          "source_refs": [
            {
              "title": "HCP projects",
