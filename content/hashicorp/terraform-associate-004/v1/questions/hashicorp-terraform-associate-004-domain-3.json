      "name": "terraform fmt",
      "description": "Rewrites configuration to canonical style."
    },
    {
      "id": "tf.cli.plan",
      "name": "terraform plan",
      "description": "Refreshes by default and proposes changes without modifying remote infrastructure."
    },
    {
      "id": "tf.cli.apply",
      "name": "terraform apply",
      "description": "Executes a plan and updates state for completed operations."
    },
