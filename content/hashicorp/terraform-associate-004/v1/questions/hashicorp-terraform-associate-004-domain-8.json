            "stage": "action",
            "choices": [
              {
                "id": "dynamic",
                "label": "Configure HCP Terraform dynamic provider credentials"
              },
              {
                "id": "static",
                "label": "Store permanent access keys as plain Terraform variables"
              },
              {
                "id": "commit",
                "label": "Commit credentials in terraform.tfvars"
              }
            ],
            "next_step_by_choice": {
              "dynamic": "s2",
              "static": "s2",
              "commit": "s2"
            }
          },
          {
            "id": "s2",
            "prompt": "Why is this preferable?",
            "stage": "verification",
            "choices": [
              {
                "id": "short",
                "label": "Runs receive short-lived, scoped credentials instead of a long-lived shared secret"
              },
              {
                "id": "state",
                "label": "It eliminates Terraform state entirely"
              },
              {
                "id": "provider",
                "label": "It removes the need for a provider"
              }
            ],
            "next_step_by_choice": {}
          }
