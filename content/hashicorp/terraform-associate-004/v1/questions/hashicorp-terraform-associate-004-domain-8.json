  "concepts": [
    {
      "id": "tf.hcp",
      "name": "HCP Terraform",
      "description": "HashiCorp hosted Terraform service for state, runs, collaboration, governance, and integrations."
    },
    {
      "id": "tf.hcp.workspace",
      "name": "HCP Terraform workspaces",
      "description": "Independent operational units with configuration, variables, state, run history, settings, and integrations."
    },
    {
      "id": "tf.hcp.project",
      "name": "HCP Terraform projects",
      "description": "Projects group workspaces and help organize access and shared variable sets."
    },
    {
      "id": "tf.hcp.runs",
      "name": "HCP Terraform run workflows",
      "description": "HCP Terraform supports VCS-, CLI-, API-driven workflows and remote execution."
    },
    {
      "id": "tf.hcp.variables",
      "name": "HCP variables and variable sets",
      "description": "Workspace variables and reusable variable sets parameterize runs at different scopes."
    },
    {
      "id": "tf.hcp.runtriggers",
      "name": "Run triggers",
      "description": "Run triggers queue downstream workspace runs after successful upstream applies; they do not pass values."
    },
    {
      "id": "tf.hcp.governance",
      "name": "Governance and policy",
      "description": "Policies, teams, permissions, health assessments, drift detection, and registry features support governance."
    },
    {
      "id": "tf.hcp.dynamic_creds",
      "name": "Dynamic provider credentials",
      "description": "Dynamic credentials avoid long-lived static cloud credentials in HCP Terraform runs."
    },
    {
      "id": "tf.cli.workspaces",
      "name": "CLI workspaces",
      "description": "CLI workspaces are multiple state instances for one configuration/backend and are not equivalent to HCP workspaces."
    }
  ],
