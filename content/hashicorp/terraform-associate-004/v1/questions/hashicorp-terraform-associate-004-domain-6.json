  "concepts": [
    {
      "id": "tf.backend",
      "name": "Terraform backends",
      "description": "A backend determines where state is stored and related operations such as locking when supported."
    },
    {
      "id": "tf.backend.local",
      "name": "Local backend",
      "description": "The default local backend stores state on local disk."
    },
    {
      "id": "tf.backend.remote",
      "name": "Remote state storage",
      "description": "Remote backends centralize state for collaboration and security controls."
    },
    {
      "id": "tf.locking",
      "name": "State locking",
      "description": "Write operations automatically lock state when the backend supports locking."
    },
    {
      "id": "tf.drift",
      "name": "Resource drift",
      "description": "Terraform compares configuration, state, and remote objects; normal plans usually reconcile drift to configuration."
    },
    {
      "id": "tf.refresh_only",
      "name": "Refresh-only mode",
      "description": "Refresh-only updates state and root outputs to remote reality without changing remote objects."
    },
    {
      "id": "tf.moved",
      "name": "moved blocks",
      "description": "moved declares address refactoring without recreation solely due to the address change."
    },
    {
      "id": "tf.removed",
      "name": "removed blocks",
      "description": "removed can stop managing an object and optionally keep the real object with destroy=false."
    },
    {
      "id": "tf.state.cli",
      "name": "State CLI",
      "description": "state list/show/mv/rm/pull/push/replace-provider manipulate or inspect state with varying risk."
    }
  ],
