  "concepts": [
    {
      "id": "tf.iac",
      "name": "Infrastructure as Code",
      "description": "Infrastructure is described declaratively in versioned configuration rather than only through manual actions."
    },
    {
      "id": "tf.declarative",
      "name": "Declarative desired state",
      "description": "Terraform configuration describes a desired end state that providers reconcile with real systems."
    },
    {
      "id": "tf.repeatability",
      "name": "Repeatability and review",
      "description": "Version-controlled configuration enables repeatable, reviewable, auditable changes."
    },
    {
      "id": "tf.multicloud",
      "name": "Provider-based multi-cloud workflows",
      "description": "Terraform uses provider plugins to manage many APIs with a consistent workflow."
    }
  ],
