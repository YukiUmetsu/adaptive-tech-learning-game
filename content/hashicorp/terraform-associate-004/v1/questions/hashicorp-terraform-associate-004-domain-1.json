    {
      "id": "d1-1a-iac-classify-001",
      "content_version": "terraform-associate-004-content-v1",
      "certification_version": "terraform-associate-004",
      "domain_id": "domain-1",
      "task_id": "1a",
      "assessment_mode": "recognition",
      "interaction_type": "classification",
      "difficulty_prior": 0.18,
      "prompt": "Classify each statement as Infrastructure as Code or manual-only infrastructure management.",
      "interaction": {
        "type": "classification",
        "items": [
          {
            "id": "git_config",
            "label": "Network and compute declarations are reviewed in Git"
          },
          {
            "id": "click_change",
            "label": "An operator changes a firewall rule only through a console with no recorded configuration"
          },
          {
            "id": "repeat_env",
            "label": "The same configuration is applied to create another environment"
          },
          {
            "id": "tribal",
            "label": "The current topology exists only in an administrator’s memory"
          }
        ],
        "categories": [
          {
            "id": "iac",
            "label": "IaC"
          },
          {
            "id": "manual",
            "label": "Manual-only"
          }
        ]
      },
      "canonical_answer": {
        "type": "classification",
        "placements": {
          "git_config": "iac",
          "click_change": "manual",
          "repeat_env": "iac",
          "tribal": "manual"
        }
      },
      "concepts": [
        {
          "concept_id": "tf.iac",
          "weight": 1.0
        }
      ],
      "explanation": "IaC expresses infrastructure in machine-readable configuration that can be reviewed and reused. Console usage is not inherently wrong, but a change that exists only as an unrecorded manual action is outside an IaC workflow.",
      "hints": [
        "Classify by the primary Terraform behavior, not by a keyword that merely appears in the option."
      ],
