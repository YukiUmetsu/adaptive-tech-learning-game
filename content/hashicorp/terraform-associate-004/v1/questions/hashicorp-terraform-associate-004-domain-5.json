  "concepts": [
    {
      "id": "tf.modules",
      "name": "Terraform modules",
      "description": "Modules package reusable Terraform configuration with explicit inputs and outputs."
    },
    {
      "id": "tf.module.sources",
      "name": "Module sources",
      "description": "Modules can come from registries, local paths, Git, HTTP/object storage, and other supported sources."
    },
    {
      "id": "tf.module.scope",
      "name": "Module scope",
      "description": "Child modules receive values through input variables and expose results through outputs."
    },
    {
      "id": "tf.module.versions",
      "name": "Module versioning",
      "description": "Registry modules can use a version argument; non-registry sources use source-specific pinning such as Git ref."
    },
    {
      "id": "tf.module.providers",
      "name": "Providers in modules",
      "description": "Each module declares provider requirements; provider configurations are usually defined in the root and inherited or explicitly passed."
    },
    {
      "id": "tf.module.aliases",
      "name": "Aliased providers in modules",
      "description": "configuration_aliases and a module providers map pass aliased provider configurations to children."
    }
  ],
