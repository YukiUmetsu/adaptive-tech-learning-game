  "concepts": [
    {
      "id": "tf.providers",
      "name": "Terraform providers",
      "description": "Provider plugins implement resource and data source types and communicate with external APIs."
    },
    {
      "id": "tf.provider.requirements",
      "name": "Provider requirements",
      "description": "required_providers declares provider source addresses and version constraints."
    },
    {
      "id": "tf.provider.aliases",
      "name": "Provider aliases",
      "description": "Aliases let one configuration use multiple configurations of the same provider."
    },
    {
      "id": "tf.provider.lock",
      "name": "Dependency lock file",
      "description": ".terraform.lock.hcl records selected provider versions and checksums, not module versions."
    },
    {
      "id": "tf.versions",
      "name": "Terraform and provider versions",
      "description": "required_version constrains Terraform CLI while required_providers constrains provider plugins."
    },
    {
      "id": "tf.state.purpose",
      "name": "State purpose",
      "description": "Terraform state binds resource addresses to remote objects and stores metadata needed for planning."
    }
  ],
